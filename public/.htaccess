# ==============================================================================
# ARMSTRONG LOCKSMITH — HIGH PERFORMANCE SERVER OPTIMIZATION (.htaccess)
# Designed for Cloudways Nginx/Apache Hybrid Stack with Varnish
# ==============================================================================

# 1. Directory Index & Error Handling
DirectoryIndex index.html index.php
ErrorDocument 404 /404-handler.php

# 2. Rewrite Engine Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (canonical domain)
  RewriteCond %{HTTP_HOST} ^www\.armstronglocksmithinc\.com [NC]
  RewriteRule ^(.*)$ https://armstronglocksmithinc.com/$1 [L,R=301]

  # Admin Content Studio Direct Entry
  RewriteRule ^admin/?$ /admin/index.php [L,R=302]

  # ============================================================================
  # 301 PERMANENT REDIRECTS FOR LEGACY CITY / SUBURB / DOORWAY PAGES
  # Forward all indexed regional and doorway URLs to the consolidated hub
  # ============================================================================
  
  # Location / City prefix folders (e.g. /service-area/*, /locations/*, /cities/*)
  RewriteRule ^service-area/.*$ /service-areas/ [L,R=301,NC]
  RewriteRule ^locations?/.*$ /service-areas/ [L,R=301,NC]
  RewriteRule ^cit(y|ies)/.*$ /service-areas/ [L,R=301,NC]
  RewriteRule ^areas?/.*$ /service-areas/ [L,R=301,NC]

  # Common generic "near-me" / 24-hour doorway queries
  RewriteRule ^(locksmith-near-me|emergency-locksmith-near-me|mobile-locksmith-near-me|24-hour-locksmith|24-7-locksmith|cheap-locksmith-nashville|locksmith-service-areas)/?$ /service-areas/ [L,R=301,NC]

  # All city/suburb prefix and suffix variations
  # Matches locksmith-brentwood, brentwood-locksmith, locksmith-in-brentwood, commercial-locksmith-brentwood, etc.
  RewriteRule ^(emergency-|commercial-|residential-|automotive-|car-|mobile-)?locksmith-(in-)?(brentwood|franklin|cool-springs|coolsprings|murfreesboro|hendersonville|mount-juliet|mt-juliet|mtjuliet|lebanon|smyrna|la-vergne|lavergne|gallatin|spring-hill|springhill|antioch|donelson|hermitage|green-hills|greenhills|belle-meade|bellemeade|nolensville|east-nashville|goodlettsville|madison|columbia|dickson|clarksville|fairview|thompsons-station|thompson-station|berry-hill|berryhill|inglewood|old-hickory|oldhickory|bellevue|west-end|the-gulch|gulch|germantown)(-tn)?/?$ /service-areas/ [L,R=301,NC]

  RewriteRule ^(brentwood|franklin|cool-springs|coolsprings|murfreesboro|hendersonville|mount-juliet|mt-juliet|mtjuliet|lebanon|smyrna|la-vergne|lavergne|gallatin|spring-hill|springhill|antioch|donelson|hermitage|green-hills|greenhills|belle-meade|bellemeade|nolensville|east-nashville|goodlettsville|madison|columbia|dickson|clarksville|fairview|thompsons-station|thompson-station|berry-hill|berryhill|inglewood|old-hickory|oldhickory|bellevue|west-end|the-gulch|gulch|germantown)(-tn)?-locksmith/?$ /service-areas/ [L,R=301,NC]

  # Standalone city slugs
  RewriteRule ^(brentwood|franklin|cool-springs|coolsprings|murfreesboro|hendersonville|mount-juliet|mt-juliet|mtjuliet|lebanon|smyrna|la-vergne|lavergne|gallatin|spring-hill|springhill|antioch|donelson|hermitage|green-hills|greenhills|belle-meade|bellemeade|nolensville|east-nashville|goodlettsville|madison|columbia|dickson|clarksville|fairview|thompsons-station|thompson-station|berry-hill|berryhill|inglewood|old-hickory|oldhickory|bellevue|the-gulch|germantown)(-tn)?/?$ /service-areas/ [L,R=301,NC]

  # Legacy WordPress taxonomy & author archives
  RewriteRule ^(category|tag|author)/.*$ /blog/ [L,R=301,NC]

  # Sitemap Rewrites & Aliases for Search Console
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]
  RewriteRule ^sitemap_index\.xml$ /sitemap-index.xml [L,R=301]
  RewriteRule ^page-sitemap\.xml$ /sitemap-0.xml [L,R=301]
  RewriteRule ^post-sitemap\.xml$ /sitemap-0.xml [L,R=301]

  # Clean URLs (serve directory index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Clean URLs (serve .html without extension in URL)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # === SMART 404 CATCH-ALL ===
  # Route unmatched URLs through index.php which returns proper HTTP 404.
  # This works on Cloudways because Nginx proxies PHP requests to Apache/PHP-FPM,
  # while static 404s via .htaccess alone get intercepted by Nginx's try_files fallback.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule .* /index.php [L]
</IfModule>

# 3. Gzip & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 font/ttf application/vnd.ms-fontobject
</IfModule>

# 4. Enterprise Browser Caching (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML Pages (Fresh cache with instant revalidation)
  ExpiresByType text/html "access plus 1 hour"

  # CSS & JavaScript (1 Year Immutable)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images & Media (1 Year Immutable)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts (1 Year Immutable)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Data & Feeds
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# 5. HTTP Cache-Control & Security Headers
<IfModule mod_headers.c>
  # 1-Year Cache for static assets
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|avif|js|css|swf|woff|woff2|ttf|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Short TTL for crawler-facing text assets (robots.txt, sitemaps, llms.txt).
  # These change on deploy; a long TTL lets CDNs pin a stale copy for a year.
  <FilesMatch "^(robots\.txt|llms\.txt|sitemap[^/]*\.xml)$">
    Header set Cache-Control "public, max-age=300, s-maxage=300"
  </FilesMatch>

  # Zero Stale Cache for HTML & PHP (Instant updates on Cloudflare & Browsers)
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0, private"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers for Core Web Vitals Trust
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Disable Server Signature & ETag Optimization
ServerSignature Off
FileETag MTime Size
