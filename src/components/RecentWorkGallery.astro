<section class="py-12 sm:py-16 bg-slate-50 border-y border-slate-200 font-sans" id="recent-work-gallery" style="content-visibility: auto; contain-intrinsic-size: 0 700px;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean, Natural, Non-AI) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black font-heading text-[#0f274a] tracking-tight">
          Recent Jobs From Our Shop &amp; Vans
        </h2>
        <p class="text-slate-600 mt-1 text-xs sm:text-sm max-w-2xl">
          Real car key, commercial door lock, and residential re-key jobs done by Rahim, Kawa, and Sako across Greater Nashville and at our walk-in shop.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2" id="gallery-filter-tabs">
        <button 
          type="button" 
          data-filter="all" 
          class="gallery-filter-btn active px-3.5 py-2 text-xs font-bold rounded-md bg-[#0f274a] text-white border border-[#0f274a] cursor-pointer transition"
        >
          All Jobs ({projects.length})
        </button>
        <button 
          type="button" 
          data-filter="automotive" 
          class="gallery-filter-btn px-3.5 py-2 text-xs font-bold rounded-md bg-white text-slate-700 hover:text-slate-900 border border-slate-300 cursor-pointer transition"
        >
          Car Keys ({projects.filter(p => p.category === 'automotive').length})
        </button>
        <button 
          type="button" 
          data-filter="commercial" 
          class="gallery-filter-btn px-3.5 py-2 text-xs font-bold rounded-md bg-white text-slate-700 hover:text-slate-900 border border-slate-300 cursor-pointer transition"
        >
          Commercial ({projects.filter(p => p.category === 'commercial').length})
        </button>
        <button 
          type="button" 
          data-filter="residential" 
          class="gallery-filter-btn px-3.5 py-2 text-xs font-bold rounded-md bg-white text-slate-700 hover:text-slate-900 border border-slate-300 cursor-pointer transition"
        >
          Home &amp; Unlock ({projects.filter(p => p.category === 'residential').length})
        </button>
      </div>
    </div>

    <!-- Clean 3-Column Photo Grid (No AI "Challenge/Solution" Box or Floating Badges on Photos) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch" id="gallery-cards-grid">
      {projects.map((project, idx) => (
        <a 
          href={project.href} 
          class={`gallery-item-card overflow-hidden bg-white rounded-xl border border-slate-200 hover:border-slate-400 shadow-sm hover:shadow-md group transition flex flex-col justify-between cursor-pointer ${idx >= 6 ? 'gallery-extra-item hidden' : ''}`}
          data-category={project.category}
        >
          <div>
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100 border-b border-slate-100">
              <picture>
                <source type="image/webp" srcset={`${project.webpSrc600} 600w, ${project.webpSrc600.replace('-600.webp', '-900.webp')} 900w`} sizes="(max-width: 639px) 340px, (max-width: 1023px) 50vw, 33vw" />
                <img 
                  src={project.webpSrc600 || project.imageSrc} 
                  alt={project.alt} 
                  class="w-full h-full object-cover" 
                  loading="lazy" 
                  fetchpriority="low"
                  decoding="async" 
                  width="600" 
                  height="450" 
                />
              </picture>
            </div>

            <div class="p-5 text-left">
              <div class="text-xs font-semibold text-slate-500 mb-1">
                {project.categoryLabel} &bull; {project.location}
              </div>
              <h3 class="text-base font-bold text-[#0f274a] leading-snug mb-1.5 group-hover:text-amber-700 transition">
                {project.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {project.subtitle}
              </p>
            </div>
          </div>

          <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#0f274a]">
            <span>Read Job Details &rarr;</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Show More Jobs Button -->
    <div class="mt-8 text-center" id="gallery-expand-wrapper">
      <button 
        type="button" 
        id="gallery-toggle-btn"
        data-default-label={`Show All ${projects.length} Jobs`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-white hover:bg-slate-100 text-[#0f274a] border border-slate-300 font-bold text-xs sm:text-sm cursor-pointer transition"
      >
        <span id="gallery-btn-text">Show All {projects.length} Jobs</span>
        <svg id="gallery-btn-icon" class="w-4 h-4 text-slate-600 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.gallery-filter-btn');
    const cards = document.querySelectorAll('.gallery-item-card');
    const extraCards = document.querySelectorAll('.gallery-extra-item');
    const toggleBtn = document.getElementById('gallery-toggle-btn');
    const toggleText = document.getElementById('gallery-btn-text');
    const toggleIcon = document.getElementById('gallery-btn-icon');
    const expandWrapper = document.getElementById('gallery-expand-wrapper');

    let isExpanded = false;
    let activeFilter = 'all';

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        activeFilter = filter;

        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#0f274a]', 'text-white', 'border-[#0f274a]');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
        });
        btn.classList.add('active', 'bg-[#0f274a]', 'text-white', 'border-[#0f274a]');
        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            if (filter !== 'all') {
              card.classList.remove('hidden');
            } else {
              if (card.classList.contains('gallery-extra-item') && !isExpanded) {
                card.classList.add('hidden');
              } else {
                card.classList.remove('hidden');
              }
            }
          } else {
            card.classList.add('hidden');
          }
        });

        if (expandWrapper) {
          if (filter !== 'all') {
            expandWrapper.classList.add('hidden');
          } else {
            expandWrapper.classList.remove('hidden');
          }
        }
      });
    });

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;

        extraCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (activeFilter === 'all' || category === activeFilter) {
            if (isExpanded) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }
        });

        if (isExpanded) {
          toggleText.textContent = 'Show Fewer Jobs';
          toggleIcon.classList.add('rotate-180');
        } else {
          toggleText.textContent = toggleBtn.getAttribute('data-default-label') || 'Show All Jobs';
          toggleIcon.classList.remove('rotate-180');
        }
      });
    }
  });
</script>
