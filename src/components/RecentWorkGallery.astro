---
// RecentWorkGallery.astro - Masonry-style gallery of real jobs
---

<section class="py-20 bg-slate-50 border-y border-slate-200 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-black uppercase tracking-wider mb-4 border border-amber-200">
        <span>📸</span>
        <span>Real Jobs &bull; Real Expertise</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-serif text-[#0f274a] tracking-tight leading-tight">
        Don't Trust Stock Photos. <br />
        <span class="text-amber-500">See Our Real Work.</span>
      </h2>
      <p class="text-slate-600 mt-4 text-sm sm:text-base leading-relaxed font-medium">
        Many "locksmiths" online are out-of-state dispatch centers using fake stock images. We are a real, local Nashville team. Browse our recent high-end automotive, commercial, and residential jobs.
      </p>
    </div>

    <!-- Masonry Grid Layout -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      
      <!-- Item 1: Maserati -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/Maserati-key-cut-and-programmed--scaled.jpg" alt="Maserati Smart Key Programming" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-1">Automotive</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Maserati Proximity Smart Key</h3>
        </div>
      </div>

      <!-- Item 2: Commercial Keypad -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/before-keypad-installation-on-commercial-door.jpg" alt="Commercial Door Keypad Installation" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">Commercial</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Commercial Access Control Keypad</h3>
        </div>
      </div>

      <!-- Item 3: Mercedes -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/mercedes-Benz_20250627_002342_0000-1-scaled.jpg" alt="Mercedes-Benz Key Fitment" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-1">European</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Mercedes-Benz EIS Programming</h3>
        </div>
      </div>

      <!-- Item 4: Toyota Lishi -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/TOYOTA-LISHI-TOOL.jpg" alt="Lishi Tool Lock Decoding" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-1">Origination</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Lishi Decoding a Toyota Door Lock</h3>
        </div>
      </div>

      <!-- Item 5: Audi -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/rahim-made-audi-keys-in-nashville-1.png" alt="Rahim Programming Audi Keys" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">Expertise</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Rahim Originating Audi Smart Keys</h3>
        </div>
      </div>

      <!-- Item 6: BMW -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/Bmw-key-replacement-in-Brentwood-tn_20250629_163626_0000.jpg" alt="BMW Key Replacement Brentwood" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-1">European</span>
          <h3 class="text-white font-bold text-sm sm:text-base">BMW CAS/FEM Key Programmed</h3>
        </div>
      </div>

      <!-- Item 7: Sako Unlock -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/sako-armstrong-locksmith-technecian-unlocking-a-car-scaled.jpg" alt="Sako Unlocking a Car" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-red-400 uppercase tracking-widest block mb-1">Emergency</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Sako Performing a Non-Destructive Unlock</h3>
        </div>
      </div>

      <!-- Item 8: Broken Chevy -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/chevy-remote-buttons-gone-1.jpg" alt="Broken Chevy Remote" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-1">Repairs</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Worn Fob Shells & Button Repairs</h3>
        </div>
      </div>

      <!-- Item 9: Storefront Machines -->
      <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white group relative">
        <img src="/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg" alt="Key Machines in Shop" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] to-transparent p-5 pt-12">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">208 Thompson Ln</span>
          <h3 class="text-white font-bold text-sm sm:text-base">Our In-Shop CNC & Laser Cutters</h3>
        </div>
      </div>

    </div>

    <!-- Final CTA -->
    <div class="mt-12 text-center">
      <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-[#0f274a] hover:bg-[#16335c] text-white font-extrabold text-sm shadow-xl hover:-translate-y-1 transition-all">
        Book a Local Expert Online Now &rarr;
      </a>
    </div>

  </div>
</section>
