        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0f274a] via-[#0f274a]/90 to-transparent p-5 pt-16">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">Commercial</span>
