const featuredProject = projects.find(p => p.featured) || projects[0];
const gridProjects = projects.filter(p => p.id !== featuredProject.id);
---

<section class="py-14 sm:py-20 bg-slate-50 border-y border-slate-200 overflow-hidden font-sans" id="recent-work-gallery">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-100 text-amber-900 text-xs font-black uppercase tracking-wider mb-3 border border-amber-200">
        <span>📸</span>
        <span>Real Jobs &bull; Real Nashville Proof</span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black font-heading text-[#0f274a] tracking-tight leading-tight uppercase">
        Don't Trust Stock Photos. <br />
        <span class="text-amber-500">See Our Real Work.</span>
      </h2>
      <p class="text-slate-600 mt-3 text-xs sm:text-sm md:text-base leading-relaxed font-medium">
        Many online listings are out-of-state call centers using generic stock photos. We are real master technicians in Nashville. Browse our recent automotive, commercial, and residential projects.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-6" id="gallery-filter-tabs">
        <button 
          type="button" 
          data-filter="all" 
          class="gallery-filter-btn active px-4 py-2 text-xs font-black uppercase tracking-wider bg-[#07152b] text-amber-400 border border-amber-500/80 shadow-md transition-all cursor-pointer"
        >
          All Projects (10)
        </button>
        <button 
          type="button" 
          data-filter="automotive" 
          class="gallery-filter-btn px-4 py-2 text-xs font-bold uppercase tracking-wider bg-white text-slate-700 hover:text-slate-900 border border-slate-300 hover:border-amber-400 shadow-sm transition-all cursor-pointer"
        >
          🚗 Automotive &amp; European (5)
        </button>
        <button 
          type="button" 
          data-filter="commercial" 
          class="gallery-filter-btn px-4 py-2 text-xs font-bold uppercase tracking-wider bg-white text-slate-700 hover:text-slate-900 border border-slate-300 hover:border-amber-400 shadow-sm transition-all cursor-pointer"
        >
          🏢 Commercial Security (2)
        </button>
        <button 
          type="button" 
          data-filter="emergency" 
          class="gallery-filter-btn px-4 py-2 text-xs font-bold uppercase tracking-wider bg-white text-slate-700 hover:text-slate-900 border border-slate-300 hover:border-amber-400 shadow-sm transition-all cursor-pointer"
        >
          🚨 Emergency &amp; Rekey (3)
        </button>
      </div>
    </div>

    <!-- ==================== FEATURED SPOTLIGHT CASE STUDY ==================== -->
    <div class="gallery-item-card mb-8 sm:mb-10 bg-white border-2 border-amber-500/60 shadow-xl overflow-hidden group" data-category={featuredProject.category}>
      <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
        
        <!-- Left: Verified Photo -->
        <div class="lg:col-span-6 relative overflow-hidden bg-slate-900 min-h-[260px] sm:min-h-[340px]">
          <picture>
            <source type="image/webp" srcset={`${featuredProject.webpSrc600} 600w, ${featuredProject.webpSrc1200} 1200w`} sizes="(max-width: 1023px) 100vw, 50vw" />
            <img 
              src={featuredProject.imageSrc} 
              alt={featuredProject.alt} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              loading="lazy" 
              decoding="async" 
              width="600" 
              height="800" 
            />
          </picture>
          <div class="absolute top-3 left-3 bg-[#07152b]/95 text-amber-400 border border-amber-400/50 px-3 py-1 text-[11px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{featuredProject.badge}</span>
          </div>
        </div>

        <!-- Right: Case Study Context -->
        <div class="lg:col-span-6 p-6 sm:p-8 flex flex-col justify-between bg-[#07152b] text-white">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-widest mb-2">
              <span>{featuredProject.categoryLabel}</span>
              <span>&bull;</span>
              <span class="text-slate-300">{featuredProject.location}</span>
            </div>
            
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-black font-heading uppercase text-white tracking-tight leading-snug mb-3">
              {featuredProject.title}
            </h3>

            <p class="text-slate-200 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
              {featuredProject.subtitle}
            </p>

            <!-- Specs Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 pt-4 border-t border-white/10 text-xs">
              <div class="p-3 bg-white/5 border border-white/10">
                <strong class="block text-amber-400 font-bold uppercase tracking-wider text-[10px]">Challenge</strong>
                <span class="text-slate-300 text-xs">Life-safety code egress with unauthorized exit alarm deterrent.</span>
              </div>
              <div class="p-3 bg-white/5 border border-white/10">
                <strong class="block text-emerald-400 font-bold uppercase tracking-wider text-[10px]">Solution</strong>
                <span class="text-slate-300 text-xs">Installed UL-listed Detex ECL-230D panic hardware on-site.</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-4 border-t border-white/10">
            <span class="text-xs text-slate-300 font-medium">Installed by Armstrong Master Locksmiths</span>
            <a 
              href={featuredProject.href} 
              class="px-5 py-2.5 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:brightness-110 text-slate-950 font-black text-xs uppercase tracking-wider shadow flex items-center justify-center gap-1.5 transition active:scale-95 cursor-pointer"
            >
              <span>Explore Commercial Services &rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- ==================== CURATED UNIFORM GRID ==================== -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch" id="gallery-cards-grid">
      {gridProjects.map((project, idx) => (
        <a 
          href={project.href} 
          class={`gallery-item-card block overflow-hidden bg-white border border-slate-200 hover:border-amber-500 shadow-md hover:shadow-xl group transition-all duration-300 flex flex-col justify-between cursor-pointer ${idx >= 5 ? 'gallery-extra-item hidden' : ''}`}
          data-category={project.category}
        >
          <div>
            <!-- Fixed Aspect Ratio Image Viewport -->
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-900">
              <picture>
                <source type="image/webp" srcset={`${project.webpSrc600} 600w, ${project.webpSrc1200} 1200w`} sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw" />
                <img 
                  src={project.imageSrc} 
                  alt={project.alt} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy" 
                  decoding="async" 
                  width="600" 
                  height="450" 
                />
              </picture>
              
              <!-- Badge Overlay -->
              <div class="absolute top-2.5 left-2.5 bg-[#07152b]/90 text-white border border-white/20 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wider shadow">
                {project.badge}
              </div>

              <!-- Location Tag -->
              <div class="absolute top-2.5 right-2.5 bg-black/60 backdrop-blur-sm text-slate-200 px-2 py-0.5 text-[10px] font-bold">
                📍 {project.location}
              </div>
            </div>

            <!-- Card Body Content -->
            <div class="p-4 sm:p-5 text-left">
              <span class={`text-[10px] font-black uppercase tracking-widest block mb-1 ${project.tagColor === 'emerald' ? 'text-emerald-700' : project.tagColor === 'red' ? 'text-red-700' : 'text-amber-700'}`}>
                {project.categoryLabel}
              </span>
              <h3 class="text-base sm:text-lg font-bold text-[#0f274a] font-heading uppercase tracking-tight leading-tight mb-2 group-hover:text-amber-600 transition">
                {project.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
                {project.subtitle}
              </p>
            </div>
          </div>

          <!-- Card Footer Action -->
          <div class="px-4 sm:px-5 py-2.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-700 group-hover:bg-amber-50/50 transition">
            <span class="text-[11px] text-slate-500">Verified Job</span>
            <span class="text-amber-600 font-extrabold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              View Service &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- ==================== EXPAND / SHOW ALL TOGGLE BUTTON ==================== -->
    <div class="mt-8 sm:mt-10 text-center" id="gallery-expand-wrapper">
      <button 
        type="button" 
        id="gallery-toggle-btn"
        class="inline-flex items-center gap-2 px-6 py-3 bg-[#07152b] hover:bg-[#0f274a] text-white border border-amber-500/60 hover:border-amber-400 font-black text-xs sm:text-sm uppercase tracking-wider shadow-lg transition-all active:scale-95 cursor-pointer"
      >
        <span id="gallery-btn-text">Explore All 10 Field Projects</span>
        <svg id="gallery-btn-icon" class="w-4 h-4 text-amber-400 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>

  </div>
</section>

<!-- Lightweight Filter & Expand Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.gallery-filter-btn');
    const cards = document.querySelectorAll('.gallery-item-card');
    const extraCards = document.querySelectorAll('.gallery-extra-item');
    const toggleBtn = document.getElementById('gallery-toggle-btn');
    const toggleText = document.getElementById('gallery-btn-text');
    const toggleIcon = document.getElementById('gallery-btn-icon');
    const expandWrapper = document.getElementById('gallery-expand-wrapper');

    let isExpanded = false;
    let activeFilter = 'all';

    // 1. Filter Buttons Handler
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        activeFilter = filter;

        // Active tab styling
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#07152b]', 'text-amber-400', 'border-amber-500/80', 'shadow-md');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
        });
        btn.classList.add('active', 'bg-[#07152b]', 'text-amber-400', 'border-amber-500/80', 'shadow-md');
        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');

        // Filter cards
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            // If specific filter selected, show all matching cards
            if (filter !== 'all') {
              card.classList.remove('hidden');
            } else {
              // 'all' filter obeys expansion state
              if (card.classList.contains('gallery-extra-item') && !isExpanded) {
                card.classList.add('hidden');
              } else {
                card.classList.remove('hidden');
              }
            }
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide expand button when filtering by specific category
        if (expandWrapper) {
          if (filter !== 'all') {
            expandWrapper.classList.add('hidden');
          } else {
            expandWrapper.classList.remove('hidden');
          }
        }
      });
    });

    // 2. Expand Toggle Handler
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;

        extraCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (activeFilter === 'all' || category === activeFilter) {
            if (isExpanded) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          }
        });

        if (isExpanded) {
          toggleText.textContent = 'Show Fewer Projects';
          toggleIcon.classList.add('rotate-180');
        } else {
          toggleText.textContent = 'Explore All 10 Field Projects';
          toggleIcon.classList.remove('rotate-180');
          const gallerySec = document.getElementById('recent-work-gallery');
          if (gallerySec) {
            gallerySec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }
  });
</script>
