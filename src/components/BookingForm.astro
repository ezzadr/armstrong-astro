---
// BookingForm.astro - 1:1 Design match of official Armstrong Dispatch booking interface
---

<div class="booking-dispatch-container">
  <header class="topbar">
    <div class="brand">
      <img src="/logo.webp" alt="Armstrong Locksmith" width="64" height="64" loading="eager" />
      <div>
        <strong>Schedule a Job</strong>
        <span>Armstrong Locksmith</span>
      </div>
    </div>
  </header>

  <main class="shell">
    <ol class="progress" id="booking-progress-bar" aria-label="Booking progress">
      <li class="active" data-indicator="1"><span class="dot"></span>Service</li>
      <li data-indicator="2"><span class="dot"></span>Schedule</li>
      <li data-indicator="3"><span class="dot"></span>Details</li>
      <li data-indicator="4"><span class="dot"></span>Summary</li>
    </ol>

    <form id="booking-engine-form" novalidate>
      <input type="hidden" name="service_category" value="" data-service-category />
      <input type="hidden" name="service_details" value="" data-service-details />
      
      <!-- Anti-Spam Honeypot Trap -->
      <div class="hp" aria-hidden="true">
        <label>Company website<input type="text" id="booking-hp" name="company_website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <!-- Submission / Validation Error Box -->
      <div class="errors" id="booking-error-box" hidden>
        <span id="booking-error-message">Please check required fields and try again.</span>
      </div>

      <!-- STEP 1: SERVICE SELECTION -->
      <section class="step" data-step="1">
        <h1 class="question">What service do you need?</h1>
        <div class="services">
          <label class="service">
            <input type="radio" name="service_type" value="Automotive Locksmith" data-category="automotive" required />
            <span>Automotive Locksmith</span>
          </label>
          <label class="service">
            <input type="radio" name="service_type" value="Car Lockout" data-category="emergency_lockout" required />
            <span>Car Lockout</span>
          </label>
          <label class="service">
            <input type="radio" name="service_type" value="Car Key / Programming" data-category="automotive" required />
            <span>Car Key / Programming</span>
          </label>
          <label class="service">
            <input type="radio" name="service_type" value="Residential Locksmith" data-category="residential" required />
            <span>Residential Locksmith</span>
          </label>
          <label class="service">
            <input type="radio" name="service_type" value="House Lockout" data-category="emergency_lockout" required />
            <span>House Lockout</span>
          </label>
          <label class="service">
            <input type="radio" name="service_type" value="Rekey / Lock Change" data-category="residential" required />
            <span>Rekey / Lock Change</span>
          </label>
          <label class="service">
            <input type="radio" name="service_type" value="Commercial Locksmith" data-category="commercial" required />
            <span>Commercial Locksmith</span>
          </label>
        </div>
      </section>

      <!-- STEP 2: SCHEDULE (DATE & TIME WINDOW) -->
      <section class="step" data-step="2" hidden>
        <h1 class="question">When works best for you?</h1>
        <p class="date-title" data-date-title></p>
        <div class="date-browser">
          <button class="arrow" type="button" data-prev aria-label="Earlier dates">‹</button>
          <div class="dates" data-dates></div>
          <button class="arrow" type="button" data-later aria-label="Later dates">›</button>
        </div>
        <div class="native-date">
          <input id="preferred_date" name="preferred_date" type="date" value="" />
        </div>
        <p class="local-time">Times are shown in Nashville local time.</p>
        <p class="time-title">Select a preferred arrival window</p>
        <div class="times">
          <label class="time">
            <input type="radio" name="preferred_time_window" value="morning" required />
            <span>8:00am – 11:00am</span>
          </label>
          <label class="time">
            <input type="radio" name="preferred_time_window" value="afternoon" required />
            <span>11:00am – 3:00pm</span>
          </label>
          <label class="time">
            <input type="radio" name="preferred_time_window" value="evening" required />
            <span>3:00pm – 6:00pm</span>
          </label>
          <label class="time">
            <input type="radio" name="preferred_time_window" value="anytime" checked required />
            <span>Any available time</span>
          </label>
        </div>
        <div class="actions">
          <button class="back" type="button" data-back>‹ Back</button>
          <button class="continue" type="button" data-next>Continue ›</button>
        </div>
      </section>

      <!-- STEP 3: CONTACT DETAILS -->
      <section class="step" data-step="3" hidden>
        <h1 class="question">Please provide your contact info</h1>
        <div class="fields">
          <div class="field">
            <label for="customer_name">Full name</label>
            <input id="customer_name" name="customer_name" value="" maxlength="255" autocomplete="name" placeholder="John Doe" required />
          </div>
          <div class="field">
            <label for="phone">Phone number</label>
            <input id="phone" name="phone" type="tel" value="" maxlength="50" autocomplete="tel" inputmode="tel" placeholder="(615) 555-0123" required />
          </div>
          <div class="field full">
            <label for="email">Email address <span class="optional">(optional)</span></label>
            <input id="email" name="email" type="email" value="" maxlength="255" autocomplete="email" placeholder="john@example.com" />
          </div>
          <div class="field full">
            <label for="service_address">Address</label>
            <input id="service_address" name="service_address" value="" maxlength="255" autocomplete="street-address" placeholder="Street address or location in Nashville" required />
          </div>
          <div class="field">
            <label for="city">City</label>
            <input id="city" name="city" value="Nashville" maxlength="255" autocomplete="address-level2" required />
          </div>
          <div class="field">
            <label for="postal_code">ZIP code</label>
            <input id="postal_code" name="postal_code" value="" maxlength="20" autocomplete="postal-code" inputmode="numeric" placeholder="37211" required />
          </div>
          <input type="hidden" name="state" value="TN" />
          <div class="field full">
            <span class="legend">Contact me by</span>
            <div class="contacts">
              <label class="contact">
                <input type="radio" name="contact_preference" value="phone" checked required />
                <span>Phone call</span>
              </label>
              <label class="contact">
                <input type="radio" name="contact_preference" value="text" required />
                <span>Text message</span>
              </label>
              <label class="contact">
                <input type="radio" name="contact_preference" value="email" required />
                <span>Email</span>
              </label>
            </div>
          </div>
        </div>
        <div class="actions">
          <button class="back" type="button" data-back>‹ Back</button>
          <button class="continue" type="button" data-next>Continue ›</button>
        </div>
      </section>

      <!-- STEP 4: SUMMARY & SUBMISSION -->
      <section class="step" data-step="4" hidden>
        <h1 class="question">Review your request</h1>
        <div class="summary">
          <div class="summary-row">
            <span>Service</span>
            <p data-review="service"></p>
            <button class="edit" type="button" data-edit="1">Edit</button>
          </div>
          <div class="summary-row">
            <span>Preferred time</span>
            <p data-review="schedule"></p>
            <button class="edit" type="button" data-edit="2">Edit</button>
          </div>
          <div class="summary-row">
            <span>Customer</span>
            <p data-review="customer"></p>
            <button class="edit" type="button" data-edit="3">Edit</button>
          </div>
          <div class="summary-row">
            <span>Address</span>
            <p data-review="address"></p>
            <button class="edit" type="button" data-edit="3">Edit</button>
          </div>
        </div>
        <p class="confirmation">
          This is a request, not a confirmed appointment. Armstrong will contact you to confirm availability and pricing.
        </p>
        <div class="actions">
          <button class="back" type="button" data-back>‹ Back</button>
          <button class="submit" type="submit" id="booking-submit-btn">Send request</button>
        </div>
      </section>

      <!-- STEP 5: SUCCESS CONFIRMATION -->
      <section class="step" data-step="5" hidden>
        <div class="success-box">
          <div class="success-icon">✓</div>
          <h2 class="success-title">Booking Request Received!</h2>
          <p class="success-desc">
            Thank you! Your job request has been received by Armstrong Locksmith dispatch. We will contact you shortly to confirm arrival timing and final quote.
          </p>
          <div class="summary" style="margin-bottom: 24px; text-align: left;">
            <div class="summary-row">
              <span>Service</span>
              <p data-success="service"></p>
            </div>
            <div class="summary-row">
              <span>Preferred time</span>
              <p data-success="schedule"></p>
            </div>
            <div class="summary-row">
              <span>Customer</span>
              <p data-success="customer"></p>
            </div>
            <div class="summary-row">
              <span>Address</span>
              <p data-success="address"></p>
            </div>
          </div>
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px !important; padding: 18px; margin-top: 16px;">
            <p style="margin: 0 0 8px; font-weight: 700; color: #0b2138; font-size: 0.95rem;">
              Locked out or need emergency assistance right now?
            </p>
            <a 
              href="tel:6156258000" 
              style="display: inline-flex; align-items: center; gap: 8px; background: #f2bd3f; color: #0b2138; font-weight: 800; padding: 12px 24px; border-radius: 7px !important; text-decoration: none; font-size: 0.95rem; margin-top: 4px;"
            >
              <span>📞 Call Dispatch: (615) 625-8000</span>
            </a>
          </div>
        </div>
      </section>
    </form>
  </main>

  <footer class="footer">
    Powered by <strong>Armstrong Locksmith</strong>
  </footer>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById('booking-engine-form');
    if (!form) return;

    const steps = [...form.querySelectorAll('[data-step]')];
    const indicators = [...document.querySelectorAll('[data-indicator]')];
    const progressBar = document.getElementById('booking-progress-bar');
    const category = form.querySelector('[data-service-category]');
    const details = form.querySelector('[data-service-details]');
    const dateInput = form.querySelector('#preferred_date');
    const dates = form.querySelector('[data-dates]');
    const dateTitle = form.querySelector('[data-date-title]');
    const errorBox = document.getElementById('booking-error-box');
    const errorMessage = document.getElementById('booking-error-message');
    const submitBtn = document.getElementById('booking-submit-btn');
    const honeypot = document.getElementById('booking-hp');
    const prevArrow = form.querySelector('[data-prev]');

    let step = 1;
    let offset = 0;

    const checked = name => form.querySelector(`[name="${name}"]:checked`);
    const value = name => String(form.elements[name]?.value || '').trim();
    const localIso = date => {
      const d = new Date(date);
      d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
      return d.toISOString().slice(0, 10);
    };

    function renderDates() {
      if (!dates || !dateInput) return;
      dates.innerHTML = '';
      if (prevArrow) {
        prevArrow.disabled = offset <= 0;
      }
      for (let i = 0; i < 7; i++) {
        const d = new Date();
        d.setHours(12, 0, 0, 0);
        d.setDate(d.getDate() + offset + i);
        const iso = localIso(d);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'date' + (dateInput.value === iso ? ' selected' : '');
        button.innerHTML = `<span>${d.toLocaleDateString('en-US', { weekday: 'short' })}</span><strong>${d.getDate()}</strong>`;
        button.onclick = () => {
          dateInput.value = iso;
          renderDates();
        };
        dates.append(button);
      }
      const selected = dateInput.value ? new Date(`${dateInput.value}T12:00:00`) : new Date();
      if (dateTitle) {
        dateTitle.textContent = selected.toLocaleDateString('en-US', {
          weekday: 'short',
          month: 'long',
          day: 'numeric',
          year: 'numeric'
        });
      }
    }

    const timeWindowLabels = {
      morning: '8:00am – 11:00am',
      afternoon: '11:00am – 3:00pm',
      evening: '3:00pm – 6:00pm',
      anytime: 'Any available time'
    };

    function getTimeWindowText() {
      const val = checked('preferred_time_window')?.value || 'anytime';
      return timeWindowLabels[val] || val;
    }

    function review() {
      const service = checked('service_type')?.value || '';
      const time = getTimeWindowText();
      const dateFormatted = dateInput?.value ? new Date(`${dateInput.value}T12:00:00`).toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric'
      }) : 'Soonest Available';

      const scheduleText = `${dateFormatted}\n${time}`;
      const customerText = [value('customer_name'), value('phone'), value('email')].filter(Boolean).join('\n');
      const addressText = `${value('service_address')}\n${value('city')}, TN ${value('postal_code')}`;

      const rService = form.querySelector('[data-review="service"]');
      const rSchedule = form.querySelector('[data-review="schedule"]');
      const rCustomer = form.querySelector('[data-review="customer"]');
      const rAddress = form.querySelector('[data-review="address"]');

      if (rService) rService.textContent = service;
      if (rSchedule) rSchedule.textContent = scheduleText;
      if (rCustomer) rCustomer.textContent = customerText;
      if (rAddress) rAddress.textContent = addressText;

      const sService = form.querySelector('[data-success="service"]');
      const sSchedule = form.querySelector('[data-success="schedule"]');
      const sCustomer = form.querySelector('[data-success="customer"]');
      const sAddress = form.querySelector('[data-success="address"]');

      if (sService) sService.textContent = service;
      if (sSchedule) sSchedule.textContent = scheduleText;
      if (sCustomer) sCustomer.textContent = customerText;
      if (sAddress) sAddress.textContent = addressText;
    }

    function show(number) {
      step = Math.max(1, Math.min(5, number));
      steps.forEach(s => (s.hidden = +s.dataset.step !== step));

      if (step === 5 && progressBar) {
        progressBar.hidden = true;
      } else if (progressBar) {
        progressBar.hidden = false;
        indicators.forEach((item, i) => {
          item.classList.toggle('active', i + 1 === step);
          item.classList.toggle('complete', i + 1 < step);
          item.setAttribute('aria-current', i + 1 === step ? 'step' : 'false');
        });
      }

      if (errorBox) errorBox.hidden = true;

      if (step === 4 || step === 5) review();
      window.scrollTo({ top: form.getBoundingClientRect().top + window.scrollY - 100, behavior: 'smooth' });
    }

    function valid() {
      const currentStepElem = steps[step - 1];
      if (!currentStepElem) return true;

      if (step === 2) {
        if (!dateInput.value) {
          showError('Please select a date.');
          return false;
        }
        if (!checked('preferred_time_window')) {
          showError('Please select an arrival window.');
          return false;
        }
      }

      if (step === 3) {
        const nameField = form.querySelector('#customer_name');
        const phoneField = form.querySelector('#phone');
        const addrField = form.querySelector('#service_address');
        const zipField = form.querySelector('#postal_code');

        [nameField, phoneField, addrField, zipField].forEach(f => f?.classList.remove('input-error'));

        if (!nameField?.value.trim()) {
          nameField?.classList.add('input-error');
          nameField?.focus();
          showError('Please enter your full name.');
          return false;
        }

        const phoneDigits = (phoneField?.value || '').replace(/\D/g, '');
        if (phoneDigits.length < 7) {
          phoneField?.classList.add('input-error');
          phoneField?.focus();
          showError('Please enter a valid phone number so our locksmith can reach you.');
          return false;
        }

        if (!addrField?.value.trim()) {
          addrField?.classList.add('input-error');
          addrField?.focus();
          showError('Please enter the service address.');
          return false;
        }

        if (!zipField?.value.trim()) {
          zipField?.classList.add('input-error');
          zipField?.focus();
          showError('Please enter your ZIP code.');
          return false;
        }
      }

      for (const field of currentStepElem.querySelectorAll('input,textarea')) {
        if (field.type !== 'hidden' && field.tabIndex !== -1 && !field.checkValidity()) {
          field.reportValidity();
          field.focus();
          return false;
        }
      }

      if (errorBox) errorBox.hidden = true;
      return true;
    }

    function showError(msg) {
      if (errorBox && errorMessage) {
        errorMessage.textContent = msg;
        errorBox.hidden = false;
      }
    }

    function selectService(input) {
      if (category) category.value = input.dataset.category || '';
      if (details) details.value = input.value;
      setTimeout(() => show(2), 120);
    }

    form.addEventListener('change', event => {
      const service = event.target.closest('[name="service_type"]');
      if (service) selectService(service);
    });

    form.onclick = event => {
      const service = event.target.closest('.service');
      if (service) {
        const radio = service.querySelector('[name="service_type"]');
        if (radio) {
          radio.checked = true;
          selectService(radio);
        }
      } else if (event.target.closest('[data-next]')) {
        if (valid()) show(step + 1);
      } else if (event.target.closest('[data-back]')) {
        show(step - 1);
      } else if (event.target.closest('[data-edit]')) {
        show(+event.target.closest('[data-edit]').dataset.edit);
      }
    };

    if (prevArrow) {
      prevArrow.onclick = () => {
        offset = Math.max(0, offset - 7);
        renderDates();
      };
    }

    const laterArrow = form.querySelector('[data-later]');
    if (laterArrow) {
      laterArrow.onclick = () => {
        offset += 7;
        renderDates();
      };
    }

    // Submit handler
    form.onsubmit = async event => {
      event.preventDefault();
      if (!valid()) return;

      // Spam bot honeypot check
      if (honeypot && honeypot.value.trim() !== '') {
        show(5);
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending request...';
      }

      const serviceName = checked('service_type')?.value || 'Locksmith Service';
      const windowText = getTimeWindowText();
      const preferredDateVal = dateInput.value;
      const fullService = `${serviceName} [${preferredDateVal} • ${windowText}]`;
      const custName = value('customer_name');
      const custPhone = value('phone');
      const custEmail = value('email');
      const custAddress = value('service_address');
      const custCity = value('city') || 'Nashville';
      const custZip = value('postal_code');
      const contactPref = checked('contact_preference')?.value || 'phone';

      const detailsStr = `Address: ${custAddress}, ${custCity}, TN ${custZip} | Prefers: ${contactPref}${custEmail ? ' | Email: ' + custEmail : ''}`;

      try {
        const response = await fetch('/api/contact.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: custName,
            phone: custPhone,
            service: fullService,
            details: detailsStr,
            email: custEmail || 'Not provided',
            notes: `Online Booking Request: ${serviceName} on ${preferredDateVal} (${windowText}), Contact via ${contactPref}`,
            company_website: ''
          })
        });

        // Trigger Google Analytics 4 conversion events
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'booking_submission', {
            event_category: 'Booking',
            event_label: serviceName,
            value: 1
          });
          window.gtag('event', 'generate_lead', {
            event_category: 'Booking',
            event_label: serviceName,
            value: 1
          });
        }

        if (response.ok) {
          show(5);
        } else {
          showError('We could not send your request right now. Please call us directly at (615) 625-8000.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send request';
          }
        }
      } catch (err) {
        console.error('Booking submission error:', err);
        showError('Network error. Please try again or call (615) 625-8000.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send request';
        }
      }
    };

    // Initial setup
    if (!dateInput.value) {
      dateInput.value = localIso(new Date());
    }
    dateInput.min = localIso(new Date());
    renderDates();
    show(1);
  })();
</script>

<style is:inline>
  :root {
    --navy: #0b2138;
    --blue: #2484bf;
    --gold: #f2bd3f;
    --ink: #172231;
    --muted: #6b7785;
    --line: #dce3e8;
    --bg: #f3f7f9;
  }

  .booking-dispatch-container {
    box-sizing: border-box;
    min-height: 100%;
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.4;
    padding-bottom: 30px;
  }

  .booking-dispatch-container * {
    box-sizing: border-box;
  }

  .booking-dispatch-container button,
  .booking-dispatch-container input,
  .booking-dispatch-container textarea {
    font: inherit;
  }

  .booking-dispatch-container .topbar {
    background: #fff;
    border-bottom: 1px solid #e5eaee;
  }

  .booking-dispatch-container .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(780px, calc(100% - 36px));
    min-height: 92px;
    margin: auto;
  }

  .booking-dispatch-container .brand img {
    width: 64px;
    height: 64px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 9px !important;
    object-fit: contain;
    background: #fff;
  }

  .booking-dispatch-container .brand strong,
  .booking-dispatch-container .brand span {
    display: block;
  }

  .booking-dispatch-container .brand strong {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
  }

  .booking-dispatch-container .brand span {
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .booking-dispatch-container .shell {
    width: min(780px, calc(100% - 36px));
    margin: 0 auto;
    padding: 24px 0 90px;
  }

  .booking-dispatch-container .progress {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0 0 27px;
    padding: 0;
    list-style: none;
  }

  .booking-dispatch-container .progress li {
    position: relative;
    color: #7c8792;
    text-align: center;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .booking-dispatch-container .progress li:not(:last-child):before {
    content: "";
    position: absolute;
    z-index: 0;
    top: 12px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: #dfe5e9;
  }

  .booking-dispatch-container .dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin: 0 auto 8px;
    border: 4px solid var(--bg);
    border-radius: 50% !important;
    background: #dfe5e9;
  }

  .booking-dispatch-container .progress .active {
    color: var(--blue);
  }

  .booking-dispatch-container .progress .active .dot {
    border: 2px solid var(--blue);
    background: #fff;
    box-shadow: 0 0 0 4px var(--bg);
  }

  .booking-dispatch-container .progress .complete .dot {
    background: var(--blue);
  }

  .booking-dispatch-container .progress .complete:not(:last-child):before {
    background: var(--blue);
  }

  .booking-dispatch-container form {
    min-height: 420px;
  }

  .booking-dispatch-container .step[hidden] {
    display: none;
  }

  .booking-dispatch-container .question {
