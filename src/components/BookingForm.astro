---
// BookingForm.astro - Clean Workiz Booking Flow with Stepper (No Subheadings, Clean High-End Typography)
---

<div class="w-full max-w-2xl mx-auto bg-white rounded-2xl border border-slate-300 shadow-[0_25px_60px_-10px_rgba(15,23,42,0.18)] font-sans text-left overflow-hidden transition-all">
  
  <!-- ==================== MODERN BREADCRUMB ARROW STEPPER ==================== -->
  <div class="bg-slate-900 text-white px-4 sm:px-8 pt-4.5 sm:pt-5 pb-4 border-b border-slate-800">
    
    <!-- Top Brand & Direct Phone -->
    <div class="flex items-center justify-between pb-3 mb-3.5 border-b border-white/10">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block ring-4 ring-emerald-400/20 animate-pulse"></span>
        <span class="text-xs font-black tracking-wider text-slate-200 uppercase">Armstrong Locksmith Inc</span>
      </div>
      <a 
        href="tel:6156258000" 
        class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-400/10 hover:bg-amber-400/20 border border-amber-400/30 rounded-full text-xs font-black text-amber-400 hover:text-amber-300 transition shadow-sm"
      >
        <span>📞</span>
        <span>(615) 625-8000</span>
      </a>
    </div>

    <!-- 3-Step Arrow Breadcrumb Flow -->
    <div class="flex items-center justify-between text-xs sm:text-sm font-sans pt-1">
      
      <!-- Step 1 -->
      <div id="step-flow-1" class="flex items-center gap-1.5 sm:gap-2 text-white transition-all">
        <span id="flow-badge-1" class="w-6 h-6 rounded-full bg-blue-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0">1</span>
        <span id="flow-label-1" class="font-extrabold tracking-tight text-slate-100 text-xs sm:text-sm">Service</span>
      </div>

      <!-- Arrow 1 -> 2 -->
      <div id="flow-arrow-1" class="text-slate-600 font-black text-sm sm:text-base px-1 transition-all">
        ➔
      </div>

      <!-- Step 2 -->
      <div id="step-flow-2" class="flex items-center gap-1.5 sm:gap-2 text-slate-400 transition-all">
        <span id="flow-badge-2" class="w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold text-xs flex items-center justify-center border border-slate-700 shrink-0">2</span>
        <span id="flow-label-2" class="font-medium tracking-tight text-slate-400 text-xs sm:text-sm">Schedule</span>
      </div>

      <!-- Arrow 2 -> 3 -->
      <div id="flow-arrow-2" class="text-slate-600 font-black text-sm sm:text-base px-1 transition-all">
        ➔
      </div>

      <!-- Step 3 -->
      <div id="step-flow-3" class="flex items-center gap-1.5 sm:gap-2 text-slate-400 transition-all">
        <span id="flow-badge-3" class="w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold text-xs flex items-center justify-center border border-slate-700 shrink-0">3</span>
        <span id="flow-label-3" class="font-medium tracking-tight text-slate-400 text-xs sm:text-sm">Confirm</span>
      </div>

    </div>

    <!-- High-End Dynamic Progress Track -->
    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mt-3.5">
      <div id="flow-progress" class="h-full bg-gradient-to-r from-blue-500 to-indigo-500 w-1/3 transition-all duration-300 rounded-full"></div>
    </div>

  </div>

  <!-- ==================== FORM BODY ==================== -->
  <form id="booking-form" class="p-6 sm:p-8 bg-white" novalidate>
    <!-- Hidden Form Fields & Honeypot -->
    <input type="hidden" id="field-service" name="service" value="Car key replacement" />
    <input type="hidden" id="field-location" name="location" value="Mobile Van Dispatched To My Location" />
    <input type="hidden" id="field-date" name="booking_date" value="Today" />
    <input type="hidden" id="field-time" name="booking_time" value="ASAP" />
    
    <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
      <label for="company_website">Company Website</label>
      <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" value="" />
    </div>

    <!-- ==================== STEP 1: CLEAN SERVICE LIST WITH UPFRONT VALUE ANCHORS ==================== -->
    <div id="step-1" class="step-pane space-y-2.5">
      <div class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Select a Service:</div>

      <!-- 1. Car key replacement -->
      <button 
        type="button" 
        class="service-item w-full py-3.5 px-4 sm:px-6 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl hover:border-blue-600 hover:border-b-blue-700 hover:bg-blue-50/50 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:shadow-[0_8px_18px_rgba(37,99,235,0.18)] hover:-translate-y-0.5 active:translate-y-0" 
        data-service="Car key replacement"
      >
        <span class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Car key replacement
        </span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">From $140</span>
          <span class="text-slate-400 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">›</span>
        </div>
      </button>

      <!-- 2. Residential lock and rekey -->
      <button 
        type="button" 
        class="service-item w-full py-3.5 px-4 sm:px-6 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl hover:border-blue-600 hover:border-b-blue-700 hover:bg-blue-50/50 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:shadow-[0_8px_18px_rgba(37,99,235,0.18)] hover:-translate-y-0.5 active:translate-y-0" 
        data-service="Residential lock and rekey"
      >
        <span class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Residential lock and rekey
        </span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">From $19/cyl</span>
          <span class="text-slate-400 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">›</span>
        </div>
      </button>

      <!-- 3. Commercial lock and rekey -->
      <button 
        type="button" 
        class="service-item w-full py-3.5 px-4 sm:px-6 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl hover:border-blue-600 hover:border-b-blue-700 hover:bg-blue-50/50 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:shadow-[0_8px_18px_rgba(37,99,235,0.18)] hover:-translate-y-0.5 active:translate-y-0" 
        data-service="Commercial lock and rekey"
      >
        <span class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Commercial lock and rekey
        </span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">B2B Upfront</span>
          <span class="text-slate-400 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">›</span>
        </div>
      </button>

      <!-- 4. Other locksmith services -->
      <button 
        type="button" 
        class="service-item w-full py-3.5 px-4 sm:px-6 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl hover:border-blue-600 hover:border-b-blue-700 hover:bg-blue-50/50 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:shadow-[0_8px_18px_rgba(37,99,235,0.18)] hover:-translate-y-0.5 active:translate-y-0" 
        data-service="Other locksmith services"
      >
        <span class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Other locksmith services
        </span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">Free Estimate</span>
          <span class="text-slate-400 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">›</span>
        </div>
      </button>

      <!-- 5. Emergency lockout -->
      <button 
        type="button" 
        class="service-item w-full py-3.5 px-4 sm:px-6 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl hover:border-blue-600 hover:border-b-blue-700 hover:bg-blue-50/50 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:shadow-[0_8px_18px_rgba(37,99,235,0.18)] hover:-translate-y-0.5 active:translate-y-0" 
        data-service="Emergency lockout"
      >
        <span class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Emergency lockout
        </span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">15–20m ETA</span>
          <span class="text-slate-400 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">›</span>
        </div>
      </button>

      <!-- 6. European cars -->
      <button 
        type="button" 
        class="service-item w-full py-3.5 px-4 sm:px-6 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl hover:border-blue-600 hover:border-b-blue-700 hover:bg-blue-50/50 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:shadow-[0_8px_18px_rgba(37,99,235,0.18)] hover:-translate-y-0.5 active:translate-y-0" 
        data-service="European cars"
      >
        <span class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          European cars (BMW, Benz, Audi)
        </span>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">Save vs Dealer</span>
          <span class="text-slate-400 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">›</span>
        </div>
      </button>
    </div>

    <!-- ==================== STEP 2: SCHEDULE (DATE & TIME) ==================== -->
    <div id="step-2" class="step-pane hidden space-y-5">
      
      <!-- Selected Service Bar -->
      <div class="flex items-center justify-between p-3.5 bg-slate-50 border border-slate-300 rounded-xl shadow-inner">
        <div class="text-xs">
          <span class="text-slate-500 font-medium">Service:</span>
          <strong id="wkz-selected-service" class="text-slate-900 ml-1 font-extrabold">Car key replacement</strong>
        </div>
        <button type="button" class="btn-back text-xs font-bold text-blue-600 hover:underline cursor-pointer">
          Change
        </button>
      </div>

      <!-- Service Location: Mobile Van vs Walk-In Storefront -->
      <div class="space-y-2">
        <label class="block text-xs font-extrabold text-slate-900">How would you like service?</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button 
            type="button" 
            id="loc-mobile"
            class="loc-chip p-3 bg-blue-50 border-[1.5px] border-blue-600 border-b-[3px] border-b-blue-700 text-blue-950 rounded-xl text-xs font-black text-left shadow-[0_4px_12px_rgba(37,99,235,0.22)] transition cursor-pointer flex items-center justify-between" 
            data-loc="Mobile Van Dispatched To My Location"
          >
            <div>
              <div class="font-black text-blue-950 flex items-center gap-1.5">
                <span>🚐</span>
                <span>Mobile Van Dispatch</span>
              </div>
              <div class="text-[11px] text-blue-700 font-medium mt-0.5">Technician drives to your location</div>
            </div>
            <span class="w-4 h-4 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            id="loc-store"
            class="loc-chip p-3 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 text-slate-800 rounded-xl text-xs font-bold text-left shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:border-blue-500 hover:border-b-blue-600 hover:-translate-y-0.5 transition cursor-pointer flex items-center justify-between" 
            data-loc="Walk-In Storefront (208 Thompson Ln)"
          >
            <div>
              <div class="font-bold text-slate-900 flex items-center gap-1.5">
                <span>🏪</span>
                <span>Walk-In Storefront</span>
              </div>
              <div class="text-[11px] text-slate-500 font-normal mt-0.5">208 Thompson Ln (Save trip fee)</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>
        </div>
      </div>

      <!-- Date Options -->
      <div class="space-y-2">
        <label class="block text-xs font-extrabold text-slate-900">When do you need us?</label>
        <div class="grid grid-cols-3 gap-2.5">
          <button 
            type="button" 
            class="date-chip p-3 bg-blue-50 border-[1.5px] border-blue-600 border-b-[3px] border-b-blue-700 text-blue-950 rounded-xl text-xs font-black text-center shadow-[0_4px_12px_rgba(37,99,235,0.22)] transition cursor-pointer" 
            data-date="Today"
          >
            Today
          </button>
          <button 
            type="button" 
            class="date-chip p-3 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 text-slate-800 rounded-xl text-xs font-bold text-center shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:border-blue-500 hover:border-b-blue-600 hover:-translate-y-0.5 transition cursor-pointer" 
            data-date="Tomorrow"
          >
            Tomorrow
          </button>
          <button 
            type="button" 
            class="date-chip p-3 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 text-slate-800 rounded-xl text-xs font-bold text-center shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:border-blue-500 hover:border-b-blue-600 hover:-translate-y-0.5 transition cursor-pointer" 
            data-date="Custom Date"
          >
            Custom Date
          </button>
        </div>
      </div>

      <!-- Time Window Options -->
      <div class="space-y-2">
        <label class="block text-xs font-extrabold text-slate-900">Select arrival window:</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          
          <button 
            type="button" 
            class="time-chip p-3.5 bg-blue-50 border-[1.5px] border-blue-600 border-b-[3px] border-b-blue-700 text-blue-950 rounded-xl text-xs font-black text-left shadow-[0_4px_12px_rgba(37,99,235,0.22)] transition cursor-pointer flex items-center justify-between" 
            data-time="ASAP Immediate Dispatch"
          >
            <div>
              <div class="font-black text-blue-950">⚡ ASAP Dispatch</div>
              <div class="text-[11px] text-blue-700 font-medium">Nearest mobile unit</div>
            </div>
            <span class="w-4 h-4 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 text-slate-800 rounded-xl text-xs font-bold text-left shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:border-blue-500 hover:border-b-blue-600 hover:-translate-y-0.5 transition cursor-pointer flex items-center justify-between" 
            data-time="Morning (8:00 AM – 12:00 PM)"
          >
            <div>
              <div class="font-bold text-slate-900">Morning Window</div>
              <div class="text-[11px] text-slate-500 font-normal">8:00 AM – 12:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 text-slate-800 rounded-xl text-xs font-bold text-left shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:border-blue-500 hover:border-b-blue-600 hover:-translate-y-0.5 transition cursor-pointer flex items-center justify-between" 
            data-time="Afternoon (12:00 PM – 4:00 PM)"
          >
            <div>
              <div class="font-bold text-slate-900">Afternoon Window</div>
              <div class="text-[11px] text-slate-500 font-normal">12:00 PM – 4:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 text-slate-800 rounded-xl text-xs font-bold text-left shadow-[0_4px_10px_rgba(15,23,42,0.08)] hover:border-blue-500 hover:border-b-blue-600 hover:-translate-y-0.5 transition cursor-pointer flex items-center justify-between" 
            data-time="Evening (4:00 PM – 8:00 PM)"
          >
            <div>
              <div class="font-bold text-slate-900">Evening Window</div>
              <div class="text-[11px] text-slate-500 font-normal">4:00 PM – 8:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
        <button type="button" class="btn-back px-4 py-2 text-xs font-bold text-slate-600 hover:text-slate-900 cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="button" 
          id="btn-to-3" 
          class="px-7 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white rounded-xl text-xs font-black uppercase tracking-wider border-b-[3px] border-b-blue-900 shadow-[0_6px_18px_rgba(37,99,235,0.35)] hover:-translate-y-0.5 active:translate-y-0 transition cursor-pointer"
        >
          Continue to Details &rarr;
        </button>
      </div>

    </div>

    <!-- ==================== STEP 3: BOOK (CONTACT & DETAILS) ==================== -->
    <div id="step-3" class="step-pane hidden space-y-4">
      
      <!-- Summary Line -->
      <div class="p-3 bg-slate-50 border border-slate-300 rounded-xl text-xs flex items-center justify-between shadow-inner">
        <div>
          <span class="text-slate-500 font-medium">Selected:</span>
          <strong id="wkz-summary" class="text-slate-900 ml-1 font-extrabold">Car key replacement &bull; Today (ASAP)</strong>
        </div>
        <button type="button" class="btn-back text-xs font-bold text-blue-600 hover:underline cursor-pointer">
          Edit
        </button>
      </div>

      <!-- Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="cust_name" class="block text-xs font-extrabold text-slate-900 mb-1">Full Name *</label>
          <input 
            type="text" 
            id="cust_name" 
            name="customer_name" 
            required 
            placeholder="John Smith" 
            class="w-full px-3.5 py-3 text-sm bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl focus:border-blue-600 focus:border-b-blue-700 focus:ring-4 focus:ring-blue-500/20 focus:outline-none shadow-[0_4px_12px_rgba(15,23,42,0.12)] focus:shadow-[0_8px_20px_rgba(37,99,235,0.20)] transition-all font-medium text-slate-950 placeholder:text-slate-400" 
          />
          <span id="err-name" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your name.</span>
        </div>

        <div>
          <label for="cust_phone" class="block text-xs font-extrabold text-slate-900 mb-1">Phone Number *</label>
          <input 
            type="tel" 
            id="cust_phone" 
            name="phone" 
            required 
            placeholder="(615) 000-0000" 
            class="w-full px-3.5 py-3 text-sm bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl focus:border-blue-600 focus:border-b-blue-700 focus:ring-4 focus:ring-blue-500/20 focus:outline-none shadow-[0_4px_12px_rgba(15,23,42,0.12)] focus:shadow-[0_8px_20px_rgba(37,99,235,0.20)] transition-all font-medium text-slate-950 placeholder:text-slate-400" 
          />
          <span id="err-phone" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your phone number.</span>
        </div>
      </div>

      <div>
        <label for="cust_address" class="block text-xs font-extrabold text-slate-900 mb-1">Service Address / Location</label>
        <input 
          type="text" 
          id="cust_address" 
          name="address" 
          placeholder="e.g. 123 Main St, Nashville, TN (or 'Storefront Walk-In')" 
          class="w-full px-3.5 py-3 text-sm bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl focus:border-blue-600 focus:border-b-blue-700 focus:ring-4 focus:ring-blue-500/20 focus:outline-none shadow-[0_4px_12px_rgba(15,23,42,0.12)] focus:shadow-[0_8px_20px_rgba(37,99,235,0.20)] transition-all font-medium text-slate-950 placeholder:text-slate-400" 
        />
      </div>

      <div>
        <label for="cust_notes" class="block text-xs font-extrabold text-slate-900 mb-1">Vehicle Year/Make/Model or Job Details (Optional)</label>
        <input 
          type="text" 
          id="cust_notes" 
          name="details" 
          placeholder="e.g. 2021 BMW X5 all keys lost, or 3 house locks" 
          class="w-full px-3.5 py-3 text-sm bg-white border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl focus:border-blue-600 focus:border-b-blue-700 focus:ring-4 focus:ring-blue-500/20 focus:outline-none shadow-[0_4px_12px_rgba(15,23,42,0.12)] focus:shadow-[0_8px_20px_rgba(37,99,235,0.20)] transition-all font-medium text-slate-950 placeholder:text-slate-400" 
        />
      </div>

      <div>
        <label for="cust_photo" class="block text-xs font-extrabold text-slate-900 mb-1 flex items-center justify-between">
          <span>Attach Photo of Key or Lock (Optional)</span>
          <span class="text-[10px] text-slate-500 font-normal">Helps ensure exact quote</span>
        </label>
        <input 
          type="file" 
          id="cust_photo" 
          name="photo" 
          accept="image/*" 
          class="w-full text-xs text-slate-600 file:mr-3 file:py-2 file:px-3.5 file:rounded-lg file:border-0 file:text-xs file:font-black file:bg-slate-100 file:text-slate-800 hover:file:bg-slate-200 border-[1.5px] border-slate-300 border-b-[3px] border-b-slate-400 rounded-xl p-1.5 cursor-pointer bg-white" 
        />
        <div id="photo-preview-name" class="hidden text-[11px] text-emerald-700 font-bold mt-1"></div>
      </div>

      <!-- Server Error Alert -->
      <div id="api-error" class="hidden p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl text-center font-bold">
        We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-black">615-625-8000</a>.
      </div>

      <!-- Submit Button -->
      <div class="pt-4 border-t border-slate-200 flex items-center justify-between gap-3">
        <button type="button" class="btn-back px-4 py-2 text-xs font-bold text-slate-600 hover:text-slate-900 cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="submit" 
          id="btn-submit" 
          class="px-8 py-3.5 bg-gold-metallic hover:brightness-105 text-[#07152b] rounded-xl text-xs font-black uppercase tracking-wider border-b-[3px] border-b-amber-600 shadow-md hover:-translate-y-0.5 active:translate-y-0 transition cursor-pointer disabled:opacity-50"
        >
          Confirm Booking &rarr;
        </button>
      </div>

    </div>

  </form>

  <!-- ==================== SUCCESS CONFIRMATION ==================== -->
  <div id="step-success" class="hidden p-8 sm:p-12 text-center space-y-3 bg-white">
    <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl font-bold mx-auto">
      ✓
    </div>
    <h2 class="text-base sm:text-lg font-bold text-slate-900">
      Thank you! Your request was sent to Armstrong Locksmith.
    </h2>
    <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
      Our dispatch team will review your appointment request and contact you shortly with confirmation.
    </p>
    <div class="pt-2">
      <a href="tel:6156258000" class="text-xs font-semibold text-blue-600 hover:underline">
        Need immediate dispatch? Call (615) 625-8000
      </a>
    </div>
  </div>

  <!-- Trust Footer -->
  <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200 text-center text-xs text-slate-500">
    Armstrong Locksmith Inc &bull; Verified Master Locksmith &bull; Bonded &amp; Insured &bull; <a href="tel:6156258000" class="font-bold text-amber-500 hover:text-amber-600 underline underline-offset-2">(615) 625-8000</a>
  </div>

</div>

<!-- Script -->
<script is:inline>
  (function () {
    const formStartedAt = Math.floor(Date.now() / 1000);
    let step = 1;

    const s1 = document.getElementById('step-1');
    const s2 = document.getElementById('step-2');
    const s3 = document.getElementById('step-3');
    const success = document.getElementById('step-success');
    const form = document.getElementById('booking-form');

    const flow1 = document.getElementById('step-flow-1');
    const flow2 = document.getElementById('step-flow-2');
    const flow3 = document.getElementById('step-flow-3');

    const flowBadge1 = document.getElementById('flow-badge-1');
    const flowBadge2 = document.getElementById('flow-badge-2');
    const flowBadge3 = document.getElementById('flow-badge-3');

    const flowLabel1 = document.getElementById('flow-label-1');
    const flowLabel2 = document.getElementById('flow-label-2');
    const flowLabel3 = document.getElementById('flow-label-3');

    const flowArrow1 = document.getElementById('flow-arrow-1');
    const flowArrow2 = document.getElementById('flow-arrow-2');
    const flowProgress = document.getElementById('flow-progress');

    const serviceInput = document.getElementById('field-service');
    const locationInput = document.getElementById('field-location');
    const dateInput = document.getElementById('field-date');
    const timeInput = document.getElementById('field-time');

    const selectedServiceTag = document.getElementById('wkz-selected-service');
    const summaryTag = document.getElementById('wkz-summary');

    const serviceItems = document.querySelectorAll('.service-item');
    const locChips = document.querySelectorAll('.loc-chip');
    const dateChips = document.querySelectorAll('.date-chip');
    const timeChips = document.querySelectorAll('.time-chip');

    const btnTo3 = document.getElementById('btn-to-3');
    const backBtns = document.querySelectorAll('.btn-back');
    const submitBtn = document.getElementById('btn-submit');
    const apiError = document.getElementById('api-error');

    const nameIn = document.getElementById('cust_name');
    const phoneIn = document.getElementById('cust_phone');
    const photoIn = document.getElementById('cust_photo');
    const photoPreviewName = document.getElementById('photo-preview-name');
    const errName = document.getElementById('err-name');
    const errPhone = document.getElementById('err-phone');
    const honeypot = document.getElementById('company_website');

    function updateStepper(n) {
      step = n;
      s1.classList.add('hidden');
      s2.classList.add('hidden');
      s3.classList.add('hidden');
      if (success) success.classList.add('hidden');

      if (n === 1) {
        s1.classList.remove('hidden');

        // Step 1: Active Blue
        if (flow1) flow1.className = "flex items-center gap-1.5 sm:gap-2 text-white transition-all";
        if (flowBadge1) { flowBadge1.className = "w-6 h-6 rounded-full bg-blue-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0"; flowBadge1.textContent = "1"; }
        if (flowLabel1) { flowLabel1.className = "font-extrabold tracking-tight text-slate-100 text-xs sm:text-sm"; }

        // Arrow 1 -> 2
        if (flowArrow1) flowArrow1.className = "text-slate-600 font-black text-sm sm:text-base px-1 transition-all";

        // Step 2: Upcoming Inactive
        if (flow2) flow2.className = "flex items-center gap-1.5 sm:gap-2 text-slate-400 transition-all";
        if (flowBadge2) { flowBadge2.className = "w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold text-xs flex items-center justify-center border border-slate-700 shrink-0"; flowBadge2.textContent = "2"; }
        if (flowLabel2) { flowLabel2.className = "font-medium tracking-tight text-slate-400 text-xs sm:text-sm"; }

        // Arrow 2 -> 3
        if (flowArrow2) flowArrow2.className = "text-slate-600 font-black text-sm sm:text-base px-1 transition-all";

        // Step 3: Upcoming Inactive
        if (flow3) flow3.className = "flex items-center gap-1.5 sm:gap-2 text-slate-400 transition-all";
        if (flowBadge3) { flowBadge3.className = "w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold text-xs flex items-center justify-center border border-slate-700 shrink-0"; flowBadge3.textContent = "3"; }
        if (flowLabel3) { flowLabel3.className = "font-medium tracking-tight text-slate-400 text-xs sm:text-sm"; }

        if (flowProgress) { flowProgress.style.width = "33%"; }

      } else if (n === 2) {
        s2.classList.remove('hidden');

        // Step 1: Done (Emerald)
        if (flow1) flow1.className = "flex items-center gap-1.5 sm:gap-2 text-emerald-300 transition-all";
        if (flowBadge1) { flowBadge1.className = "w-6 h-6 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0"; flowBadge1.textContent = "✓"; }
        if (flowLabel1) { flowLabel1.className = "font-bold tracking-tight text-emerald-300 text-xs sm:text-sm"; }

        // Arrow 1 -> 2 (Highlighted)
        if (flowArrow1) flowArrow1.className = "text-emerald-400 font-black text-sm sm:text-base px-1 transition-all";

        // Step 2: Active Blue
        if (flow2) flow2.className = "flex items-center gap-1.5 sm:gap-2 text-white transition-all";
        if (flowBadge2) { flowBadge2.className = "w-6 h-6 rounded-full bg-blue-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0"; flowBadge2.textContent = "2"; }
        if (flowLabel2) { flowLabel2.className = "font-extrabold tracking-tight text-slate-100 text-xs sm:text-sm"; }

        // Arrow 2 -> 3
        if (flowArrow2) flowArrow2.className = "text-slate-600 font-black text-sm sm:text-base px-1 transition-all";

        // Step 3: Upcoming Inactive
        if (flow3) flow3.className = "flex items-center gap-1.5 sm:gap-2 text-slate-400 transition-all";
        if (flowBadge3) { flowBadge3.className = "w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold text-xs flex items-center justify-center border border-slate-700 shrink-0"; flowBadge3.textContent = "3"; }
        if (flowLabel3) { flowLabel3.className = "font-medium tracking-tight text-slate-400 text-xs sm:text-sm"; }

        if (flowProgress) { flowProgress.style.width = "66%"; }
        if (selectedServiceTag) selectedServiceTag.textContent = serviceInput.value;

      } else if (n === 3) {
        s3.classList.remove('hidden');

        // Step 1: Done (Emerald)
        if (flow1) flow1.className = "flex items-center gap-1.5 sm:gap-2 text-emerald-300 transition-all";
        if (flowBadge1) { flowBadge1.className = "w-6 h-6 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0"; flowBadge1.textContent = "✓"; }
        if (flowLabel1) { flowLabel1.className = "font-bold tracking-tight text-emerald-300 text-xs sm:text-sm"; }

        // Arrow 1 -> 2 (Highlighted)
        if (flowArrow1) flowArrow1.className = "text-emerald-400 font-black text-sm sm:text-base px-1 transition-all";

        // Step 2: Done (Emerald)
        if (flow2) flow2.className = "flex items-center gap-1.5 sm:gap-2 text-emerald-300 transition-all";
        if (flowBadge2) { flowBadge2.className = "w-6 h-6 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0"; flowBadge2.textContent = "✓"; }
        if (flowLabel2) { flowLabel2.className = "font-bold tracking-tight text-emerald-300 text-xs sm:text-sm"; }

        // Arrow 2 -> 3 (Highlighted)
        if (flowArrow2) flowArrow2.className = "text-emerald-400 font-black text-sm sm:text-base px-1 transition-all";

        // Step 3: Active Blue
        if (flow3) flow3.className = "flex items-center gap-1.5 sm:gap-2 text-white transition-all";
        if (flowBadge3) { flowBadge3.className = "w-6 h-6 rounded-full bg-blue-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0"; flowBadge3.textContent = "3"; }
        if (flowLabel3) { flowLabel3.className = "font-extrabold tracking-tight text-slate-100 text-xs sm:text-sm"; }

        if (flowProgress) { flowProgress.style.width = "100%"; }
        const locLabel = locationInput && locationInput.value.includes('Walk-In') ? 'Storefront' : 'Mobile Van';
        if (summaryTag) summaryTag.textContent = `${serviceInput.value} • ${locLabel} • ${dateInput.value} (${timeInput.value})`;

      } else if (n === 4) {
        form.classList.add('hidden');
        if (success) success.classList.remove('hidden');

        [flow1, flow2, flow3].forEach(f => {
          if (f) f.className = "flex items-center gap-1.5 sm:gap-2 text-emerald-300 transition-all";
        });
        [flowBadge1, flowBadge2, flowBadge3].forEach(b => {
          if (b) {
            b.className = "w-6 h-6 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm shrink-0";
            b.textContent = "✓";
          }
        });
        [flowLabel1, flowLabel2, flowLabel3].forEach(l => {
          if (l) l.className = "font-bold tracking-tight text-emerald-300 text-xs sm:text-sm";
        });
        if (flowArrow1) flowArrow1.className = "text-emerald-400 font-black text-sm sm:text-base px-1 transition-all";
        if (flowArrow2) flowArrow2.className = "text-emerald-400 font-black text-sm sm:text-base px-1 transition-all";
        if (flowProgress) flowProgress.style.width = "100%";
      }

      window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    // Step 1 Click -> Advances directly to Step 2
    serviceItems.forEach(item => {
      item.addEventListener('click', function () {
        const val = this.getAttribute('data-service');
        if (serviceInput) serviceInput.value = val;
        updateStepper(2);
      });
    });

    // Step 2 Location (Mobile Van vs Walk-In Shop)
    locChips.forEach(chip => {
      chip.addEventListener('click', function () {
        locChips.forEach(c => {
          c.classList.remove('border-blue-600', 'border-b-blue-700', 'bg-blue-50', 'text-blue-950', 'font-black', 'shadow-[0_4px_12px_rgba(37,99,235,0.22)]');
          c.classList.add('border-slate-300', 'border-b-slate-400', 'bg-white', 'text-slate-800', 'font-bold', 'shadow-[0_4px_10px_rgba(15,23,42,0.08)]');
          const check = c.querySelector('span:last-child');
          if (check) {
            check.classList.remove('bg-blue-600', 'text-white');
            check.classList.add('border', 'border-slate-300', 'text-transparent');
          }
        });
        this.classList.remove('border-slate-300', 'border-b-slate-400', 'bg-white', 'text-slate-800', 'font-bold', 'shadow-[0_4px_10px_rgba(15,23,42,0.08)]');
        this.classList.add('border-blue-600', 'border-b-blue-700', 'bg-blue-50', 'text-blue-950', 'font-black', 'shadow-[0_4px_12px_rgba(37,99,235,0.22)]');
        const check = this.querySelector('span:last-child');
        if (check) {
          check.classList.remove('border', 'border-slate-300', 'text-transparent');
          check.classList.add('bg-blue-600', 'text-white');
        }
        const val = this.getAttribute('data-loc');
        if (locationInput) locationInput.value = val;

        const addrInput = document.getElementById('cust_address');
        if (addrInput) {
          if (val.includes('Walk-In')) {
            addrInput.value = '208 Thompson Ln, Nashville, TN 37211 (Storefront Shop)';
          } else if (addrInput.value.includes('208 Thompson Ln')) {
            addrInput.value = '';
          }
        }
      });
    });

    // Step 3 Photo Attachment Preview
    if (photoIn && photoPreviewName) {
      photoIn.addEventListener('change', function () {
        if (this.files && this.files[0]) {
          photoPreviewName.textContent = `✓ Selected: ${this.files[0].name}`;
          photoPreviewName.classList.remove('hidden');
        } else {
          photoPreviewName.classList.add('hidden');
        }
      });
    }

    // Step 2 Date
    dateChips.forEach(chip => {
      chip.addEventListener('click', function () {
        dateChips.forEach(c => {
          c.classList.remove('border-blue-600', 'border-b-blue-700', 'bg-blue-50', 'text-blue-950', 'font-black', 'shadow-[0_4px_12px_rgba(37,99,235,0.22)]');
          c.classList.add('border-slate-300', 'border-b-slate-400', 'bg-white', 'text-slate-800', 'font-bold', 'shadow-[0_4px_10px_rgba(15,23,42,0.08)]');
        });
        this.classList.remove('border-slate-300', 'border-b-slate-400', 'bg-white', 'text-slate-800', 'font-bold', 'shadow-[0_4px_10px_rgba(15,23,42,0.08)]');
        this.classList.add('border-blue-600', 'border-b-blue-700', 'bg-blue-50', 'text-blue-950', 'font-black', 'shadow-[0_4px_12px_rgba(37,99,235,0.22)]');
        if (dateInput) dateInput.value = this.getAttribute('data-date');
      });
    });

    // Step 2 Time
    timeChips.forEach(chip => {
      chip.addEventListener('click', function () {
        timeChips.forEach(c => {
          c.classList.remove('border-blue-600', 'border-b-blue-700', 'bg-blue-50', 'text-blue-950', 'font-black', 'shadow-[0_4px_12px_rgba(37,99,235,0.22)]');
          c.classList.add('border-slate-300', 'border-b-slate-400', 'bg-white', 'text-slate-800', 'font-bold', 'shadow-[0_4px_10px_rgba(15,23,42,0.08)]');
          const check = c.querySelector('span:last-child');
          if (check) {
            check.classList.remove('bg-blue-600', 'text-white');
            check.classList.add('border', 'border-slate-300', 'text-transparent');
          }
        });
        this.classList.remove('border-slate-300', 'border-b-slate-400', 'bg-white', 'text-slate-800', 'font-bold', 'shadow-[0_4px_10px_rgba(15,23,42,0.08)]');
        this.classList.add('border-blue-600', 'border-b-blue-700', 'bg-blue-50', 'text-blue-950', 'font-black', 'shadow-[0_4px_12px_rgba(37,99,235,0.22)]');
        const check = this.querySelector('span:last-child');
        if (check) {
          check.classList.remove('border', 'border-slate-300', 'text-transparent');
          check.classList.add('bg-blue-600', 'text-white');
        }
        if (timeInput) timeInput.value = this.getAttribute('data-time');
      });
    });

    if (btnTo3) btnTo3.addEventListener('click', () => updateStepper(3));
    backBtns.forEach(b => b.addEventListener('click', () => {
      if (step > 1) updateStepper(step - 1);
    }));

    if (nameIn && errName) {
      nameIn.addEventListener('input', () => {
        errName.classList.add('hidden');
        nameIn.classList.remove('border-red-500');
      });
    }
    if (phoneIn && errPhone) {
      phoneIn.addEventListener('input', () => {
        errPhone.classList.add('hidden');
        phoneIn.classList.remove('border-red-500');
      });
    }

    // Submit
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (submitBtn?.disabled) return;
        if (apiError) apiError.classList.add('hidden');

        let hasError = false;
        const name = nameIn ? nameIn.value.trim() : '';
        const phone = phoneIn ? phoneIn.value.trim() : '';
        const bot = honeypot ? honeypot.value.trim() : '';

        if (!name) {
          if (errName) errName.classList.remove('hidden');
          if (nameIn) nameIn.classList.add('border-red-500');
          hasError = true;
        }
        if (!phone || phone.length < 7) {
          if (errPhone) errPhone.classList.remove('hidden');
          if (phoneIn) phoneIn.classList.add('border-red-500');
          hasError = true;
        }

        if (hasError) return;
        if (bot !== '') {
          updateStepper(4);
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = '⚡ Sending Request...';
        }

        const s = serviceInput ? serviceInput.value : 'Locksmith';
        const loc = locationInput ? locationInput.value : 'Mobile Van Dispatched';
        const d = dateInput ? dateInput.value : 'Today';
        const t = timeInput ? timeInput.value : 'ASAP';
        const addr = document.getElementById('cust_address')?.value || '';
        const notes = document.getElementById('cust_notes')?.value || '';
        const photoFile = photoIn?.files?.[0]?.name ? `Attached Photo: ${photoIn.files[0].name}` : '';

        const fullService = `${s} [${loc} • ${d} • ${t}]`;
        const detailsStr = [addr ? `Location: ${addr}` : '', notes ? `Details: ${notes}` : '', photoFile].filter(Boolean).join(' | ');

        const safeFormStartedAt = Math.min(formStartedAt, Math.floor(Date.now() / 1000) - 8);

        const payload = {
          customer_name: name,
          phone: phone,
          service: fullService,
          service_type: fullService,
          vehicle: detailsStr || 'Website Booking',
          form_started_at: safeFormStartedAt,
          company_website: ''
        };

        // Save the actual photo privately in Dispatch before the existing lead notification.
        // The contact proxy uses the same phone/service, so its follow-up is deduplicated.
        const selectedPhoto = photoIn?.files?.[0];
        if (selectedPhoto) {
          try {
            if (selectedPhoto.size > 5 * 1024 * 1024) {
              throw new Error('Choose a photo smaller than 5 MB.');
            }
            const upload = new FormData();
            Object.entries(payload).forEach(([key, value]) => upload.append(key, String(value)));
            upload.append('photo', selectedPhoto);
            const result = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: upload
            });
            const saved = await result.json();
            if (!result.ok || saved.photo_received !== true) {
              throw new Error(saved.errors?.photo?.[0] || 'Your photo could not be saved. Please use a JPG, PNG or WebP photo under 5 MB and try again.');
            }
          } catch (error) {
            if (apiError) {
              apiError.textContent = error instanceof Error ? error.message : 'Photo upload failed. Please try again.';
              apiError.classList.remove('hidden');
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Confirm Booking →';
            }
            return;
          }
        }

        // Preserve the existing email/SMS notification and text-only booking flow.
        const emailPromise = fetch('/api/contact.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name,
            phone: phone,
            service: fullService,
            details: detailsStr || 'Website Booking',
            notes: `Online Booking Request [${loc}]`,
            company_website: ''
          })
        }).catch(err => {
          console.warn('Email booking notification notice:', err);
          return { ok: false, status: 0 };
        });

        try {
          const emailResult = await emailPromise;

          if (emailResult.ok) {
            updateStepper(4);
          } else {
            // Both failed (network offline / server issue)
            if (apiError) apiError.classList.remove('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Confirm Booking →';
            }
          }
        } catch (err) {
          console.error('Booking submission error:', err);
          if (apiError) apiError.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Confirm Booking →';
          }
        }
      });
    }
  })();
</script>



