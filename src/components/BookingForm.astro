---
// BookingForm.astro - Official Armstrong Dispatch Platform Iframe Embed
---

<div class="armstrong-booking-wrapper w-full max-w-4xl mx-auto bg-white border-2 border-slate-300 shadow-2xl overflow-hidden font-sans text-left">
  
  <!-- Luxury Showroom Brand Header -->
  <div class="bg-showroom text-white px-6 sm:px-10 py-7 border-b-2 border-amber-500 flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative">
    <div>
      <div class="flex items-center gap-2 text-[10px] font-black tracking-widest text-amber-400 uppercase mb-1">
        <span class="w-2.5 h-2.5 bg-emerald-400 inline-block animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
        <span>ARMSTRONG AI DISPATCH ENGINE</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black font-heading tracking-tight uppercase text-white">
        Schedule Service &amp; <span class="text-gold-gradient">Dispatch</span>
      </h1>
      <p class="text-slate-300 text-xs sm:text-sm mt-1 max-w-lg font-normal">
        Select your vehicle or property service below. Our master technicians will confirm availability and arrive fully equipped.
      </p>
    </div>

    <!-- Quick Emergency Call Pill -->
    <div class="flex flex-col sm:items-end gap-1 shrink-0">
      <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Need Immediate Roadside Help?</span>
      <a 
        href="tel:6156258000" 
        class="px-5 py-2.5 bg-gold-metallic text-slate-950 font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg transition active:scale-95 cursor-pointer"
        aria-label="Call Armstrong Locksmith at (615) 625-8000"
      >
        <svg class="w-4 h-4 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
        <span>Call (615) 625-8000</span>
      </a>
    </div>
  </div>

  <!-- Trust Highlights Strip -->
  <div class="bg-[#0b1b36] border-b border-slate-800 px-6 py-2.5 flex flex-wrap items-center justify-between text-[11px] text-slate-300 gap-2">
    <div class="flex items-center gap-1.5 text-amber-400 font-bold">
      <span>🛡️</span>
      <span class="text-slate-200">TN Locksmith License #406</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span>⭐</span>
      <span class="text-slate-200">4.9 Star Rating (750+ Reviews)</span>
    </div>
    <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
      <span>🏪</span>
      <span class="text-slate-200">Storefront: 208 Thompson Ln</span>
    </div>
  </div>

  <!-- Embedded Dispatch App Container -->
  <div class="armstrong-booking w-full bg-white relative">
    <iframe
      id="armstrong-booking-frame"
      src="https://booking.armstronglocksmithinc.com/embed/booking"
      title="Schedule Armstrong Locksmith Service"
      loading="eager"
      scrolling="no"
      allow="geolocation"
      style="width:100%; min-height:760px; border:0; display:block; background:#ffffff;"
    ></iframe>
  </div>

  <!-- Bottom Guarantee Strip -->
  <div class="bg-slate-50 border-t border-slate-200 px-6 py-3 flex flex-wrap items-center justify-between text-xs text-slate-600 gap-2">
    <span class="font-medium">🔒 Encrypted Dispatch Request &bull; No upfront charges until service is confirmed.</span>
    <a href="/locksmith-pricing-nashville/" class="font-bold text-[#0f274a] hover:text-amber-600 hover:underline transition">
      View Pricing Guide &rarr;
    </a>
  </div>

</div>

<script is:inline>
  (function () {
    const frame = document.getElementById('armstrong-booking-frame');

    window.addEventListener('message', function (event) {
      if (
        event.origin !== 'https://booking.armstronglocksmithinc.com' ||
        event.source !== frame?.contentWindow ||
        event.data?.type !== 'armstrong-booking-height'
      ) {
        return;
      }

      const height = Number(event.data.height);

      if (Number.isFinite(height) && height > 0 && frame) {
        frame.style.height = Math.max(760, height) + 'px';
      }
    });
  })();
</script>
