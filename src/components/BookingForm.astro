---
// BookingForm.astro - Identical Workiz-Style Pure Minimalist Booking Flow
---

<div class="w-full max-w-lg mx-auto bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden font-sans text-left">
  
  <!-- Header -->
  <div class="px-6 pt-6 pb-4 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h1 class="text-base font-bold text-slate-900">Armstrong Locksmith</h1>
      <p id="step-caption" class="text-xs text-slate-500 mt-0.5">Step 1 of 3: Choose a service</p>
    </div>
    <a href="tel:6156258000" class="text-xs font-semibold text-slate-600 hover:text-slate-900 transition">
      (615) 625-8000
    </a>
  </div>

  <!-- Progress Bar -->
  <div class="w-full bg-slate-100 h-1">
    <div id="step-bar" class="bg-blue-600 h-1 w-1/3 transition-all duration-300"></div>
  </div>

  <!-- Form -->
  <form id="booking-form" class="p-6" novalidate>
    <!-- Hidden fields & honeypot -->
    <input type="hidden" id="field-service" name="service" value="Car Key Replacement" />
    <input type="hidden" id="field-date" name="booking_date" value="Today" />
    <input type="hidden" id="field-time" name="booking_time" value="ASAP" />
    
    <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
      <label for="company_website">Company Website</label>
      <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" value="" />
    </div>

    <!-- ==================== STEP 1: SERVICE LIST ==================== -->
    <div id="step-1" class="step-pane space-y-2">
      <div class="text-xs font-medium text-slate-500 mb-3">Select a service to get started:</div>

      <button type="button" class="service-item w-full p-3.5 border border-slate-200 rounded-md hover:border-blue-500 hover:bg-blue-50/20 flex items-center justify-between transition cursor-pointer text-left" data-service="Car Key Replacement">
        <div class="flex items-center gap-3">
          <span class="text-lg">🔑</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">Car Key Replacement</div>
            <div class="text-xs text-slate-500">Key cutting, fob replacement &amp; smart keys</div>
          </div>
        </div>
        <span class="text-slate-400 text-sm font-bold">›</span>
      </button>

      <button type="button" class="service-item w-full p-3.5 border border-slate-200 rounded-md hover:border-blue-500 hover:bg-blue-50/20 flex items-center justify-between transition cursor-pointer text-left" data-service="European Car Key Specialist">
        <div class="flex items-center gap-3">
          <span class="text-lg">🏎️</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">European Key Specialist</div>
            <div class="text-xs text-slate-500">BMW, Mercedes, Audi, Land Rover &amp; Porsche</div>
          </div>
        </div>
        <span class="text-slate-400 text-sm font-bold">›</span>
      </button>

      <button type="button" class="service-item w-full p-3.5 border border-slate-200 rounded-md hover:border-red-500 hover:bg-red-50/20 flex items-center justify-between transition cursor-pointer text-left" data-service="Emergency Lockout">
        <div class="flex items-center gap-3">
          <span class="text-lg">🚨</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">Emergency Lockout</div>
            <div class="text-xs text-slate-500">Locked keys in car, house, or business</div>
          </div>
        </div>
        <span class="text-slate-400 text-sm font-bold">›</span>
      </button>

      <button type="button" class="service-item w-full p-3.5 border border-slate-200 rounded-md hover:border-blue-500 hover:bg-blue-50/20 flex items-center justify-between transition cursor-pointer text-left" data-service="Residential House Rekey & Deadbolts">
        <div class="flex items-center gap-3">
          <span class="text-lg">🏡</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">Residential Rekey &amp; Locks</div>
            <div class="text-xs text-slate-500">Change locks, deadbolts &amp; smart keypads</div>
          </div>
        </div>
        <span class="text-slate-400 text-sm font-bold">›</span>
      </button>

      <button type="button" class="service-item w-full p-3.5 border border-slate-200 rounded-md hover:border-blue-500 hover:bg-blue-50/20 flex items-center justify-between transition cursor-pointer text-left" data-service="Commercial Storefront & Door Hardware">
        <div class="flex items-center gap-3">
          <span class="text-lg">🏢</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">Commercial &amp; Business Locks</div>
            <div class="text-xs text-slate-500">Storefront locks, panic exit bars &amp; master keys</div>
          </div>
        </div>
        <span class="text-slate-400 text-sm font-bold">›</span>
      </button>

      <button type="button" class="service-item w-full p-3.5 border border-slate-200 rounded-md hover:border-blue-500 hover:bg-blue-50/20 flex items-center justify-between transition cursor-pointer text-left" data-service="Other Locksmith Service">
        <div class="flex items-center gap-3">
          <span class="text-lg">🛠️</span>
          <div>
            <div class="text-sm font-semibold text-slate-900">Other Locksmith Service</div>
            <div class="text-xs text-slate-500">Key extraction, mailbox, safe opening</div>
          </div>
        </div>
        <span class="text-slate-400 text-sm font-bold">›</span>
      </button>
    </div>

    <!-- ==================== STEP 2: DATE & TIME ==================== -->
    <div id="step-2" class="step-pane hidden space-y-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-600">When do you need us?</span>
        <button type="button" class="btn-back text-xs text-blue-600 hover:underline cursor-pointer">Change service</button>
      </div>

      <!-- Date Pills -->
      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-slate-600">Select Day</label>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" class="date-chip p-2.5 border-2 border-blue-600 bg-blue-50 text-blue-900 rounded text-xs font-semibold text-center transition cursor-pointer" data-date="Today">
            Today
          </button>
          <button type="button" class="date-chip p-2.5 border border-slate-200 bg-white text-slate-700 rounded text-xs font-medium text-center hover:bg-slate-50 transition cursor-pointer" data-date="Tomorrow">
            Tomorrow
          </button>
          <button type="button" class="date-chip p-2.5 border border-slate-200 bg-white text-slate-700 rounded text-xs font-medium text-center hover:bg-slate-50 transition cursor-pointer" data-date="Later this week">
            Custom Date
          </button>
        </div>
      </div>

      <!-- Time Pills -->
      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-slate-600">Select Time Window</label>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" class="time-chip p-2.5 border-2 border-blue-600 bg-blue-50 text-blue-900 rounded text-xs font-semibold text-left transition cursor-pointer" data-time="ASAP Immediate Dispatch">
            ⚡ ASAP Dispatch
          </button>
          <button type="button" class="time-chip p-2.5 border border-slate-200 bg-white text-slate-700 rounded text-xs font-medium text-left hover:bg-slate-50 transition cursor-pointer" data-time="Morning (8 AM – 12 PM)">
            Morning (8 AM – 12 PM)
          </button>
          <button type="button" class="time-chip p-2.5 border border-slate-200 bg-white text-slate-700 rounded text-xs font-medium text-left hover:bg-slate-50 transition cursor-pointer" data-time="Afternoon (12 PM – 4 PM)">
            Afternoon (12 PM – 4 PM)
          </button>
          <button type="button" class="time-chip p-2.5 border border-slate-200 bg-white text-slate-700 rounded text-xs font-medium text-left hover:bg-slate-50 transition cursor-pointer" data-time="Evening (4 PM – 8 PM)">
            Evening (4 PM – 8 PM)
          </button>
        </div>
      </div>

      <!-- Button -->
      <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
        <button type="button" class="btn-back text-xs text-slate-500 hover:text-slate-900 cursor-pointer">
          &larr; Back
        </button>
        <button type="button" id="btn-to-3" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-semibold shadow-sm transition cursor-pointer">
          Continue &rarr;
        </button>
      </div>
    </div>

    <!-- ==================== STEP 3: CONTACT INFO ==================== -->
    <div id="step-3" class="step-pane hidden space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-600">Your details</span>
        <button type="button" class="btn-back text-xs text-blue-600 hover:underline cursor-pointer">Change time</button>
      </div>

      <div>
        <label for="cust_name" class="block text-xs font-medium text-slate-700 mb-1">Full Name *</label>
        <input type="text" id="cust_name" name="customer_name" required placeholder="John Smith" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-blue-500 focus:outline-none" />
        <span id="err-name" class="hidden text-[11px] text-red-600 mt-1 block">Please enter your name.</span>
      </div>

      <div>
        <label for="cust_phone" class="block text-xs font-medium text-slate-700 mb-1">Phone Number *</label>
        <input type="tel" id="cust_phone" name="phone" required placeholder="(615) 000-0000" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-blue-500 focus:outline-none" />
        <span id="err-phone" class="hidden text-[11px] text-red-600 mt-1 block">Please enter your phone number.</span>
      </div>

      <div>
        <label for="cust_address" class="block text-xs font-medium text-slate-700 mb-1">Service Address / City</label>
        <input type="text" id="cust_address" name="address" placeholder="123 Main St, Nashville" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-blue-500 focus:outline-none" />
      </div>

      <div>
        <label for="cust_notes" class="block text-xs font-medium text-slate-700 mb-1">Vehicle Make/Model or Lock Details (Optional)</label>
        <input type="text" id="cust_notes" name="details" placeholder="e.g. 2021 BMW X5, locked out, or 3 locks" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-blue-500 focus:outline-none" />
      </div>

      <div id="api-error" class="hidden p-2.5 bg-red-50 border border-red-200 text-red-700 text-xs rounded text-center font-medium">
        We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-bold">615-625-8000</a>.
      </div>

      <!-- Submit -->
      <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
        <button type="button" class="btn-back text-xs text-slate-500 hover:text-slate-900 cursor-pointer">
          &larr; Back
        </button>
        <button type="submit" id="btn-submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-semibold shadow-sm transition cursor-pointer disabled:opacity-50">
          Book Appointment
        </button>
      </div>
    </div>

  </form>

  <!-- ==================== SUCCESS ==================== -->
  <div id="step-success" class="hidden p-8 text-center space-y-3">
    <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl font-bold mx-auto">
      ✓
    </div>
    <h2 class="text-base font-bold text-slate-900">
      Thank you! Your request was sent to Armstrong Locksmith.
    </h2>
    <p class="text-xs text-slate-500 max-w-sm mx-auto">
      Our dispatch team will review your details and call or text you shortly to confirm your appointment.
    </p>
    <div class="pt-2">
      <a href="tel:6156258000" class="text-xs font-semibold text-blue-600 hover:underline">
        Need immediate help? Call (615) 625-8000
      </a>
    </div>
  </div>

</div>

<!-- Script -->
<script is:inline>
  (function () {
    const formStartedAt = Math.floor(Date.now() / 1000);
    let step = 1;

    const s1 = document.getElementById('step-1');
    const s2 = document.getElementById('step-2');
    const s3 = document.getElementById('step-3');
    const success = document.getElementById('step-success');
    const form = document.getElementById('booking-form');

    const caption = document.getElementById('step-caption');
    const bar = document.getElementById('step-bar');

    const serviceInput = document.getElementById('field-service');
    const dateInput = document.getElementById('field-date');
    const timeInput = document.getElementById('field-time');

    const serviceItems = document.querySelectorAll('.service-item');
    const dateChips = document.querySelectorAll('.date-chip');
    const timeChips = document.querySelectorAll('.time-chip');

    const btnTo3 = document.getElementById('btn-to-3');
    const backBtns = document.querySelectorAll('.btn-back');
    const submitBtn = document.getElementById('btn-submit');
    const apiError = document.getElementById('api-error');

    const nameIn = document.getElementById('cust_name');
    const phoneIn = document.getElementById('cust_phone');
    const errName = document.getElementById('err-name');
    const errPhone = document.getElementById('err-phone');
    const honeypot = document.getElementById('company_website');

    function goTo(n) {
      step = n;
      s1.classList.add('hidden');
      s2.classList.add('hidden');
      s3.classList.add('hidden');
      if (success) success.classList.add('hidden');

      if (n === 1) {
        s1.classList.remove('hidden');
        if (caption) caption.textContent = "Step 1 of 3: Choose a service";
        if (bar) bar.style.width = "33%";
      } else if (n === 2) {
        s2.classList.remove('hidden');
        if (caption) caption.textContent = `Step 2 of 3: ${serviceInput.value}`;
        if (bar) bar.style.width = "66%";
      } else if (n === 3) {
        s3.classList.remove('hidden');
        if (caption) caption.textContent = "Step 3 of 3: Your information";
        if (bar) bar.style.width = "100%";
      } else if (n === 4) {
        form.classList.add('hidden');
        if (success) success.classList.remove('hidden');
        if (caption) caption.textContent = "Appointment requested";
        if (bar) bar.style.width = "100%";
      }
    }

    // Step 1 Click
    serviceItems.forEach(item => {
      item.addEventListener('click', function () {
        const val = this.getAttribute('data-service');
        if (serviceInput) serviceInput.value = val;
        goTo(2);
      });
    });

    // Step 2 Date
    dateChips.forEach(chip => {
      chip.addEventListener('click', function () {
        dateChips.forEach(c => {
          c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-semibold');
          c.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700');
        });
        this.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700');
        this.classList.add('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-semibold');
        if (dateInput) dateInput.value = this.getAttribute('data-date');
      });
    });

    // Step 2 Time
    timeChips.forEach(chip => {
      chip.addEventListener('click', function () {
        timeChips.forEach(c => {
          c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-semibold');
          c.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700');
        });
        this.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700');
        this.classList.add('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-semibold');
        if (timeInput) timeInput.value = this.getAttribute('data-time');
      });
    });

    if (btnTo3) btnTo3.addEventListener('click', () => goTo(3));
    backBtns.forEach(b => b.addEventListener('click', () => {
      if (step > 1) goTo(step - 1);
    }));

    if (nameIn && errName) {
      nameIn.addEventListener('input', () => {
        errName.classList.add('hidden');
        nameIn.classList.remove('border-red-500');
      });
    }
    if (phoneIn && errPhone) {
      phoneIn.addEventListener('input', () => {
        errPhone.classList.add('hidden');
        phoneIn.classList.remove('border-red-500');
      });
    }

    // Submit
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (apiError) apiError.classList.add('hidden');

        let hasError = false;
        const name = nameIn ? nameIn.value.trim() : '';
        const phone = phoneIn ? phoneIn.value.trim() : '';
        const bot = honeypot ? honeypot.value.trim() : '';

        if (!name) {
          if (errName) errName.classList.remove('hidden');
          if (nameIn) nameIn.classList.add('border-red-500');
          hasError = true;
        }
        if (!phone || phone.length < 7) {
          if (errPhone) errPhone.classList.remove('hidden');
          if (phoneIn) phoneIn.classList.add('border-red-500');
          hasError = true;
        }

        if (hasError) return;
        if (bot !== '') {
          goTo(4);
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';
        }

        const s = serviceInput ? serviceInput.value : 'Locksmith';
        const d = dateInput ? dateInput.value : 'Today';
        const t = timeInput ? timeInput.value : 'ASAP';
        const addr = document.getElementById('cust_address')?.value || '';
        const notes = document.getElementById('cust_notes')?.value || '';

        const fullService = `${s} [${d} - ${t}]`;
        const detailsStr = [addr ? `Address: ${addr}` : '', notes ? `Notes: ${notes}` : ''].filter(Boolean).join(' | ');

        const payload = {
          customer_name: name,
          phone: phone,
          service: fullService,
          service_type: s,
          vehicle: detailsStr || 'Website Booking',
          form_started_at: formStartedAt,
          company_website: ''
        };

        try {
          const res = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            goTo(4);
          } else {
            const data = await res.json().catch(() => ({}));
            if (res.status === 422 && data.errors) {
              if (data.errors.customer_name && errName) {
                errName.textContent = data.errors.customer_name[0];
                errName.classList.remove('hidden');
              }
              if (data.errors.phone && errPhone) {
                errPhone.textContent = data.errors.phone[0];
                errPhone.classList.remove('hidden');
              }
            }
            if (apiError) apiError.classList.remove('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Book Appointment';
            }
          }
        } catch (err) {
          console.error(err);
          if (apiError) apiError.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Book Appointment';
          }
        }
      });
    }
  })();
</script>
