---
// BookingForm.astro - High-Performance Native AI Dispatch Platform Form (No Iframe)
---

<div class="armstrong-booking-wrapper w-full max-w-2xl mx-auto bg-white border-2 border-slate-300 shadow-2xl overflow-hidden font-sans text-left">
  
  <!-- Luxury Showroom Brand Header -->
  <div class="bg-showroom text-white px-6 sm:px-10 py-7 border-b-2 border-amber-500 relative">
    <div class="flex items-center gap-2 text-[10px] font-black tracking-widest text-amber-400 uppercase mb-1">
      <span class="w-2.5 h-2.5 bg-emerald-400 inline-block animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
      <span>ARMSTRONG DIRECT DISPATCH</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-black font-heading tracking-tight uppercase text-white">
      Schedule Service &amp; <span class="text-gold-gradient">Dispatch</span>
    </h1>
    <p class="text-slate-300 text-xs sm:text-sm mt-1 max-w-lg font-normal">
      Fill out the quick 4-step details below. Our on-duty master technicians in Nashville will receive your request immediately.
    </p>
  </div>

  <!-- Trust Highlights Strip -->
  <div class="bg-[#0b1b36] border-b border-slate-800 px-6 py-2.5 flex flex-wrap items-center justify-between text-[11px] text-slate-300 gap-2">
    <div class="flex items-center gap-1.5 text-amber-400 font-bold">
      <span>🛡️</span>
      <span class="text-slate-200">TN License #406</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span>⭐</span>
      <span class="text-slate-200">4.9 Star Rating (750+ Reviews)</span>
    </div>
    <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
      <span>🏪</span>
      <span class="text-slate-200">Shop: 208 Thompson Ln</span>
    </div>
  </div>

  <!-- Form Body -->
  <div class="p-6 sm:p-10">
    <form id="online-booking-form" class="flex flex-col gap-4 text-left" novalidate>
      <!-- Invisible Honeypot Field -->
      <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
        <label for="booking_company_website">Company Website</label>
        <input type="text" id="booking_company_website" name="company_website" tabindex="-1" autocomplete="off" value="" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="booking-name" class="block text-xs font-bold text-slate-800 mb-1">Your Full Name *</label>
          <input 
            type="text" 
            id="booking-name" 
            name="customer_name" 
            required 
            placeholder="e.g. John Smith" 
            class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
          />
          <span id="booking-name-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your full name.</span>
        </div>
        <div>
          <label for="booking-phone" class="block text-xs font-bold text-slate-800 mb-1">Phone Number *</label>
          <input 
            type="tel" 
            id="booking-phone" 
            name="phone" 
            required 
            placeholder="(615) 000-0000" 
            class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
          />
          <span id="booking-phone-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter a valid phone number.</span>
        </div>
      </div>

      <div>
        <label for="booking-service" class="block text-xs font-bold text-slate-800 mb-1">Service Needed *</label>
        <select 
          id="booking-service" 
          name="service" 
          required 
          class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
        >
          <option value="">Select a service category...</option>
          <option value="Car Key Replacement">🔑 Car Key Replacement (All Makes & Models)</option>
          <option value="European Specialist">🏎️ European Luxury Keys (BMW, Benz, Audi, Land Rover)</option>
          <option value="Key Fob Programming">📶 Key Fob & Remote Programming</option>
          <option value="Emergency Car Lockout">🚨 Emergency Vehicle Lockout</option>
          <option value="House Lockout / Rekey">🏡 Residential House Lockout / Lock Rekey</option>
          <option value="Commercial Locksmith">🏢 Commercial Door Hardware & Storefront Locks</option>
          <option value="Other">🛠️ Other Locksmith Service</option>
        </select>
        <span id="booking-service-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please select a service category.</span>
      </div>

      <div>
        <label for="booking-vehicle" class="block text-xs font-bold text-slate-800 mb-1">Vehicle Make / Model or Lock Details (Optional)</label>
        <input 
          type="text" 
          id="booking-vehicle" 
          name="vehicle" 
          placeholder="e.g. 2021 BMW X5 push-to-start, or 4 Schlage deadbolts" 
          class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
        />
      </div>

      <!-- Network / Server Error Alert -->
      <div id="booking-error-msg" class="hidden p-3.5 bg-red-50 border border-red-400 text-red-800 text-xs font-bold text-center">
        We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-black text-red-950">615-625-8000</a>.
      </div>

      <button 
        type="submit" 
        id="booking-submit-btn"
        class="w-full mt-2 py-4 px-6 bg-gold-metallic text-slate-950 font-black text-base uppercase tracking-wider shadow-xl transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer border-b-2 border-amber-600 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span>Submit Request to Dispatch &rarr;</span>
      </button>

      <div class="text-[11px] text-slate-500 text-center font-medium flex items-center justify-center gap-1 mt-1">
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span>Direct Transmission to Armstrong Dispatch &bull; Upfront Pricing Guaranteed</span>
      </div>
    </form>

    <!-- Success View -->
    <div id="booking-success-msg" class="hidden p-8 bg-emerald-50 border-2 border-emerald-500 text-emerald-950 text-center">
      <div class="text-5xl mb-3">✅</div>
      <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-emerald-950 mb-2">
        Thank you! Your request was sent to Armstrong Locksmith.
      </h2>
      <p class="text-sm text-emerald-800 max-w-md mx-auto leading-relaxed">
        Our dispatch staff has received your booking details and will review and reach out to you promptly.
      </p>
      <div class="mt-6 pt-4 border-t border-emerald-200 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="tel:6156258000" class="px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs uppercase tracking-wider shadow transition">
          <span>Need Immediate Dispatch? Call (615) 625-8000 &rarr;</span>
        </a>
        <a href="/" class="px-6 py-3 bg-white hover:bg-slate-100 text-slate-800 font-bold text-xs uppercase tracking-wider border border-slate-300 shadow transition">
          <span>Return Home</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Guarantee Strip -->
  <div class="bg-slate-50 border-t border-slate-200 px-6 py-3.5 flex flex-wrap items-center justify-between text-xs text-slate-600 gap-2">
    <span class="font-medium">🔒 Encrypted Dispatch Submission &bull; No upfront charges until service is confirmed.</span>
    <a href="tel:6156258000" class="font-bold text-[#0f274a] hover:text-amber-600 transition">
      Emergency Call: (615) 625-8000
    </a>
  </div>

</div>

<script is:inline>
  (function () {
    // Record timestamp when the form first loads / opens
    const formStartedAt = Math.floor(Date.now() / 1000);

    const form = document.getElementById('online-booking-form');
    const successMsg = document.getElementById('booking-success-msg');
    const errorBanner = document.getElementById('booking-error-msg');
    const submitBtn = document.getElementById('booking-submit-btn');

    const nameInput = document.getElementById('booking-name');
    const phoneInput = document.getElementById('booking-phone');
    const serviceSelect = document.getElementById('booking-service');
    const vehicleInput = document.getElementById('booking-vehicle');
    const honeypotInput = document.getElementById('booking_company_website');

    const nameError = document.getElementById('booking-name-error');
    const phoneError = document.getElementById('booking-phone-error');
    const serviceError = document.getElementById('booking-service-error');

    // Clear inline errors on input
    if (nameInput && nameError) {
      nameInput.addEventListener('input', function () {
        nameError.classList.add('hidden');
        nameInput.classList.remove('border-red-500');
      });
    }
    if (phoneInput && phoneError) {
      phoneInput.addEventListener('input', function () {
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
      });
    }
    if (serviceSelect && serviceError) {
      serviceSelect.addEventListener('change', function () {
        serviceError.classList.add('hidden');
        serviceSelect.classList.remove('border-red-500');
      });
    }

    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        // Reset errors
        if (errorBanner) errorBanner.classList.add('hidden');
        let hasError = false;

        const customerName = nameInput ? nameInput.value.trim() : '';
        const phone = phoneInput ? phoneInput.value.trim() : '';
        const service = serviceSelect ? serviceSelect.value : '';
        const vehicle = vehicleInput ? vehicleInput.value.trim() : '';
        const honeypot = honeypotInput ? honeypotInput.value.trim() : '';

        // Validation
        if (!customerName) {
          if (nameError) nameError.classList.remove('hidden');
          if (nameInput) nameInput.classList.add('border-red-500');
          hasError = true;
        }
        if (!phone || phone.length < 7) {
          if (phoneError) phoneError.classList.remove('hidden');
          if (phoneInput) phoneInput.classList.add('border-red-500');
          hasError = true;
        }
        if (!service) {
          if (serviceError) serviceError.classList.remove('hidden');
          if (serviceSelect) serviceSelect.classList.add('border-red-500');
          hasError = true;
        }

        if (hasError) return;

        // Honeypot bot protection
        if (honeypot !== '') {
          form.classList.add('hidden');
          if (successMsg) successMsg.classList.remove('hidden');
          return;
        }

        // Disable submit button
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>⚡ Transmitting Request...</span>';
        }

        const payload = {
          customer_name: customerName,
          phone: phone,
          service: service,
          service_type: service,
          vehicle: vehicle,
          form_started_at: formStartedAt,
          company_website: ''
        };

        try {
          const res = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            form.classList.add('hidden');
            if (successMsg) {
              successMsg.classList.remove('hidden');
            }
          } else {
            const data = await res.json().catch(() => ({}));
            
            if (res.status === 422 && data.errors) {
              if (data.errors.customer_name && nameError) {
                nameError.textContent = data.errors.customer_name[0];
                nameError.classList.remove('hidden');
              }
              if (data.errors.phone && phoneError) {
                phoneError.textContent = data.errors.phone[0];
                phoneError.classList.remove('hidden');
              }
              if ((data.errors.service || data.errors.service_type) && serviceError) {
                serviceError.textContent = (data.errors.service || data.errors.service_type)[0];
                serviceError.classList.remove('hidden');
              }
            }

            if (errorBanner) {
              errorBanner.classList.remove('hidden');
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<span>Submit Request to Dispatch &rarr;</span>';
            }
          }
        } catch (err) {
          console.error('Network error during booking submission:', err);
          if (errorBanner) {
            errorBanner.classList.remove('hidden');
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Submit Request to Dispatch &rarr;</span>';
          }
        }
      });
    }
  })();
</script>
