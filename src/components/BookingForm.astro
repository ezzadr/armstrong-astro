---
// BookingForm.astro - Official Armstrong AI Dispatch Platform Embed
---

<div class="w-full max-w-4xl mx-auto bg-white border-2 border-slate-300 shadow-2xl overflow-hidden font-sans text-left">
  
  <!-- Brand Header Strip -->
  <div class="bg-[#07152b] text-white px-6 sm:px-10 py-6 border-b-2 border-amber-500 flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-[10px] font-black tracking-widest text-amber-400 uppercase">
        <span class="w-2 h-2 bg-emerald-400 inline-block animate-pulse"></span>
        <span>ARMSTRONG AI DISPATCH SYSTEM</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black font-heading tracking-tight uppercase text-white mt-0.5">
        Live Service Booking &amp; Dispatch
      </h2>
    </div>

    <!-- Quick Direct Phone -->
    <a 
      href="tel:6156258000" 
      class="inline-flex items-center gap-2 px-4 py-2 bg-gold-metallic hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider transition active:scale-98 shadow-sm"
    >
      <span>📞 (615) 625-8000</span>
    </a>
  </div>

  <!-- Dispatch Platform Iframe Container -->
  <div class="w-full bg-white relative min-h-[700px] sm:min-h-[850px]">
    
    <!-- Loading Spinner (Auto-hides once iframe loads) -->
    <div id="frame-loading-indicator" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-50 text-slate-600 gap-3 z-10">
      <div class="w-8 h-8 border-3 border-slate-300 border-t-amber-500 animate-spin"></div>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Connecting to Armstrong Dispatch...</span>
    </div>

    <iframe
      id="armstrong-booking-frame"
      src="https://booking.armstronglocksmithinc.com/embed/booking"
      title="Book Armstrong Locksmith Service"
      loading="eager"
      class="w-full transition-all duration-300 block"
      style="width: 100%; min-height: 800px; border: 0; border-radius: 0px !important; display: block;"
      onload="document.getElementById('frame-loading-indicator')?.classList.add('hidden');"
    >
    </iframe>

  </div>

  <!-- Trust Footer Strip -->
  <div class="bg-slate-50 px-6 py-3 border-t border-slate-200 flex flex-wrap items-center justify-between text-[11px] text-slate-600 gap-2">
    <span>🛡️ TN State License #406 &bull; Verified Master Locksmith</span>
    <span>🏪 Storefront: 208 Thompson Ln, Nashville TN 37211</span>
  </div>

</div>

<!-- Auto-Resize Listener for Seamless Height -->
<script is:inline>
  window.addEventListener('message', function (event) {
    if (event.origin !== 'https://booking.armstronglocksmithinc.com') return;
    if (event.data?.type !== 'armstrong-booking-height') return;

    const frame = document.getElementById('armstrong-booking-frame');
    if (frame) {
      frame.style.height = Math.max(650, Math.min(2400, Number(event.data.height) || 1100)) + 'px';
    }
  });
</script>
