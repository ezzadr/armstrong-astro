---
// BookingForm.astro - Ultra-Clean, Minimalist AI Dispatch Booking Interface
---

<div class="w-full max-w-3xl mx-auto bg-white border border-slate-200 shadow-xl overflow-hidden font-sans text-left">
  
  <!-- Clean Brand Header Banner (Navy with Minimalist Typography) -->
  <div class="bg-[#07152b] text-white px-6 sm:px-10 py-8 sm:py-10 border-b-2 border-amber-500 relative">
    <div class="flex items-center gap-2 text-[11px] font-bold tracking-widest text-amber-400 uppercase mb-2">
      <span class="w-2 h-2 bg-emerald-400 inline-block"></span>
      <span>NASHVILLE LOCKSMITH SERVICE</span>
    </div>
    
    <h2 class="text-2xl sm:text-3xl font-black font-heading tracking-tight uppercase text-white">
      Tell us what you need.
    </h2>
    
    <p class="text-slate-300 text-xs sm:text-sm mt-2 leading-relaxed max-w-xl font-normal">
      Send your service request directly to Armstrong Dispatch. A team member will review the details and contact you to confirm availability and pricing.
    </p>

    <!-- Minimalist Badges -->
    <div class="flex flex-wrap gap-2 pt-4 text-[11px] text-slate-300">
      <span class="px-2.5 py-0.5 border border-slate-700 bg-slate-900/60">Licensed &amp; Local</span>
      <span class="px-2.5 py-0.5 border border-slate-700 bg-slate-900/60">Residential</span>
      <span class="px-2.5 py-0.5 border border-slate-700 bg-slate-900/60">Automotive</span>
      <span class="px-2.5 py-0.5 border border-slate-700 bg-slate-900/60">Commercial</span>
    </div>
  </div>

  <!-- Form Body -->
  <div class="p-6 sm:p-10 bg-white">
    
    <!-- Success Message Container -->
    <div id="booking-success-container" class="hidden p-8 bg-slate-50 border border-emerald-500 text-center space-y-4 my-2">
      <div class="w-12 h-12 bg-emerald-600 text-white text-2xl font-bold flex items-center justify-center mx-auto">
        ✓
      </div>
      <h3 class="text-xl sm:text-2xl font-black font-heading text-slate-900 uppercase">
        Request Sent to Dispatch
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
        Thank you! A dispatcher is reviewing your request now and will reach out shortly to confirm your quote and time window.
      </p>
      <div class="pt-2">
        <a href="tel:6156258000" class="inline-flex items-center gap-1.5 px-6 py-2.5 bg-[#0f274a] text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-800 transition">
          <span>📞 Call Dispatch: (615) 625-8000</span>
        </a>
      </div>
    </div>

    <!-- Clean Main Form -->
    <form id="arm-ai-booking-form" class="space-y-6">
      
      <!-- Sub-header -->
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-100 pb-3">
        <div>
          <h3 class="text-base sm:text-lg font-black font-heading text-slate-900 uppercase">Request an appointment</h3>
          <p class="text-xs text-slate-500">We'll use these details to prepare before we call or text you back.</p>
        </div>
        <span class="text-[10px] text-slate-400">All fields required unless marked optional</span>
      </div>

      <!-- 1. Name & Callback Phone -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label for="book-name" class="block text-xs font-bold text-slate-700">Your name</label>
          <input 
            type="text" 
            id="book-name" 
            name="name" 
            required 
            placeholder="John Doe" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
          />
        </div>

        <div class="space-y-1">
          <label for="book-phone" class="block text-xs font-bold text-slate-700">Best callback number</label>
          <input 
            type="tel" 
            id="book-phone" 
            name="phone" 
            required 
            placeholder="(615) 000-0000" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
          />
        </div>
      </div>

      <!-- 2. Email (Optional) -->
      <div class="space-y-1">
        <label for="book-email" class="block text-xs font-bold text-slate-700">Email <span class="text-slate-400 font-normal">(optional)</span></label>
        <input 
          type="email" 
          id="book-email" 
          name="email" 
          placeholder="name@example.com" 
          class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
        />
      </div>

      <!-- 3. Type of Service (Clean Pills) -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700">Type of service</label>
        <input type="hidden" id="book-service-type" name="service_type" value="Car / Automotive" />
        
        <div class="flex flex-wrap gap-2">
          <button 
            type="button" 
            data-value="Car / Automotive"
            class="svc-pill active px-4 py-2 border border-[#0f274a] bg-[#0f274a] text-white text-xs font-bold transition cursor-pointer"
          >
            Car / Automotive
          </button>
          <button 
            type="button" 
            data-value="Home / Residential"
            class="svc-pill px-4 py-2 border border-slate-300 bg-white text-slate-700 text-xs font-bold hover:border-slate-400 transition cursor-pointer"
          >
            Home / Residential
          </button>
          <button 
            type="button" 
            data-value="Business / Commercial"
            class="svc-pill px-4 py-2 border border-slate-300 bg-white text-slate-700 text-xs font-bold hover:border-slate-400 transition cursor-pointer"
          >
            Business / Commercial
          </button>
          <button 
            type="button" 
            data-value="Emergency Lockout"
            class="svc-pill px-4 py-2 border border-slate-300 bg-white text-slate-700 text-xs font-bold hover:border-slate-400 transition cursor-pointer"
          >
            Emergency Lockout
          </button>
        </div>
      </div>

      <!-- 4. What service do you need? -->
      <div class="space-y-1">
        <label for="book-service-detail" class="block text-xs font-bold text-slate-700">What service do you need?</label>
        <input 
          type="text" 
          id="book-service-detail" 
          name="service_needed" 
          placeholder="Example: car key replacement, rekey, lock repair" 
          class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
        />
      </div>

      <!-- 5. Tell us a little more (Textarea) -->
      <div class="space-y-1">
        <label for="book-notes" class="block text-xs font-bold text-slate-700">Tell us a little more</label>
        <textarea 
          id="book-notes" 
          name="notes" 
          rows="3" 
          placeholder="Include the vehicle year/make/model, lock problem, number of doors, or anything else that will help us prepare." 
          class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
        ></textarea>
      </div>

      <!-- 6. Service Address Row (Address, City, ZIP) -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
        <div class="sm:col-span-6 space-y-1">
          <label class="block text-xs font-bold text-slate-700">Service address</label>
          <input 
            type="text" 
            name="address" 
            required 
            placeholder="Street address (or 'Shop Drop-In')" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
          />
        </div>
        <div class="sm:col-span-3 space-y-1">
          <label class="block text-xs font-bold text-slate-700">City</label>
          <input 
            type="text" 
            name="city" 
            required 
            value="Nashville" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
          />
        </div>
        <div class="sm:col-span-3 space-y-1">
          <label class="block text-xs font-bold text-slate-700">ZIP</label>
          <input 
            type="text" 
            name="zip" 
            required 
            placeholder="37211" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition"
          />
        </div>
      </div>

      <!-- 7. Preferred Date & Preferred Time -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-700">Preferred date <span class="text-slate-400 font-normal">(optional)</span></label>
          <input 
            type="date" 
            name="preferred_date" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition cursor-pointer"
          />
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-700">Preferred time <span class="text-slate-400 font-normal">(optional)</span></label>
          <select 
            name="preferred_time" 
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none transition cursor-pointer"
          >
            <option value="asap">ASAP Emergency Dispatch</option>
            <option value="morning">Morning (8:00 AM – 12:00 PM)</option>
            <option value="afternoon">Afternoon (12:00 PM – 5:00 PM)</option>
            <option value="evening">Evening (5:00 PM – 9:00 PM)</option>
            <option value="anytime" selected>Flexible / Anytime</option>
          </select>
        </div>
      </div>

      <!-- 8. How should we contact you? -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700">How should we contact you?</label>
        <input type="hidden" id="book-contact-pref" name="contact_pref" value="Phone call" />
        
        <div class="flex flex-wrap gap-2">
          <button 
            type="button" 
            data-pref="Phone call"
            class="pref-pill active px-4 py-2 border border-[#0f274a] bg-[#0f274a] text-white text-xs font-bold transition cursor-pointer"
          >
            Phone call
          </button>
          <button 
            type="button" 
            data-pref="Text message"
            class="pref-pill px-4 py-2 border border-slate-300 bg-white text-slate-700 text-xs font-bold hover:border-slate-400 transition cursor-pointer"
          >
            Text message
          </button>
          <button 
            type="button" 
            data-pref="Email"
            class="pref-pill px-4 py-2 border border-slate-300 bg-white text-slate-700 text-xs font-bold hover:border-slate-400 transition cursor-pointer"
          >
            Email
          </button>
        </div>
      </div>

      <!-- 9. Disclaimer & Submit Button Row -->
      <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-[11px] text-slate-500 max-w-sm text-left leading-relaxed">
          * This is a service request, not a confirmed appointment. Armstrong will confirm the schedule and price with you.
        </p>

        <button 
          type="submit" 
          id="book-submit-btn"
          class="w-full sm:w-auto px-8 py-3.5 bg-gold-metallic hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow transition active:scale-98 cursor-pointer"
        >
          <span>Send request to Armstrong</span>
          <span>&rarr;</span>
        </button>
      </div>

    </form>

  </div>

</div>

<!-- Ultra-Light Client Interactivity -->
<script is:inline>
  (function () {
    const form = document.getElementById('arm-ai-booking-form');
    const serviceTypeInput = document.getElementById('book-service-type');
    const contactPrefInput = document.getElementById('book-contact-pref');
    const svcPills = document.querySelectorAll('.svc-pill');
    const prefPills = document.querySelectorAll('.pref-pill');
    const successContainer = document.getElementById('booking-success-container');
    const submitBtn = document.getElementById('book-submit-btn');

    // Service Pills toggle
    svcPills.forEach(pill => {
      pill.addEventListener('click', function () {
        svcPills.forEach(p => {
          p.classList.remove('active', 'border-[#0f274a]', 'bg-[#0f274a]', 'text-white');
          p.classList.add('border-slate-300', 'bg-white', 'text-slate-700');
        });
        this.classList.remove('border-slate-300', 'bg-white', 'text-slate-700');
        this.classList.add('active', 'border-[#0f274a]', 'bg-[#0f274a]', 'text-white');
        if (serviceTypeInput) serviceTypeInput.value = this.getAttribute('data-value') || '';
      });
    });

    // Contact Preference Pills toggle
    prefPills.forEach(pill => {
      pill.addEventListener('click', function () {
        prefPills.forEach(p => {
          p.classList.remove('active', 'border-[#0f274a]', 'bg-[#0f274a]', 'text-white');
          p.classList.add('border-slate-300', 'bg-white', 'text-slate-700');
        });
        this.classList.remove('border-slate-300', 'bg-white', 'text-slate-700');
        this.classList.add('active', 'border-[#0f274a]', 'bg-[#0f274a]', 'text-white');
        if (contactPrefInput) contactPrefInput.value = this.getAttribute('data-pref') || '';
      });
    });

    // Submit handler
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Sending...</span>';
        }

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        payload.timestamp = new Date().toISOString();

        try {
          await fetch('/api/dispatch.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } catch (err) {
          console.log('Logged:', err);
        }

        form.classList.add('hidden');
        if (successContainer) {
          successContainer.classList.remove('hidden');
          successContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }
  })();
</script>
