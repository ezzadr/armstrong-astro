---
// BookingForm.astro - Workiz-Style Luxury Interactive Booking Engine
---

<div class="w-full max-w-4xl mx-auto bg-white border-2 border-slate-300 shadow-2xl overflow-hidden font-sans text-left">
  
  <!-- ==================== SHOWROOM PROGRESS HEADER ==================== -->
  <div class="bg-showroom text-white px-6 sm:px-10 py-6 border-b-2 border-amber-500 flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative">
    <div>
      <div class="flex items-center gap-2 text-[10px] font-black tracking-widest text-amber-400 uppercase mb-1">
        <span class="w-2.5 h-2.5 bg-emerald-400 inline-block animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
        <span>ARMSTRONG ONLINE SCHEDULER</span>
      </div>
      <h1 id="wizard-step-heading" class="text-2xl sm:text-3xl font-black font-heading tracking-tight uppercase text-white">
        Step 1: Choose Your Service
      </h1>
    </div>

    <!-- Interactive Step Indicators -->
    <div class="flex items-center gap-2 text-xs font-bold font-mono">
      <div id="badge-step-1" class="step-badge px-3 py-1.5 bg-amber-500 text-slate-950 font-black shadow flex items-center gap-1.5">
        <span>1</span><span class="hidden sm:inline">SERVICE</span>
      </div>
      <span class="text-slate-600">&rarr;</span>
      <div id="badge-step-2" class="step-badge px-3 py-1.5 bg-slate-800 text-slate-400 flex items-center gap-1.5">
        <span>2</span><span class="hidden sm:inline">DATE &amp; TIME</span>
      </div>
      <span class="text-slate-600">&rarr;</span>
      <div id="badge-step-3" class="step-badge px-3 py-1.5 bg-slate-800 text-slate-400 flex items-center gap-1.5">
        <span>3</span><span class="hidden sm:inline">LOCATION</span>
      </div>
    </div>
  </div>

  <!-- Real-time Progress Bar -->
  <div class="w-full bg-slate-200 h-1.5">
    <div id="wizard-progress-bar" class="bg-amber-500 h-1.5 w-1/3 transition-all duration-300"></div>
  </div>

  <!-- Trust Ribbon -->
  <div class="bg-[#0b1b36] border-b border-slate-800 px-6 sm:px-10 py-2.5 flex flex-wrap items-center justify-between text-[11px] text-slate-300 gap-2">
    <div class="flex items-center gap-1.5 text-amber-400 font-bold">
      <span>🛡️</span>
      <span class="text-slate-200">TN License #406</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span>⭐</span>
      <span class="text-slate-200">4.9 Stars (750+ Google Reviews)</span>
    </div>
    <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
      <span>🏪</span>
      <span class="text-slate-200">Walk-In Shop &amp; Mobile Vans</span>
    </div>
  </div>

  <!-- ==================== MAIN FORM CONTAINER ==================== -->
  <form id="workiz-style-form" class="p-6 sm:p-10 bg-white" novalidate>
    <!-- Hidden Honeypot & State Inputs -->
    <input type="hidden" id="selected-service-title" name="service" value="Car Key Replacement" />
    <input type="hidden" id="selected-service-cat" name="service_category" value="Automotive" />
    <input type="hidden" id="selected-date-val" name="booking_date" value="Today" />
    <input type="hidden" id="selected-time-val" name="booking_time" value="ASAP Immediate Dispatch" />

    <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
      <label for="company_website_honeypot">Company Website</label>
      <input type="text" id="company_website_honeypot" name="company_website" tabindex="-1" autocomplete="off" value="" />
    </div>

    <!-- ==================== STEP 1: SERVICE SELECTION (WORKIZ CARDS) ==================== -->
    <div id="step-view-1" class="step-view space-y-6">
      
      <div>
        <h2 class="text-lg font-black font-heading uppercase text-slate-900">Select the service you need</h2>
        <p class="text-xs text-slate-500 mt-0.5">Click any service to customize options and select your time window.</p>
      </div>

      <!-- Service Category Tabs / Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Card 1: Car Key Replacement -->
        <div 
          class="service-select-box group p-6 border-2 border-amber-500 bg-amber-50/40 hover:bg-amber-50/70 transition-all cursor-pointer relative shadow-sm"
          data-service-title="Car Key Replacement (All Makes)"
          data-category="automotive"
          data-base-price="From $120"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-12 h-12 bg-amber-500 text-slate-950 flex items-center justify-center text-2xl shadow-sm shrink-0">
              🔑
            </div>
            <span class="service-radio w-6 h-6 border-2 border-amber-600 bg-amber-500 text-slate-950 flex items-center justify-center text-xs font-black">
              ✓
            </span>
          </div>
          <div class="mt-3">
            <h3 class="text-base font-black font-heading uppercase text-slate-950">Car Key Replacement</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Cut &amp; program standard, laser-cut, and push-to-start smart key fobs on-site.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-amber-200/80 flex items-center justify-between text-xs font-bold">
            <span class="text-amber-800">Save $100s vs Dealership</span>
            <span class="text-slate-950 font-black">Select &rarr;</span>
          </div>
        </div>

        <!-- Card 2: European Car Key Specialist -->
        <div 
          class="service-select-box group p-6 border-2 border-slate-200 hover:border-[#0f274a] bg-slate-50 hover:bg-slate-100 transition-all cursor-pointer relative shadow-sm"
          data-service-title="European Luxury Car Key Specialist"
          data-category="european"
          data-base-price="From $180"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-12 h-12 bg-[#07152b] text-amber-400 flex items-center justify-center text-2xl shadow-sm shrink-0">
              🏎️
            </div>
            <span class="service-radio w-6 h-6 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">
              ✓
            </span>
          </div>
          <div class="mt-3">
            <h3 class="text-base font-black font-heading uppercase text-slate-950">European Specialist</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">BMW, Mercedes-Benz, Audi, Land Rover &amp; Porsche key cutting &amp; CAS/FEM programming.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-bold">
            <span class="text-slate-500">Dealer-Grade Systems</span>
            <span class="text-slate-950 font-black">Select &rarr;</span>
          </div>
        </div>

        <!-- Card 3: Residential Locksmith & Rekey -->
        <div 
          class="service-select-box group p-6 border-2 border-slate-200 hover:border-[#0f274a] bg-slate-50 hover:bg-slate-100 transition-all cursor-pointer relative shadow-sm"
          data-service-title="Residential Lock Rekeying & Deadbolts"
          data-category="residential"
          data-base-price="From $65"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-12 h-12 bg-emerald-700 text-white flex items-center justify-center text-2xl shadow-sm shrink-0">
              🏡
            </div>
            <span class="service-radio w-6 h-6 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">
              ✓
            </span>
          </div>
          <div class="mt-3">
            <h3 class="text-base font-black font-heading uppercase text-slate-950">Residential Rekey &amp; Locks</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Repin existing house deadbolts to a single key, smart keypad locks &amp; high security.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-bold">
            <span class="text-slate-500">Same-Day Home Visit</span>
            <span class="text-slate-950 font-black">Select &rarr;</span>
          </div>
        </div>

        <!-- Card 4: Commercial Door Hardware -->
        <div 
          class="service-select-box group p-6 border-2 border-slate-200 hover:border-[#0f274a] bg-slate-50 hover:bg-slate-100 transition-all cursor-pointer relative shadow-sm"
          data-service-title="Commercial Storefront & Door Hardware"
          data-category="commercial"
          data-base-price="Free Estimate"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-12 h-12 bg-slate-800 text-white flex items-center justify-center text-2xl shadow-sm shrink-0">
              🏢
            </div>
            <span class="service-radio w-6 h-6 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">
              ✓
            </span>
          </div>
          <div class="mt-3">
            <h3 class="text-base font-black font-heading uppercase text-slate-950">Commercial &amp; Storefront</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Storefront door locks, panic exit bars, master key systems &amp; Adams Rite hardware.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-bold">
            <span class="text-slate-500">Licensed &amp; Insured</span>
            <span class="text-slate-950 font-black">Select &rarr;</span>
          </div>
        </div>

        <!-- Card 5: Emergency Lockout -->
        <div 
          class="service-select-box group p-6 border-2 border-slate-200 hover:border-red-600 bg-slate-50 hover:bg-red-50/40 transition-all cursor-pointer relative shadow-sm sm:col-span-2"
          data-service-title="Emergency Vehicle & Property Lockout"
          data-category="emergency"
          data-base-price="From $65"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-12 h-12 bg-red-600 text-white flex items-center justify-center text-2xl shadow-sm shrink-0">
              🚨
            </div>
            <span class="service-radio w-6 h-6 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">
              ✓
            </span>
          </div>
          <div class="mt-3">
            <h3 class="text-base font-black font-heading uppercase text-red-950">Emergency Lockout (Car, Home, Office)</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Locked keys in car or house? Fast priority roadside and mobile dispatch across Nashville.</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-bold">
            <span class="text-red-700">⚡ Immediate Mobile Response</span>
            <span class="text-slate-950 font-black">Select &rarr;</span>
          </div>
        </div>

      </div>

      <!-- Specific Details Sub-Box -->
      <div id="service-specific-details" class="p-5 bg-slate-50 border border-slate-200 space-y-3">
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
          Vehicle Make / Model or Lock Specifications
        </label>
        <input 
          type="text" 
          id="item-details-input" 
          name="vehicle"
          placeholder="e.g. 2021 BMW X5 push-to-start (lost all keys), or 4 house deadbolts" 
          class="w-full px-4 py-3 bg-white border border-slate-300 focus:border-[#0f274a] text-slate-900 text-sm outline-none font-medium"
        />
      </div>

      <div class="pt-4 border-t border-slate-200 flex justify-end">
        <button 
          type="button" 
          id="btn-step-1-next" 
          class="w-full sm:w-auto px-8 py-4 bg-gold-metallic text-slate-950 font-black text-sm uppercase tracking-wider shadow-lg hover:shadow-xl transition active:scale-95 cursor-pointer border-b-2 border-amber-600 flex items-center justify-center gap-2"
        >
          <span>Continue to Date &amp; Time &rarr;</span>
        </button>
      </div>

    </div>

    <!-- ==================== STEP 2: WORKIZ-STYLE DATE & TIME SELECTOR ==================== -->
    <div id="step-view-2" class="step-view hidden space-y-6">
      
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <div>
          <h2 class="text-lg font-black font-heading uppercase text-slate-900">Select Date &amp; Arrival Window</h2>
          <p class="text-xs text-slate-500">Pick your preferred day and arrival time slot.</p>
        </div>
        <button type="button" class="btn-prev text-xs font-bold text-slate-500 hover:text-slate-900 flex items-center gap-1 cursor-pointer">
          &larr; Change Service
        </button>
      </div>

      <!-- Horizontal Date Picker Strip -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">1. Select Day</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="date-buttons-grid">
          
          <button 
            type="button" 
            class="date-select-btn p-3.5 border-2 border-amber-500 bg-amber-50 text-slate-950 font-bold text-left transition cursor-pointer"
            data-date="Today (Immediate / Same-Day)"
          >
            <span class="block text-[10px] text-amber-800 uppercase font-black">Same-Day</span>
            <span class="block text-sm font-black mt-0.5">Today</span>
            <span class="block text-[11px] text-slate-600" id="label-today">Fast Dispatch</span>
          </button>

          <button 
            type="button" 
            class="date-select-btn p-3.5 border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-left transition cursor-pointer"
            data-date="Tomorrow"
          >
            <span class="block text-[10px] text-slate-500 uppercase font-black">Next Day</span>
            <span class="block text-sm font-black mt-0.5">Tomorrow</span>
            <span class="block text-[11px] text-slate-500" id="label-tomorrow">Standard</span>
          </button>

          <button 
            type="button" 
            class="date-select-btn p-3.5 border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-left transition cursor-pointer"
            data-date="Saturday Storefront Visit"
          >
            <span class="block text-[10px] text-slate-500 uppercase font-black">Weekend</span>
            <span class="block text-sm font-black mt-0.5">Saturday</span>
            <span class="block text-[11px] text-slate-500">10 AM – 4 PM</span>
          </button>

          <button 
            type="button" 
            class="date-select-btn p-3.5 border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-left transition cursor-pointer"
            data-date="Custom Scheduled Date"
          >
            <span class="block text-[10px] text-slate-500 uppercase font-black">Flexible</span>
            <span class="block text-sm font-black mt-0.5">Custom Date</span>
            <span class="block text-[11px] text-slate-500">Next Week</span>
          </button>

        </div>
      </div>

      <!-- Time Window Slot Selector -->
      <div class="space-y-2 pt-2">
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">2. Select Arrival Time Window</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="time-slots-grid">
          
          <button 
            type="button" 
            class="time-slot-btn p-4 border-2 border-amber-500 bg-amber-50 text-slate-950 font-bold text-left flex items-center justify-between transition cursor-pointer shadow-sm"
            data-time="⚡ ASAP Immediate Dispatch"
          >
            <div>
              <span class="block text-sm font-black text-slate-950">⚡ ASAP Dispatch</span>
              <span class="text-xs text-amber-800 font-medium">Nearest mobile van to your location</span>
            </div>
            <span class="time-radio w-5 h-5 border-2 border-amber-600 bg-amber-500 text-slate-950 flex items-center justify-center text-xs font-black">✓</span>
          </button>

          <button 
            type="button" 
            class="time-slot-btn p-4 border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-left flex items-center justify-between transition cursor-pointer shadow-sm"
            data-time="Morning Window (8:00 AM – 11:00 AM)"
          >
            <div>
              <span class="block text-sm font-black text-slate-950">Morning Window</span>
              <span class="text-xs text-slate-500 font-medium">8:00 AM – 11:00 AM</span>
            </div>
            <span class="time-radio w-5 h-5 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">✓</span>
          </button>

          <button 
            type="button" 
            class="time-slot-btn p-4 border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-left flex items-center justify-between transition cursor-pointer shadow-sm"
            data-time="Midday Window (11:00 AM – 2:00 PM)"
          >
            <div>
              <span class="block text-sm font-black text-slate-950">Midday Window</span>
              <span class="text-xs text-slate-500 font-medium">11:00 AM – 2:00 PM</span>
            </div>
            <span class="time-radio w-5 h-5 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">✓</span>
          </button>

          <button 
            type="button" 
            class="time-slot-btn p-4 border-2 border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-bold text-left flex items-center justify-between transition cursor-pointer shadow-sm"
            data-time="Afternoon Window (2:00 PM – 5:00 PM)"
          >
            <div>
              <span class="block text-sm font-black text-slate-950">Afternoon Window</span>
              <span class="text-xs text-slate-500 font-medium">2:00 PM – 5:00 PM</span>
            </div>
            <span class="time-radio w-5 h-5 border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-xs font-black">✓</span>
          </button>

        </div>
      </div>

      <!-- Navigation Actions -->
      <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
        <button type="button" class="btn-prev px-5 py-3 border border-slate-300 text-slate-700 font-bold text-xs uppercase hover:bg-slate-100 transition cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="button" 
          id="btn-step-2-next" 
          class="px-8 py-4 bg-gold-metallic text-slate-950 font-black text-sm uppercase tracking-wider shadow-lg hover:shadow-xl transition active:scale-95 cursor-pointer border-b-2 border-amber-600"
        >
          <span>Continue to Location &amp; Contact &rarr;</span>
        </button>
      </div>

    </div>

    <!-- ==================== STEP 3: CONTACT, LOCATION & SUMMARY ==================== -->
    <div id="step-view-3" class="step-view hidden space-y-6">
      
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <div>
          <h2 class="text-lg font-black font-heading uppercase text-slate-900">Contact &amp; Service Location</h2>
          <p class="text-xs text-slate-500">We will confirm dispatch and arrival time with you.</p>
        </div>
        <button type="button" class="btn-prev text-xs font-bold text-slate-500 hover:text-slate-900 flex items-center gap-1 cursor-pointer">
          &larr; Back
        </button>
      </div>

      <!-- Live Booking Summary Box (Workiz Luxury Style) -->
      <div class="p-4 bg-[#07152b] text-white border-l-4 border-amber-500 shadow-md">
        <div class="flex items-center justify-between border-b border-white/10 pb-2 mb-2">
          <span class="text-[10px] uppercase tracking-wider font-bold text-amber-400">Booking Summary</span>
          <span class="text-[11px] font-bold text-emerald-400">✓ Upfront Pricing</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
          <div>
            <span class="text-slate-400 block">Service:</span>
            <strong id="summary-service" class="text-white font-bold">Car Key Replacement</strong>
          </div>
          <div>
            <span class="text-slate-400 block">Schedule Window:</span>
            <strong id="summary-timing" class="text-amber-300 font-bold">Today • ASAP Dispatch</strong>
          </div>
        </div>
      </div>

      <!-- Contact Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="workiz-name" class="block text-xs font-bold text-slate-800 mb-1">Full Name *</label>
          <input 
            type="text" 
            id="workiz-name" 
            name="customer_name" 
            required 
            placeholder="John Smith" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0f274a] text-slate-900 text-sm outline-none font-medium"
          />
          <span id="name-error-msg" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your full name.</span>
        </div>

        <div>
          <label for="workiz-phone" class="block text-xs font-bold text-slate-800 mb-1">Phone Number *</label>
          <input 
            type="tel" 
            id="workiz-phone" 
            name="phone" 
            required 
            placeholder="(615) 000-0000" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0f274a] text-slate-900 text-sm outline-none font-medium"
          />
          <span id="phone-error-msg" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter a valid phone number.</span>
        </div>
      </div>

      <!-- Address Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
        <div class="sm:col-span-7">
          <label for="workiz-address" class="block text-xs font-bold text-slate-800 mb-1">Service Address / Location</label>
          <input 
            type="text" 
            id="workiz-address" 
            name="address" 
            placeholder="Street address (or 'Storefront Shop Drop-In')" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0f274a] text-slate-900 text-sm outline-none font-medium"
          />
        </div>
        <div class="sm:col-span-5">
          <label for="workiz-city" class="block text-xs font-bold text-slate-800 mb-1">City / Area</label>
          <input 
            type="text" 
            id="workiz-city" 
            name="city" 
            value="Nashville, TN" 
            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0f274a] text-slate-900 text-sm outline-none font-medium"
          />
        </div>
      </div>

      <!-- Notes Field -->
      <div>
        <label for="workiz-notes" class="block text-xs font-bold text-slate-800 mb-1">Special Instructions / Gate Code <span class="text-slate-400 font-normal">(optional)</span></label>
        <textarea 
          id="workiz-notes" 
          name="notes" 
          rows="2" 
          placeholder="Any special notes for our technician..." 
          class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 focus:bg-white focus:border-[#0f274a] text-slate-900 text-sm outline-none font-medium"
        ></textarea>
      </div>

      <!-- Network / Server Error Alert -->
      <div id="submit-error-banner" class="hidden p-3.5 bg-red-50 border border-red-400 text-red-800 text-xs font-bold text-center">
        We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-black text-red-950">615-625-8000</a>.
      </div>

      <!-- Submit Actions -->
      <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <button type="button" class="btn-prev px-5 py-3 border border-slate-300 text-slate-700 font-bold text-xs uppercase hover:bg-slate-100 transition cursor-pointer">
          &larr; Back
        </button>

        <button 
          type="submit" 
          id="submit-booking-btn" 
          class="w-full sm:w-auto px-10 py-4 bg-gold-metallic text-slate-950 font-black text-sm uppercase tracking-wider shadow-xl transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer border-b-2 border-amber-600 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span>Confirm &amp; Send to Armstrong Dispatch &rarr;</span>
        </button>
      </div>

    </div>

  </form>

  <!-- ==================== SUCCESS VIEW ==================== -->
  <div id="booking-success-view" class="hidden p-8 sm:p-12 bg-white text-center space-y-4">
    <div class="w-16 h-16 bg-emerald-600 text-white text-3xl font-bold flex items-center justify-center mx-auto shadow-lg">
      ✓
    </div>
    
    <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-950 uppercase tracking-tight">
      Thank you! Your request was sent to Armstrong Locksmith.
    </h2>
    
    <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
      Our dispatch team in Nashville has received your booking details and will review and reach out to you promptly to confirm arrival time.
    </p>

    <div class="pt-4 flex flex-wrap justify-center gap-3">
      <a href="tel:6156258000" class="px-6 py-3.5 bg-[#07152b] text-white font-black text-xs uppercase tracking-wider hover:bg-slate-800 transition">
        📞 Call Dispatch: (615) 625-8000
      </a>
      <a href="/" class="px-6 py-3.5 bg-slate-100 text-slate-800 font-bold text-xs uppercase tracking-wider hover:bg-slate-200 transition">
        Return to Homepage &rarr;
      </a>
    </div>
  </div>

</div>

<!-- ==================== INTERACTIVE SCRIPT ==================== -->
<script is:inline>
  (function () {
    // Record timestamp when the form first loads / opens
    const formStartedAt = Math.floor(Date.now() / 1000);

    let currentStep = 1;

    const heading = document.getElementById('wizard-step-heading');
    const progressBar = document.getElementById('wizard-progress-bar');

    const step1View = document.getElementById('step-view-1');
    const step2View = document.getElementById('step-view-2');
    const step3View = document.getElementById('step-view-3');
    const successView = document.getElementById('booking-success-view');
    const form = document.getElementById('workiz-style-form');

    const badge1 = document.getElementById('badge-step-1');
    const badge2 = document.getElementById('badge-step-2');
    const badge3 = document.getElementById('badge-step-3');

    const serviceBoxes = document.querySelectorAll('.service-select-box');
    const selectedServiceInput = document.getElementById('selected-service-title');
    const selectedCatInput = document.getElementById('selected-service-cat');

    const dateBtns = document.querySelectorAll('.date-select-btn');
    const timeBtns = document.querySelectorAll('.time-slot-btn');
    const selectedDateInput = document.getElementById('selected-date-val');
    const selectedTimeInput = document.getElementById('selected-time-val');

    const summaryService = document.getElementById('summary-service');
    const summaryTiming = document.getElementById('summary-timing');

    const btnNext1 = document.getElementById('btn-step-1-next');
    const btnNext2 = document.getElementById('btn-step-2-next');
    const prevBtns = document.querySelectorAll('.btn-prev');
    const submitBtn = document.getElementById('submit-booking-btn');
    const errorBanner = document.getElementById('submit-error-banner');

    const nameInput = document.getElementById('workiz-name');
    const phoneInput = document.getElementById('workiz-phone');
    const nameError = document.getElementById('name-error-msg');
    const phoneError = document.getElementById('phone-error-msg');
    const honeypotInput = document.getElementById('company_website_honeypot');

    function updateStep(step) {
      currentStep = step;

      step1View.classList.add('hidden');
      step2View.classList.add('hidden');
      step3View.classList.add('hidden');
      if (successView) successView.classList.add('hidden');

      [badge1, badge2, badge3].forEach(b => {
        if (b) {
          b.classList.remove('bg-amber-500', 'text-slate-950', 'font-black');
          b.classList.add('bg-slate-800', 'text-slate-400');
        }
      });

      if (step === 1) {
        step1View.classList.remove('hidden');
        if (heading) heading.textContent = "Step 1: Choose Your Service";
        if (progressBar) progressBar.style.width = "33%";
        if (badge1) {
          badge1.classList.remove('bg-slate-800', 'text-slate-400');
          badge1.classList.add('bg-amber-500', 'text-slate-950', 'font-black');
        }
      } else if (step === 2) {
        step2View.classList.remove('hidden');
        if (heading) heading.textContent = "Step 2: Select Date & Time Slot";
        if (progressBar) progressBar.style.width = "66%";
        if (badge2) {
          badge2.classList.remove('bg-slate-800', 'text-slate-400');
          badge2.classList.add('bg-amber-500', 'text-slate-950', 'font-black');
        }
      } else if (step === 3) {
        step3View.classList.remove('hidden');
        if (heading) heading.textContent = "Step 3: Contact & Service Location";
        if (progressBar) progressBar.style.width = "100%";
        if (badge3) {
          badge3.classList.remove('bg-slate-800', 'text-slate-400');
          badge3.classList.add('bg-amber-500', 'text-slate-950', 'font-black');
        }
        // Update summary box
        if (summaryService) summaryService.textContent = selectedServiceInput.value;
        if (summaryTiming) summaryTiming.textContent = `${selectedDateInput.value} • ${selectedTimeInput.value}`;
      } else if (step === 4) {
        form.classList.add('hidden');
        if (successView) successView.classList.remove('hidden');
        if (heading) heading.textContent = "Request Dispatched!";
        if (progressBar) progressBar.style.width = "100%";
      }

      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    // 1. Service Box Click Handler
    serviceBoxes.forEach(box => {
      box.addEventListener('click', function () {
        serviceBoxes.forEach(b => {
          b.classList.remove('border-amber-500', 'bg-amber-50/40', 'bg-amber-50/70');
          b.classList.add('border-slate-200', 'bg-slate-50');
          const r = b.querySelector('.service-radio');
          if (r) {
            r.classList.remove('border-amber-600', 'bg-amber-500', 'text-slate-950');
            r.classList.add('border-slate-300', 'bg-white', 'text-transparent');
          }
        });

        this.classList.remove('border-slate-200', 'bg-slate-50');
        this.classList.add('border-amber-500', 'bg-amber-50/40');
        const activeRadio = this.querySelector('.service-radio');
        if (activeRadio) {
          activeRadio.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
          activeRadio.classList.add('border-amber-600', 'bg-amber-500', 'text-slate-950');
        }

        const title = this.getAttribute('data-service-title');
        const cat = this.getAttribute('data-category');
        if (selectedServiceInput) selectedServiceInput.value = title;
        if (selectedCatInput) selectedCatInput.value = cat;
      });
    });

    // 2. Date Buttons Click Handler
    dateBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        dateBtns.forEach(b => {
          b.classList.remove('border-amber-500', 'bg-amber-50', 'text-slate-950');
          b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-800');
        });
        this.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-800');
        this.classList.add('border-amber-500', 'bg-amber-50', 'text-slate-950');
        const val = this.getAttribute('data-date');
        if (selectedDateInput) selectedDateInput.value = val;
      });
    });

    // 3. Time Slots Click Handler
    timeBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        timeBtns.forEach(b => {
          b.classList.remove('border-amber-500', 'bg-amber-50');
          b.classList.add('border-slate-200', 'bg-slate-50');
          const r = b.querySelector('.time-radio');
          if (r) {
            r.classList.remove('border-amber-600', 'bg-amber-500', 'text-slate-950');
            r.classList.add('border-slate-300', 'bg-white', 'text-transparent');
          }
        });
        this.classList.remove('border-slate-200', 'bg-slate-50');
        this.classList.add('border-amber-500', 'bg-amber-50');
        const activeRadio = this.querySelector('.time-radio');
        if (activeRadio) {
          activeRadio.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
          activeRadio.classList.add('border-amber-600', 'bg-amber-500', 'text-slate-950');
        }
        const val = this.getAttribute('data-time');
        if (selectedTimeInput) selectedTimeInput.value = val;
      });
    });

    // Step Navigations
    if (btnNext1) btnNext1.addEventListener('click', () => updateStep(2));
    if (btnNext2) btnNext2.addEventListener('click', () => updateStep(3));
    prevBtns.forEach(b => b.addEventListener('click', () => {
      if (currentStep > 1) updateStep(currentStep - 1);
    }));

    // Clear validation error on input
    if (nameInput && nameError) {
      nameInput.addEventListener('input', () => {
        nameError.classList.add('hidden');
        nameInput.classList.remove('border-red-500');
      });
    }
    if (phoneInput && phoneError) {
      phoneInput.addEventListener('input', () => {
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
      });
    }

    // 4. Submit Handler (Sends to Production API)
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (errorBanner) errorBanner.classList.add('hidden');
        let hasError = false;

        const customerName = nameInput ? nameInput.value.trim() : '';
        const phone = phoneInput ? phoneInput.value.trim() : '';
        const honeypot = honeypotInput ? honeypotInput.value.trim() : '';

        if (!customerName) {
          if (nameError) nameError.classList.remove('hidden');
          if (nameInput) nameInput.classList.add('border-red-500');
          hasError = true;
        }
        if (!phone || phone.length < 7) {
          if (phoneError) phoneError.classList.remove('hidden');
          if (phoneInput) phoneInput.classList.add('border-red-500');
          hasError = true;
        }

        if (hasError) return;

        // Honeypot bot protection
        if (honeypot !== '') {
          updateStep(4);
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>⚡ Transmitting Request...</span>';
        }

        const serviceTitle = selectedServiceInput ? selectedServiceInput.value : 'Locksmith Service';
        const serviceCat = selectedCatInput ? selectedCatInput.value : 'General';
        const bookingDate = selectedDateInput ? selectedDateInput.value : 'Today';
        const bookingTime = selectedTimeInput ? selectedTimeInput.value : 'ASAP';
        const vehicleOrDetails = document.getElementById('item-details-input')?.value || '';
        const address = document.getElementById('workiz-address')?.value || '';
        const city = document.getElementById('workiz-city')?.value || '';
        const notes = document.getElementById('workiz-notes')?.value || '';

        const fullService = `${serviceTitle} [${bookingDate} • ${bookingTime}]`;
        const fullLocation = [address, city].filter(Boolean).join(', ');
        const detailsString = [vehicleOrDetails, fullLocation ? `Location: ${fullLocation}` : '', notes ? `Note: ${notes}` : ''].filter(Boolean).join(' | ');

        const payload = {
          customer_name: customerName,
          phone: phone,
          service: fullService,
          service_type: serviceCat,
          vehicle: detailsString || 'Details provided on call',
          form_started_at: formStartedAt,
          company_website: ''
        };

        try {
          const res = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            updateStep(4);
          } else {
            const data = await res.json().catch(() => ({}));
            
            if (res.status === 422 && data.errors) {
              if (data.errors.customer_name && nameError) {
                nameError.textContent = data.errors.customer_name[0];
                nameError.classList.remove('hidden');
              }
              if (data.errors.phone && phoneError) {
                phoneError.textContent = data.errors.phone[0];
                phoneError.classList.remove('hidden');
              }
            }

            if (errorBanner) errorBanner.classList.remove('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<span>Confirm &amp; Send to Armstrong Dispatch &rarr;</span>';
            }
          }
        } catch (err) {
          console.error('Dispatch network error:', err);
          if (errorBanner) errorBanner.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Confirm &amp; Send to Armstrong Dispatch &rarr;</span>';
          }
        }
      });
    }
  })();
</script>
