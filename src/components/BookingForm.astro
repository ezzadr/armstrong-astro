---
// BookingForm.astro - Clean Workiz Booking Flow with Stepper (No Subheadings, Clean High-End Typography)
---

<div class="w-full max-w-2xl mx-auto bg-white rounded-xl border border-slate-200/90 shadow-lg font-sans text-left overflow-hidden transition-all">
  
  <!-- ==================== TOP STEP HEADER (START -> SCHEDULE -> BOOK) ==================== -->
  <div class="bg-slate-50/90 border-b border-slate-200 px-6 sm:px-10 py-5">
    
    <!-- Brand Line -->
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-200/80">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block ring-4 ring-emerald-100"></span>
        <span class="text-xs font-black tracking-wider text-slate-800 uppercase">Armstrong Locksmith Inc</span>
      </div>
      <a 
        href="tel:6156258000" 
        class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-slate-200 rounded-full text-xs font-bold text-slate-700 hover:text-blue-600 hover:border-blue-300 shadow-sm transition"
      >
        <span>📞</span>
        <span>(615) 625-8000</span>
      </a>
    </div>

    <!-- Visual 3-Step Stepper (Start -> Schedule -> Book) -->
    <div class="relative flex items-center justify-between max-w-md mx-auto px-4">
      <!-- Connecting Progress Track -->
      <div class="absolute top-1/2 left-8 right-8 -translate-y-1/2 h-[2px] bg-slate-200 -z-0">
        <div id="step-track" class="h-full bg-blue-600 w-0 transition-all duration-300"></div>
      </div>

      <!-- Step 1: Start -->
      <div class="relative z-10 flex flex-col items-center gap-1.5">
        <div id="node-1" class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all">
          1
        </div>
        <div class="text-center">
          <span id="label-1" class="block text-xs font-bold text-slate-900 tracking-tight">Start</span>
        </div>
      </div>

      <!-- Step 2: Schedule -->
      <div class="relative z-10 flex flex-col items-center gap-1.5">
        <div id="node-2" class="w-8 h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 font-bold text-xs flex items-center justify-center transition-all">
          2
        </div>
        <div class="text-center">
          <span id="label-2" class="block text-xs font-medium text-slate-400 tracking-tight">Schedule</span>
        </div>
      </div>

      <!-- Step 3: Book -->
      <div class="relative z-10 flex flex-col items-center gap-1.5">
        <div id="node-3" class="w-8 h-8 rounded-full bg-white border-2 border-slate-300 text-slate-400 font-bold text-xs flex items-center justify-center transition-all">
          3
        </div>
        <div class="text-center">
          <span id="label-3" class="block text-xs font-medium text-slate-400 tracking-tight">Book</span>
        </div>
      </div>
    </div>

  </div>

  <!-- ==================== FORM BODY ==================== -->
  <form id="booking-form" class="p-6 sm:p-8 bg-white" novalidate>
    <!-- Hidden Form Fields & Honeypot -->
    <input type="hidden" id="field-service" name="service" value="Car key replacement" />
    <input type="hidden" id="field-date" name="booking_date" value="Today" />
    <input type="hidden" id="field-time" name="booking_time" value="ASAP" />
    
    <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
      <label for="company_website">Company Website</label>
      <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" value="" />
    </div>

    <!-- ==================== STEP 1: CLEAN SERVICE LIST (NO SUBHEADINGS) ==================== -->
    <div id="step-1" class="step-pane space-y-3">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Select a Service:</div>

      <!-- 1. Car key replacement -->
      <button 
        type="button" 
        class="service-item w-full py-4.5 px-5 sm:px-6 border border-slate-200 rounded-xl hover:border-blue-600 hover:bg-slate-50/80 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-sm hover:shadow hover:translate-x-0.5" 
        data-service="Car key replacement"
      >
        <span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Car key replacement
        </span>
        <span class="text-slate-300 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">
          ›
        </span>
      </button>

      <!-- 2. Residential lock and rekey -->
      <button 
        type="button" 
        class="service-item w-full py-4.5 px-5 sm:px-6 border border-slate-200 rounded-xl hover:border-blue-600 hover:bg-slate-50/80 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-sm hover:shadow hover:translate-x-0.5" 
        data-service="Residential lock and rekey"
      >
        <span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Residential lock and rekey
        </span>
        <span class="text-slate-300 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">
          ›
        </span>
      </button>

      <!-- 3. Commercial lock and rekey -->
      <button 
        type="button" 
        class="service-item w-full py-4.5 px-5 sm:px-6 border border-slate-200 rounded-xl hover:border-blue-600 hover:bg-slate-50/80 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-sm hover:shadow hover:translate-x-0.5" 
        data-service="Commercial lock and rekey"
      >
        <span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Commercial lock and rekey
        </span>
        <span class="text-slate-300 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">
          ›
        </span>
      </button>

      <!-- 4. Other locksmith services -->
      <button 
        type="button" 
        class="service-item w-full py-4.5 px-5 sm:px-6 border border-slate-200 rounded-xl hover:border-blue-600 hover:bg-slate-50/80 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-sm hover:shadow hover:translate-x-0.5" 
        data-service="Other locksmith services"
      >
        <span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Other locksmith services
        </span>
        <span class="text-slate-300 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">
          ›
        </span>
      </button>

      <!-- 5. Emergency lockout -->
      <button 
        type="button" 
        class="service-item w-full py-4.5 px-5 sm:px-6 border border-slate-200 rounded-xl hover:border-blue-600 hover:bg-slate-50/80 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-sm hover:shadow hover:translate-x-0.5" 
        data-service="Emergency lockout"
      >
        <span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          Emergency lockout
        </span>
        <span class="text-slate-300 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">
          ›
        </span>
      </button>

      <!-- 6. European cars -->
      <button 
        type="button" 
        class="service-item w-full py-4.5 px-5 sm:px-6 border border-slate-200 rounded-xl hover:border-blue-600 hover:bg-slate-50/80 flex items-center justify-between transition-all duration-150 cursor-pointer text-left group shadow-sm hover:shadow hover:translate-x-0.5" 
        data-service="European cars"
      >
        <span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
          European cars
        </span>
        <span class="text-slate-300 group-hover:text-blue-600 text-xl font-bold transition-transform group-hover:translate-x-1">
          ›
        </span>
      </button>
    </div>

    <!-- ==================== STEP 2: SCHEDULE (DATE & TIME) ==================== -->
    <div id="step-2" class="step-pane hidden space-y-6">
      
      <!-- Selected Service Bar -->
      <div class="flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded-xl">
        <div class="text-xs">
          <span class="text-slate-500">Service:</span>
          <strong id="wkz-selected-service" class="text-slate-900 ml-1 font-bold">Car key replacement</strong>
        </div>
        <button type="button" class="btn-back text-xs font-bold text-blue-600 hover:underline cursor-pointer">
          Change
        </button>
      </div>

      <!-- Dynamic Sunday Notice -->
      <div id="booking-sunday-notice" class="hidden p-3.5 bg-amber-50 border border-amber-300 rounded-xl text-left">
        <div class="flex items-start gap-2.5">
          <span class="text-amber-600 text-base">📅</span>
          <div>
            <span class="text-xs font-bold text-amber-900 block">Sunday Notice: Storefront opens Monday at 8:00 AM</span>
            <p class="text-[11px] text-amber-800 mt-0.5 leading-relaxed">
              Mobile units are on-call today for urgent lockouts. For planned service, choose <strong>Tomorrow (Monday)</strong> to get guaranteed #1 priority arrival at 8:00 AM.
            </p>
          </div>
        </div>
      </div>

      <!-- Date Options -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700">When do you need us?</label>
        <div class="grid grid-cols-3 gap-2.5">
          <button 
            type="button" 
            class="date-chip p-3 border-2 border-blue-600 bg-blue-50 text-blue-900 rounded-xl text-xs font-bold text-center transition cursor-pointer" 
            data-date="Today"
          >
            Today
          </button>
          <button 
            type="button" 
            class="date-chip p-3 border border-slate-200 bg-white text-slate-700 rounded-xl text-xs font-medium text-center hover:bg-slate-50 transition cursor-pointer" 
            data-date="Tomorrow"
          >
            Tomorrow
          </button>
          <button 
            type="button" 
            class="date-chip p-3 border border-slate-200 bg-white text-slate-700 rounded-xl text-xs font-medium text-center hover:bg-slate-50 transition cursor-pointer" 
            data-date="Custom Date"
          >
            Custom Date
          </button>
        </div>
      </div>

      <!-- Time Window Options -->
      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-700">Select arrival window:</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          
          <button 
            type="button" 
            class="time-chip p-3.5 border-2 border-blue-600 bg-blue-50 text-blue-900 rounded-xl text-xs font-bold text-left transition cursor-pointer flex items-center justify-between" 
            data-time="ASAP Immediate Dispatch"
          >
            <div>
              <div class="font-bold">⚡ ASAP Dispatch</div>
              <div class="text-[11px] text-blue-700 font-normal">Nearest mobile unit</div>
            </div>
            <span class="w-4 h-4 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 border border-slate-200 bg-white text-slate-700 rounded-xl text-xs font-medium text-left hover:bg-slate-50 transition cursor-pointer flex items-center justify-between" 
            data-time="Morning (8:00 AM – 12:00 PM)"
          >
            <div>
              <div class="font-semibold text-slate-900">Morning Window</div>
              <div class="text-[11px] text-slate-500 font-normal">8:00 AM – 12:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 border border-slate-200 bg-white text-slate-700 rounded-xl text-xs font-medium text-left hover:bg-slate-50 transition cursor-pointer flex items-center justify-between" 
            data-time="Afternoon (12:00 PM – 4:00 PM)"
          >
            <div>
              <div class="font-semibold text-slate-900">Afternoon Window</div>
              <div class="text-[11px] text-slate-500 font-normal">12:00 PM – 4:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 border border-slate-200 bg-white text-slate-700 rounded-xl text-xs font-medium text-left hover:bg-slate-50 transition cursor-pointer flex items-center justify-between" 
            data-time="Evening (4:00 PM – 8:00 PM)"
          >
            <div>
              <div class="font-semibold text-slate-900">Evening Window</div>
              <div class="text-[11px] text-slate-500 font-normal">4:00 PM – 8:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-slate-300 text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
        <button type="button" class="btn-back px-4 py-2 text-xs font-semibold text-slate-500 hover:text-slate-900 cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="button" 
          id="btn-to-3" 
          class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-sm transition cursor-pointer"
        >
          Continue to Details &rarr;
        </button>
      </div>

    </div>

    <!-- ==================== STEP 3: BOOK (CONTACT & DETAILS) ==================== -->
    <div id="step-3" class="step-pane hidden space-y-4">
      
      <!-- Summary Line -->
      <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs flex items-center justify-between">
        <div>
          <span class="text-slate-500">Selected:</span>
          <strong id="wkz-summary" class="text-slate-900 ml-1 font-bold">Car key replacement &bull; Today (ASAP)</strong>
        </div>
        <button type="button" class="btn-back text-xs font-bold text-blue-600 hover:underline cursor-pointer">
          Edit
        </button>
      </div>

      <!-- Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="cust_name" class="block text-xs font-bold text-slate-700 mb-1">Full Name *</label>
          <input 
            type="text" 
            id="cust_name" 
            name="customer_name" 
            required 
            placeholder="John Smith" 
            class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-blue-600 focus:ring-1 focus:ring-blue-600 focus:outline-none transition font-medium" 
          />
          <span id="err-name" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your name.</span>
        </div>

        <div>
          <label for="cust_phone" class="block text-xs font-bold text-slate-700 mb-1">Phone Number *</label>
          <input 
            type="tel" 
            id="cust_phone" 
            name="phone" 
            required 
            placeholder="(615) 000-0000" 
            class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-blue-600 focus:ring-1 focus:ring-blue-600 focus:outline-none transition font-medium" 
          />
          <span id="err-phone" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your phone number.</span>
        </div>
      </div>

      <div>
        <label for="cust_address" class="block text-xs font-bold text-slate-700 mb-1">Service Address / Location</label>
        <input 
          type="text" 
          id="cust_address" 
          name="address" 
          placeholder="e.g. 123 Main St, Nashville, TN (or 'Storefront Walk-In')" 
          class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-blue-600 focus:ring-1 focus:ring-blue-600 focus:outline-none transition font-medium" 
        />
      </div>

      <div>
        <label for="cust_notes" class="block text-xs font-bold text-slate-700 mb-1">Vehicle Year/Make/Model or Job Details (Optional)</label>
        <input 
          type="text" 
          id="cust_notes" 
          name="details" 
          placeholder="e.g. 2021 BMW X5 all keys lost, or 3 house locks" 
          class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-blue-600 focus:ring-1 focus:ring-blue-600 focus:outline-none transition font-medium" 
        />
      </div>

      <!-- Server Error Alert -->
      <div id="api-error" class="hidden p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl text-center font-bold">
        We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-black">615-625-8000</a>.
      </div>

      <!-- Submit Button -->
      <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
        <button type="button" class="btn-back px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-900 cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="submit" 
          id="btn-submit" 
          class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-sm transition cursor-pointer disabled:opacity-50"
        >
          Book Appointment
        </button>
      </div>

    </div>

  </form>

  <!-- ==================== SUCCESS CONFIRMATION ==================== -->
  <div id="step-success" class="hidden p-8 sm:p-12 text-center space-y-3 bg-white">
    <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl font-bold mx-auto">
      ✓
    </div>
    <h2 class="text-base sm:text-lg font-bold text-slate-900">
      Thank you! Your request was sent to Armstrong Locksmith.
    </h2>
    <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
      Our dispatch team will review your appointment request and contact you shortly with confirmation.
    </p>
    <div class="pt-2">
      <a href="tel:6156258000" class="text-xs font-semibold text-blue-600 hover:underline">
        Need immediate dispatch? Call (615) 625-8000
      </a>
    </div>
  </div>

  <!-- Trust Footer -->
  <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200 text-center text-xs text-slate-500">
    Armstrong Locksmith Inc &bull; Licensed, Bonded &amp; Insured TN #406 &bull; (615) 625-8000
  </div>

</div>

<!-- Script -->
<script is:inline>
  (function () {
    const formStartedAt = Math.floor(Date.now() / 1000);
    let step = 1;

    const s1 = document.getElementById('step-1');
    const s2 = document.getElementById('step-2');
    const s3 = document.getElementById('step-3');
    const success = document.getElementById('step-success');
    const form = document.getElementById('booking-form');

    const node1 = document.getElementById('node-1');
    const node2 = document.getElementById('node-2');
    const node3 = document.getElementById('node-3');

    const label1 = document.getElementById('label-1');
    const label2 = document.getElementById('label-2');
    const label3 = document.getElementById('label-3');

    const track = document.getElementById('step-track');

    const serviceInput = document.getElementById('field-service');
    const dateInput = document.getElementById('field-date');
    const timeInput = document.getElementById('field-time');

    const selectedServiceTag = document.getElementById('wkz-selected-service');
    const summaryTag = document.getElementById('wkz-summary');

    const serviceItems = document.querySelectorAll('.service-item');
    const dateChips = document.querySelectorAll('.date-chip');
    const timeChips = document.querySelectorAll('.time-chip');

    const btnTo3 = document.getElementById('btn-to-3');
    const backBtns = document.querySelectorAll('.btn-back');
    const submitBtn = document.getElementById('btn-submit');
    const apiError = document.getElementById('api-error');

    const nameIn = document.getElementById('cust_name');
    const phoneIn = document.getElementById('cust_phone');
    const errName = document.getElementById('err-name');
    const errPhone = document.getElementById('err-phone');
    const honeypot = document.getElementById('company_website');

    function updateStepper(n) {
      step = n;
      s1.classList.add('hidden');
      s2.classList.add('hidden');
      s3.classList.add('hidden');
      if (success) success.classList.add('hidden');

      // Reset node styles
      [node1, node2, node3].forEach((node, idx) => {
        node.className = "w-8 h-8 rounded-full border-2 border-slate-300 bg-white text-slate-400 font-bold text-xs flex items-center justify-center transition-all";
        node.textContent = idx + 1;
      });
      [label1, label2, label3].forEach(lbl => {
        lbl.className = "block text-xs font-medium text-slate-400 tracking-tight";
      });

      if (n === 1) {
        s1.classList.remove('hidden');
        if (track) track.style.width = "0%";
        node1.className = "w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all";
        label1.className = "block text-xs font-bold text-slate-900 tracking-tight";
      } else if (n === 2) {
        s2.classList.remove('hidden');
        if (track) track.style.width = "50%";
        
        node1.className = "w-8 h-8 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all";
        node1.textContent = "✓";
        label1.className = "block text-xs font-medium text-slate-600 tracking-tight";

        node2.className = "w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all";
        label2.className = "block text-xs font-bold text-slate-900 tracking-tight";

        if (selectedServiceTag) selectedServiceTag.textContent = serviceInput.value;
      } else if (n === 3) {
        s3.classList.remove('hidden');
        if (track) track.style.width = "100%";

        node1.className = "w-8 h-8 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all";
        node1.textContent = "✓";
        label1.className = "block text-xs font-medium text-slate-600 tracking-tight";

        node2.className = "w-8 h-8 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all";
        node2.textContent = "✓";
        label2.className = "block text-xs font-medium text-slate-600 tracking-tight";

        node3.className = "w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shadow-sm transition-all";
        label3.className = "block text-xs font-bold text-slate-900 tracking-tight";

        if (summaryTag) summaryTag.textContent = `${serviceInput.value} • ${dateInput.value} (${timeInput.value})`;
      } else if (n === 4) {
        form.classList.add('hidden');
        if (success) success.classList.remove('hidden');
        if (track) track.style.width = "100%";
        [node1, node2, node3].forEach(node => {
          node.className = "w-8 h-8 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center shadow-sm";
          node.textContent = "✓";
        });
      }

      window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    // Step 1 Click -> Advances directly to Step 2
    serviceItems.forEach(item => {
      item.addEventListener('click', function () {
        const val = this.getAttribute('data-service');
        if (serviceInput) serviceInput.value = val;
        updateStepper(2);
      });
    });

    // Step 2 Date
    dateChips.forEach(chip => {
      chip.addEventListener('click', function () {
        dateChips.forEach(c => {
          c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-bold');
          c.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'font-medium');
        });
        this.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'font-medium');
        this.classList.add('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-bold');
        if (dateInput) dateInput.value = this.getAttribute('data-date');
      });
    });

    // Step 2 Time
    timeChips.forEach(chip => {
      chip.addEventListener('click', function () {
        timeChips.forEach(c => {
          c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-bold');
          c.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'font-medium');
          const check = c.querySelector('span:last-child');
          if (check) {
            check.classList.remove('bg-blue-600', 'text-white');
            check.classList.add('border', 'border-slate-300', 'text-transparent');
          }
        });
        this.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'font-medium');
        this.classList.add('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-bold');
        const check = this.querySelector('span:last-child');
        if (check) {
          check.classList.remove('border', 'border-slate-300', 'text-transparent');
          check.classList.add('bg-blue-600', 'text-white');
        }
        if (timeInput) timeInput.value = this.getAttribute('data-time');
      });
    });

    // Dynamic Sunday Detection for Priority Monday Dispatch
    try {
      const now = new Date();
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'short'
      }).formatToParts(now);
      const weekday = parts.find(p => p.type === 'weekday')?.value;
      if (weekday === 'Sun') {
        const sundayNotice = document.getElementById('booking-sunday-notice');
        if (sundayNotice) sundayNotice.classList.remove('hidden');

        // Dynamically customize Tomorrow chip to Monday Priority
        const tomorrowChip = document.querySelector('.date-chip[data-date="Tomorrow"]');
        if (tomorrowChip) {
          tomorrowChip.innerHTML = '<span>Tomorrow (Monday) ⭐</span>';
          dateChips.forEach(c => {
            c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-bold');
            c.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'font-medium');
          });
          tomorrowChip.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'font-medium');
          tomorrowChip.classList.add('border-2', 'border-blue-600', 'bg-blue-50', 'text-blue-900', 'font-bold');
          if (dateInput) dateInput.value = 'Tomorrow (Monday 8AM Priority)';
        }

        // Recommend Morning Window
        const morningChip = document.querySelector('.time-chip[data-time="Morning (8:00 AM – 12:00 PM)"]');
        if (morningChip) {
          const subtext = morningChip.querySelector('div div:last-child');
          if (subtext) subtext.textContent = '8:00 AM – 12:00 PM (Monday Priority)';
        }
      }
    } catch (e) {}

    if (btnTo3) btnTo3.addEventListener('click', () => updateStepper(3));
    backBtns.forEach(b => b.addEventListener('click', () => {
      if (step > 1) updateStepper(step - 1);
    }));

    if (nameIn && errName) {
      nameIn.addEventListener('input', () => {
        errName.classList.add('hidden');
        nameIn.classList.remove('border-red-500');
      });
    }
    if (phoneIn && errPhone) {
      phoneIn.addEventListener('input', () => {
        errPhone.classList.add('hidden');
        phoneIn.classList.remove('border-red-500');
      });
    }

    // Submit
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (apiError) apiError.classList.add('hidden');

        let hasError = false;
        const name = nameIn ? nameIn.value.trim() : '';
        const phone = phoneIn ? phoneIn.value.trim() : '';
        const bot = honeypot ? honeypot.value.trim() : '';

        if (!name) {
          if (errName) errName.classList.remove('hidden');
          if (nameIn) nameIn.classList.add('border-red-500');
          hasError = true;
        }
        if (!phone || phone.length < 7) {
          if (errPhone) errPhone.classList.remove('hidden');
          if (phoneIn) phoneIn.classList.add('border-red-500');
          hasError = true;
        }

        if (hasError) return;
        if (bot !== '') {
          updateStepper(4);
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        const s = serviceInput ? serviceInput.value : 'Locksmith';
        const d = dateInput ? dateInput.value : 'Today';
        const t = timeInput ? timeInput.value : 'ASAP';
        const addr = document.getElementById('cust_address')?.value || '';
        const notes = document.getElementById('cust_notes')?.value || '';

        const fullService = `${s} [${d} • ${t}]`;
        const detailsStr = [addr ? `Address: ${addr}` : '', notes ? `Notes: ${notes}` : ''].filter(Boolean).join(' | ');

        const safeFormStartedAt = Math.min(formStartedAt, Math.floor(Date.now() / 1000) - 8);

        const payload = {
          customer_name: name,
          phone: phone,
          service: fullService,
          service_type: s,
          vehicle: detailsStr || 'Website Booking',
          form_started_at: safeFormStartedAt,
          company_website: ''
        };

        async function tryFallback() {
          try {
            const fb = await fetch('/api/contact.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: name,
                phone: phone,
                service: fullService,
                details: detailsStr || 'Website Booking',
                notes: 'Online Booking Request'
              })
            });
            if (fb.ok) {
              updateStepper(4);
              return true;
            }
          } catch (e) {
            console.error('Fallback booking error:', e);
          }
          return false;
        }

        try {
          const res = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            updateStepper(4);
          } else {
            const fbOk = await tryFallback();
            if (fbOk) return;

            const data = await res.json().catch(() => ({}));
            if (res.status === 422 && data.errors) {
              if (data.errors.customer_name && errName) {
                errName.textContent = data.errors.customer_name[0];
                errName.classList.remove('hidden');
              }
              if (data.errors.phone && errPhone) {
                errPhone.textContent = data.errors.phone[0];
                errPhone.classList.remove('hidden');
              }
            }
            if (apiError) apiError.classList.remove('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Book Appointment';
            }
          }
        } catch (err) {
          console.error('Booking error, trying fallback:', err);
          const fbOk = await tryFallback();
          if (fbOk) return;

          if (apiError) apiError.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Book Appointment';
          }
        }
      });
    }
  })();
</script>
