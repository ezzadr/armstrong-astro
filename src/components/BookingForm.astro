---
// BookingForm.astro - Exact Workiz Online Booking System Clone
---

<div class="w-full max-w-2xl mx-auto bg-white rounded-lg border border-[#e5e7eb] shadow-sm font-sans text-left overflow-hidden">
  
  <!-- ==================== WORKIZ HEADER ==================== -->
  <div class="px-6 py-5 border-b border-[#e5e7eb] flex items-center justify-between bg-white">
    <div>
      <h1 class="text-base font-bold text-[#111827]">Armstrong Locksmith Inc.</h1>
      <p id="wkz-step-caption" class="text-xs text-[#6b7280] mt-0.5">Step 1 of 3: Select a service</p>
    </div>
    <a 
      href="tel:6156258000" 
      class="text-xs font-semibold text-[#2563eb] hover:text-[#1d4ed8] transition"
    >
      (615) 625-8000
    </a>
  </div>

  <!-- Workiz Progress Bar -->
  <div class="w-full bg-[#f3f4f6] h-1.5">
    <div id="wkz-progress" class="bg-[#2563eb] h-1.5 w-1/3 transition-all duration-300"></div>
  </div>

  <!-- ==================== WORKIZ FORM ==================== -->
  <form id="booking-form" class="p-6 sm:p-8" novalidate>
    <!-- Hidden Form Fields & Honeypot -->
    <input type="hidden" id="field-service" name="service" value="Car Key Replacement" />
    <input type="hidden" id="field-date" name="booking_date" value="Today" />
    <input type="hidden" id="field-time" name="booking_time" value="ASAP" />
    
    <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
      <label for="company_website">Company Website</label>
      <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" value="" />
    </div>

    <!-- ==================== STEP 1: WORKIZ SERVICE LIST ==================== -->
    <div id="step-1" class="step-pane space-y-2.5">
      <div class="text-xs font-medium text-[#6b7280] mb-3">Please choose the service you need:</div>

      <!-- Service 1 -->
      <button 
        type="button" 
        class="service-item w-full p-4 border border-[#e5e7eb] rounded-lg hover:border-[#2563eb] hover:bg-[#f8fafc] flex items-center justify-between transition cursor-pointer text-left group" 
        data-service="Car Key Replacement"
      >
        <div>
          <div class="text-sm font-semibold text-[#111827] group-hover:text-[#2563eb]">Car Key Replacement</div>
          <div class="text-xs text-[#6b7280] mt-0.5">Key cutting, key fob programming, smart &amp; transponder keys</div>
        </div>
        <svg class="w-5 h-5 text-[#9ca3af] group-hover:text-[#2563eb] transition-transform group-hover:translate-x-0.5 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Service 2 -->
      <button 
        type="button" 
        class="service-item w-full p-4 border border-[#e5e7eb] rounded-lg hover:border-[#2563eb] hover:bg-[#f8fafc] flex items-center justify-between transition cursor-pointer text-left group" 
        data-service="European Car Key Specialist"
      >
        <div>
          <div class="text-sm font-semibold text-[#111827] group-hover:text-[#2563eb]">European Car Key Specialist</div>
          <div class="text-xs text-[#6b7280] mt-0.5">BMW, Mercedes-Benz, Audi, Land Rover &amp; Porsche key programming</div>
        </div>
        <svg class="w-5 h-5 text-[#9ca3af] group-hover:text-[#2563eb] transition-transform group-hover:translate-x-0.5 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Service 3 -->
      <button 
        type="button" 
        class="service-item w-full p-4 border border-[#e5e7eb] rounded-lg hover:border-[#2563eb] hover:bg-[#f8fafc] flex items-center justify-between transition cursor-pointer text-left group" 
        data-service="Emergency Lockout"
      >
        <div>
          <div class="text-sm font-semibold text-[#111827] group-hover:text-[#2563eb]">Emergency Lockout (Car / House / Business)</div>
          <div class="text-xs text-[#6b7280] mt-0.5">Locked keys inside vehicle, home, apartment, or commercial storefront</div>
        </div>
        <svg class="w-5 h-5 text-[#9ca3af] group-hover:text-[#2563eb] transition-transform group-hover:translate-x-0.5 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Service 4 -->
      <button 
        type="button" 
        class="service-item w-full p-4 border border-[#e5e7eb] rounded-lg hover:border-[#2563eb] hover:bg-[#f8fafc] flex items-center justify-between transition cursor-pointer text-left group" 
        data-service="Residential House Rekey & Locks"
      >
        <div>
          <div class="text-sm font-semibold text-[#111827] group-hover:text-[#2563eb]">Residential Rekey &amp; Locks</div>
          <div class="text-xs text-[#6b7280] mt-0.5">Change locks, rekey existing deadbolts, install smart keypads</div>
        </div>
        <svg class="w-5 h-5 text-[#9ca3af] group-hover:text-[#2563eb] transition-transform group-hover:translate-x-0.5 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Service 5 -->
      <button 
        type="button" 
        class="service-item w-full p-4 border border-[#e5e7eb] rounded-lg hover:border-[#2563eb] hover:bg-[#f8fafc] flex items-center justify-between transition cursor-pointer text-left group" 
        data-service="Commercial Storefront & Door Hardware"
      >
        <div>
          <div class="text-sm font-semibold text-[#111827] group-hover:text-[#2563eb]">Commercial &amp; Storefront Locks</div>
          <div class="text-xs text-[#6b7280] mt-0.5">Commercial door hardware, panic exit bars, master key systems, Adams Rite</div>
        </div>
        <svg class="w-5 h-5 text-[#9ca3af] group-hover:text-[#2563eb] transition-transform group-hover:translate-x-0.5 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Service 6 -->
      <button 
        type="button" 
        class="service-item w-full p-4 border border-[#e5e7eb] rounded-lg hover:border-[#2563eb] hover:bg-[#f8fafc] flex items-center justify-between transition cursor-pointer text-left group" 
        data-service="Other Locksmith Service"
      >
        <div>
          <div class="text-sm font-semibold text-[#111827] group-hover:text-[#2563eb]">Other Locksmith Service</div>
          <div class="text-xs text-[#6b7280] mt-0.5">Broken key extraction, mailbox locks, safe opening &amp; consultations</div>
        </div>
        <svg class="w-5 h-5 text-[#9ca3af] group-hover:text-[#2563eb] transition-transform group-hover:translate-x-0.5 shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- ==================== STEP 2: WORKIZ DATE & TIME ==================== -->
    <div id="step-2" class="step-pane hidden space-y-6">
      
      <!-- Selected Service Info -->
      <div class="flex items-center justify-between p-3.5 bg-[#f9fafb] border border-[#e5e7eb] rounded-lg">
        <div class="text-xs">
          <span class="text-[#6b7280]">Service:</span>
          <strong id="wkz-selected-service" class="text-[#111827] ml-1 font-semibold">Car Key Replacement</strong>
        </div>
        <button type="button" class="btn-back text-xs font-semibold text-[#2563eb] hover:underline cursor-pointer">
          Change
        </button>
      </div>

      <!-- Date Options -->
      <div class="space-y-2">
        <label class="block text-xs font-semibold text-[#374151]">When do you need service?</label>
        <div class="grid grid-cols-3 gap-2.5">
          <button 
            type="button" 
            class="date-chip p-3 border-2 border-[#2563eb] bg-[#eff6ff] text-[#1e40af] rounded-lg text-xs font-semibold text-center transition cursor-pointer" 
            data-date="Today"
          >
            Today
          </button>
          <button 
            type="button" 
            class="date-chip p-3 border border-[#e5e7eb] bg-white text-[#374151] rounded-lg text-xs font-medium text-center hover:bg-[#f9fafb] transition cursor-pointer" 
            data-date="Tomorrow"
          >
            Tomorrow
          </button>
          <button 
            type="button" 
            class="date-chip p-3 border border-[#e5e7eb] bg-white text-[#374151] rounded-lg text-xs font-medium text-center hover:bg-[#f9fafb] transition cursor-pointer" 
            data-date="Custom Date"
          >
            Custom Date
          </button>
        </div>
      </div>

      <!-- Time Window Options -->
      <div class="space-y-2">
        <label class="block text-xs font-semibold text-[#374151]">Select an arrival window:</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          
          <button 
            type="button" 
            class="time-chip p-3.5 border-2 border-[#2563eb] bg-[#eff6ff] text-[#1e40af] rounded-lg text-xs font-semibold text-left transition cursor-pointer flex items-center justify-between" 
            data-time="ASAP Immediate Dispatch"
          >
            <div>
              <div class="font-semibold">ASAP Dispatch</div>
              <div class="text-[11px] text-[#3b82f6] font-normal">Nearest mobile unit</div>
            </div>
            <span class="w-4 h-4 rounded-full bg-[#2563eb] text-white flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 border border-[#e5e7eb] bg-white text-[#374151] rounded-lg text-xs font-medium text-left hover:bg-[#f9fafb] transition cursor-pointer flex items-center justify-between" 
            data-time="Morning (8:00 AM – 12:00 PM)"
          >
            <div>
              <div class="font-semibold text-[#111827]">Morning Window</div>
              <div class="text-[11px] text-[#6b7280] font-normal">8:00 AM – 12:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-[#d1d5db] text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 border border-[#e5e7eb] bg-white text-[#374151] rounded-lg text-xs font-medium text-left hover:bg-[#f9fafb] transition cursor-pointer flex items-center justify-between" 
            data-time="Afternoon (12:00 PM – 4:00 PM)"
          >
            <div>
              <div class="font-semibold text-[#111827]">Afternoon Window</div>
              <div class="text-[11px] text-[#6b7280] font-normal">12:00 PM – 4:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-[#d1d5db] text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

          <button 
            type="button" 
            class="time-chip p-3.5 border border-[#e5e7eb] bg-white text-[#374151] rounded-lg text-xs font-medium text-left hover:bg-[#f9fafb] transition cursor-pointer flex items-center justify-between" 
            data-time="Evening (4:00 PM – 8:00 PM)"
          >
            <div>
              <div class="font-semibold text-[#111827]">Evening Window</div>
              <div class="text-[11px] text-[#6b7280] font-normal">4:00 PM – 8:00 PM</div>
            </div>
            <span class="w-4 h-4 rounded-full border border-[#d1d5db] text-transparent flex items-center justify-center text-[10px]">✓</span>
          </button>

        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="pt-4 border-t border-[#e5e7eb] flex items-center justify-between">
        <button type="button" class="btn-back px-4 py-2 text-xs font-medium text-[#6b7280] hover:text-[#111827] cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="button" 
          id="btn-to-3" 
          class="px-6 py-2.5 bg-[#2563eb] hover:bg-[#1d4ed8] text-white rounded-lg text-xs font-semibold shadow-sm transition cursor-pointer"
        >
          Next Step &rarr;
        </button>
      </div>

    </div>

    <!-- ==================== STEP 3: WORKIZ CONTACT & DETAILS ==================== -->
    <div id="step-3" class="step-pane hidden space-y-4">
      
      <!-- Summary Line -->
      <div class="p-3 bg-[#f9fafb] border border-[#e5e7eb] rounded-lg text-xs flex items-center justify-between">
        <div>
          <span class="text-[#6b7280]">Appointment:</span>
          <strong id="wkz-summary" class="text-[#111827] ml-1 font-semibold">Car Key Replacement &bull; Today (ASAP)</strong>
        </div>
        <button type="button" class="btn-back text-xs font-semibold text-[#2563eb] hover:underline cursor-pointer">
          Edit
        </button>
      </div>

      <!-- Inputs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <div>
          <label for="cust_name" class="block text-xs font-medium text-[#374151] mb-1">Full Name *</label>
          <input 
            type="text" 
            id="cust_name" 
            name="customer_name" 
            required 
            placeholder="John Smith" 
            class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#d1d5db] rounded-lg focus:border-[#2563eb] focus:ring-1 focus:ring-[#2563eb] focus:outline-none transition" 
          />
          <span id="err-name" class="hidden text-[11px] text-[#dc2626] font-medium mt-1 block">Please enter your name.</span>
        </div>

        <div>
          <label for="cust_phone" class="block text-xs font-medium text-[#374151] mb-1">Phone Number *</label>
          <input 
            type="tel" 
            id="cust_phone" 
            name="phone" 
            required 
            placeholder="(615) 000-0000" 
            class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#d1d5db] rounded-lg focus:border-[#2563eb] focus:ring-1 focus:ring-[#2563eb] focus:outline-none transition" 
          />
          <span id="err-phone" class="hidden text-[11px] text-[#dc2626] font-medium mt-1 block">Please enter your phone number.</span>
        </div>
      </div>

      <div>
        <label for="cust_address" class="block text-xs font-medium text-[#374151] mb-1">Service Address / Location</label>
        <input 
          type="text" 
          id="cust_address" 
          name="address" 
          placeholder="e.g. 123 Main St, Nashville, TN (or 'Storefront Walk-In')" 
          class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#d1d5db] rounded-lg focus:border-[#2563eb] focus:ring-1 focus:ring-[#2563eb] focus:outline-none transition" 
        />
      </div>

      <div>
        <label for="cust_notes" class="block text-xs font-medium text-[#374151] mb-1">Vehicle Year/Make/Model or Job Details (Optional)</label>
        <input 
          type="text" 
          id="cust_notes" 
          name="details" 
          placeholder="e.g. 2021 BMW X5 all keys lost, or 3 house locks" 
          class="w-full px-3.5 py-2.5 text-sm bg-white border border-[#d1d5db] rounded-lg focus:border-[#2563eb] focus:ring-1 focus:ring-[#2563eb] focus:outline-none transition" 
        />
      </div>

      <!-- Server Error Alert -->
      <div id="api-error" class="hidden p-3 bg-[#fef2f2] border border-[#fecaca] text-[#991b1b] text-xs rounded-lg text-center font-medium">
        We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-bold">615-625-8000</a>.
      </div>

      <!-- Workiz Submit Button -->
      <div class="pt-4 border-t border-[#e5e7eb] flex items-center justify-between">
        <button type="button" class="btn-back px-4 py-2 text-xs font-medium text-[#6b7280] hover:text-[#111827] cursor-pointer">
          &larr; Back
        </button>
        <button 
          type="submit" 
          id="btn-submit" 
          class="px-7 py-3 bg-[#2563eb] hover:bg-[#1d4ed8] text-white rounded-lg text-xs font-semibold shadow-sm transition cursor-pointer disabled:opacity-50"
        >
          Book Appointment
        </button>
      </div>

    </div>

  </form>

  <!-- ==================== WORKIZ SUCCESS CONFIRMATION ==================== -->
  <div id="step-success" class="hidden p-8 sm:p-12 text-center space-y-3 bg-white">
    <div class="w-12 h-12 bg-[#ecfdf5] text-[#059669] rounded-full flex items-center justify-center text-2xl font-bold mx-auto">
      ✓
    </div>
    <h2 class="text-base sm:text-lg font-bold text-[#111827]">
      Thank you! Your request was sent to Armstrong Locksmith.
    </h2>
    <p class="text-xs text-[#6b7280] max-w-sm mx-auto leading-relaxed">
      Our dispatch team will review your appointment request and contact you shortly with confirmation.
    </p>
    <div class="pt-2">
      <a href="tel:6156258000" class="text-xs font-semibold text-[#2563eb] hover:underline">
        Need immediate dispatch? Call (615) 625-8000
      </a>
    </div>
  </div>

  <!-- Workiz Footer -->
  <div class="px-6 py-3 bg-[#f9fafb] border-t border-[#e5e7eb] text-center text-[11px] text-[#9ca3af]">
    Secured by Armstrong Locksmith Inc. &bull; TN License #406 &bull; (615) 625-8000
  </div>

</div>

<!-- Script -->
<script is:inline>
  (function () {
    const formStartedAt = Math.floor(Date.now() / 1000);
    let step = 1;

    const s1 = document.getElementById('step-1');
    const s2 = document.getElementById('step-2');
    const s3 = document.getElementById('step-3');
    const success = document.getElementById('step-success');
    const form = document.getElementById('booking-form');

    const caption = document.getElementById('wkz-step-caption');
    const progressBar = document.getElementById('wkz-progress');

    const serviceInput = document.getElementById('field-service');
    const dateInput = document.getElementById('field-date');
    const timeInput = document.getElementById('field-time');

    const selectedServiceTag = document.getElementById('wkz-selected-service');
    const summaryTag = document.getElementById('wkz-summary');

    const serviceItems = document.querySelectorAll('.service-item');
    const dateChips = document.querySelectorAll('.date-chip');
    const timeChips = document.querySelectorAll('.time-chip');

    const btnTo3 = document.getElementById('btn-to-3');
    const backBtns = document.querySelectorAll('.btn-back');
    const submitBtn = document.getElementById('btn-submit');
    const apiError = document.getElementById('api-error');

    const nameIn = document.getElementById('cust_name');
    const phoneIn = document.getElementById('cust_phone');
    const errName = document.getElementById('err-name');
    const errPhone = document.getElementById('err-phone');
    const honeypot = document.getElementById('company_website');

    function goTo(n) {
      step = n;
      s1.classList.add('hidden');
      s2.classList.add('hidden');
      s3.classList.add('hidden');
      if (success) success.classList.add('hidden');

      if (n === 1) {
        s1.classList.remove('hidden');
        if (caption) caption.textContent = "Step 1 of 3: Select a service";
        if (progressBar) progressBar.style.width = "33%";
      } else if (n === 2) {
        s2.classList.remove('hidden');
        if (caption) caption.textContent = "Step 2 of 3: Select date & time";
        if (progressBar) progressBar.style.width = "66%";
        if (selectedServiceTag) selectedServiceTag.textContent = serviceInput.value;
      } else if (n === 3) {
        s3.classList.remove('hidden');
        if (caption) caption.textContent = "Step 3 of 3: Your information";
        if (progressBar) progressBar.style.width = "100%";
        if (summaryTag) summaryTag.textContent = `${serviceInput.value} • ${dateInput.value} (${timeInput.value})`;
      } else if (n === 4) {
        form.classList.add('hidden');
        if (success) success.classList.remove('hidden');
        if (caption) caption.textContent = "Appointment Request Submitted";
        if (progressBar) progressBar.style.width = "100%";
      }

      window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    // Step 1 Click -> Advances directly to Step 2
    serviceItems.forEach(item => {
      item.addEventListener('click', function () {
        const val = this.getAttribute('data-service');
        if (serviceInput) serviceInput.value = val;
        goTo(2);
      });
    });

    // Step 2 Date
    dateChips.forEach(chip => {
      chip.addEventListener('click', function () {
        dateChips.forEach(c => {
          c.classList.remove('border-2', 'border-[#2563eb]', 'bg-[#eff6ff]', 'text-[#1e40af]', 'font-semibold');
          c.classList.add('border', 'border-[#e5e7eb]', 'bg-white', 'text-[#374151]', 'font-medium');
        });
        this.classList.remove('border', 'border-[#e5e7eb]', 'bg-white', 'text-[#374151]', 'font-medium');
        this.classList.add('border-2', 'border-[#2563eb]', 'bg-[#eff6ff]', 'text-[#1e40af]', 'font-semibold');
        if (dateInput) dateInput.value = this.getAttribute('data-date');
      });
    });

    // Step 2 Time
    timeChips.forEach(chip => {
      chip.addEventListener('click', function () {
        timeChips.forEach(c => {
          c.classList.remove('border-2', 'border-[#2563eb]', 'bg-[#eff6ff]', 'text-[#1e40af]', 'font-semibold');
          c.classList.add('border', 'border-[#e5e7eb]', 'bg-white', 'text-[#374151]', 'font-medium');
          const check = c.querySelector('span:last-child');
          if (check) {
            check.classList.remove('bg-[#2563eb]', 'text-white');
            check.classList.add('border', 'border-[#d1d5db]', 'text-transparent');
          }
        });
        this.classList.remove('border', 'border-[#e5e7eb]', 'bg-white', 'text-[#374151]', 'font-medium');
        this.classList.add('border-2', 'border-[#2563eb]', 'bg-[#eff6ff]', 'text-[#1e40af]', 'font-semibold');
        const check = this.querySelector('span:last-child');
        if (check) {
          check.classList.remove('border', 'border-[#d1d5db]', 'text-transparent');
          check.classList.add('bg-[#2563eb]', 'text-white');
        }
        if (timeInput) timeInput.value = this.getAttribute('data-time');
      });
    });

    if (btnTo3) btnTo3.addEventListener('click', () => goTo(3));
    backBtns.forEach(b => b.addEventListener('click', () => {
      if (step > 1) goTo(step - 1);
    }));

    if (nameIn && errName) {
      nameIn.addEventListener('input', () => {
        errName.classList.add('hidden');
        nameIn.classList.remove('border-[#dc2626]');
      });
    }
    if (phoneIn && errPhone) {
      phoneIn.addEventListener('input', () => {
        errPhone.classList.add('hidden');
        phoneIn.classList.remove('border-[#dc2626]');
      });
    }

    // Submit
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (apiError) apiError.classList.add('hidden');

        let hasError = false;
        const name = nameIn ? nameIn.value.trim() : '';
        const phone = phoneIn ? phoneIn.value.trim() : '';
        const bot = honeypot ? honeypot.value.trim() : '';

        if (!name) {
          if (errName) errName.classList.remove('hidden');
          if (nameIn) nameIn.classList.add('border-[#dc2626]');
          hasError = true;
        }
        if (!phone || phone.length < 7) {
          if (errPhone) errPhone.classList.remove('hidden');
          if (phoneIn) phoneIn.classList.add('border-[#dc2626]');
          hasError = true;
        }

        if (hasError) return;
        if (bot !== '') {
          goTo(4);
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        const s = serviceInput ? serviceInput.value : 'Locksmith';
        const d = dateInput ? dateInput.value : 'Today';
        const t = timeInput ? timeInput.value : 'ASAP';
        const addr = document.getElementById('cust_address')?.value || '';
        const notes = document.getElementById('cust_notes')?.value || '';

        const fullService = `${s} [${d} • ${t}]`;
        const detailsStr = [addr ? `Address: ${addr}` : '', notes ? `Notes: ${notes}` : ''].filter(Boolean).join(' | ');

        const payload = {
          customer_name: name,
          phone: phone,
          service: fullService,
          service_type: s,
          vehicle: detailsStr || 'Website Booking',
          form_started_at: formStartedAt,
          company_website: ''
        };

        try {
          const res = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            goTo(4);
          } else {
            const data = await res.json().catch(() => ({}));
            if (res.status === 422 && data.errors) {
              if (data.errors.customer_name && errName) {
                errName.textContent = data.errors.customer_name[0];
                errName.classList.remove('hidden');
              }
              if (data.errors.phone && errPhone) {
                errPhone.textContent = data.errors.phone[0];
                errPhone.classList.remove('hidden');
              }
            }
            if (apiError) apiError.classList.remove('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Book Appointment';
            }
          }
        } catch (err) {
          console.error(err);
          if (apiError) apiError.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Book Appointment';
          }
        }
      });
    }
  })();
</script>
