---
// BackToTop.astro - Luxury Showroom Zero-Curve Back To Top Button
---

<button
  id="arm-back-to-top"
  type="button"
  aria-label="Back to top of page"
  class="fixed right-4 sm:right-6 md:right-8 bottom-18 md:bottom-8 z-40 opacity-0 pointer-events-none translate-y-4 scale-95 transition-all duration-300 ease-out bg-[#07152b] border border-amber-500/50 hover:border-amber-400 text-amber-400 hover:text-white shadow-2xl hover:bg-slate-900 group cursor-pointer flex items-center gap-1.5 px-3 py-2.5 active:scale-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
>
  <!-- Sleek Upward Arrow -->
  <svg 
    class="w-4 h-4 text-amber-400 group-hover:text-amber-300 group-hover:-translate-y-0.5 transition-transform duration-200 shrink-0" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2.5" 
    stroke-linecap="square" 
    stroke-linejoin="miter"
  >
    <path d="M18 15l-6-6-6 6"/>
  </svg>
  <span class="text-[10px] font-black uppercase tracking-widest text-amber-400/90 group-hover:text-white transition-colors select-none">
    TOP
  </span>
</button>

<script is:inline>
  (function () {
    const btn = document.getElementById('arm-back-to-top');
    if (!btn) return;

    let ticking = false;
    const scrollThreshold = 350;

    function handleScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > scrollThreshold) {
            btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4', 'scale-95');
            btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
          } else {
            btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
            btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4', 'scale-95');
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    // Passive scroll listener for 0ms main-thread blocking
    window.addEventListener('scroll', handleScroll, { passive: true });

    // Smooth scroll to top on click
    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    // Initial check in case page loaded mid-scroll
    handleScroll();
  })();
</script>
