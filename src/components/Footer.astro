---
// Footer.astro - Clean, Spacious, Organized Modern Footer (Sharp Industrial Edges)
---

<footer class="bg-[#0b172a] text-slate-300 pt-16 pb-24 md:pb-12 border-t-2 border-amber-500 font-sans" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-slate-800">
      
      <!-- Col 1: Shop Photo & Storefront Identity (Span 4) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        
        <!-- Clean Brand Logo -->
        <a href="/" class="flex flex-col group w-fit" aria-label="Armstrong Locksmith Home">
          <div class="flex items-center gap-1.5">
            <span class="text-2xl font-black tracking-tight text-white font-serif uppercase leading-none">
              ARMSTRONG
            </span>
            <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 bg-gold-metallic text-slate-950 font-sans tracking-wider leading-none">
              LOCKSMITH
            </span>
          </div>
          <span class="text-[10px] text-slate-400 font-bold tracking-wider uppercase mt-1">
            Storefront &bull; Auto &bull; Home &bull; Business
          </span>
        </a>

        <!-- Storefront Photo Card -->
        <div class="overflow-hidden border border-slate-700 shadow-md">
          <div class="relative group">
            <picture>
              <source type="image/webp" srcset="/shop-600.webp 600w, /shop-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 400px" />
              <img 
              src="/shop.jpeg" 
              alt="Armstrong Locksmith Nashville Storefront 208 Thompson Lane" 
              class="w-full h-auto"
              width="400"
              height="144"
              loading="lazy"
              />
            </picture>
            <div class="absolute inset-0 bg-slate-900/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
              <a href="https://g.page/r/CQS5BtikwbmqEBM" target="_blank" rel="noopener noreferrer" class="pointer-events-auto bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-[10px] uppercase tracking-widest px-4 py-2.5 rounded shadow-lg flex items-center gap-2 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/></svg>
                Get Directions
              </a>
            </div>
          </div>
          <div class="p-3 bg-slate-900 text-xs flex flex-col gap-1 border-t border-slate-800">
            <div class="text-slate-200 font-medium">📍 208 Thompson Ln, Nashville, TN 37211</div>
            <div class="flex items-center justify-between text-slate-400 pt-0.5">
              <span>📞 <a href="tel:6156258000" class="text-white font-bold hover:text-amber-400 transition">(615) 625-8000</a></span>
              <span class="text-amber-400 font-semibold">Certified &amp; Insured</span>
            </div>
            <div class="text-slate-400 pt-0.5">
              <span>✉️ <a href="mailto:locksmith@armstronglocksmithinc.com" class="text-slate-300 hover:text-amber-400 transition font-medium">locksmith@armstronglocksmithinc.com</a></span>
            </div>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed font-normal">
          Locally owned & operated locksmith serving Davidson & Williamson County with on-site automotive key cutting and physical shop services.
        </p>
      </div>

      <!-- Col 2: Automotive Locksmith (Span 3) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <p class="text-white font-bold text-xs sm:text-sm tracking-wider uppercase flex items-center gap-1.5">
          <span>Car Key Services</span>
        </p>
        
        <div class="bg-slate-900/80 p-3 border border-slate-800 shadow-sm flex flex-col gap-1 text-xs">
          <a href="/car-key-replacement-nashville/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 4a5.5 5.5 0 0 0-5.5 5.5c0 2.61 1.83 4.8 4.3 5.35L4 17.15V20h3v-2h2v-2h1.15l1.3-1.3A5.5 5.5 0 1 0 7.5 4Zm0 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z"/></svg>
            <span>Car Key Replacement</span>
          </a>
          <a href="/european-car-key-specialist/" class="py-1.5 px-2 text-amber-300 font-semibold bg-amber-500/10 border border-amber-500/20 hover:bg-amber-500/20 hover:text-white transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-300 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99ZM6.85 7h10.29l1.04 3H5.81l1.04-3ZM19 17H5v-4.66l.12-.34h13.77l.11.34V17Zm-11.5-2c.83 0 1.5-.67 1.5-1.5S8.33 12 7.5 12 6 12.67 6 13.5 6.67 15 7.5 15Zm9 0c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5Z"/></svg>
            <span>European Keys (BMW/Audi/Benz)</span>
          </a>
          <a href="/key-fob-replacement-nashville/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 2v11h2v9l7-12h-4l3-8H7Z"/></svg>
            <span>Key Fob Programming & Cut</span>
          </a>
          <a href="/dealer-key/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58ZM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5Z"/></svg>
            <span>OEM Dealer Key Alternative</span>
          </a>
          <a href="/emergency-car-lockout/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z"/></svg>
            <span>Emergency Car Lockout</span>
          </a>
        </div>
      </div>

      <!-- Col 3: Residential & Commercial (Span 2) -->
      <div class="lg:col-span-2 flex flex-col gap-3">
        <p class="text-white font-bold text-xs sm:text-sm tracking-wider uppercase flex items-center gap-1.5">
          <span>Locks & Hardware</span>
        </p>
        
        <div class="bg-slate-900/80 p-3 border border-slate-800 shadow-sm flex flex-col gap-1 text-xs">
          <a href="/residential-locksmith-nashville/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
            <span>Residential Rekeying</span>
          </a>
          <a href="/commercial-locksmith/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 7V3H2v18h20V7H12ZM6 19H4v-2h2v2Zm0-4H4v-2h2v2Zm0-4H4V9h2v2Zm0-4H4V5h2v2Zm4 12H8v-2h2v2Zm0-4H8v-2h2v2Zm0-4H8V9h2v2Zm0-4H8V5h2v2Zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10Zm-2-8h-2v2h2V11Zm0 4h-2v2h2v-2Z"/></svg>
            <span>Commercial Storefronts</span>
          </a>
          <a href="/locksmith-pricing-nashville/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4Z"/></svg>
            <span>Upfront Price Guide</span>
          </a>
          <a href="/service-areas/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/></svg>
            <span>Nashville Service Areas</span>
          </a>
          <a href="/about-us/" class="py-1.5 px-2 text-slate-300 hover:text-white hover:bg-slate-800/70 transition-all flex items-center gap-2.5 group">
            <svg class="w-3.5 h-3.5 text-amber-400 shrink-0 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4Zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4Z"/></svg>
            <span>About Us (Rahim)</span>
          </a>
        </div>
      </div>

      <!-- Col 4: Store & Mobile Hours (Span 3) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <p class="text-white font-bold text-xs sm:text-sm tracking-wider uppercase">
          Service Hours
        </p>
        
        <div class="bg-slate-900/80 p-3.5 border border-slate-800 flex flex-col gap-2.5 text-xs">
          <!-- Storefront -->
          <div class="border-b border-slate-800 pb-2">
            <div class="text-[11px] font-bold text-amber-400 uppercase tracking-wider mb-1">🏪 Walk-In Storefront</div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Mon – Fri:</span>
              <span class="text-white font-bold">8:00 AM – 6:00 PM</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Saturday:</span>
              <span class="text-white font-bold">10:00 AM – 4:00 PM</span>
            </div>
          </div>
          <!-- Mobile Dispatch -->
          <div>
            <div class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider mb-1">🚐 Mobile Van Dispatch</div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Mon – Fri:</span>
              <span class="text-emerald-300 font-bold">8:00 AM – 11:30 PM</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Saturday:</span>
              <span class="text-emerald-300 font-bold">10:00 AM – 4:00 PM</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Sunday:</span>
              <span class="text-emerald-300 font-bold">On-Call Dispatch</span>
            </div>
          </div>
        </div>

        <div class="text-[11px] text-slate-400">
          Drop in at 208 Thompson Ln before 6 PM or call <a href="tel:6156258000" class="font-bold text-amber-400 hover:text-amber-300 underline underline-offset-2">(615) 625-8000</a> for mobile dispatch until 11:30 PM.
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex flex-col gap-2.5 items-center sm:items-start">
        <div>
          &copy; {new Date().getFullYear()} Armstrong Locksmith Inc All Rights Reserved. Certified & Insured.
        </div>
        <div class="flex items-center gap-2 opacity-90 mt-1">
          <svg class="h-6 w-auto drop-shadow-md" viewBox="0 0 32 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="20" rx="3" fill="#1434CB"/><path d="M13.5 13.5l1.8-8.5h2.8l-1.8 8.5h-2.8zm14-8.3c-.4-.1-1.1-.3-1.9-.3-2 0-3.5 1-3.5 2.6 0 1.2 1 1.8 1.8 2.2.8.4 1.1.6 1.1 1 0 .5-.6.8-1.2.8-.8 0-1.3-.2-1.8-.4l-.2-.1-.3 1.6c.4.2 1.2.4 2.1.4 2.2 0 3.7-1 3.7-2.7 0-.9-.6-1.6-1.8-2.2-.7-.3-1.2-.6-1.2-.9 0-.3.4-.7 1.1-.7.7 0 1.2.2 1.5.3l.2.1.2-1.5zm-10.4 6.2c.1-.4.8-2.2.8-2.2.1-.2.1-.3.2-.4h-1.6l-1 2.3-1.2-5.9h-2.9l.1.4 1.8 7.9h2.9s.3-1.7.7-3.4c.1-.3.2-.6.2-1zm5.2-6.3l-2.2 8.5h2.7l2.2-8.5h-2.7z" fill="#fff"/></svg>
          <svg class="h-6 w-auto drop-shadow-md" viewBox="0 0 32 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="20" rx="3" fill="#252525"/><circle cx="11.5" cy="10" r="5.5" fill="#EB001B"/><circle cx="20.5" cy="10" r="5.5" fill="#F79E1B"/><path d="M16 14.3a5.5 5.5 0 010-8.6 5.5 5.5 0 000 8.6z" fill="#FF5F00"/></svg>
          <svg class="h-6 w-auto drop-shadow-md" viewBox="0 0 32 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="20" rx="3" fill="#007BC1"/><path d="M10.8 13.5h1.9l-2.8-7h-2L5 13.5h1.9l.5-1.2h3.5l.6 1.2zM8 8.7l.8 2.1H7.2l.8-2.1zm9.3 2.5h-4.4V6.5h4.2v1.6h-2.5v1.2h2.5v1.6h-2.5v1.2h2.5v1.6zm5.5-7l-1.4 3.4L19.5 6.5h-1.7l2.6 5.8-2.7 5.8h1.7l1.6-3.4 1.5 3.4h1.7l-2.7-5.8 2.7-5.8h-1.7z" fill="#fff"/></svg>
          <svg class="h-6 w-auto drop-shadow-md" viewBox="0 0 32 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="20" rx="3" fill="#000"/><path d="M12.6 8.3c0-.9.5-1.7 1.3-2.1-.5-.7-1.3-1.1-2.2-1.2-.9-.1-1.8.2-2.3.8-.5.5-1.2 1.6-.9 2.8.2 1.1 1 2.3 2 3.8.9 1.2 1.9 2.3 3.3 2.3 1.3 0 1.9-.8 3.4-.8 1.6 0 2.1.8 3.5.8 1.3 0 2.2-1 3-2.2.8-1 1.1-2 1.1-2.1-.1 0-1.9-.7-1.9-2.8 0-1.7 1.4-2.5 1.5-2.6-1.1-1.6-2.8-1.8-3.3-1.8-1.1-.1-2.3.6-2.9.6-.5 0-1.5-.6-2.5-.5zm1.5-3.3c.5-.6.9-1.5.8-2.3-.8.1-1.8.6-2.3 1.2-.5.6-1 1.5-.9 2.4.9.1 1.8-.5 2.4-1.3z" fill="#fff"/></svg>
        </div>
      </div>

      <div class="flex items-center gap-4 flex-wrap text-slate-400">
        <a href="/terms-and-conditions/" class="hover:text-white transition">Terms & Conditions</a>
        <span>&bull;</span>
        <a href="/privacy-policy/" class="hover:text-white transition">Privacy Policy</a>
        <span>&bull;</span>
        <a href="/refund-and-cancellation-policy/" class="hover:text-white transition">Refunds</a>
        <span>&bull;</span>
        <a href="/contact-armstrong-locksmith/" class="hover:text-white transition">Contact</a>
      </div>
    </div>

  </div>

</footer>
