---
// Footer.astro - Clean, Spacious, Organized Modern Footer (Sharp Industrial Edges)
import { getReviewStats } from '../lib/reviewStats.mjs';
// Server-rendered so the count is right before JS runs; .arm-review-count spans are refreshed live by syncReviewCounts() in Header.astro.
const { reviewCount } = await getReviewStats();
---

<footer class="bg-[#0b172a] text-slate-300 pt-16 pb-24 md:pb-12 border-t-2 border-amber-500 font-sans" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-slate-800">
      
      <!-- Col 1: Shop Photo & Storefront Identity (Span 4) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        
        <!-- Clean Brand Logo -->
        <a href="/" class="flex flex-col group w-fit" aria-label="Armstrong Locksmith Home">
          <div class="flex items-center gap-1.5">
            <span class="text-2xl font-black tracking-tight text-white font-serif uppercase leading-none">
              ARMSTRONG
            </span>
            <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 bg-gold-metallic text-slate-950 font-sans tracking-wider leading-none">
              LOCKSMITH
            </span>
          </div>
          <span class="text-[10px] text-slate-400 font-bold tracking-wider uppercase mt-1">
            Storefront &bull; Auto &bull; Home &bull; Business
          </span>
        </a>

        <!-- Storefront Photo Card with Integrated Map Action -->
        <div class="overflow-hidden border border-slate-700/80 rounded-sm bg-slate-900 shadow-md">
          <picture>
            <source type="image/webp" srcset="/shop-600.webp 600w, /shop-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 400px" />
            <img 
              src="/shop.jpeg" 
              alt="Armstrong Locksmith Nashville Storefront 208 Thompson Lane" 
              class="w-full h-auto block"
              width="400"
              height="144"
              loading="lazy"
            />
          </picture>
          
          <div class="p-3.5 flex flex-col gap-2.5">
            <div class="flex items-center justify-between gap-2">
              <div class="text-xs text-slate-200 font-medium">
                <span class="text-amber-400 mr-1">📍</span> 208 Thompson Ln, Nashville
              </div>
              <span class="text-[9px] uppercase font-bold text-amber-400 bg-amber-500/10 border border-amber-500/20 px-1.5 py-0.5 rounded shrink-0">Walk-Ins Welcome</span>
            </div>
            
            <!-- Reliable One-Tap Map Directions Button (Works 100% on Mobile & Desktop) -->
            <a 
              href="https://g.page/r/CQS5BtikwbmqEBM" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-2 px-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider rounded flex items-center justify-center gap-1.5 transition-colors shadow-sm active:scale-[0.99]"
            >
              <svg class="w-3.5 h-3.5 text-slate-950" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/></svg>
              <span>Get Directions (Google Maps)</span>
              <svg class="w-3 h-3 text-slate-950 ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <div class="flex flex-col gap-1.5 pt-2 border-t border-slate-800/80 text-xs text-slate-400">
              <div class="flex items-center justify-between">
                <span>📞 <a href="tel:6156258000" class="text-white font-bold hover:text-amber-400 transition-colors">(615) 625-8000</a></span>
                <a href="/contact-armstrong-locksmith/" class="text-[11px] font-bold text-amber-400 hover:text-amber-300 transition-colors">Send Message &rarr;</a>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] pt-0.5">
                <span>✉️</span>
                <a 
                  href="mailto:locksmith@armstronglocksmithinc.com" 
                  class="text-slate-300 hover:text-amber-400 transition-colors font-medium break-all cursor-pointer"
                  id="footer-email-link"
                  title="Click to email or copy address"
                >locksmith@armstronglocksmithinc.com</a>
              </div>
            </div>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed font-normal">
          Locally owned & operated locksmith serving Davidson & Williamson County with on-site automotive key cutting and physical shop services.
        </p>
      </div>

      <!-- Col 2: Automotive Locksmith (Span 3) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <p class="text-white font-bold text-xs sm:text-sm tracking-wider uppercase border-b border-slate-800 pb-2 flex items-center justify-between">
          <span>Car Key Services</span>
          <span class="text-[10px] text-amber-400 font-semibold tracking-normal normal-case">Mobile + Store</span>
        </p>
        
        <ul class="flex flex-col gap-1.5 text-xs">
          <li>
            <a href="/car-key-replacement-nashville/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Car Key Replacement</span>
            </a>
          </li>
          <li>
            <a href="/european-car-key-specialist/" class="py-1 px-2 text-amber-300 font-semibold bg-amber-500/10 border border-amber-500/20 hover:bg-amber-500/20 hover:text-white transition-all flex items-center gap-2 rounded">
              <span class="text-amber-400 text-xs">★</span>
              <span>European Keys (BMW/Audi/Benz)</span>
            </a>
          </li>
          <li>
            <a href="/key-fob-replacement-nashville/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Key Fob Programming & Cut</span>
            </a>
          </li>
          <li>
            <a href="/dealer-key/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>OEM Dealer Key Alternative</span>
            </a>
          </li>
          <li>
            <a href="/emergency-car-lockout/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Emergency Car Lockout</span>
            </a>
          </li>
          <li>
            <a href="/nashville-car-unlock-service/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Trunk & Vehicle Unlock</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Residential & Commercial (Span 2) -->
      <div class="lg:col-span-2 flex flex-col gap-3">
        <p class="text-white font-bold text-xs sm:text-sm tracking-wider uppercase border-b border-slate-800 pb-2">
          <span>Locks & Keys</span>
        </p>
        
        <ul class="flex flex-col gap-1.5 text-xs">
          <li>
            <a href="/residential-locksmith-nashville/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Residential Rekeying</span>
            </a>
          </li>
          <li>
            <a href="/nashville-rekey-service/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Lock Rekey Service</span>
            </a>
          </li>
          <li>
            <a href="/commercial-locksmith/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Commercial Storefronts</span>
            </a>
          </li>
          <li>
            <a href="/locksmith-pricing-nashville/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Upfront Price Guide</span>
            </a>
          </li>
          <li>
            <a href="/service-areas/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>Nashville Service Areas</span>
            </a>
          </li>
          <li>
            <a href="/about-us/" class="py-1 px-1 text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-2 group">
              <span class="text-amber-500/80 group-hover:translate-x-0.5 transition-transform">›</span>
              <span>About Us (Rahim)</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Store & Mobile Hours + Google Reviews (Span 3) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <p class="text-white font-bold text-xs sm:text-sm tracking-wider uppercase border-b border-slate-800 pb-2">
          <span>Service Hours</span>
        </p>
        
        <div class="bg-slate-900/90 p-3.5 border border-slate-800 rounded-sm flex flex-col gap-2.5 text-xs shadow-xs">
          <!-- Storefront -->
          <div class="border-b border-slate-800/80 pb-2">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">🏪 Walk-In Storefront</span>
              <span class="inline-flex items-center gap-1 text-[9px] font-bold text-slate-400 uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Open
              </span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Mon – Fri:</span>
              <span class="text-white font-bold">8:00 AM – 6:00 PM</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Saturday:</span>
              <span class="text-white font-bold">10:00 AM – 4:00 PM</span>
            </div>
          </div>
          
          <!-- Mobile Dispatch -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">🚐 Mobile Van Dispatch</span>
              <span class="text-[9px] text-emerald-400 font-semibold">Late Night</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Mon – Fri:</span>
              <span class="text-emerald-300 font-bold">8:00 AM – 11:30 PM</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Saturday:</span>
              <span class="text-emerald-300 font-bold">10:00 AM – 4:00 PM</span>
            </div>
            <div class="flex justify-between items-center text-slate-300 text-[11px]">
              <span>Sunday:</span>
              <span class="text-slate-400 font-bold">Closed</span>
            </div>
          </div>
        </div>

        <!-- Google Reviews Trust Badge -->
        <a 
          href="/google-reviews/" 
          class="p-3 bg-slate-900/90 hover:bg-slate-800/90 border border-slate-800 hover:border-amber-500/40 rounded-sm transition-all group flex items-center justify-between shadow-xs"
          aria-label="View our Google reviews"
        >
          <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
              <span class="text-amber-400 text-xs">★★★★★</span>
              <span class="text-white font-bold text-xs">4.9 / 5.0</span>
            </div>
            <span class="text-[10px] text-slate-400"><span class="arm-review-count">{reviewCount}+</span> Verified Google Reviews</span>
          </div>
          <span class="text-xs font-bold text-amber-400 group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-5 text-xs text-slate-400">
      
      <!-- Copyright & Payment Badges -->
      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 text-center sm:text-left">
        <div>
          &copy; {new Date().getFullYear()} Armstrong Locksmith Inc. Certified &amp; Insured.
        </div>
        
        <!-- Standard White Merchant Payment Cards -->
        <div class="flex items-center gap-1.5" aria-label="Accepted Payment Methods">
          <!-- Visa -->
          <div class="h-6 w-9 bg-white rounded flex items-center justify-center shadow-xs border border-slate-700/60 p-0.5" title="Visa">
            <svg class="h-3 w-auto" viewBox="0 0 24 24" fill="#1434CB" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9.112 8.262L5.97 15.758H3.92L2.374 9.775c-.094-.368-.175-.503-.461-.658C1.447 8.864.677 8.627 0 8.479l.046-.217h3.3a.904.904 0 01.894.764l.817 4.338 2.018-5.102zm8.033 5.049c.008-1.979-2.736-2.088-2.717-2.972.006-.269.262-.555.822-.628a3.66 3.66 0 011.913.336l.34-1.59a5.207 5.207 0 00-1.814-.333c-1.917 0-3.266 1.02-3.278 2.479-.012 1.079.963 1.68 1.698 2.04.756.367 1.01.603 1.006.931-.005.504-.602.725-1.16.734-.975.015-1.54-.263-1.992-.473l-.351 1.642c.453.208 1.289.39 2.156.398 2.037 0 3.37-1.006 3.377-2.564m5.061 2.447H24l-1.565-7.496h-1.656a.883.883 0 00-.826.55l-2.909 6.946h2.036l.405-1.12h2.488zm-2.163-2.656l1.02-2.815.588 2.815zm-8.16-4.84l-1.603 7.496H8.34l1.605-7.496z"/></svg>
          </div>
          <!-- Mastercard -->
          <div class="h-6 w-9 bg-white rounded flex items-center justify-center shadow-xs border border-slate-700/60 p-0.5" title="Mastercard">
            <svg class="h-3.5 w-auto" viewBox="0 0 24 15" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="7.5" cy="7.5" r="7.5" fill="#EB001B"/><circle cx="16.5" cy="7.5" r="7.5" fill="#F79E1B"/><path d="M12 13.97a7.5 7.5 0 010-12.94 7.5 7.5 0 000 12.94z" fill="#FF5F00"/></svg>
          </div>
          <!-- American Express -->
          <div class="h-6 w-9 bg-[#007BC1] rounded flex items-center justify-center shadow-xs border border-slate-700/60 overflow-hidden" title="American Express">
            <span class="text-[8px] font-black text-white tracking-tighter uppercase font-sans">AMEX</span>
          </div>
          <!-- Discover -->
          <div class="h-6 w-9 bg-white rounded flex items-center justify-center shadow-xs border border-slate-700/60 p-0.5" title="Discover">
            <span class="text-[7.5px] font-black text-[#F76707] tracking-tighter uppercase font-sans">DISC</span>
          </div>
          <!-- Apple Pay -->
          <div class="h-6 w-9 bg-black rounded flex items-center justify-center shadow-xs border border-slate-700/60 p-0.5" title="Apple Pay">
            <svg class="h-3.5 w-auto" viewBox="0 0 24 24" fill="#fff" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2.15 4.318a42.16 42.16 0 0 0-.454.003c-.15.005-.303.013-.452.04a1.44 1.44 0 0 0-1.06.772c-.07.138-.114.278-.14.43-.028.148-.037.3-.04.45A10.2 10.2 0 0 0 0 6.222v11.557c0 .07.002.138.003.207.004.15.013.303.04.452.027.15.072.291.142.429a1.436 1.436 0 0 0 .63.63c.138.07.278.115.43.142.148.027.3.036.45.04l.208.003h20.194l.207-.003c.15-.004.303-.013.452-.04.15-.027.291-.071.428-.141a1.432 1.432 0 0 0 .631-.631c.07-.138.115-.278.141-.43.027-.148.036-.3.04-.45.002-.07.003-.138.003-.208l.001-.246V6.221c0-.07-.002-.138-.004-.207a2.995 2.995 0 0 0-.04-.452 1.446 1.446 0 0 0-1.2-1.201 3.022 3.022 0 0 0-.452-.04 10.448 10.448 0 0 0-.453-.003zm0 .512h19.942c.066 0 .131.002.197.003.115.004.25.01.375.032.109.02.2.05.287.094a.927.927 0 0 1 .407.407.997.997 0 0 1 .094.288c.022.123.028.258.031.374.002.065.003.13.003.197v11.552c0 .065 0 .13-.003.196-.003.115-.009.25-.032.375a.927.927 0 0 1-.5.693 1.002 1.002 0 0 1-.286.094 2.598 2.598 0 0 1-.373.032l-.2.003H1.906c-.066 0-.133-.002-.196-.003a2.61 2.61 0 0 1-.375-.032c-.109-.02-.2-.05-.288-.094a.918.918 0 0 1-.406-.407 1.006 1.006 0 0 1-.094-.288 2.531 2.531 0 0 1-.032-.373 9.588 9.588 0 0 1-.002-.197V6.224c0-.065 0-.131.002-.197.004-.114.01-.248.032-.375.02-.108.05-.199.094-.287a.925.925 0 0 1 .407-.406 1.03 1.03 0 0 1 .287-.094c.125-.022.26-.029.375-.032.065-.002.131-.002.196-.003zm4.71 3.7c-.3.016-.668.199-.88.456-.191.22-.36.58-.316.918.338.03.675-.169.888-.418.205-.258.345-.603.308-.955zm2.207.42v5.493h.852v-1.877h1.18c1.078 0 1.835-.739 1.835-1.812 0-1.07-.742-1.805-1.808-1.805zm.852.719h.982c.739 0 1.161.396 1.161 1.089 0 .692-.422 1.092-1.164 1.092h-.979zm-3.154.3c-.45.01-.83.28-1.05.28-.235 0-.593-.264-.981-.257a1.446 1.446 0 0 0-1.23.747c-.527.908-.139 2.255.374 2.995.249.366.549.769.944.754.373-.014.52-.242.973-.242.454 0 .586.242.98.235.41-.007.667-.366.915-.733.286-.417.403-.82.41-.841-.007-.008-.79-.308-.797-1.209-.008-.754.615-1.113.644-1.135-.352-.52-.9-.578-1.09-.593a1.123 1.123 0 0 0-.092-.002zm8.204.397c-.99 0-1.606.533-1.652 1.256h.777c.072-.358.369-.586.845-.586.502 0 .803.266.803.711v.309l-1.097.064c-.951.054-1.488.484-1.488 1.184 0 .72.548 1.207 1.332 1.207.526 0 1.032-.281 1.264-.727h.019v.659h.788v-2.76c0-.803-.62-1.317-1.591-1.317zm1.94.072l1.446 4.009c0 .003-.073.24-.073.247-.125.41-.33.571-.711.571-.069 0-.206 0-.267-.015v.666c.06.011.267.019.335.019.83 0 1.226-.312 1.568-1.283l1.5-4.214h-.868l-1.012 3.259h-.015l-1.013-3.26zm-1.167 2.189v.316c0 .521-.45.917-1.024.917-.442 0-.731-.228-.731-.579 0-.342.278-.56.769-.593z"/></svg>
          </div>
        </div>
      </div>

      <!-- Legal Links -->
      <div class="flex items-center gap-3 sm:gap-4 flex-wrap text-slate-400">
        <a href="/terms-and-conditions/" class="hover:text-white transition-colors">Terms</a>
        <span>&bull;</span>
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy</a>
        <span>&bull;</span>
        <a href="/refund-and-cancellation-policy/" class="hover:text-white transition-colors">Refunds</a>
        <span>&bull;</span>
        <a href="/contact-armstrong-locksmith/" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>

  </div>

  <script is:inline>
    const emailLink = document.getElementById('footer-email-link');
    if (emailLink) {
      emailLink.addEventListener('click', () => {
        if (navigator.clipboard) {
          navigator.clipboard.writeText('locksmith@armstronglocksmithinc.com').then(() => {
            const original = emailLink.innerText;
            emailLink.innerText = '✓ Copied to clipboard!';
            setTimeout(() => { emailLink.innerText = original; }, 2500);
          }).catch(() => {});
        }
      });
    }
  </script>

</footer>
