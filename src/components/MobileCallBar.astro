---
// MobileCallBar.astro - High-Converting 3-Segment Sticky Bottom Bar
---

<div id="arm-mobile-callbar" class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-[#07152b] bg-navy-grid border-t-2 border-amber-500 shadow-2xl flex items-stretch h-14">
  
  <!-- 1. Primary Call Button (Orange / Gold with dynamic status) -->
  <a 
    href="tel:6156258000" 
    class="flex-[1.8] bg-gradient-to-r from-amber-500 via-orange-500 to-amber-500 hover:brightness-105 text-slate-950 font-black flex items-center justify-center gap-2.5 px-3 py-1 border-r border-slate-900 shadow-inner active:scale-98 transition"
    aria-label="Call Armstrong Locksmith at (615) 625-8000"
  >
    <svg class="w-5 h-5 text-slate-950 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/>
    </svg>
    <div class="flex flex-col text-left leading-tight">
      <span class="text-xs sm:text-sm font-black tracking-tight">(615) 625-8000</span>
      <span id="arm-callbar-status" class="text-[9px] uppercase tracking-wider font-extrabold text-slate-900 opacity-90">
        OPEN NOW
      </span>
    </div>
  </a>

  <!-- 2. Text / SMS Button -->
  <a 
    id="arm-callbar-sms"
    href="sms:6156258000" 
    class="flex-1 bg-[#07152b] bg-navy-grid hover:bg-[#0f274a] bg-navy-grid text-white flex flex-col items-center justify-center gap-0.5 px-2 py-1 border-r border-slate-800 active:scale-98 transition"
    aria-label="Send SMS text to Armstrong Locksmith"
  >
    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
    </svg>
    <span class="text-[10px] font-black uppercase tracking-wider text-slate-200">TEXT</span>
  </a>

  <!-- 3. Shop / Directions Button -->
  <a 
    href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" 
    target="_blank" 
    rel="noopener noreferrer"
    class="flex-1 bg-[#07152b] bg-navy-grid hover:bg-[#0f274a] bg-navy-grid text-white flex flex-col items-center justify-center gap-0.5 px-2 py-1 active:scale-98 transition"
    aria-label="Get GPS Directions to 208 Thompson Ln"
  >
    <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/>
    </svg>
    <span class="text-[10px] font-black uppercase tracking-wider text-slate-200">SHOP</span>
  </a>

</div>

<script is:inline>
  (function() {
    function updateCallBarStatus() {
      const el = document.getElementById('arm-callbar-status');
      if (!el) return;
      
      const now = new Date();
      // Format to Nashville time
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'short',
        hour: 'numeric',
        minute: 'numeric',
        hour12: false
      }).formatToParts(now);

      const dayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
      const m = {};
      parts.forEach(p => { if (p.type !== 'literal') m[p.type] = p.value; });
      const day = dayMap[m.weekday];
      const hour = parseInt(m.hour, 10);
      const minute = parseInt(m.minute, 10);
      const cur = hour * 60 + minute;

      const wOpen = 8 * 60, wClose = 23 * 60 + 30; // Mon-Fri: 8:00 AM - 11:30 PM
      const sOpen = 10 * 60, sClose = 16 * 60;      // Sat: 10:00 AM - 4:00 PM

      let statusText = "OPEN NOW";
      if (day >= 1 && day <= 5) {
        if (cur >= wOpen && cur <= 18 * 60) {
          statusText = "OPEN NOW";
        } else if (cur > 18 * 60 && cur <= wClose) {
          statusText = "MOBILE DISPATCH";
        } else {
          statusText = "OPENS 8:00 AM";
        }
      } else if (day === 6) {
        if (cur >= sOpen && cur <= sClose) {
          statusText = "OPEN NOW";
        } else {
          statusText = "OPENS MON 8AM";
        }
      } else if (day === 0) {
        statusText = "ON-CALL / MON 8AM";
        const smsBtn = document.getElementById('arm-callbar-sms');
        if (smsBtn) {
          smsBtn.setAttribute('href', 'sms:6156258000?&body=Hi%20Armstrong%20Locksmith%2C%20I%20would%20like%20to%20request%20service%20for%20Monday%20at%208%3A00%20AM.');
        }
      }

      el.textContent = statusText;
    }

    updateCallBarStatus();
  })();
</script>
