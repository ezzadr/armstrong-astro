---
// Header.astro - Desktop mega-navigation + mobile drawer.
//
// Both trees render from src/data/nav.json. They used to be two hand-written
// blocks of markup, which silently drifted: /european-car-key-specialist/ and
// /automotive-locksmith-in-nashville-tn/ were in the desktop menu and missing
// from mobile. Sharing the arrays makes that class of bug impossible.
//
// Anchor text lives in nav.json. Desktop renders first in the DOM and first
// link counts, so those labels are what Google attributes sitewide - they all
// carry the head term of the page they point at.
import { getReviewStats } from '../lib/reviewStats.mjs';
import nav from '../data/nav.json';
import { storeWeekdays, storeSaturday, mobileSaturday, mobileUntil } from '../data/hours.mjs';
// Server-rendered so the count is right before JS runs; .arm-review-count spans are refreshed live by syncReviewCounts() below.
const { reviewCount } = await getReviewStats();
---

<header id="arm-site-header" class="sticky top-0 z-50 w-full bg-white shadow-md font-sans border-b-2 border-slate-200 lg:border-b-0">

  <!-- Tier 1: Brand Logo, Walk-In Shop Info Strip (Desktop), and Action CTAs -->
  <div class="max-w-[96rem] mx-auto px-4 sm:px-6 xl:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-4">

    <!-- Left: Official Company Logo + Storefront Trust Info (Desktop) -->
    <div class="flex items-center gap-5 xl:gap-7">
      <a href="/" class="flex items-center flex-shrink-0 group" aria-label="Armstrong Locksmith Homepage">
        <picture>
          <source srcset="/logo.webp" type="image/webp" />
          <img
            src="/logo.png"
            alt="Armstrong Locksmith Nashville"
            class="h-12 sm:h-14 md:h-16 w-auto object-contain transition-transform group-hover:scale-102"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="200"
            height="153"
          />
        </picture>
      </a>

      <!-- Desktop Storefront & Reviews Callout -->
      <div class="hidden lg:flex items-center gap-5 pl-5 border-l border-slate-200 text-xs">
        <a href="/nashville-locksmith-storefront/" class="group flex items-center gap-2.5 text-slate-700 hover:text-[#0f274a]">
          <div class="w-8 h-8 rounded-md bg-slate-100 border border-slate-200 flex items-center justify-center text-[#0f274a] group-hover:bg-[#0f274a] group-hover:text-amber-400 transition-colors shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <span class="block font-extrabold text-[#0f274a] text-[13px] leading-tight group-hover:underline">Walk-In Shop: 208 Thompson Ln</span>
            <span class="block text-[11px] text-slate-500 mt-0.5">Mon–Fri {storeWeekdays} &bull; Sat {storeSaturday}</span>
          </div>
        </a>

        <a href="/google-reviews/" class="hidden xl:flex items-center gap-2 pl-5 border-l border-slate-200 text-slate-700 hover:text-[#0f274a]">
          <span class="text-amber-500 text-sm tracking-tight">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <div>
            <span class="block font-extrabold text-[#0f274a] text-[13px] leading-tight">4.9 Google Rating</span>
            <span class="block text-[11px] text-slate-500 mt-0.5"><span class="arm-review-count font-bold text-slate-700">{reviewCount}+</span> Local Reviews</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Right: Header Action CTAs + Mobile Menu Button -->
    <div class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">

      <!-- Prominent Call Button (All Screens: Compact on Phone, Full on Tablet/Desktop) -->
      <a
        href="tel:6156258000"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-4 py-2 sm:py-2.5 rounded-md bg-[#0f274a] hover:bg-[#16335c] text-white font-black text-xs sm:text-sm shadow transition active:scale-95 whitespace-nowrap"
        aria-label="Call Armstrong Locksmith at (615) 625-8000"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
        <span class="hidden sm:inline">CALL </span><span>(615) 625-8000</span>
      </a>

      <!-- Book Online Button (Desktop >= 768px) -->
      <a
        href="/book-online/"
        class="hidden md:inline-flex items-center justify-center px-4 py-2.5 rounded-md bg-gold-metallic hover:brightness-105 text-[#07152b] font-black text-xs sm:text-sm shadow-sm transition active:scale-95 whitespace-nowrap border-b-2 border-amber-600 cursor-pointer"
        aria-label="Book Locksmith Service Online"
      >
        <span>Book Online</span>
      </a>

      <!-- Mobile Menu Toggle Button (High-Contrast Shop Gold) -->
      <button
        id="arm-mobile-menu-btn"
        type="button"
        class="lg:hidden flex items-center gap-1.5 px-3 py-2 rounded-md bg-[#f59e0b] hover:bg-amber-400 border-b-2 border-amber-600 text-[#07152b] shadow-sm active:scale-95 transition-all duration-200 cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0f274a]"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
      >
        <div class="flex flex-col gap-1 w-4 shrink-0 pointer-events-none">
          <span class="w-full h-0.5 bg-[#07152b]"></span>
          <span class="w-full h-0.5 bg-[#07152b]"></span>
          <span class="w-full h-0.5 bg-[#07152b]"></span>
        </div>
        <span class="arm-menu-label text-[11px] font-black uppercase tracking-wider text-[#07152b] select-none pointer-events-none">
          MENU
        </span>
      </button>

    </div>

  </div>

  <!-- Tier 2: High-Contrast Shop Gold Desktop Navigation Bar (lg: 1024px+) -->
  <div class="hidden lg:block bg-[#f59e0b] border-y border-amber-600 shadow-md">
    <div class="max-w-[96rem] mx-auto px-6 xl:px-8 flex items-center justify-between">
      <nav class="arm-desktop-nav relative flex items-center divide-x divide-[#07152b]/15 border-x border-[#07152b]/15 text-[16px] xl:text-[18px] font-black text-[#07152b] tracking-tight" aria-label="Main Navigation">

      <!-- Silo 1: Car Keys Mega-Dropdown -->
      <div class="group">
        <a href="/car-key-replacement-nashville/" class="arm-nav-item px-6 xl:px-7 py-3 hover:bg-[#07152b] hover:text-white group-hover:bg-[#07152b] group-hover:text-white transition-colors inline-flex items-center gap-2 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-car-keys">
          <span>Car Keys</span>
          <svg class="w-4 h-4 text-[#07152b] group-hover:text-amber-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <!-- 3-Column Mega Dropdown Panel -->
        <div id="arm-menu-car-keys" class="arm-dropdown-panel absolute top-full left-0 hidden group-hover:block group-focus-within:block w-[880px] max-w-[calc(100vw-2rem)] bg-white rounded-b-2xl rounded-tr-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 text-xs overflow-visible before:content-[''] before:absolute before:-top-3 before:inset-x-0 before:h-3">
          <div class="h-1 bg-[#d4a017]"></div>

          <div class="grid grid-cols-12 gap-5 p-5 xl:p-6 text-left">

            <!-- Col 1: European Car Keys -->
            <div class="col-span-5 bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 pb-2.5 mb-3 border-b border-slate-200 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                  <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/></svg>
                  <span>European Car Keys</span>
                </div>

                <div class="space-y-1.5">
                  {nav.european.map((item) => (
                    <a href={item.href} class="group/item flex items-center justify-between p-2 rounded-lg bg-white border border-slate-200/70 hover:border-amber-400 hover:shadow-xs transition-all">
                      <div>
                        <span class="block text-slate-900 font-bold">{item.label}</span>
                      </div>
                      <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all font-bold">&rarr;</span>
                    </a>
                  ))}

                  <div class="grid grid-cols-2 gap-1.5 pt-1">
                    {nav.europeanCompact.map((item) => (
                      <a
                        href={item.href}
                        class={`p-1.5 rounded bg-white border border-slate-200/70 text-slate-800 font-semibold hover:border-amber-400 hover:text-amber-700 text-[11px] truncate${item.wide ? ' col-span-2 text-center' : ''}`}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <a href={nav.europeanHub.href} class="mt-3 block p-2.5 rounded-lg bg-amber-50 hover:bg-amber-100 border border-amber-300 text-amber-950 font-black text-center transition-all duration-200 hover:shadow-xs">
                <span>{nav.europeanHub.label} &rarr;</span>
              </a>
            </div>

            <!-- Col 2: Popular Domestic & Asian Brands -->
            <div class="col-span-4 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 pb-2.5 mb-3 border-b border-slate-200 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                  <svg class="w-4 h-4 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                  <span>Domestic &amp; Asian Makes</span>
                </div>

                <div class="grid grid-cols-2 gap-1.5 text-[11px] font-bold">
                  {nav.makes.map((item) => (
                    <a href={item.href} class="p-2 rounded-lg bg-slate-50 hover:bg-amber-50 hover:text-amber-700 text-slate-800 border border-slate-200/70 transition-colors flex items-center justify-between">
                      <span class="truncate">{item.label}</span>
                    </a>
                  ))}
                </div>

                <div class="mt-3 space-y-1 text-[11px]">
                  {nav.keyServices.map((item) => (
                    <a href={item.href} class="block p-1.5 text-slate-700 hover:text-amber-600 font-semibold transition-colors">
                      &rsaquo; {item.label}
                    </a>
                  ))}
                </div>
              </div>

              <a href={nav.makesHub.href} class="mt-3 block p-2 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-900 font-black text-center transition-all duration-200 hover:shadow-xs">
                <span>{nav.makesHub.label} &rarr;</span>
              </a>
            </div>

            <!-- Col 3: Lost All Keys & Urgent Assistance -->
            <div class="col-span-3 bg-[#07152b] text-white p-4 rounded-xl border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2.5 mb-2.5 pb-2.5 border-b border-white/10">
                  <img
                    src="/images/rahim-face-96.webp"
                    alt="Rahim, Owner of Armstrong Locksmith"
                    width="36"
                    height="36"
                    loading="lazy"
                    decoding="async"
                    class="w-9 h-9 rounded-full object-cover border-2 border-amber-400 shrink-0"
                  />
                  <div>
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Real Nashville Shop</div>
                    <div class="text-[11px] font-bold text-white leading-tight">208 Thompson Ln</div>
                  </div>
                </div>
                <div class="text-xs font-black text-white uppercase tracking-tight">Lost All Your Car Keys?</div>
                <p class="text-[11px] text-slate-300 mt-1.5 leading-relaxed">
                  We come to where your car is parked and cut and program a new key on the spot — no towing to the dealer.
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-white/10">
                <a href="/emergency-car-lockout/" class="block p-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-black text-center text-[11px] uppercase tracking-wider shadow-sm transition-colors active:scale-95">
                  Emergency Car Lockout &rarr;
                </a>
              </div>
            </div>

          </div>

          <!-- Mega Menu Bottom Action Banner -->
          <div class="bg-[#07152b] bg-navy-grid px-6 py-3 border-t border-amber-500/20 flex items-center justify-between text-white text-xs">
            <div class="flex items-center gap-3">
              <span class="flex items-center gap-1.5 text-amber-400 font-bold">
                <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/></svg>
                <span>Walk-In Shop: 208 Thompson Ln, Nashville</span>
              </span>
              <span class="hidden md:inline text-slate-500">&bull;</span>
              <span class="hidden md:inline text-slate-300">Mobile vans across Metro Nashville</span>
            </div>
            <a href="tel:6156258000" class="font-bold text-amber-400 hover:text-white transition-colors flex items-center gap-1">
              <span>Call Shop: (615) 625-8000 &rarr;</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Silo 2: Locks & Rekeys (Home & Business) -->
      <div class="relative group">
        <a href="/residential-locksmith-nashville/" class="arm-nav-item px-6 xl:px-7 py-3 hover:bg-[#07152b] hover:text-white group-hover:bg-[#07152b] group-hover:text-white transition-colors inline-flex items-center gap-2 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-commercial">
          <span>Locks &amp; Rekeys</span>
          <svg class="w-4 h-4 text-[#07152b] group-hover:text-amber-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <div id="arm-menu-commercial" class="arm-dropdown-panel absolute top-full left-0 hidden group-hover:block group-focus-within:block w-[640px] max-w-[calc(100vw-2rem)] bg-white rounded-b-2xl rounded-tr-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 text-xs overflow-visible before:content-[''] before:absolute before:-top-3 before:inset-x-0 before:h-3">
          <div class="h-1 bg-[#d4a017]"></div>

          <div class="grid grid-cols-2 divide-x divide-slate-200 p-5 gap-6 text-left">

            <!-- Residential Security Section -->
            <div>
              <div class="flex items-center gap-2 pb-2 mb-3 border-b border-slate-200 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span>Home &amp; Residential</span>
              </div>

              <div class="flex flex-col divide-y divide-slate-100">
                {nav.residential.map((item) => (
                  <a href={item.href} class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-700 font-semibold hover:bg-slate-50 hover:text-[#0f274a] hover:border-l-2 hover:border-amber-500 transition-all">
                    <div>
                      <span class="block text-slate-900 font-bold">{item.label}</span>
                    </div>
                    <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all font-bold">&rarr;</span>
                  </a>
                ))}

                <a href="/book-online/" class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-800 font-bold bg-amber-50/60 hover:bg-amber-100 hover:border-l-2 hover:border-amber-500 rounded-lg transition-all mt-1">
                  <div>
                    <span class="block text-slate-900 font-bold">Schedule Lock Service</span>
                  </div>
                  <span class="text-amber-600 group-hover/item:translate-x-1 transition-transform font-bold">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Commercial Security Section -->
            <div class="pl-6">
              <div class="flex items-center gap-2 pb-2 mb-3 border-b border-slate-200 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                <svg class="w-4 h-4 text-[#0f274a] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
                <span>Business &amp; Commercial</span>
              </div>

              <div class="flex flex-col divide-y divide-slate-100">
                {nav.commercial.map((item) => (
                  <a href={item.href} class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-700 font-semibold hover:bg-slate-50 hover:text-[#0f274a] hover:border-l-2 hover:border-amber-500 transition-all">
                    <div>
                      <span class="block text-slate-900 font-bold">{item.label}</span>
                    </div>
                    <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all font-bold">&rarr;</span>
                  </a>
                ))}

                <a href="/nashville-locksmith-storefront/" class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-900 font-bold bg-slate-100 hover:bg-slate-200 hover:border-l-2 hover:border-[#0f274a] rounded-lg transition-all mt-1">
                  <div>
                    <span class="block text-[#0f274a] font-black">Walk-In Storefront Shop</span>
                  </div>
                  <span class="text-[#0f274a] group-hover/item:translate-x-1 transition-transform font-bold">&rarr;</span>
                </a>
              </div>
            </div>

          </div>

          <div class="bg-slate-50 px-6 py-2.5 border-t border-slate-200 text-slate-600 text-[11px] flex items-center justify-between">
            <span class="font-medium">Locally Owned Nashville Shop &bull; Bonded &amp; Insured</span>
            <a href="/contact-armstrong-locksmith/" class="font-bold text-[#0f274a] hover:underline">Get Free Estimate &rarr;</a>
          </div>

        </div>
      </div>

      <!-- Silo 3: Lockout. Direct link, no dropdown - the highest-intent visitor
           on the site should not have to guess which menu it lives under. -->
      <div>
        <a href="/emergency-car-lockout/" class="arm-nav-item px-6 xl:px-7 py-3 text-[#07152b] hover:bg-red-700 hover:text-white transition-colors inline-flex items-center gap-2 cursor-pointer">
          <span class="w-2 h-2 rounded-full bg-red-600"></span>
          <span>Lockout</span>
        </a>
      </div>

      <!-- Silo 4: Pricing Dropdown -->
      <div class="relative group">
        <a href="/locksmith-pricing-nashville/" class="arm-nav-item px-6 xl:px-7 py-3 hover:bg-[#07152b] hover:text-white group-hover:bg-[#07152b] group-hover:text-white transition-colors inline-flex items-center gap-2 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-pricing">
          <span>Pricing</span>
          <svg class="w-4 h-4 text-[#07152b] group-hover:text-amber-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <div id="arm-menu-pricing" class="arm-dropdown-panel absolute top-full left-0 hidden group-hover:block group-focus-within:block w-72 bg-white rounded-b-2xl rounded-tr-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 text-xs overflow-visible text-left before:content-[''] before:absolute before:-top-3 before:inset-x-0 before:h-3">
          <div class="h-1 bg-[#d4a017]"></div>
          <div class="divide-y divide-slate-100 p-2">
            {nav.pricing.map((item) => (
              <a
                href={item.href}
                class={item.feature
                  ? 'group/item flex items-center justify-between p-3 rounded-xl bg-amber-50/60 hover:bg-amber-100 font-bold text-amber-950 transition-colors'
                  : 'group/item flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 text-slate-800 transition-colors'}
              >
                <div>
                  <span class={item.feature ? 'block text-amber-950 font-black' : 'block font-bold text-slate-900'}>
                    {item.label}
                    {item.showCount && <> (<span class="arm-review-count">{reviewCount}+</span>)</>}
                  </span>
                </div>
                <span class={item.feature
                  ? 'text-amber-600 group-hover/item:translate-x-1 transition-transform'
                  : 'text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all'}>&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Silo 5: Locations. Shop + areas first, company links visually split
           below so the two intents are not presented as one flat list. -->
      <div class="relative group">
        <a href="/service-areas/" class="arm-nav-item px-6 xl:px-7 py-3 hover:bg-[#07152b] hover:text-white group-hover:bg-[#07152b] group-hover:text-white transition-colors inline-flex items-center gap-2 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-locations">
          <span>Locations</span>
          <svg class="w-4 h-4 text-[#07152b] group-hover:text-amber-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>
