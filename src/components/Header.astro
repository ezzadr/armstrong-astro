---
// Header.astro - Header with Official Company Logo & Perfect Mobile Alignment
---

<header id="arm-site-header" class="sticky top-0 z-50 w-full bg-white border-b border-slate-200 shadow-sm font-sans">
  
  <!-- Top Micro Utility Bar -->
  <div class="bg-[#0f274a] text-white text-[10px] sm:text-xs py-1.5 px-3 sm:px-6 lg:px-8 border-t-2 border-amber-500">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      
      <!-- Storefront Link -->
      <a 
        href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-slate-200 hover:text-amber-400 font-medium transition truncate"
      >
        <svg class="w-3 h-3 text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
        <span class="truncate">208 Thompson Ln, Nashville, TN</span>
      </a>

      <!-- Status & License -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="hidden sm:inline text-amber-300 font-semibold">TN Lic #406</span>
        <div id="arm-status-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-bold uppercase tracking-wider text-[9px] sm:text-[10px]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="status-text">Open</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Main Navigation Row -->
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-2.5 flex items-center justify-between gap-3">
    
    <!-- Official Company Logo -->
    <a href="/" class="flex items-center flex-shrink-0 group" aria-label="Armstrong Locksmith Homepage">
      <img 
        src="/logo.png" 
        alt="Armstrong Locksmith Nashville" 
        class="h-10 sm:h-12 md:h-14 w-auto object-contain" 
        loading="eager"
        fetchpriority="high"
        width="220"
        height="56"
      />
    </a>

    <!-- Desktop Navigation Links (XL Screens) -->
    <nav class="hidden xl:flex items-center gap-6 text-sm font-bold text-slate-700">
      <a href="/" class="hover:text-[#0f274a] transition py-1">Home</a>
      
      <!-- Car Keys Dropdown -->
      <div class="relative group py-1">
        <a href="/car-key-replacement-nashville/" class="hover:text-[#0f274a] transition inline-flex items-center gap-1">
          <span>Car Keys</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <div class="absolute top-full left-0 hidden group-hover:block w-64 p-2 bg-white rounded-xl shadow-xl border border-slate-200 z-50 mt-1">
          <a href="/car-key-replacement-nashville/" class="block px-3 py-2.5 rounded-lg text-xs font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition">
            🔑 Car Key Replacement
          </a>
          <a href="/european-car-key-specialist/" class="block px-3 py-2.5 rounded-lg text-xs font-bold text-amber-900 bg-amber-50/70 hover:bg-amber-100 transition">
            🏎️ European Specialist (BMW, Audi, Benz)
          </a>
          <a href="/dealer-key/" class="block px-3 py-2.5 rounded-lg text-xs font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition">
            ⚙️ OEM Dealer Keys
          </a>
          <a href="/emergency-car-lockout/" class="block px-3 py-2.5 rounded-lg text-xs font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition">
            🚨 Emergency Car Lockout
          </a>
        </div>
      </div>

      <!-- Locks Dropdown -->
      <div class="relative group py-1">
        <button type="button" class="hover:text-[#0f274a] transition inline-flex items-center gap-1">
          <span>Locks & Security</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div class="absolute top-full left-0 hidden group-hover:block w-60 p-2 bg-white rounded-xl shadow-xl border border-slate-200 z-50 mt-1">
          <a href="/residential-locksmith-nashville/" class="block px-3 py-2.5 rounded-lg text-xs font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition">
            🏡 Residential Locksmith & Rekey
          </a>
          <a href="/commercial-locksmith/" class="block px-3 py-2.5 rounded-lg text-xs font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 transition">
            🏢 Commercial Doors & Hardware
          </a>
        </div>
      </div>

      <a href="/service-areas/" class="hover:text-[#0f274a] transition py-1">Service Areas</a>
      <a href="/locksmith-pricing-nashville/" class="hover:text-[#0f274a] transition py-1">Pricing</a>
      <a href="/blog/" class="hover:text-[#0f274a] transition py-1">Blog</a>
      <a href="/about-us/" class="hover:text-[#0f274a] transition py-1">About Us</a>
      <a href="/contact-armstrong-locksmith/" class="hover:text-[#0f274a] transition py-1">Contact</a>
    </nav>

    <!-- Header Action CTAs -->
    <div class="flex items-center gap-2 flex-shrink-0">
      
      <!-- Prominent Call Button (Navy & High Contrast on Mobile/Desktop) -->
      <a 
        href="tel:6156258000" 
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-lg bg-[#0f274a] hover:bg-[#16335c] text-white font-black text-xs sm:text-sm shadow transition active:scale-95 whitespace-nowrap border border-slate-700"
        aria-label="Call Armstrong Locksmith at (615) 625-8000"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
        <span>CALL (615) 625-8000</span>
      </a>

      <!-- Book Online Button (Desktop >= 768px) -->
      <a 
        href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1 px-3.5 py-2 sm:py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow transition active:scale-95 whitespace-nowrap"
      >
        <span>Book Online</span>
      </a>

      <!-- Mobile Menu Toggle Button (Clean Square Box with Border) -->
      <button 
        id="arm-mobile-menu-btn" 
        type="button" 
        class="xl:hidden w-10 h-10 rounded-lg bg-white border border-slate-300 hover:bg-slate-50 text-slate-900 focus:outline-none transition flex items-center justify-center flex-shrink-0 cursor-pointer shadow-sm"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 pointer-events-none text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

    </div>

  </div>

  <!-- Dynamic Smart After-Hours Alert Banner -->
  <div 
    id="arm-after-hours-banner" 
    class="hidden bg-[#0a192f] text-white border-t border-b border-amber-500/60 px-4 py-3.5 sm:py-4 shadow-xl transition-all duration-300"
  >
    <div class="max-w-7xl mx-auto flex flex-col gap-2.5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="text-sm sm:text-base font-black uppercase tracking-wider text-white flex items-center gap-2 font-sans">
            <span>WE'RE CURRENTLY CLOSED</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-200 leading-snug pt-1">
            You can still send a service request. We'll contact you after we reopen <strong id="arm-reopen-time" class="text-amber-300 font-bold">Monday at 8:00 AM</strong>.
          </p>
        </div>
        <button 
          id="arm-close-banner-btn" 
          type="button" 
          class="w-7 h-7 rounded border border-slate-600 hover:border-white text-slate-400 hover:text-white flex items-center justify-center text-sm font-bold transition active:scale-95 cursor-pointer shrink-0"
          aria-label="Dismiss notice"
        >
          &times;
        </button>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
        <a 
          href="#quote-form-section" 
          class="w-full py-2.5 px-3 rounded-lg bg-[#f59e0b] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider text-center shadow transition active:scale-98 flex items-center justify-center"
        >
          <span>Send a Request</span>
        </a>

        <a 
          href="/#storefront-hours" 
          class="w-full py-2.5 px-3 rounded-lg bg-[#07152b] hover:bg-[#0f274a] text-white font-bold text-xs sm:text-sm uppercase tracking-wider text-center border border-slate-600 hover:border-slate-400 shadow transition active:scale-98 flex items-center justify-center"
        >
          <span>View Hours</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Clean Drawer Menu -->
  <div id="arm-mobile-drawer" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden opacity-0 transition-opacity duration-300">
    <div class="fixed top-0 right-0 h-full w-full max-w-xs bg-white shadow-2xl p-5 flex flex-col justify-between overflow-y-auto overscroll-contain transform translate-x-full transition-transform duration-300 pb-12">
      
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <img src="/logo.png" alt="Armstrong Locksmith" class="h-9 w-auto object-contain" />
          <button id="arm-drawer-close" class="p-2 text-slate-400 hover:text-black font-bold text-2xl leading-none cursor-pointer" aria-label="Close menu">&times;</button>
        </div>

        <!-- Navigation Links -->
        <nav class="flex flex-col gap-1 py-2.5 text-xs sm:text-sm font-bold text-slate-800">
          <a href="/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">🏠 Home</a>
          <a href="/car-key-replacement-nashville/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">🔑 Car Key Replacement</a>
          <a href="/european-car-key-specialist/" class="p-2 rounded-lg bg-amber-50 text-amber-900 border border-amber-200 flex items-center gap-2.5">🏎️ European Keys (BMW/Audi/Benz)</a>
          <a href="/residential-locksmith-nashville/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">🏡 Residential Locksmith & Rekey</a>
          <a href="/commercial-locksmith/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">🏢 Commercial Doors & Hardware</a>
          <a href="/locksmith-pricing-nashville/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">💵 Upfront Price Guide</a>
          <a href="/service-areas/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">📍 Nashville Service Areas</a>
          <a href="/blog/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">📰 Locksmith Insights & Blog</a>
          <a href="/about-us/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">👨‍🔧 About Us (Rahim)</a>
          <a href="/contact-armstrong-locksmith/" class="p-2 rounded-lg hover:bg-slate-100 flex items-center gap-2.5">📞 Contact & Storefront</a>
        </nav>
      </div>

      <!-- Drawer Bottom Actions -->
      <div class="flex flex-col gap-2 pt-3 border-t border-slate-200 shrink-0 pb-6 mt-2">
        <a href="tel:6156258000" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-center shadow flex items-center justify-center gap-2 text-sm active:scale-98 transition-transform">
          <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          Call (615) 625-8000
        </a>
        <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold text-center text-xs shadow active:scale-98 transition-transform">
          Book Online
        </a>
        <div class="text-center text-[10px] text-slate-500 pt-0.5">
          📍 Storefront: 208 Thompson Ln, Nashville
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    (function () {
      function getNashvilleTime() {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Chicago',
          weekday: 'short',
          hour: 'numeric',
          minute: 'numeric',
          hour12: false
        }).formatToParts(new Date());

        const dayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        const m = {};
        parts.forEach(p => { if (p.type !== 'literal') m[p.type] = p.value; });
        return { day: dayMap[m.weekday], hour: parseInt(m.hour, 10), minute: parseInt(m.minute, 10) };
      }

      function updateStatus() {
        const badge = document.getElementById('arm-status-badge');
        if (!badge) return;

        const { day, hour, minute } = getNashvilleTime();
        const cur = hour * 60 + minute;
        const wOpen = 8 * 60, wClose = 23 * 60 + 30;
        const sOpen = 10 * 60, sClose = 16 * 60;

        let isOpen = false;
        if (day >= 1 && day <= 5) {
          isOpen = cur >= wOpen && cur <= wClose;
        } else if (day === 6) {
          isOpen = cur >= sOpen && cur <= sClose;
        }

        const text = badge.querySelector('.status-text');

        if (isOpen) {
          badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-bold uppercase tracking-wider text-[9px] sm:text-[10px]';
          if (text) text.textContent = 'Open';
        } else {
          badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold uppercase tracking-wider text-[9px] sm:text-[10px]';
          if (text) text.textContent = 'On-Call';
        }
      }

      // Smart After Hours Banner Detection
      function checkAfterHours() {
        const banner = document.getElementById('arm-after-hours-banner');
        const reopenEl = document.getElementById('arm-reopen-time');
        const closeBtn = document.getElementById('arm-close-banner-btn');
        if (!banner) return;

        if (sessionStorage.getItem('arm_banner_dismissed') === 'true') {
          return;
        }

        const { day, hour, minute } = getNashvilleTime();
        const cur = hour * 60 + minute;
        const wOpen = 8 * 60, wClose = 23 * 60 + 30; // Mon-Fri: 8:00 AM - 11:30 PM
        const sOpen = 10 * 60, sClose = 16 * 60;      // Sat: 10:00 AM - 4:00 PM

        let isOpen = false;
        let reopenText = "Monday at 8:00 AM";

        if (day >= 1 && day <= 4) { // Mon-Thu
          if (cur >= wOpen && cur <= wClose) {
            isOpen = true;
          } else if (cur < wOpen) {
            reopenText = "today at 8:00 AM";
          } else {
            reopenText = "tomorrow at 8:00 AM";
          }
        } else if (day === 5) { // Friday
          if (cur >= wOpen && cur <= wClose) {
            isOpen = true;
          } else if (cur < wOpen) {
            reopenText = "today at 8:00 AM";
          } else {
            reopenText = "Saturday at 10:00 AM";
          }
        } else if (day === 6) { // Saturday
          if (cur >= sOpen && cur <= sClose) {
            isOpen = true;
          } else if (cur < sOpen) {
            reopenText = "today at 10:00 AM";
          } else {
            reopenText = "Monday at 8:00 AM (Mobile on-call Sunday)";
          }
        } else if (day === 0) { // Sunday
          isOpen = true; // Sunday on-call
        }

        if (!isOpen) {
          if (reopenEl) reopenEl.textContent = reopenText;
          banner.classList.remove('hidden');
        } else {
          banner.classList.add('hidden');
        }

        if (closeBtn) {
          closeBtn.onclick = function() {
            banner.classList.add('hidden');
            sessionStorage.setItem('arm_banner_dismissed', 'true');
          };
        }
      }

      checkAfterHours();
      updateStatus();
      setInterval(() => {
        updateStatus();
        checkAfterHours();
      }, 60000);

      // Mobile Menu Drawer Toggle
      function setupMenu() {
        const menuBtn = document.getElementById('arm-mobile-menu-btn');
        const drawer = document.getElementById('arm-mobile-drawer');
        const closeBtn = document.getElementById('arm-drawer-close');

        if (!menuBtn || !drawer) return;

        function openDrawer() {
          drawer.classList.remove('hidden');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.add('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          requestAnimationFrame(() => {
            drawer.classList.remove('opacity-0');
            const drawerContent = drawer.querySelector('div');
            if (drawerContent) drawerContent.classList.remove('translate-x-full');
          });
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.add('opacity-0');
          const drawerContent = drawer.querySelector('div');
          if (drawerContent) drawerContent.classList.add('translate-x-full');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          setTimeout(() => {
            drawer.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }

        menuBtn.onclick = openDrawer;
        if (closeBtn) closeBtn.onclick = closeDrawer;
        drawer.onclick = function(e) {
          if (e.target === drawer) closeDrawer();
        };
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupMenu);
      } else {
        setupMenu();
      }
    })();
  </script>
</header>
