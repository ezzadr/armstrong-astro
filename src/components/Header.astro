        <!-- 3-Column Luxury Mega Dropdown Panel -->
        <div id="arm-menu-car-keys" class="absolute top-full left-0 hidden group-hover:block group-focus-within:block w-[870px] max-w-[calc(100vw-2rem)] bg-white shadow-luxury-card ring-1 ring-black/5 border-x border-b border-slate-200 z-50 mt-0 text-xs overflow-hidden">
          <div class="h-[3px] bg-gold-metallic"></div>

          <div class="grid grid-cols-3 divide-x divide-slate-200 p-5 xl:p-6 gap-6">

