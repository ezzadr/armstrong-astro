  <script is:inline>
    (function () {
      // Mobile Menu Drawer Toggle
      function setupMenu() {
        const menuBtn = document.getElementById('arm-mobile-menu-btn');
        const drawer = document.getElementById('arm-mobile-drawer');
        const closeBtn = document.getElementById('arm-drawer-close');

        if (!menuBtn || !drawer) return;

        function openDrawer() {
          drawer.classList.remove('hidden');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.add('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          requestAnimationFrame(() => {
            drawer.classList.remove('opacity-0');
            const drawerContent = drawer.querySelector('div');
            if (drawerContent) drawerContent.classList.remove('translate-x-full');
          });
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.add('opacity-0');
          const drawerContent = drawer.querySelector('div');
          if (drawerContent) drawerContent.classList.add('translate-x-full');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          setTimeout(() => {
            drawer.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }

        // Keep the trigger's aria-expanded honest - it ships as "false" in the
        // markup and previously never changed, so assistive tech was told the
        // drawer was closed the whole time it was open.
        menuBtn.onclick = function() {
          openDrawer();
          menuBtn.setAttribute('aria-expanded', 'true');
        };
        if (closeBtn) closeBtn.onclick = function() {
          closeDrawer();
          menuBtn.setAttribute('aria-expanded', 'false');
        };
        drawer.onclick = function(e) {
          if (e.target === drawer) {
            closeDrawer();
            menuBtn.setAttribute('aria-expanded', 'false');
          }
        };
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
            closeDrawer();
            menuBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Accordion Logic for Mobile Menu
      function setupAccordions() {
        const btns = document.querySelectorAll('.arm-accordion-btn');
        btns.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            const content = this.nextElementSibling;
            const chevron = this.querySelector('.arm-chevron');
            const isExpanded = this.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              content.classList.add('hidden');
              chevron.classList.remove('rotate-180');
              this.setAttribute('aria-expanded', 'false');
            } else {
              content.classList.remove('hidden');
              chevron.classList.add('rotate-180');
              this.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }

      // Desktop mega-dropdowns.
      //
      // The panels open purely through Tailwind's group-hover / group-focus-within,
      // which works for mouse and keyboard. Two problems came out of that:
      //   1. The <button> triggers were inert - clicking them did nothing at all.
      //   2. Their aria-expanded shipped as "false" and nothing ever updated it,
      //      so a screen reader was told the menu was collapsed while it was
      //      visibly open. A wrong state is worse than no state.
      //
      // Triggers that are <a> (Car Keys, About Us) are deliberately left alone:
      // clicking them navigates to the hub page, which is the correct behaviour.
      // Only the <button> triggers, which had no click behaviour to break, are wired up.
      function setupDesktopDropdowns() {
        const triggers = document.querySelectorAll('nav button[aria-haspopup="true"]');

        triggers.forEach(btn => {
          const group = btn.closest('.group');
          if (!group) return;
          const panel = group.querySelector(':scope > div.absolute');
          if (!panel) return;

          const isOpen = () => panel.style.display === 'block';
          const open = () => {
            // inline display beats the utility classes; removing it hands control back
            panel.style.display = 'block';
            btn.setAttribute('aria-expanded', 'true');
          };
          const close = () => {
            panel.style.removeProperty('display');
            btn.setAttribute('aria-expanded', 'false');
          };

          btn.addEventListener('click', e => {
            e.preventDefault();
            const wasOpen = isOpen();
            // only one open at a time
            triggers.forEach(other => {
              const g = other.closest('.group');
              const p = g && g.querySelector(':scope > div.absolute');
              if (p) p.style.removeProperty('display');
              other.setAttribute('aria-expanded', 'false');
            });
            if (!wasOpen) open();
          });

          // keep the attribute truthful when the panel is opened by hover or focus
          group.addEventListener('mouseenter', () => btn.setAttribute('aria-expanded', 'true'));
          group.addEventListener('mouseleave', () => {
            if (!isOpen()) btn.setAttribute('aria-expanded', 'false');
          });
          group.addEventListener('focusin', () => btn.setAttribute('aria-expanded', 'true'));
          group.addEventListener('focusout', () => {
            if (!group.contains(document.activeElement) && !isOpen()) close();
          });

          document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && isOpen()) { close(); btn.focus(); }
          });
        });

        document.addEventListener('click', e => {
          triggers.forEach(btn => {
            const group = btn.closest('.group');
            if (group && !group.contains(e.target)) {
              const panel = group.querySelector(':scope > div.absolute');
              if (panel) panel.style.removeProperty('display');
              btn.setAttribute('aria-expanded', 'false');
            }
          });
        });
      }

      // Sitewide live review count. Every hardcoded "771+" that should track
      // the real Google total is wrapped in .arm-review-count; this swaps them
      // for the live figure from the cached reviews endpoint. Runs at idle so
      // it never competes with LCP; on any failure the server-rendered number
      // simply stays, so there is no empty or shifting state.
      function syncReviewCounts() {
        if (!document.querySelector('.arm-review-count')) return;
        fetch('/api/reviews.php')
          .then(r => (r.ok ? r.json() : null))
          .then(d => {
            if (d && d.user_ratings_total) {
              document.querySelectorAll('.arm-review-count').forEach(el => {
                el.textContent = d.user_ratings_total + '+';
              });
            }
          })
          .catch(() => {});
      }

      function initAll() {
        setupMenu();
        setupAccordions();
        setupDesktopDropdowns();
        if ('requestIdleCallback' in window) {
          requestIdleCallback(syncReviewCounts, { timeout: 4000 });
        } else {
          setTimeout(syncReviewCounts, 1500);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
    })();
  </script>
