        if (!menuBtn || !drawer) return;

        function openDrawer() {
          drawer.classList.remove('hidden');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.add('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          requestAnimationFrame(() => {
            drawer.classList.remove('opacity-0');
            const drawerContent = drawer.querySelector('div');
            if (drawerContent) drawerContent.classList.remove('translate-x-full');
          });
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.add('opacity-0');
          const drawerContent = drawer.querySelector('div');
          if (drawerContent) drawerContent.classList.add('translate-x-full');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          setTimeout(() => {
            drawer.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }

        // Keep the trigger's aria-expanded honest - it ships as "false" in the
        // markup and previously never changed, so assistive tech was told the
        // drawer was closed the whole time it was open.
        menuBtn.onclick = function() {
          openDrawer();
          menuBtn.setAttribute('aria-expanded', 'true');
        };
        if (closeBtn) closeBtn.onclick = function() {
          closeDrawer();
          menuBtn.setAttribute('aria-expanded', 'false');
        };
        drawer.onclick = function(e) {
          if (e.target === drawer) {
            closeDrawer();
            menuBtn.setAttribute('aria-expanded', 'false');
          }
        };
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
            closeDrawer();
            menuBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Accordion Logic for Mobile Menu
      function setupAccordions() {
        const btns = document.querySelectorAll('.arm-accordion-btn');
        btns.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            const content = this.nextElementSibling;
            const chevron = this.querySelector('.arm-chevron');
            const isExpanded = this.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              content.classList.add('hidden');
              chevron.classList.remove('rotate-180');
              this.setAttribute('aria-expanded', 'false');
            } else {
              content.classList.remove('hidden');
              chevron.classList.add('rotate-180');
              this.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }

      // Desktop mega-dropdowns.
      //
      // The panels open through Tailwind's group-hover / group-focus-within, so
      // mouse and keyboard users never need JS. This adds two things on top:
      //   1. Keeps each trigger's aria-expanded truthful while a panel is open by
      //      hover or focus (it ships as "false" and CSS can't update it).
      //   2. Tap-only devices (iPad Pro landscape is 1024px and gets this nav):
      //      there is no hover, so the first tap on a trigger opens its panel
      //      instead of navigating and a second tap follows the link. Mouse and
      //      keyboard users are unaffected - hover / focus has already opened the
      //      panel by the time the click lands, so the click just navigates.
      function setupDesktopDropdowns() {
        const items = [];
        document.querySelectorAll('.arm-desktop-nav a.arm-nav-item[aria-controls]').forEach(trigger => {
          const group = trigger.closest('.group');
          const panel = document.getElementById(trigger.getAttribute('aria-controls'));
          if (group && panel) items.push({ trigger, group, panel, shownAt: 0 });
        });
        if (!items.length) return;

        const tapOnly = window.matchMedia('(hover: none)');
        const isVisible = item => getComputedStyle(item.panel).display !== 'none';
        // "pinned" = opened by a tap, held open with an inline style
        const isPinned = item => item.panel.style.display === 'block';
        const sync = item => item.trigger.setAttribute('aria-expanded', isVisible(item) ? 'true' : 'false');
        const pin = item => { item.panel.style.display = 'block'; sync(item); };
        const unpin = item => {
          // removing the inline style hands control back to the hover/focus classes
          item.panel.style.removeProperty('display');
          sync(item);
        };

        items.forEach(item => {
          const { trigger, group } = item;

          trigger.addEventListener('click', e => {
            if (isPinned(item)) return; // second tap: follow the link
            // Touch browsers emulate :hover on the tap itself, so on a tap-only
            // device a panel that appeared in the same instant as this click
            // was opened by this tap - keep it open rather than navigating.
            if (isVisible(item) && (!tapOnly.matches || Date.now() - item.shownAt > 400)) return;
            e.preventDefault();
            items.forEach(unpin);
            pin(item);
          });

          // hover / focus open the panel via CSS; only the attribute needs updating
          group.addEventListener('mouseenter', () => { item.shownAt = Date.now(); sync(item); });
          group.addEventListener('mouseleave', () => { if (!isPinned(item)) sync(item); });
          group.addEventListener('focusin', () => sync(item));
          group.addEventListener('focusout', () => {
            // let focus land first so :focus-within reflects the new target
            setTimeout(() => { if (!isPinned(item)) sync(item); }, 0);
          });
        });

        document.addEventListener('click', e => {
          items.forEach(item => {
            if (isPinned(item) && !item.group.contains(e.target)) unpin(item);
          });
        });

        document.addEventListener('keydown', e => {
          if (e.key !== 'Escape') return;
          items.forEach(item => {
            if (isPinned(item)) { unpin(item); item.trigger.focus(); }
          });
        });
      }

      // Sitewide live review count. Every server-rendered count that should track
      // the real Google total is wrapped in .arm-review-count; this swaps them
      // for the live figure from the cached reviews endpoint. Runs at idle so
      // it never competes with LCP; on any failure the server-rendered number
      // simply stays, so there is no empty or shifting state.
      function syncReviewCounts() {
        if (!document.querySelector('.arm-review-count')) return;
        fetch('/api/reviews.php')
          .then(r => (r.ok ? r.json() : null))
          .then(d => {
            if (d && d.user_ratings_total) {
              document.querySelectorAll('.arm-review-count').forEach(el => {
                el.textContent = d.user_ratings_total + '+';
              });
            }
          })
          .catch(() => {});
      }

      function initAll() {
        setupMenu();
        setupAccordions();
        setupDesktopDropdowns();
        if ('requestIdleCallback' in window) {
          requestIdleCallback(syncReviewCounts, { timeout: 4000 });
        } else {
          setTimeout(syncReviewCounts, 1500);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
    })();
  </script>
</header>
