---
// Header.astro - Car Shire Premium 2-Tier Sharp Automotive Header
---

<header id="arm-site-header" class="w-full font-sans bg-white border-b border-slate-200 z-50 sticky top-0 shadow-sm">
  
  <!-- ==================== TOP TIER: LOGO & DIRECT CONTACT INFO ==================== -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4 flex items-center justify-between gap-4">
    
    <!-- Logo (Sharp, prominent) -->
    <a href="/" class="flex items-center flex-shrink-0 group" aria-label="Armstrong Locksmith Homepage">
      <img 
        src="/logo.png" 
        alt="Armstrong Locksmith Nashville" 
        class="h-12 sm:h-14 md:h-16 w-auto object-contain" 
        loading="eager"
        fetchpriority="high"
        width="260"
        height="66"
      />
    </a>

    <!-- Middle Info Blocks (Car Shire Signature Layout - Hidden on mobile, visible on lg+) -->
    <div class="hidden lg:flex items-center gap-8 text-slate-800">
      
      <!-- Block 1: Phone -->
      <a href="tel:6156258000" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-[#0f274a] text-amber-400 flex items-center justify-center text-lg shrink-0 group-hover:bg-amber-500 group-hover:text-slate-950 transition">
          📞
        </div>
        <div class="text-left">
          <span class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Call Our Technicians</span>
          <span class="block text-sm font-black text-[#0f274a] group-hover:text-amber-600 transition">(615) 625-8000</span>
        </div>
      </a>

      <!-- Block 2: Location -->
      <a href="https://maps.google.com/?q=208+Thompson+Ln,+Nashville,+TN+37211" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-[#0f274a] text-amber-400 flex items-center justify-center text-lg shrink-0 group-hover:bg-amber-500 group-hover:text-slate-950 transition">
          📍
        </div>
        <div class="text-left">
          <span class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Storefront Location</span>
          <span class="block text-sm font-black text-[#0f274a] group-hover:text-amber-600 transition">208 Thompson Ln</span>
        </div>
      </a>

      <!-- Block 3: Hours Modal Trigger -->
      <button type="button" id="arm-view-hours-btn" data-open-hours class="flex items-center gap-3 group text-left cursor-pointer">
        <div class="w-10 h-10 bg-emerald-700 text-white flex items-center justify-center text-lg shrink-0 group-hover:bg-emerald-600 transition">
          ⏱️
        </div>
        <div>
          <span class="block text-[11px] font-bold text-emerald-700 uppercase tracking-wider flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Mobile Dispatch Open</span>
          </span>
          <span class="block text-sm font-black text-[#0f274a] group-hover:text-amber-600 transition">View Store Hours &rarr;</span>
        </div>
      </button>

    </div>

    <!-- Right: Sharp Action Buttons & Mobile Hamburger -->
    <div class="flex items-center gap-3">
      
      <!-- Call Button for Mobile/Tablet (< lg) -->
      <a 
        href="tel:6156258000" 
        class="lg:hidden inline-flex items-center gap-1.5 px-4 py-2.5 bg-[#0f274a] text-white font-black text-xs uppercase tracking-wider shadow transition active:scale-95 border-b-2 border-amber-500"
        aria-label="Call Armstrong Locksmith"
      >
        <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
        <span>(615) 625-8000</span>
      </a>

      <!-- Sharp Booking Button -->
      <a 
        href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow transition active:scale-95 border-b-2 border-amber-600"
      >
        <span>Book Online</span>
        <span>&rarr;</span>
      </a>

      <!-- Mobile Hamburger Button (Sharp) -->
      <button 
        id="arm-mobile-menu-btn" 
        type="button" 
        class="lg:hidden w-10 h-10 bg-[#0f274a] text-white flex items-center justify-center transition focus:outline-none cursor-pointer"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

    </div>

  </div>

  <!-- ==================== BOTTOM TIER: SOLID NAVY NAVIGATION RIBBON ==================== -->
  <div class="hidden lg:block bg-[#0f274a] border-t-2 border-amber-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      
      <!-- Primary Navigation Links (Sharp, uppercase, industrial) -->
      <nav class="flex items-center text-xs font-black uppercase tracking-widest text-slate-100">
        
        <a href="/" class="px-5 py-3.5 bg-amber-500 text-slate-950 border-r border-[#16335c] transition font-black">
          Home
        </a>

        <!-- Dropdown: Automotive Keys -->
        <div class="relative group">
          <a href="/car-key-replacement-nashville/" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition flex items-center gap-1.5 border-r border-[#16335c]">
            <span>Automotive Keys</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 hidden group-hover:block w-72 bg-[#07152b] border-t-2 border-amber-500 shadow-2xl z-50">
            <a href="/car-key-replacement-nashville/" class="block px-5 py-3 text-xs font-bold text-slate-200 hover:bg-[#0f274a] hover:text-amber-400 border-b border-white/5 transition">
              🔑 Car Key Replacement (All Makes)
            </a>
            <a href="/european-car-key-specialist/" class="block px-5 py-3 text-xs font-bold text-amber-400 bg-white/5 hover:bg-[#0f274a] border-b border-white/5 transition">
              🏎️ European Specialist (BMW, Audi, Benz)
            </a>
            <a href="/key-fob-replacement-nashville/" class="block px-5 py-3 text-xs font-bold text-slate-200 hover:bg-[#0f274a] hover:text-amber-400 border-b border-white/5 transition">
              📶 Key Fobs & Proximity Remotes
            </a>
            <a href="/dealer-key/" class="block px-5 py-3 text-xs font-bold text-slate-200 hover:bg-[#0f274a] hover:text-amber-400 border-b border-white/5 transition">
              ⚙️ OEM Dealer Alternative
            </a>
            <a href="/emergency-car-lockout/" class="block px-5 py-3 text-xs font-bold text-slate-200 hover:bg-[#0f274a] hover:text-amber-400 transition">
              🚨 Emergency Vehicle Lockout
            </a>
          </div>
        </div>

        <!-- Dropdown: Locks & Hardware -->
        <div class="relative group">
          <button type="button" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition flex items-center gap-1.5 border-r border-[#16335c]">
            <span>Locks & Hardware</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="absolute top-full left-0 hidden group-hover:block w-72 bg-[#07152b] border-t-2 border-amber-500 shadow-2xl z-50">
            <a href="/residential-locksmith-nashville/" class="block px-5 py-3 text-xs font-bold text-slate-200 hover:bg-[#0f274a] hover:text-amber-400 border-b border-white/5 transition">
              🏡 Residential Locksmith & Rekey
            </a>
            <a href="/commercial-locksmith/" class="block px-5 py-3 text-xs font-bold text-slate-200 hover:bg-[#0f274a] hover:text-amber-400 transition">
              🏢 Commercial Storefront Hardware
            </a>
          </div>
        </div>

        <a href="/locksmith-pricing-nashville/" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition border-r border-[#16335c]">
          Upfront Pricing
        </a>
        <a href="/service-areas/" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition border-r border-[#16335c]">
          Service Areas
        </a>
        <a href="/blog/" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition border-r border-[#16335c]">
          Locksmith Blog
        </a>
        <a href="/about-us/" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition border-r border-[#16335c]">
          About Rahim
        </a>
        <a href="/contact-armstrong-locksmith/" class="px-5 py-3.5 hover:bg-[#16335c] hover:text-amber-400 transition">
          Contact Us
        </a>

      </nav>

      <!-- Right Tag: License & Certification -->
      <div class="text-[11px] font-bold text-slate-300 flex items-center gap-2">
        <span class="text-amber-400">🛡️</span>
        <span>TN State License <strong class="text-white">#406</strong></span>
      </div>

    </div>
  </div>

  <!-- ==================== MOBILE NAVIGATION DRAWER ==================== -->
  <div 
    id="arm-mobile-drawer" 
    class="fixed inset-0 bg-slate-950/80 z-[100] hidden opacity-0 transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  >
    <div class="fixed top-0 right-0 w-80 max-w-[85vw] h-full bg-[#07152b] text-white p-6 shadow-2xl flex flex-col justify-between overflow-y-auto transform translate-x-full transition-transform duration-300 border-l-2 border-amber-500">
      
      <div>
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10">
          <span class="text-xs font-black text-amber-400 uppercase tracking-widest">Menu</span>
          <button id="arm-drawer-close" type="button" class="w-8 h-8 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center font-bold text-lg cursor-pointer">&times;</button>
        </div>

        <nav class="flex flex-col gap-1 text-sm font-bold">
          <a href="/" class="px-4 py-3 bg-amber-500 text-slate-950 font-black uppercase tracking-wider">Home</a>
          <a href="/car-key-replacement-nashville/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 border-b border-white/5 uppercase tracking-wider">Car Key Replacement</a>
          <a href="/european-car-key-specialist/" class="px-4 py-3 bg-white/5 text-amber-400 border-b border-white/5 uppercase tracking-wider">🏎️ European Specialist</a>
          <a href="/residential-locksmith-nashville/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 border-b border-white/5 uppercase tracking-wider">Residential Locksmith</a>
          <a href="/commercial-locksmith/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 border-b border-white/5 uppercase tracking-wider">Commercial Doors</a>
          <a href="/locksmith-pricing-nashville/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 border-b border-white/5 uppercase tracking-wider">Upfront Pricing</a>
          <a href="/service-areas/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 border-b border-white/5 uppercase tracking-wider">Service Areas</a>
          <a href="/about-us/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 border-b border-white/5 uppercase tracking-wider">About Rahim & Team</a>
          <a href="/contact-armstrong-locksmith/" class="px-4 py-3 hover:bg-[#0f274a] text-slate-200 hover:text-amber-400 uppercase tracking-wider">Contact</a>
        </nav>
      </div>

      <div class="pt-6 border-t border-white/10 flex flex-col gap-3">
        <a href="tel:6156258000" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs text-center uppercase tracking-wider shadow flex items-center justify-center gap-2">
          <span>Call (615) 625-8000</span>
        </a>
        <a href="sms:6156258000" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs text-center uppercase tracking-wider shadow flex items-center justify-center gap-2">
          <span>Text Us a Photo</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Operating Hours Modal (Sharp Automotive Style) -->
  <div 
    id="arm-hours-modal" 
    class="fixed inset-0 bg-slate-950/80 z-[110] hidden opacity-0 transition-opacity duration-200 flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative w-full max-w-md bg-white border-t-4 border-amber-500 shadow-2xl overflow-hidden transform scale-95 transition-transform duration-200">
      
      <div class="bg-[#0f274a] px-5 py-4 text-white flex items-center justify-between">
        <div>
          <h2 class="text-sm font-black tracking-widest uppercase font-sans text-white">Store & Service Hours</h2>
          <p class="text-[11px] text-slate-300 font-medium">Armstrong Locksmith Inc &bull; 208 Thompson Ln</p>
        </div>
        <button id="arm-hours-modal-close" type="button" class="w-8 h-8 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center font-bold text-lg cursor-pointer">&times;</button>
      </div>

      <div class="p-6 space-y-4">
        
        <div id="arm-modal-status-box" class="p-3 bg-emerald-50 border border-emerald-300 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span id="arm-modal-dot" class="w-2.5 h-2.5 bg-emerald-500 animate-pulse"></span>
            <strong id="arm-modal-status-text" class="text-xs font-black text-emerald-950 uppercase tracking-wide">Mobile Dispatch Open Now</strong>
          </div>
          <span id="arm-modal-reopen-pill" class="text-[10px] font-bold text-emerald-900 bg-emerald-200/70 px-2 py-0.5">Available</span>
        </div>

        <div class="border border-slate-200 divide-y divide-slate-100 text-xs">
          <div id="day-row-1" class="flex items-center justify-between p-3"><span class="day-name font-bold text-slate-900">Monday</span><span class="font-medium text-slate-700">8:00 AM – 11:30 PM</span></div>
          <div id="day-row-2" class="flex items-center justify-between p-3"><span class="day-name font-bold text-slate-900">Tuesday</span><span class="font-medium text-slate-700">8:00 AM – 11:30 PM</span></div>
          <div id="day-row-3" class="flex items-center justify-between p-3"><span class="day-name font-bold text-slate-900">Wednesday</span><span class="font-medium text-slate-700">8:00 AM – 11:30 PM</span></div>
          <div id="day-row-4" class="flex items-center justify-between p-3"><span class="day-name font-bold text-slate-900">Thursday</span><span class="font-medium text-slate-700">8:00 AM – 11:30 PM</span></div>
          <div id="day-row-5" class="flex items-center justify-between p-3"><span class="day-name font-bold text-slate-900">Friday</span><span class="font-medium text-slate-700">8:00 AM – 11:30 PM</span></div>
          <div id="day-row-6" class="flex items-center justify-between p-3"><span class="day-name font-bold text-slate-900">Saturday</span><span class="font-medium text-slate-700">10:00 AM – 4:00 PM</span></div>
          <div id="day-row-0" class="flex items-center justify-between p-3 bg-slate-50"><span class="day-name font-bold text-slate-900">Sunday</span><span class="font-medium text-emerald-700 font-bold">Mobile Emergency On-Call</span></div>
        </div>

        <div class="pt-2 flex gap-3">
          <a href="tel:6156258000" class="flex-1 py-3 bg-[#0f274a] text-white font-black text-xs uppercase tracking-wider text-center">Call Now</a>
          <a href="https://maps.google.com/?q=208+Thompson+Ln,+Nashville,+TN+37211" target="_blank" rel="noopener noreferrer" class="flex-1 py-3 bg-amber-500 text-slate-950 font-black text-xs uppercase tracking-wider text-center">Get Directions</a>
        </div>

      </div>

    </div>
  </div>

  <script>
    (function() {
      function getNashvilleTime() {
        const now = new Date();
        const str = now.toLocaleString("en-US", { timeZone: "America/Chicago" });
        const nDate = new Date(str);
        return {
          day: nDate.getDay(),
          hour: nDate.getHours(),
          minute: nDate.getMinutes()
        };
      }

      function setupMenu() {
        const menuBtn = document.getElementById('arm-mobile-menu-btn');
        const drawer = document.getElementById('arm-mobile-drawer');
        const closeBtn = document.getElementById('arm-drawer-close');
        if (!menuBtn || !drawer) return;

        const inner = drawer.querySelector('div');

        function openDrawer() {
          drawer.classList.remove('hidden');
          requestAnimationFrame(() => {
            drawer.classList.remove('opacity-0');
            if (inner) inner.classList.remove('translate-x-full');
          });
          document.body.style.overflow = 'hidden';
          menuBtn.setAttribute('aria-expanded', 'true');
        }

        function closeDrawer() {
          drawer.classList.add('opacity-0');
          if (inner) inner.classList.add('translate-x-full');
          setTimeout(() => {
            drawer.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
          menuBtn.setAttribute('aria-expanded', 'false');
        }

        menuBtn.onclick = openDrawer;
        if (closeBtn) closeBtn.onclick = closeDrawer;
        drawer.onclick = function(e) {
          if (e.target === drawer) closeDrawer();
        };
      }

      function setupHoursModal() {
        const modal = document.getElementById('arm-hours-modal');
        const openBtn = document.getElementById('arm-view-hours-btn');
        const closeBtn = document.getElementById('arm-hours-modal-close');
        if (!modal) return;

        function openModal() {
          const { day, hour, minute } = getNashvilleTime();
          for (let i = 0; i <= 6; i++) {
            const row = document.getElementById('day-row-' + i);
            if (row) row.classList.remove('bg-amber-100', 'font-black', 'border-l-4', 'border-amber-500', 'pl-3');
          }
          const todayRow = document.getElementById('day-row-' + day);
          if (todayRow) todayRow.classList.add('bg-amber-100', 'font-black', 'border-l-4', 'border-amber-500', 'pl-3');

          modal.classList.remove('hidden');
          requestAnimationFrame(() => {
            modal.classList.remove('opacity-0');
          });
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal.classList.add('opacity-0');
          setTimeout(() => {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }, 200);
        }

        if (openBtn) openBtn.onclick = openModal;
        if (closeBtn) closeBtn.onclick = closeModal;

        document.querySelectorAll('[data-open-hours]').forEach(el => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            openModal();
          });
        });

        modal.onclick = (e) => {
          if (e.target === modal) closeModal();
        };
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupMenu();
          setupHoursModal();
        });
      } else {
        setupMenu();
        setupHoursModal();
      }
    })();
  </script>
</header>
