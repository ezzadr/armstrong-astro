---
// Header.astro - Desktop mega-navigation + mobile drawer.
//
// Both trees render from src/data/nav.json. They used to be two hand-written
// blocks of markup, which silently drifted: /european-car-key-specialist/ and
// /automotive-locksmith-in-nashville-tn/ were in the desktop menu and missing
// from mobile. Sharing the arrays makes that class of bug impossible.
//
// Anchor text lives in nav.json. Desktop renders first in the DOM and first
// link counts, so those labels are what Google attributes sitewide - they all
// carry the head term of the page they point at.
import { getReviewStats } from '../lib/reviewStats.mjs';
import nav from '../data/nav.json';
// Server-rendered so the count is right before JS runs; .arm-review-count spans are refreshed live by syncReviewCounts() below.
const { reviewCount } = await getReviewStats();
---

<header id="arm-site-header" class="sticky top-0 z-50 w-full bg-white border-b-2 border-slate-200 shadow-sm font-sans">

  <!-- Main Navigation Row -->
  <div class="max-w-[96rem] mx-auto px-4 sm:px-6 xl:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-3 xl:gap-4">

    <!-- Official Company Logo (Ultra-Lightweight 6KB WebP) -->
    <a href="/" class="flex items-center flex-shrink-0 group" aria-label="Armstrong Locksmith Homepage">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="Armstrong Locksmith Nashville"
          class="h-12 sm:h-14 md:h-16 xl:h-18 w-auto object-contain transition-transform group-hover:scale-102"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="200"
          height="153"
        />
      </picture>
    </a>

    <!-- Desktop Navigation (lg: 1024px+).
         `relative` here is what the Car Keys panel anchors to. Labels are kept
         short deliberately: at 1024-1279px the full row (logo + 5 items + both
         CTAs) has to fit, and single-word labels also scan faster than the
         compound "Pricing & Reviews" style they replaced. -->
    <nav class="arm-desktop-nav relative hidden lg:flex items-center divide-x divide-slate-200 border-x border-slate-200 text-[12px] xl:text-[14px] font-bold text-slate-800" aria-label="Main Navigation">

      <!-- Silo 1: Car Keys Mega-Dropdown -->
      <div class="group">
        <a href="/car-key-replacement-nashville/" class="arm-nav-item px-2.5 xl:px-3.5 py-2 hover:text-[#0f274a] hover:bg-slate-50 transition-colors inline-flex items-center gap-1.5 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-car-keys">
          <span class="text-amber-500 text-sm">🚗</span>
          <span>Car Keys</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 group-hover:text-amber-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <!-- 3-Column Mega Dropdown Panel -->
        <div id="arm-menu-car-keys" class="absolute top-full left-0 hidden group-hover:block group-focus-within:block w-[880px] max-w-[calc(100vw-2rem)] bg-white rounded-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 mt-1 text-xs overflow-hidden">
          <div class="h-1 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-600"></div>

          <div class="grid grid-cols-12 gap-5 p-5 xl:p-6 text-left">

            <!-- Col 1: European Specialists (High Ticket) -->
            <div class="col-span-5 bg-slate-50/80 p-4 rounded-xl border border-slate-200/80 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-200">
                  <div class="flex items-center gap-2 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                    <span class="w-5 h-5 rounded bg-[#07152b] text-amber-400 flex items-center justify-center text-[10px]">🏎️</span>
                    <span>European Specialists</span>
                  </div>
                  <span class="text-[9px] bg-amber-100 text-amber-900 border border-amber-300 font-black px-1.5 py-0.5 rounded tracking-wider whitespace-nowrap shrink-0">DEALER LEVEL</span>
                </div>

                <div class="space-y-1.5">
                  {nav.european.map((item) => (
                    <a href={item.href} class="group/item flex items-center justify-between p-2 rounded-lg bg-white border border-slate-200/70 hover:border-amber-400 hover:shadow-xs transition-all">
                      <div>
                        <span class="block text-slate-900 font-bold">{item.label}</span>
                        <span class="block text-[10px] text-slate-500 font-normal">{item.desc}</span>
                      </div>
                      <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all font-bold">&rarr;</span>
                    </a>
                  ))}

                  <div class="grid grid-cols-2 gap-1.5 pt-1">
                    {nav.europeanCompact.map((item) => (
                      <a
                        href={item.href}
                        class={`p-1.5 rounded bg-white border border-slate-200/70 text-slate-800 font-semibold hover:border-amber-400 hover:text-amber-700 text-[11px] truncate${item.wide ? ' col-span-2 text-center' : ''}`}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <a href={nav.europeanHub.href} class="mt-3 block p-2.5 rounded-lg bg-amber-50 hover:bg-amber-100 border border-amber-300 text-amber-950 font-black text-center transition-all duration-200 hover:shadow-xs">
                <span>{nav.europeanHub.label} &rarr;</span>
                <span class="block text-[10px] font-medium text-amber-800">{nav.europeanHub.desc}</span>
              </a>
            </div>

            <!-- Col 2: Popular Domestic & Asian Brands -->
            <div class="col-span-4 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-200">
                  <div class="flex items-center gap-2 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                    <span class="w-5 h-5 rounded bg-slate-200 text-slate-700 flex items-center justify-center text-[10px]">🚗</span>
                    <span>All Makes &amp; Fobs</span>
                  </div>
                  <span class="text-[9px] bg-slate-200 text-slate-800 font-black px-1.5 py-0.5 rounded tracking-wider">OEM CHIP</span>
                </div>

                <div class="grid grid-cols-2 gap-1.5 text-[11px] font-bold">
                  {nav.makes.map((item) => (
                    <a href={item.href} class="p-2 rounded-lg bg-slate-50 hover:bg-amber-50 hover:text-amber-700 text-slate-800 border border-slate-200/70 transition-colors flex items-center justify-between">
                      <span class="truncate">{item.label}</span>
                    </a>
                  ))}
                </div>

                <div class="mt-3 space-y-1 text-[11px]">
                  {nav.keyServices.map((item) => (
                    <a href={item.href} class="block p-1.5 text-slate-700 hover:text-amber-600 font-semibold transition-colors">
                      &bull; {item.label}
                    </a>
                  ))}
                </div>
              </div>

              <a href={nav.makesHub.href} class="mt-3 block p-2 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-900 font-black text-center transition-all duration-200 hover:shadow-xs">
                <span>{nav.makesHub.label} &rarr;</span>
                <span class="block text-[10px] font-medium text-slate-600">{nav.makesHub.desc}</span>
              </a>
            </div>

            <!-- Col 3: Key Technology & Urgent Assistance -->
            <div class="col-span-3 bg-amber-50/70 p-4 rounded-xl border border-amber-200 flex flex-col justify-between">
              <div>
                <div class="w-8 h-8 rounded-lg bg-[#07152b] text-amber-400 flex items-center justify-center font-bold text-sm mb-2.5 shadow-xs">
                  ⚡
                </div>
                <div class="text-xs font-black text-slate-900 uppercase tracking-tight">Lost All Vehicle Keys?</div>
                <p class="text-[11px] text-slate-600 mt-1 leading-relaxed">
                  We decode locks with Lishi tools and originate fresh computerized keys on-site. Zero dealership towing needed.
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-amber-200/80">
                <a href="/emergency-car-lockout/" class="block p-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-black text-center text-[11px] uppercase tracking-wider shadow-sm transition-colors active:scale-95">
                  🚨 Emergency Car Lockout
                </a>
              </div>
            </div>

          </div>

          <!-- Mega Menu Bottom Action Banner -->
          <div class="bg-[#07152b] bg-navy-grid px-6 py-3 border-t border-amber-500/20 flex items-center justify-between text-white text-xs">
            <div class="flex items-center gap-3">
              <span class="flex items-center gap-1.5 text-amber-400 font-bold">
                <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/></svg>
                <span>Walk-In Storefront: 208 Thompson Ln</span>
              </span>
              <span class="hidden md:inline text-slate-500">&bull;</span>
              <span class="hidden md:inline text-slate-300">Prompt Mobile Van Dispatch Across Nashville Metro</span>
            </div>
            <a href="tel:6156258000" class="font-bold text-amber-400 hover:text-white transition-colors flex items-center gap-1">
              <span>Call Store: (615) 625-8000 &rarr;</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Silo 2: Locks & Rekeys (Home & Business) -->
      <div class="relative group">
        <a href="/residential-locksmith-nashville/" class="arm-nav-item px-2.5 xl:px-3.5 py-2 hover:text-[#0f274a] hover:bg-slate-50 transition-colors inline-flex items-center gap-1.5 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-commercial">
          <span class="text-emerald-600 text-sm">🏠</span>
          <span>Locks &amp; Rekeys</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 group-hover:text-amber-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <div id="arm-menu-commercial" class="absolute top-full left-0 hidden group-hover:block group-focus-within:block w-[680px] max-w-[calc(100vw-2rem)] bg-white rounded-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 mt-1 text-xs overflow-hidden">
          <div class="h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-amber-500"></div>

          <div class="grid grid-cols-2 divide-x divide-slate-200 p-5 gap-6 text-left">

            <!-- Residential Security Section -->
            <div>
              <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200">
                <div class="flex items-center gap-2 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                  <span class="w-5 h-5 rounded bg-emerald-100 text-emerald-800 flex items-center justify-center text-[10px]">🏡</span>
                  <span>Home &amp; Residential</span>
                </div>
                <span class="text-[9px] bg-emerald-100 text-emerald-900 border border-emerald-300 font-black px-1.5 py-0.5 rounded tracking-wider">FAMILY</span>
              </div>

              <div class="flex flex-col divide-y divide-slate-100">
                {nav.residential.map((item) => (
                  <a href={item.href} class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-700 font-semibold hover:bg-slate-50 hover:text-[#0f274a] hover:border-l-2 hover:border-amber-500 transition-all">
                    <div>
                      <span class="block text-slate-900 font-bold">{item.label}</span>
                      <span class="block text-[10px] text-slate-500 font-normal">{item.desc}</span>
                    </div>
                    <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all font-bold">&rarr;</span>
                  </a>
                ))}

                <a href="/book-online/" class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-800 font-bold bg-amber-50/60 hover:bg-amber-100 hover:border-l-2 hover:border-amber-500 rounded-lg transition-all mt-1">
                  <div>
                    <span class="block text-slate-900 font-bold">📅 Schedule Lock Service</span>
                    <span class="block text-[10px] text-amber-800 font-medium">Select date &amp; time online</span>
                  </div>
                  <span class="text-amber-600 group-hover/item:translate-x-1 transition-transform font-bold">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Commercial Security Section -->
            <div class="pl-6">
              <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200">
                <div class="flex items-center gap-2 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                  <span class="w-5 h-5 rounded bg-blue-100 text-blue-800 flex items-center justify-center text-[10px]">🏢</span>
                  <span>Commercial Hardware</span>
                </div>
                <span class="text-[9px] bg-blue-100 text-blue-900 border border-blue-300 font-black px-1.5 py-0.5 rounded tracking-wider">BUSINESS</span>
              </div>

              <div class="flex flex-col divide-y divide-slate-100">
                {nav.commercial.map((item) => (
                  <a href={item.href} class="group/item flex items-center justify-between px-2.5 py-2.5 text-slate-700 font-semibold hover:bg-slate-50 hover:text-[#0f274a] hover:border-l-2 hover:border-amber-500 transition-all">
                    <div>
                      <span class="block text-slate-900 font-bold">{item.label}</span>
                      <span class="block text-[10px] text-slate-500 font-normal">{item.desc}</span>
                    </div>
                    <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all font-bold">&rarr;</span>
                  </a>
                ))}

                <a href="/nashville-locksmith-storefront/" class="group/item flex items-center justify-between px-2.5 py-2.5 text-emerald-900 font-bold bg-emerald-50/70 hover:bg-emerald-100 hover:border-l-2 hover:border-emerald-600 rounded-lg transition-all mt-1">
                  <div>
                    <span class="block text-emerald-950 font-black">🏪 Walk-In Storefront Shop</span>
                    <span class="block text-[10px] text-emerald-700 font-normal">208 Thompson Ln &bull; While You Wait</span>
                  </div>
                  <span class="text-emerald-700 group-hover/item:translate-x-1 transition-transform font-bold">&rarr;</span>
                </a>
              </div>
            </div>

          </div>

          <div class="bg-slate-50 px-6 py-2.5 border-t border-slate-200 text-slate-600 text-[11px] flex items-center justify-between">
            <span class="font-medium">🛡️ Master Locksmith &bull; Bonded &amp; Insured Commercial Contractor</span>
            <a href="/contact-armstrong-locksmith/" class="font-bold text-[#0f274a] hover:underline">Get Free Estimate &rarr;</a>
          </div>

        </div>
      </div>

      <!-- Silo 3: Lockout. Direct link, no dropdown - the highest-intent visitor
           on the site should not have to guess which menu it lives under. -->
      <div>
        <a href="/emergency-car-lockout/" class="arm-nav-item px-2.5 xl:px-3.5 py-2 text-red-700 hover:text-white hover:bg-red-600 transition-colors inline-flex items-center gap-1.5 cursor-pointer">
          <span class="text-sm">🚨</span>
          <span>Lockout</span>
        </a>
      </div>

      <!-- Silo 4: Pricing Dropdown -->
      <div class="relative group">
        <a href="/locksmith-pricing-nashville/" class="arm-nav-item px-2.5 xl:px-3.5 py-2 hover:text-[#0f274a] hover:bg-slate-50 transition-colors inline-flex items-center gap-1.5 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-pricing">
          <span class="text-amber-500 text-sm">💰</span>
          <span>Pricing</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 group-hover:text-amber-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <div id="arm-menu-pricing" class="absolute top-full left-0 hidden group-hover:block group-focus-within:block w-80 bg-white rounded-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 mt-1 text-xs overflow-hidden text-left">
          <div class="h-1 bg-gradient-to-r from-amber-500 to-yellow-400"></div>
          <div class="divide-y divide-slate-100 p-2">
            {nav.pricing.map((item) => (
              <a
                href={item.href}
                class={item.feature
                  ? 'group/item flex items-center justify-between p-3 rounded-xl bg-amber-50/60 hover:bg-amber-100 font-bold text-amber-950 transition-colors'
                  : 'group/item flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 text-slate-800 transition-colors'}
              >
                <div>
                  <span class={item.feature ? 'block text-amber-950 font-black' : 'block font-bold text-slate-900'}>
                    {item.icon} {item.label}
                    {item.showCount && <> (<span class="arm-review-count">{reviewCount}+</span>)</>}
                  </span>
                  <span class={item.feature ? 'block text-[10px] text-amber-800 font-normal' : 'block text-[10px] text-slate-500'}>{item.desc}</span>
                </div>
                <span class={item.feature
                  ? 'text-amber-600 group-hover/item:translate-x-1 transition-transform'
                  : 'text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all'}>&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Silo 5: Locations. Shop + areas first, company links visually split
           below so the two intents are not presented as one flat list. -->
      <div class="relative group">
        <a href="/service-areas/" class="arm-nav-item px-2.5 xl:px-3.5 py-2 hover:text-[#0f274a] hover:bg-slate-50 transition-colors inline-flex items-center gap-1.5 cursor-pointer" aria-expanded="false" aria-controls="arm-menu-locations">
          <span class="text-blue-500 text-sm">📍</span>
          <span>Locations</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 group-hover:text-amber-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <div id="arm-menu-locations" class="absolute top-full right-0 hidden group-hover:block group-focus-within:block w-80 bg-white rounded-2xl shadow-[0_20px_50px_rgba(15,23,42,0.18)] border border-slate-200 z-50 mt-1 text-xs overflow-hidden text-left">
          <div class="h-1 bg-gradient-to-r from-blue-600 to-amber-500"></div>
          <div class="divide-y divide-slate-100 p-2">
            {nav.locations.map((item) => (
              <a
                href={item.href}
                class={item.feature
                  ? 'group/item flex items-center justify-between p-3 rounded-xl bg-emerald-50/60 hover:bg-emerald-100 transition-colors'
                  : 'group/item flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 text-slate-800 transition-colors'}
              >
                <div>
                  <span class={item.feature ? 'block font-bold text-emerald-950' : 'block font-bold text-slate-900'}>{item.icon} {item.label}</span>
                  <span class={item.feature ? 'block text-[10px] text-emerald-800' : 'block text-[10px] text-slate-500'}>{item.desc}</span>
                </div>
                <span class={item.feature
                  ? 'text-emerald-700 group-hover/item:translate-x-1 transition-transform font-bold'
                  : 'text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all'}>&rarr;</span>
              </a>
            ))}
          </div>
          <div class="px-2 pb-2">
            <div class="text-[9px] font-black uppercase tracking-wider text-slate-400 px-3 pt-2 pb-1 border-t border-slate-100">The Company</div>
            {nav.company.map((item) => (
              <a href={item.href} class="group/item flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 text-slate-800 transition-colors">
                <div>
                  <span class="block font-bold text-slate-900">{item.icon} {item.label}</span>
                  <span class="block text-[10px] text-slate-500">{item.desc}</span>
                </div>
                <span class="text-amber-500 opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-1 transition-all">&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </div>

    </nav>

    <!-- Header Action CTAs -->
    <div class="flex items-center gap-2.5 flex-shrink-0">

      <!-- Prominent Call Button (Navy & High Contrast) -->
      <a
        href="tel:6156258000"
        class="hidden md:inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 lg:px-3 xl:px-4 py-2 sm:py-2.5 bg-[#0f274a] bg-navy-grid hover:bg-[#16335c] text-white font-black text-xs sm:text-sm shadow transition active:scale-95 whitespace-nowrap border border-slate-700"
        aria-label="Call Armstrong Locksmith at (615) 625-8000"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
        <span>CALL (615) 625-8000</span>
      </a>

      <!-- Book Online Button (Desktop >= 768px) - Gold Metallic Exact Match -->
      <a
        href="/book-online/"
        class="hidden md:inline-flex items-center justify-center px-4 lg:px-3 xl:px-4 py-2 sm:py-2.5 bg-gold-metallic hover:brightness-105 text-[#07152b] font-black text-xs sm:text-sm shadow-md transition active:scale-95 whitespace-nowrap border-b-2 border-amber-600 cursor-pointer"
        aria-label="Book Locksmith Service Online"
      >
        <span>Book Online</span>
      </a>

      <!-- Mobile Menu Toggle Button (Luxury Showroom Styling) -->
      <button
        id="arm-mobile-menu-btn"
        type="button"
        class="lg:hidden flex items-center gap-1.5 px-2.5 sm:px-3 py-2 bg-[#07152b] border border-amber-500/60 hover:border-amber-400 text-amber-400 hover:text-white shadow-md active:scale-95 transition-all duration-200 cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
      >
        <div class="flex flex-col gap-1 w-4 shrink-0 pointer-events-none">
          <span class="w-full h-0.5 bg-amber-400 group-hover:bg-amber-300 transition-colors"></span>
          <span class="w-full h-0.5 bg-amber-400 group-hover:bg-amber-300 transition-colors"></span>
