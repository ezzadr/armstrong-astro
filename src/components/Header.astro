            <!-- Col 2: Popular Domestic & Asian Brands -->
            <div class="col-span-4 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-200">
                  <div class="flex items-center gap-2 font-heading font-black tracking-wider uppercase text-[11px] text-slate-900">
                    <span class="w-5 h-5 rounded bg-slate-200 text-slate-700 flex items-center justify-center text-[10px]">🚗</span>
                    <span>All Makes &amp; Fobs</span>
                  </div>
                  <span class="text-[9px] bg-slate-200 text-slate-800 font-black px-1.5 py-0.5 rounded tracking-wider">OEM CHIP</span>
