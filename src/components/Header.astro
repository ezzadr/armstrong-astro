  <script is:inline>
    (function () {
      function getNashvilleTime() {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Chicago',
          weekday: 'short',
          hour: 'numeric',
          minute: 'numeric',
          hour12: false
        }).formatToParts(new Date());

        const dayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        const m = {};
        parts.forEach(p => { if (p.type !== 'literal') m[p.type] = p.value; });
        return { day: dayMap[m.weekday], hour: parseInt(m.hour, 10), minute: parseInt(m.minute, 10) };
      }

      function updateStatus() {
        const badge = document.getElementById('arm-status-badge');
        if (!badge) return;

        const { day, hour, minute } = getNashvilleTime();
        const cur = hour * 60 + minute;
        const wOpen = 8 * 60, wClose = 23 * 60 + 30;
        const sOpen = 10 * 60, sClose = 16 * 60;

        let isOpen = false;
        if (day >= 1 && day <= 5) {
          isOpen = cur >= wOpen && cur <= wClose;
        } else if (day === 6) {
          isOpen = cur >= sOpen && cur <= sClose;
        }

        const text = badge.querySelector('.status-text');

        if (isOpen) {
          badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-bold uppercase tracking-wider text-[9px] sm:text-[10px]';
          if (text) text.textContent = 'Open';
        } else {
          badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold uppercase tracking-wider text-[9px] sm:text-[10px]';
          if (text) text.textContent = 'On-Call';
        }
      }

      // Smart After Hours Banner Detection
      function checkAfterHours() {
        const banner = document.getElementById('arm-after-hours-banner');
        const reopenEl = document.getElementById('arm-reopen-time');
        const closeBtn = document.getElementById('arm-close-banner-btn');
        if (!banner) return;

        if (sessionStorage.getItem('arm_banner_dismissed') === 'true') {
          return;
        }

        const { day, hour, minute } = getNashvilleTime();
        const cur = hour * 60 + minute;
        const wOpen = 8 * 60, wClose = 23 * 60 + 30; // Mon-Fri: 8:00 AM - 11:30 PM
        const sOpen = 10 * 60, sClose = 16 * 60;      // Sat: 10:00 AM - 4:00 PM

        let isOpen = false;
        let reopenText = "Monday at 8:00 AM";

        if (day >= 1 && day <= 4) { // Mon-Thu
          if (cur >= wOpen && cur <= wClose) {
            isOpen = true;
          } else if (cur < wOpen) {
            reopenText = "today at 8:00 AM";
          } else {
            reopenText = "tomorrow at 8:00 AM";
          }
        } else if (day === 5) { // Friday
          if (cur >= wOpen && cur <= wClose) {
            isOpen = true;
          } else if (cur < wOpen) {
            reopenText = "today at 8:00 AM";
          } else {
            reopenText = "Saturday at 10:00 AM";
          }
        } else if (day === 6) { // Saturday
          if (cur >= sOpen && cur <= sClose) {
            isOpen = true;
          } else if (cur < sOpen) {
            reopenText = "today at 10:00 AM";
          } else {
            reopenText = "Monday at 8:00 AM (Mobile on-call Sunday)";
          }
        } else if (day === 0) { // Sunday
          isOpen = true; // Sunday on-call
        }

        if (!isOpen) {
          if (reopenEl) reopenEl.textContent = reopenText;
          banner.classList.remove('hidden');
        } else {
          banner.classList.add('hidden');
        }

        if (closeBtn) {
          closeBtn.onclick = function() {
            banner.classList.add('hidden');
            sessionStorage.setItem('arm_banner_dismissed', 'true');
          };
        }
      }

      checkAfterHours();
      updateStatus();
      setInterval(() => {
        updateStatus();
        checkAfterHours();
      }, 60000);

      // Mobile Menu Drawer Toggle
      function setupMenu() {
        const menuBtn = document.getElementById('arm-mobile-menu-btn');
        const drawer = document.getElementById('arm-mobile-drawer');
        const closeBtn = document.getElementById('arm-drawer-close');

        if (!menuBtn || !drawer) return;

        function openDrawer() {
          drawer.classList.remove('hidden');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.add('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          requestAnimationFrame(() => {
            drawer.classList.remove('opacity-0');
            const drawerContent = drawer.querySelector('div');
            if (drawerContent) drawerContent.classList.remove('translate-x-full');
          });
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.add('opacity-0');
          const drawerContent = drawer.querySelector('div');
          if (drawerContent) drawerContent.classList.add('translate-x-full');
          const callBar = document.getElementById('arm-mobile-callbar');
          if (callBar) {
            callBar.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-full');
          }
          setTimeout(() => {
            drawer.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }

        menuBtn.onclick = openDrawer;
        if (closeBtn) closeBtn.onclick = closeDrawer;
        drawer.onclick = function(e) {
          if (e.target === drawer) closeDrawer();
        };
      }

      // Operating Hours Modal Logic
      function setupHoursModal() {
        const modal = document.getElementById('arm-hours-modal');
        const openBtn = document.getElementById('arm-view-hours-btn');
        const closeBtn = document.getElementById('arm-hours-modal-close');
        const statusBox = document.getElementById('arm-modal-status-box');
        const statusText = document.getElementById('arm-modal-status-text');
        const reopenPill = document.getElementById('arm-modal-reopen-pill');
        const dot = document.getElementById('arm-modal-dot');

        if (!modal) return;

        function openModal() {
          const { day, hour, minute } = getNashvilleTime();
          const cur = hour * 60 + minute;
          const wOpen = 8 * 60, wClose = 23 * 60 + 30;
          const sOpen = 10 * 60, sClose = 16 * 60;

          // Highlight today's row
          for (let i = 0; i <= 6; i++) {
            const row = document.getElementById('day-row-' + i);
            if (row) {
              row.classList.remove('bg-amber-100', 'text-amber-950', 'font-black', 'border-l-4', 'border-amber-500', 'pl-3');
              const badge = row.querySelector('.today-badge');
              if (badge) badge.remove();
            }
          }

          const todayRow = document.getElementById('day-row-' + day);
          if (todayRow) {
            todayRow.classList.add('bg-amber-100', 'text-amber-950', 'font-black', 'border-l-4', 'border-amber-500', 'pl-3');
            const dayName = todayRow.querySelector('.day-name');
            if (dayName && !todayRow.querySelector('.today-badge')) {
              const badge = document.createElement('span');
              badge.className = 'today-badge ml-2 text-[10px] uppercase tracking-wider bg-amber-500 text-slate-950 px-1.5 py-0.5 rounded font-black';
              badge.textContent = 'TODAY';
              dayName.appendChild(badge);
            }
          }

          // Check current open/closed
          let isOpen = false;
          let reopenStr = "Reopening Mon 8:00 AM";

          if (day >= 1 && day <= 5) {
            if (cur >= wOpen && cur <= wClose) isOpen = true;
            else if (cur < wOpen) reopenStr = "Reopening Today 8:00 AM";
            else reopenStr = day === 5 ? "Reopening Sat 10:00 AM" : "Reopening Tomorrow 8:00 AM";
          } else if (day === 6) {
            if (cur >= sOpen && cur <= sClose) isOpen = true;
            else if (cur < sOpen) reopenStr = "Reopening Today 10:00 AM";
            else reopenStr = "Mobile Dispatch On-Call Sunday";
          } else {
            isOpen = true; // Sunday on-call
          }

          if (isOpen) {
            if (statusBox) statusBox.className = 'p-3 rounded-2xl bg-emerald-50 border border-emerald-300 flex items-center justify-between gap-2';
            if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
            if (statusText) {
              statusText.textContent = 'Status: Open Now';
              statusText.className = 'text-xs font-black text-emerald-950 uppercase tracking-wide';
            }
            if (reopenPill) {
              reopenPill.textContent = 'Available Now';
              reopenPill.className = 'text-[10px] sm:text-[11px] font-bold text-emerald-900 bg-emerald-200/70 px-2 py-0.5 rounded-full';
            }
          } else {
            if (statusBox) statusBox.className = 'p-3 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-between gap-2';
            if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse';
            if (statusText) {
              statusText.textContent = 'Status: Currently Closed';
              statusText.className = 'text-xs font-black text-amber-950 uppercase tracking-wide';
            }
            if (reopenPill) {
              reopenPill.textContent = reopenStr;
              reopenPill.className = 'text-[10px] sm:text-[11px] font-bold text-amber-900 bg-amber-200/70 px-2 py-0.5 rounded-full';
            }
          }

          modal.classList.remove('hidden');
          requestAnimationFrame(() => {
            modal.classList.remove('opacity-0');
            const card = modal.querySelector('div');
            if (card) card.classList.remove('scale-95');
          });
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal.classList.add('opacity-0');
          const card = modal.querySelector('div');
          if (card) card.classList.add('scale-95');
          setTimeout(() => {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }, 200);
        }

        if (openBtn) openBtn.onclick = openModal;
        if (closeBtn) closeBtn.onclick = closeModal;

        // Catch any link with href="#storefront-hours" or [data-open-hours]
        document.querySelectorAll('a[href="#storefront-hours"], a[href="/#storefront-hours"], [data-open-hours]').forEach(el => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            openModal();
          });
        });

        modal.onclick = (e) => {
          if (e.target === modal) closeModal();
        };

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setupMenu();
          setupHoursModal();
        });
      } else {
        setupMenu();
        setupHoursModal();
      }
    })();
  </script>
</header>
