---
// PromoPopup.astro - Dual Responsive Storefront Offer: Micro-Pill (Mobile) & Compact Card (Desktop)
import promo from '../data/promo.json';

if (!promo || !promo.active) {
  return;
}
---

<!-- 1. MOBILE VIEW: Concept 1 Micro-Pill (< 768px) -->
<div 
  id="arm-promo-mobile" 
  class="md:hidden fixed z-40 bottom-[64px] left-3 right-3 sm:left-auto sm:right-6 sm:max-w-sm transition-all duration-300 ease-out opacity-0 translate-y-3 pointer-events-none will-change-transform"
  role="region"
  aria-label="Storefront Promotional Offer"
>
  <div class="bg-white border-2 border-emerald-500 rounded-full shadow-[0_12px_36px_rgba(0,0,0,0.35)] p-1.5 pl-3 pr-2 flex items-center justify-between gap-2.5 ring-4 ring-emerald-500/15">
    
    <!-- Left: Emerald Badge & Storefront text (Clicking opens Google Maps GPS) -->
    <a 
      href={promo.directionsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center gap-2.5 min-w-0 flex-1 hover:opacity-90 transition-opacity"
      title="Get GPS Directions to 208 Thompson Ln"
    >
      <span class="bg-emerald-600 text-white text-[10px] font-black px-2.5 py-1 rounded-full shrink-0 shadow-xs">
        {promo.discountBadge}
      </span>
      <div class="truncate text-left leading-tight">
        <span class="block text-xs font-black text-slate-950 tracking-tight truncate">{promo.mobileText}</span>
        <span class="block text-[9.5px] text-slate-600 font-bold truncate">📍 208 Thompson Ln • Code: {promo.promoCode}</span>
      </div>
    </a>

    <!-- Right: Dismiss Button -->
    <button 
      type="button" 
      class="arm-promo-close-btn w-6 h-6 rounded-full bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-500 hover:text-slate-900 flex items-center justify-center text-xs font-bold transition cursor-pointer shrink-0"
      aria-label="Dismiss offer"
    >
      ✕
    </button>

  </div>
</div>

<!-- 2. DESKTOP VIEW: Sleek Bento Card (>= 768px) -->
<div 
  id="arm-promo-desktop" 
  class="hidden md:block fixed z-40 bottom-6 right-6 w-[340px] transition-all duration-300 ease-out opacity-0 translate-y-3 pointer-events-none will-change-transform"
  role="region"
  aria-label="Storefront Promotional Offer"
>
  <div class="relative bg-[#0a192f] text-white rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-slate-700/80 p-4.5 overflow-hidden ring-1 ring-white/10">
    
    <!-- Top Emerald Accent Line -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-600"></div>

    <!-- Close Button -->
    <button 
      type="button" 
      class="arm-promo-close-btn absolute top-3.5 right-3.5 w-6 h-6 rounded-full bg-slate-800/90 hover:bg-slate-700 active:bg-slate-600 text-slate-400 hover:text-white flex items-center justify-center text-xs font-bold transition cursor-pointer"
      aria-label="Dismiss discount offer"
    >
      ✕
    </button>

    <!-- Header Badges: Emerald Discount + Clean Code Pill -->
    <div class="flex items-center gap-2 mb-2.5 pr-6">
      <span class="inline-flex items-center gap-1 bg-emerald-500 text-slate-950 font-black text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
        <span>🏪</span> {promo.discountBadge} IN SHOP
      </span>
      <span class="text-[11px] font-mono font-bold text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2 py-0.5 rounded-md">
        Code: {promo.promoCode}
      </span>
    </div>

    <!-- Offer Title (Tapping opens shop directions) -->
    <a 
      href={promo.directionsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="group block mb-1.5"
      title="Get Directions to 208 Thompson Ln"
    >
      <h3 class="text-sm font-black text-white group-hover:text-emerald-400 transition-colors leading-snug flex items-center justify-between">
        <span>{promo.title}</span>
        <span class="text-emerald-400 text-xs opacity-80 group-hover:translate-x-0.5 transition-transform ml-1 shrink-0">&rarr;</span>
      </h3>
    </a>

    <!-- Location & Subtitle -->
    <p class="text-[11.5px] text-slate-300 leading-relaxed mb-3">
      {promo.subtitle}
    </p>

    <!-- Storefront Hours & Address Bar -->
    <a 
      href={promo.directionsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="block p-2 rounded-xl bg-slate-800/60 border border-slate-700/60 hover:border-emerald-500/50 hover:bg-slate-800 text-[10.5px] text-slate-300 transition"
    >
      <div class="flex items-center gap-1.5 font-bold text-emerald-400 mb-0.5">
        <span>📍</span>
        <span>208 Thompson Ln, Nashville, TN 37211</span>
      </div>
      <div class="text-[9.5px] text-slate-400 pl-4">
        {promo.footnote}
      </div>
    </a>

  </div>
</div>

<script is:inline>
  (function() {
    const storageKey = 'arm_promo_dismissed_v6';

    function init() {
      try {
        if (sessionStorage.getItem(storageKey)) return;
      } catch (e) {}

      const mob = document.getElementById('arm-promo-mobile');
      const dsk = document.getElementById('arm-promo-desktop');

      function reveal() {
        if (mob) {
          mob.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
          mob.classList.add('opacity-100', 'translate-y-0');
        }
        if (dsk) {
          dsk.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
          dsk.classList.add('opacity-100', 'translate-y-0');
        }
      }

      // Smooth reveal 500ms after DOM ready
      setTimeout(reveal, 500);

      document.querySelectorAll('.arm-promo-close-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (mob) {
            mob.classList.remove('opacity-100', 'translate-y-0');
            mob.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
          }
          if (dsk) {
            dsk.classList.remove('opacity-100', 'translate-y-0');
            dsk.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
          }
          try {
            sessionStorage.setItem(storageKey, '1');
          } catch (err) {}
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
