---
// PromoPopup.astro - Ultra-Minimal, High-Performance Storefront Deal Pill
import promo from '../data/promo.json';

if (!promo || !promo.active) {
  return;
}
---

<div 
  id="arm-promo-pill"
  class="fixed z-40 bottom-[64px] left-3 right-3 sm:left-auto sm:right-6 sm:max-w-sm md:bottom-6 opacity-0 translate-y-4 pointer-events-none transition-all duration-300 ease-out will-change-transform"
  role="region"
  aria-label="Storefront Discount Offer"
>
  <div class="bg-slate-900/95 backdrop-blur-md border border-amber-500/70 rounded-full shadow-[0_12px_32px_rgba(0,0,0,0.4)] p-1.5 pl-3 flex items-center justify-between gap-2.5 ring-2 ring-black/40">
    
    <!-- Left: Badge & Storefront text (Clicking takes user to Google Maps GPS) -->
    <a 
      href={promo.directionsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center gap-2 min-w-0 flex-1 hover:opacity-95 transition-opacity"
      title="Get GPS Directions to 208 Thompson Ln"
    >
      <span class="bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 text-[10px] font-black px-2.5 py-1 rounded-full shrink-0 shadow-2xs">
        {promo.discountBadge}
      </span>
      <div class="truncate text-left leading-tight">
        <span class="block text-xs font-bold text-white tracking-tight truncate">{promo.text}</span>
        <span class="block text-[9.5px] text-amber-400 font-medium truncate">{promo.subtext}</span>
      </div>
    </a>

    <!-- Right: GPS Navigation Action & Dismiss Button -->
    <div class="flex items-center gap-1.5 shrink-0">
      <a 
        href={promo.directionsUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-3.5 py-1.5 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 hover:brightness-105 active:scale-95 text-slate-950 font-black text-xs rounded-full flex items-center gap-1 shadow-xs transition"
        aria-label="Get GPS Directions to 208 Thompson Ln"
      >
        <span>{promo.buttonText}</span>
        <span class="font-bold">&rarr;</span>
      </a>

      <button 
        id="arm-promo-close" 
        type="button" 
        class="w-6 h-6 rounded-full bg-slate-800 hover:bg-slate-700 active:bg-slate-600 text-slate-400 hover:text-white flex items-center justify-center text-xs font-bold transition cursor-pointer"
        aria-label="Dismiss offer"
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>
</div>

<script is:inline define:vars={{ promoCode: promo.promoCode }}>
  (function() {
    const storageKey = 'arm_promo_dismissed_' + promoCode;

    function initPromo() {
      try {
        if (sessionStorage.getItem(storageKey)) return;
      } catch (e) {}

      const pill = document.getElementById('arm-promo-pill');
      const closeBtn = document.getElementById('arm-promo-close');
      if (!pill) return;

      // Reveal after initial paint / idle time (zero LCP or render blocking)
      setTimeout(() => {
        pill.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        pill.classList.add('opacity-100', 'translate-y-0');
      }, 1000);

      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          pill.classList.remove('opacity-100', 'translate-y-0');
          pill.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          try {
            sessionStorage.setItem(storageKey, '1');
          } catch (err) {}
        });
      }
    }

    if (document.readyState === 'complete') {
      initPromo();
    } else {
      window.addEventListener('load', () => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(initPromo);
        } else {
          setTimeout(initPromo, 800);
        }
      });
    }
  })();
</script>
