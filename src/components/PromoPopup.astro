---
// PromoPopup.astro - In-shop discount offer.
// The discount is the whole point of this card, so it is the biggest thing in
// it: one huge number, one line saying what it is for, one button. Everything
// else (promo code, hours) is a footnote.
// Colours are a bright yellow (Tailwind yellow-400) with black text, and the
// navy from the header for the button so the one action still reads as a
// button against the yellow.
import promo from '../data/promo.json';

if (!promo || !promo.active) {
  return;
}
---

<!-- 1. MOBILE: bold yellow bar (< 768px) -->
<div
  id="arm-promo-mobile"
  class="md:hidden fixed z-40 bottom-[64px] left-3 right-3 transition-all duration-300 ease-out opacity-0 translate-y-3 pointer-events-none will-change-transform"
  role="region"
  aria-label="In-shop car key discount"
>
  <div class="bg-yellow-400 border-2 border-yellow-500 rounded-2xl shadow-[0_12px_36px_rgba(0,0,0,0.4)] ring-4 ring-yellow-400/25 p-2 flex items-center gap-2.5">

    <!-- Whole row is the tap target for directions -->
    <a
      href={promo.directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 min-w-0 flex-1 active:opacity-80 transition-opacity"
      title="Get directions to 208 Thompson Ln"
    >
      <!-- The number -->
      <span class="shrink-0 text-center leading-none text-black">
        <span class="block text-[30px] font-black tracking-tighter">{promo.discountNumber}</span>
        <span class="block text-[10px] font-black tracking-[0.18em] mt-0.5">{promo.discountWord}</span>
      </span>

      <span class="w-px self-stretch bg-black/25 shrink-0"></span>

      <span class="min-w-0 text-left">
        <span class="block text-[14px] font-black text-black leading-tight tracking-tight">{promo.mobileText}</span>
        <span class="block text-[11px] font-bold text-black/70 truncate mt-0.5">📍 {promo.mobileSubtext}</span>
      </span>
    </a>

    <button
      type="button"
      class="arm-promo-close-btn w-7 h-7 rounded-full bg-black/15 hover:bg-black/25 active:bg-black/35 text-black flex items-center justify-center text-xs font-bold transition cursor-pointer shrink-0 self-start"
      aria-label="Dismiss offer"
    >
      ✕
    </button>

  </div>
</div>

<!-- 2. DESKTOP: the number fills the card (>= 768px) -->
<div
  id="arm-promo-desktop"
  class="hidden md:block fixed z-40 bottom-6 right-6 w-[330px] transition-all duration-300 ease-out opacity-0 translate-y-3 pointer-events-none will-change-transform"
  role="region"
  aria-label="In-shop car key discount"
>
  <div class="relative bg-yellow-400 text-black rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.45)] border-2 border-yellow-500 overflow-hidden">

    <button
      type="button"
      class="arm-promo-close-btn absolute top-3 right-3 z-10 w-7 h-7 rounded-full bg-black/15 hover:bg-black/25 active:bg-black/35 text-black flex items-center justify-center text-xs font-bold transition cursor-pointer"
      aria-label="Dismiss offer"
    >
      ✕
    </button>

    <div class="p-5">

      <!-- THE NUMBER. Everything else on this card is secondary to it. -->
      <div class="flex items-end gap-2 leading-none text-black">
        <span class="text-[68px] font-black tracking-tighter leading-[0.8]">{promo.discountNumber}</span>
        <span class="text-[26px] font-black uppercase tracking-tight pb-1.5">{promo.discountWord}</span>
      </div>

      <p class="mt-3 text-[15px] font-black uppercase tracking-tight text-black leading-tight">
        {promo.headline}
      </p>
      <p class="mt-1.5 text-xs text-black/75 leading-relaxed font-medium">
        {promo.subtitle}
      </p>

      <!-- One action. Navy so it still reads as a button on yellow. -->
      <a
        href={promo.directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex items-center justify-center gap-1.5 w-full bg-[#0f274a] hover:bg-[#16345f] active:bg-[#0a1c38] text-white font-black text-sm uppercase tracking-wide py-3 rounded-xl transition-colors shadow-lg shadow-black/20"
      >
        <span>📍</span>
        <span>{promo.ctaLabel}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <p class="mt-2.5 text-center text-[10px] text-black/70 leading-relaxed font-medium">
        <span class="font-mono font-black text-black">{promo.promoCode}</span>
        <span class="mx-1">·</span>
        {promo.location}
      </p>
      <p class="text-center text-[10px] text-black/60 mt-0.5 font-medium">
        {promo.footnote}
      </p>

    </div>
  </div>
</div>

<script is:inline>
  (function() {
    // Bumped with each redesign so people who dismissed the old card see this one.
    const storageKey = 'arm_promo_dismissed_v8';

    function init() {
      try {
        if (sessionStorage.getItem(storageKey)) return;
      } catch (e) {}

      const mob = document.getElementById('arm-promo-mobile');
      const dsk = document.getElementById('arm-promo-desktop');

      function reveal() {
        [mob, dsk].forEach(function(el) {
          if (!el) return;
          el.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
          el.classList.add('opacity-100', 'translate-y-0');
        });
      }

      setTimeout(reveal, 500);

      document.querySelectorAll('.arm-promo-close-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          [mob, dsk].forEach(function(el) {
            if (!el) return;
            el.classList.remove('opacity-100', 'translate-y-0');
            el.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
          });
          try {
            sessionStorage.setItem(storageKey, '1');
          } catch (err) {}
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
