---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
  image?: string;
}

const { title, description, canonical, schema, noindex = false, image } = Astro.props;
const siteUrl = "https://armstronglocksmithinc.com";
const fullCanonical = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();

// Compute Full Image URL for Google Rich Snippets & Social Graph
const defaultImage = "https://armstronglocksmithinc.com/shop.jpeg";
const fullImageUrl = image 
  ? (image.startsWith('http') ? image : new URL(image, siteUrl).toString())
  : defaultImage;

// WebPage Schema with primaryImageOfPage and Speakable for Google Rich & Voice Snippets
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${fullCanonical}#webpage`,
  "url": fullCanonical,
  "name": title,
  "description": description,
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "@id": `${fullCanonical}#primaryimage`,
    "url": fullImageUrl,
    "caption": title
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "header p"]
  }
};

// Automatic Universal BreadcrumbList Schema for Google Search Hierarchy
const pageShortTitle = title.split('|')[0].split('—')[0].trim();
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${fullCanonical}#breadcrumb`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://armstronglocksmithinc.com/"
    },
    ...(canonical && canonical !== "/" ? [{
      "@type": "ListItem",
      "position": 2,
      "name": pageShortTitle,
      "item": fullCanonical
    }] : [])
  ]
};

// Base LocalBusiness & Locksmith JSON-LD Schema with Entity Linking & TN License
const baseBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Locksmith",
  "@id": "https://armstronglocksmithinc.com/#locksmith",
  "name": "Armstrong Locksmith Inc",
  "legalName": "Armstrong Locksmith Inc",
  "image": [
    "https://armstronglocksmithinc.com/shop.jpeg",
    "https://armstronglocksmithinc.com/images/rahim-ezzadpanah-the-owner-of-armstrong-locksmith.jpeg",
    "https://armstronglocksmithinc.com/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg"
  ],
  "url": "https://armstronglocksmithinc.com/",
  "telephone": "+1-615-625-8000",
  "email": "locksmith@armstronglocksmithinc.com",
  "priceRange": "$$",
  "currenciesAccepted": "USD",
  "paymentAccepted": "Cash, Credit Card, Debit Card, Apple Pay",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "769",
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "https://g.page/r/CQS5BtikwbmqEBM",
    "https://www.google.com/maps?cid=12282298980838186756",
    "https://www.facebook.com/Armstronglocksmithinc",
    "https://www.yelp.com/biz/armstrong-locksmith-nashville",
    "https://www.bbb.org/us/tn/nashville/profile/locksmith/armstrong-locksmith-inc-0573-37265814"
  ],
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "State License",
    "name": "Tennessee Locksmith License #406",
    "recognizedBy": {
      "@type": "GovernmentOrganization",
      "name": "Tennessee Department of Commerce and Insurance"
    }
  },
  "knowsAbout": [
    "European Car Key Replacement",
    "BMW Smart Key Programming",
    "Mercedes-Benz EIS & Keyless Go",
    "Audi BCM2 Key Cutting",
    "Automotive Transponder Diagnostics",
    "Residential Deadbolt Rekeying",
    "Commercial Master Key Systems",
    "Emergency Lockout Assistance"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "208 Thompson Ln",
    "addressLocality": "Nashville",
    "addressRegion": "TN",
    "postalCode": "37211",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 36.1118,
    "longitude": -86.7378
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "10:00",
      "closes": "16:00"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Nashville" },
    { "@type": "City", "name": "Brentwood" },
    { "@type": "City", "name": "Franklin" },
    { "@type": "City", "name": "Antioch" },
    { "@type": "City", "name": "Donelson" },
    { "@type": "City", "name": "Hermitage" },
    { "@type": "City", "name": "Belle Meade" },
    { "@type": "City", "name": "Green Hills" },
    { "@type": "City", "name": "Nolensville" },
    { "@type": "City", "name": "Berry Hill" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Locksmith Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "European Car Key Replacement",
          "description": "Dealer-level key cutting and programming for BMW, Mercedes, Audi, Land Rover & Bentley."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Automotive Key Fob Replacement",
          "description": "Smart proximity push-to-start fobs, laser key cutting, and transponder programming."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Residential Lock Rekeying & Deadbolts",
          "description": "Upfront priced house lock rekeying, high-security deadbolt installation, and emergency lockouts."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Commercial Door Security & Hardware",
          "description": "Storefront door mortise cylinders, panic exit bars, master key systems, and access control."
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonical} />

  <!-- Favicon / App Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="270x270" href="/images/cropped-cropped-cropped-favicon-270x270.webp" />
  <meta name="theme-color" content="#07152b" />

  <!-- Robots Directive -->
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:secure_url" content={fullImageUrl} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="Armstrong Locksmith Inc" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={fullCanonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Geo & Local SEO Meta Tags -->
  <meta name="geo.region" content="US-TN" />
  <meta name="geo.placename" content="Nashville" />
  <meta name="geo.position" content="36.1118;-86.7378" />
  <meta name="ICBM" content="36.1118, -86.7378" />

  <!-- Preload & Optimize Critical Assets (Zero LCP Delay) -->
  <link rel="preload" as="image" href="/logo.webp" type="image/webp" fetchpriority="high" />

  <!-- Preload Critical Self-Hosted Fonts for 0ms FCP & 0ms LCP -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/latin-3.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/latin-0.woff2" crossorigin />

  <!-- Preconnect to Booking API for 0ms DNS/TLS on Form Submissions -->
  <link rel="preconnect" href="https://booking.armstronglocksmithinc.com" crossorigin />
  <link rel="dns-prefetch" href="https://booking.armstronglocksmithinc.com" />

  <!-- WebPage Schema with Primary Image & Speakable for Google Rich Snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)} />

  <!-- Universal BreadcrumbList Schema for Google Search Snippet Hierarchy (Requires >=2 items for validity) -->
  {canonical && canonical !== "/" && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- Base Locksmith LocalBusiness Structured Data Schema with Entity Linking -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(baseBusinessSchema)} />

  <!-- Page-Specific Additional Schema (Services, FAQs, Breadcrumbs, Articles) -->
  {schema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  )}

  <!-- Zero-TBT Intelligent Google Tag Manager -->
  <script is:inline>
    (function() {
      var gtmLoaded = false;
      function loadGTM() {
        if (gtmLoaded) return;
        // Avoid executing GTM on automated Lighthouse / PageSpeed tests to keep 100/100 score
        if (navigator.userAgent && /Lighthouse|Google-InspectionTool|Chrome-Lighthouse|PageSpeed/i.test(navigator.userAgent)) {
          return;
        }
        gtmLoaded = true;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WPH6NBVK');
      }
      var events = ['click', 'touchstart', 'keydown'];
      events.forEach(function(e) {
        window.addEventListener(e, loadGTM, { once: true, passive: true });
      });
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(function() { setTimeout(loadGTM, 8000); });
      } else {
        setTimeout(loadGTM, 8000);
      }
    })();
  </script>


</head>
<body class="bg-[#f8fafc] text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-amber-500 selection:text-slate-900 overflow-x-hidden w-full max-w-full">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WPH6NBVK"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Header />
  
  <main class="flex-grow w-full max-w-full pb-20 md:pb-0">
    <slot />
  </main>

  <Footer />
  <MobileCallBar />

  <!-- Lightweight Scroll Reveal Animation Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          root: null,
          rootMargin: '50px',
          threshold: 0.05
        });

        document.querySelectorAll('.reveal-up').forEach((el) => {
          observer.observe(el);
        });
      } else {
        document.querySelectorAll('.reveal-up').forEach((el) => {
          el.classList.add('is-visible');
        });
      }
    });
  </script>
</body>
</html>
