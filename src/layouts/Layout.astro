---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';

// Live-synced at build time (see src/lib/reviewStats.mjs). Feeds the schema
// aggregateRating below so the structured data Google reads stays current
// without a manual edit on every deploy.
const { reviewCount, ratingValue } = await getReviewStats();

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
  image?: string;
  ogType?: string;      // "website" (default) or "article" for blog posts
  breadcrumb?: boolean; // false when the page supplies its own BreadcrumbList
}

const { title, description, canonical, schema, noindex = false, image, ogType = "website", breadcrumb = true } = Astro.props;
const siteUrl = "https://armstronglocksmithinc.com";
const fullCanonical = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();

// Compute Full Image URL for Google Rich Snippets & Social Graph
const defaultImage = "https://armstronglocksmithinc.com/shop.jpeg";
const fullImageUrl = image 
  ? (image.startsWith('http') ? image : new URL(image, siteUrl).toString())
  : defaultImage;

// WebPage Schema with primaryImageOfPage and Speakable for Google Rich & Voice Snippets
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${fullCanonical}#webpage`,
  "url": fullCanonical,
  "name": title,
  "description": description,
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "@id": `${fullCanonical}#primaryimage`,
    "url": fullImageUrl,
    "caption": title
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "header p"]
  }
};

// Automatic Universal BreadcrumbList Schema for Google Search Hierarchy
const pageShortTitle = title.split('|')[0].split('—')[0].trim();
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${fullCanonical}#breadcrumb`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://armstronglocksmithinc.com/"
    },
    ...(canonical && canonical !== "/" ? [{
      "@type": "ListItem",
      "position": 2,
      "name": pageShortTitle,
      "item": fullCanonical
    }] : [])
  ]
};

// Base LocalBusiness & Locksmith JSON-LD Schema with Entity Linking & TN License
const baseBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Locksmith",
  "@id": "https://armstronglocksmithinc.com/#locksmith",
  "name": "Armstrong Locksmith Inc",
  "legalName": "Armstrong Locksmith Inc",
  "image": [
    "https://armstronglocksmithinc.com/shop.jpeg",
    "https://armstronglocksmithinc.com/images/rahim-ezzadpanah-the-owner-of-armstrong-locksmith.jpeg",
    "https://armstronglocksmithinc.com/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg"
  ],
  "url": "https://armstronglocksmithinc.com/",
  "telephone": "+1-615-625-8000",
  "email": "locksmith@armstronglocksmithinc.com",
  "priceRange": "$$",
  "hasMap": "https://www.google.com/maps?cid=12282298980838186756",
  "currenciesAccepted": "USD",
  "paymentAccepted": "Cash, Credit Card, Debit Card, Apple Pay",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": ratingValue,
    "reviewCount": reviewCount,
    "bestRating": "5",
    "worstRating": "1"
  },
  "sameAs": [
    "https://g.page/r/CQS5BtikwbmqEBM",
    "https://www.google.com/maps?cid=12282298980838186756",
    "https://www.facebook.com/Armstronglocksmithinc",
    "https://www.yelp.com/biz/armstrong-locksmith-nashville",
    "https://www.bbb.org/us/tn/nashville/profile/locksmith/armstrong-locksmith-inc-0573-37265814"
  ],
  "knowsAbout": [
    "European Car Key Replacement",
    "BMW Smart Key Programming",
    "Mercedes-Benz EIS & Keyless Go",
    "Audi BCM2 Key Cutting",
    "Automotive Transponder Diagnostics",
    "Residential Deadbolt Rekeying",
    "Commercial Master Key Systems",
    "Emergency Lockout Assistance"
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "208 Thompson Ln",
    "addressLocality": "Nashville",
    "addressRegion": "TN",
    "postalCode": "37211",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 36.1118,
    "longitude": -86.7378
  },
  // Mirrors the Google Business Profile main hours exactly. GBP is authoritative
  // for the local pack and the "Open now" label, so structured data must not
  // contradict it. Mobile dispatch runs later (until 23:30 Mon-Fri) and is
  // communicated in page copy, where a reader gets the surrounding context
  // rather than a bare open/closed label.
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "10:00",
      "closes": "16:00"
    }
  ],
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Davidson County, Tennessee" },
    { "@type": "AdministrativeArea", "name": "Williamson County, Tennessee" },
    { "@type": "City", "name": "Nashville" },
    { "@type": "City", "name": "Brentwood" },
    { "@type": "City", "name": "Franklin" },
    { "@type": "City", "name": "Antioch" },
    { "@type": "City", "name": "Donelson" },
    { "@type": "City", "name": "Hermitage" },
    { "@type": "City", "name": "Belle Meade" },
    { "@type": "City", "name": "Green Hills" },
    { "@type": "City", "name": "Nolensville" },
    { "@type": "City", "name": "Berry Hill" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Locksmith Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "url": "https://armstronglocksmithinc.com/european-car-key-specialist/",
        "itemOffered": {
          "@type": "Service",
          "name": "European Car Key Replacement",
          "description": "Dealer-level key cutting and programming for BMW, Mercedes, Audi, Land Rover & Bentley.",
          "url": "https://armstronglocksmithinc.com/european-car-key-specialist/",
          "serviceType": "Automotive Locksmith",
          "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
        }
      },
      {
        "@type": "Offer",
        "url": "https://armstronglocksmithinc.com/key-fob-replacement-nashville/",
        "itemOffered": {
          "@type": "Service",
          "name": "Car Key & Fob Replacement",
          "description": "Smart proximity push-to-start fobs, laser key cutting, and transponder programming.",
          "url": "https://armstronglocksmithinc.com/key-fob-replacement-nashville/",
          "serviceType": "Automotive Locksmith",
          "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
        }
      },
      {
        "@type": "Offer",
        "url": "https://armstronglocksmithinc.com/emergency-car-lockout/",
        "itemOffered": {
          "@type": "Service",
          "name": "Emergency Car Lockout Service",
          "description": "Prompt mobile dispatch for car lockouts across Nashville and Middle Tennessee.",
          "url": "https://armstronglocksmithinc.com/emergency-car-lockout/",
          "serviceType": "Emergency Locksmith",
          "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
        }
      },
      {
        "@type": "Offer",
        "url": "https://armstronglocksmithinc.com/residential-locksmith-nashville/",
        "itemOffered": {
          "@type": "Service",
          "name": "Residential Lock Rekeying & Deadbolts",
          "description": "Upfront priced house lock rekeying, high-security deadbolt installation, and emergency lockouts.",
          "url": "https://armstronglocksmithinc.com/residential-locksmith-nashville/",
          "serviceType": "Residential Locksmith",
          "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
        }
      },
      {
        "@type": "Offer",
        "url": "https://armstronglocksmithinc.com/commercial-locksmith/",
        "itemOffered": {
          "@type": "Service",
          "name": "Commercial Door Security & Hardware",
          "description": "Storefront door mortise cylinders, panic exit bars, master key systems, and access control.",
          "url": "https://armstronglocksmithinc.com/commercial-locksmith/",
          "serviceType": "Commercial Locksmith",
          "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={fullCanonical} />

  <!-- Favicon / App Icons with Cache Buster -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
  <link rel="shortcut icon" href="/favicon.ico?v=2" />
  <meta name="theme-color" content="#07152b" />

  <!-- Robots Directive -->
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:secure_url" content={fullImageUrl} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="Armstrong Locksmith Inc" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={fullCanonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Geo & Local SEO Meta Tags -->
  <meta name="geo.region" content="US-TN" />
  <meta name="geo.placename" content="Nashville" />
  <meta name="geo.position" content="36.1118;-86.7378" />
  <meta name="ICBM" content="36.1118, -86.7378" />

  <!-- Preload Critical Self-Hosted Fonts for 0ms FCP & 0ms LCP -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/latin-3.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/latin-0.woff2" crossorigin />

  <!-- Preconnect to Booking API for 0ms DNS/TLS on Form Submissions -->
  <link rel="preconnect" href="https://booking.armstronglocksmithinc.com" crossorigin />
  <link rel="dns-prefetch" href="https://booking.armstronglocksmithinc.com" />

  <!-- WebPage Schema with Primary Image & Speakable for Google Rich Snippets -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)} />

  <!-- Universal BreadcrumbList Schema for Google Search Snippet Hierarchy (Requires >=2 items for validity) -->
  {breadcrumb && canonical && canonical !== "/" && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- Base Locksmith LocalBusiness Structured Data Schema with Entity Linking -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(baseBusinessSchema)} />

  <!-- Page-Specific Additional Schema (Services, FAQs, Breadcrumbs, Articles) -->
  {schema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  )}

  <!--
    Deferred Google Tag Manager.

    GTM loads on the first real interaction (click / touch / keydown) or once the
    browser goes idle, whichever comes first. That keeps it off the critical path
    without hiding it from anyone: every visitor gets the same page, and so does
    every measurement tool.

    This deliberately does NOT skip GTM for Lighthouse / PageSpeed user agents.
    Serving a lighter page to Google's inspection tools inflates the lab score
    while real users still pay the cost, so the number stops describing anything.
    Field data (CrUX) always measured the real page regardless, and that is what
    Search Console reports and what ranking uses.
  -->
  <!-- Call-click tracking that survives the deferred GTM load below: the tap
       that dials is also the tap that loads GTM, so GTM's own click triggers
       never see it. Queue the event on dataLayer now; GTM replays the queue
       when it loads. In GTM, trigger on Custom Event "call_click". -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    document.addEventListener('click', function (e) {
      var t = e.target;
      var a = t && t.closest ? t.closest('a[href^="tel:"]') : null;
      if (a) window.dataLayer.push({ event: 'call_click', call_href: a.getAttribute('href'), call_page: window.location.pathname });
    }, true);
  </script>

  <!-- Zero-TBT Deferred Google Tag Manager -->
  <script is:inline>
    (function() {
      var gtmLoaded = false;
      function loadGTM() {
        if (gtmLoaded) return;
        gtmLoaded = true;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WPH6NBVK');
      }
      var events = ['click', 'touchstart', 'keydown'];
      events.forEach(function(e) {
        window.addEventListener(e, loadGTM, { once: true, passive: true });
      });
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(function() { setTimeout(loadGTM, 8000); });
      } else {
        setTimeout(loadGTM, 8000);
      }
    })();
  </script>


</head>
<body class="bg-[#f8fafc] text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-amber-500 selection:text-slate-900 overflow-x-hidden w-full max-w-full">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WPH6NBVK"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Header />
  
  <main class="flex-grow w-full max-w-full pb-20 md:pb-0">
    <slot />
  </main>

  <Footer />
  <MobileCallBar />
  <BackToTop />

  <!-- Lightweight Scroll Reveal Animation Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          root: null,
          rootMargin: '50px',
          threshold: 0.05
        });

        document.querySelectorAll('.reveal-up').forEach((el) => {
          observer.observe(el);
        });
      } else {
        document.querySelectorAll('.reveal-up').forEach((el) => {
          el.classList.add('is-visible');
        });
      }
    });
  </script>
</body>
</html>
