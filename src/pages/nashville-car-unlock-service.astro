---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Nashville Car Unlock Service | Fast Mobile Auto Lockout Dispatch";
const seoDescription = "Locked out of your car in Nashville? 24/7 fast mobile auto lockout service. 100% damage-free vehicle entry for all makes & models. Call (615) 625-8000.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Will unlocking my car damage the door, paint, or weatherstripping?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Never. Unlike amateur tow operators who use rigid metal rods or crowbars that bend door frames and tear weatherstripping, Armstrong Locksmith uses precision Lishi optical lock decoders and soft-vinyl non-marring air wedges to safely open your vehicle with zero structural or cosmetic damage."
      }
    },
    {
      "@type": "Question",
      "name": "What if my keys are locked in the trunk and the interior trunk button is locked out?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Many modern vehicles (especially European brands like BMW, Mercedes, and Audi) disable interior trunk release buttons when the alarm is armed. Our mobile locksmiths can decode the physical trunk lock cylinder directly using Lishi tools or access the onboard diagnostic (OBD2) system to pop the trunk safely."
      }
    },
    {
      "@type": "Question",
      "name": "What proof of ownership do I need for you to unlock my vehicle?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For safety and legal compliance under Tennessee State Locksmith License #406, we require the driver to provide matching government ID along with vehicle registration, title, or valid insurance documentation before or immediately upon opening the vehicle."
      }
    },
    {
      "@type": "Question",
      "name": "Can you cut and program a brand new car key on-site if I lost them completely?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Our mobile vans are fully equipped mobile workshops with computer-controlled laser key cutters and OBD2 programming machines. If your keys are lost rather than locked inside, we can originate and program a new key on the spot so you don't have to tow your car."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://armstronglocksmithinc.com/nashville-car-unlock-service/#service",
  "name": "Nashville Car Unlock & Vehicle Lockout Service",
  "provider": {
    "@type": "Locksmith",
    "name": "Armstrong Locksmith Inc",
    "telephone": "+1-615-625-8000",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "208 Thompson Ln",
      "addressLocality": "Nashville",
      "addressRegion": "TN",
      "postalCode": "37211",
      "addressCountry": "US"
    }
  },
  "areaServed": "Nashville, TN, Brentwood, TN, Franklin, TN, Antioch, TN, Donelson, TN",
  "description": "24/7 fast emergency mobile car unlocking and vehicle lockout service across Greater Nashville with 100% damage-free guarantee."
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/nashville-car-unlock-service/" schema={[serviceSchema, faqSchema]}>
  
  <!-- ==================== HERO SECTION ==================== -->
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold w-fit border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>🚨 Emergency Mobile Car Unlock &bull; Nashville & Middle TN</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
          Nashville Car Unlock <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500">Fast & Damage-Free</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal max-w-2xl">
          Locked your keys inside the cabin, trunk, or running vehicle? Armstrong Locksmith provides prompt mobile lockout dispatch across Greater Nashville. We decode locks cleanly with zero bent frames, scratched paint, or damaged weatherstripping.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 border border-emerald-400/40"
          >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a 
            href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-7 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-base uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg transition active:scale-95 border border-amber-300"
          >
            <span>Book Online &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Hero Trust Card -->
      <div class="lg:col-span-5">
        <div class="bg-white/10 backdrop-blur-md rounded-3xl p-7 border border-white/15 shadow-2xl text-left">
          <h2 class="text-xl font-bold text-white font-serif pb-3 border-b border-white/15 flex items-center gap-2">
            <span class="text-amber-400">🛡️</span>
            <span>The Armstrong Lockout Standard</span>
          </h2>
          <ul class="flex flex-col gap-3.5 my-4 text-xs sm:text-sm text-slate-200">
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-base leading-none">✓</span>
              <span><strong>100% Damage-Free Guarantee:</strong> We use specialized optical picks, never pry bars.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-base leading-none">✓</span>
              <span><strong>All Makes & Models:</strong> Domestic, Asian, European luxury, trucks & vans.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-base leading-none">✓</span>
              <span><strong>Trunk & Deadlock Bypass:</strong> BMW, Mercedes, Audi & high-security deadlocks.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold text-base leading-none">✓</span>
              <span><strong>Key Generation on Location:</strong> If keys are lost, we cut & program a new key immediately.</span>
            </li>
          </ul>

          <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-amber-300 font-bold">
            <span>TN License #406</span>
            <span>⭐ 4.9 Stars (120+ Reviews)</span>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- ==================== REAL TECHNICIAN PHOTO & DISPATCH ==================== -->
  <section class="py-12 sm:py-16 bg-slate-50 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-5 rounded-3xl overflow-hidden border-2 border-slate-200 shadow-xl">
        <img 
          src="/images/sako-armstrong-locksmith-technecian-unlocking-a-car-scaled.jpg" 
          alt="Armstrong Locksmith Technician Sako Unlocking Vehicle Safely with Lishi Decoder"
          class="w-full h-80 object-cover"
        />
        <div class="p-3.5 bg-white text-xs font-bold text-[#0f274a] text-center border-t border-slate-200">
          Master Technician performing safe, non-destructive vehicle entry on location
        </div>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <span class="text-xs font-black uppercase tracking-wider text-amber-600">Professional Automotive Locksmiths</span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#0f274a] font-serif tracking-tight">
          Why Tow Trucks & Amateurs Damage Your Vehicle
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Amateur lockout operators and untrained tow drivers frequently jam stiff metal rods (slim jims) and wooden door wedges into modern door frames. This results in bent door frames that whistle on the highway, sliced power window wiring, punctured side-curtain airbag modules, and scratched paint.
        </p>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          At Armstrong Locksmith, our technicians are state-licensed master locksmiths equipped with <strong>precision optical Lishi tools</strong>. We read and decode the internal wafer tumblers through the exterior keyhole, smoothly turning the lock cylinder just like an original factory key with <strong>zero pressure applied to door frames</strong>.
        </p>

        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-xs sm:text-sm text-emerald-950 font-medium flex items-center gap-3">
          <span class="text-xl">🛡️</span>
          <span><strong>Zero Paint or Frame Damage Guarantee:</strong> We treat your vehicle with the exact precision and care required for modern automotive electronics.</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 6 COMMON LOCKOUT SCENARIOS WE SOLVE ==================== -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
