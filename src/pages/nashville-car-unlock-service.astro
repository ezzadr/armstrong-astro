---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Nashville Car Unlock Service | Fast 15-Min Lockout Dispatch";
const seoDescription = "Locked out of your car in Nashville? 24/7 fast mobile auto lockout service. Non-destructive entry for all makes & models. Call (615) 625-8000.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/nashville-car-unlock-service/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Emergency Car Lockout &bull; 15-25 Min Dispatch</span>
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
        Nashville Car Unlock Service
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Locked your keys in the car or trunk? Fast, safe, non-destructive automotive unlocking across Nashville, Downtown, BNA Airport, and Williamson County.
      </p>
      <div class="flex pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 text-white font-extrabold text-base shadow">Call (615) 625-8000</a>
      </div>
    </div>
  </header>
</Layout>