---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Nashville Car Unlock Service | Mobile Auto Lockout";
const seoDescription = "Locked out of your car in Nashville? Mobile auto lockout service by licensed locksmiths. Damage-free entry for all makes. Call (615) 625-8000.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Will unlocking my car damage my door seals, paint, or power windows?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. When amateurs or tow drivers force metal rods (slim jims) inside a modern door panel, they easily rip out side-airbag wiring, scratch window tint, and bend door frames so they whistle on the highway. We use specialized Lishi lock picks to decode the key wafers directly through the outside keyhole—turning the lock cylinder just like your factory key with zero pressure on your door."
      }
    },
    {
      "@type": "Question",
      "name": "What if my keys are locked in the trunk and the interior trunk button doesn't work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most modern cars—especially BMW, Mercedes, Audi, and Lexus—disable interior trunk buttons and fold-down seats once the car is locked and armed. We decode the mechanical keyway on your trunk or driver door to turn off the deadlock, or connect through the OBD2 diagnostic port to pop the trunk release."
      }
    },
    {
      "@type": "Question",
      "name": "What do I need to show before you unlock my vehicle?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To protect vehicle owners and maintain full security compliance, we require a valid government photo ID and proof that matches the vehicle (registration, insurance card, title, or rental contract). If your documents are locked inside the glovebox, we verify them immediately after opening."
      }
    },
    {
      "@type": "Question",
      "name": "What if I discover my keys are completely lost once the car is opened?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our mobile vans carry CNC computerized key cutters and electronic programming equipment. If your keys aren't inside the car, we can read your lock cylinder bitting code on-site, laser-cut a new mechanical blade, and program a replacement transponder key or smart fob right there in your driveway."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://armstronglocksmithinc.com/nashville-car-unlock-service/#service",
  "name": "Nashville Car Unlock & Vehicle Lockout Service",
  "provider": {
    "@type": "Locksmith",
    "name": "Armstrong Locksmith Inc",
    "telephone": "+1-615-625-8000",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "208 Thompson Ln",
      "addressLocality": "Nashville",
      "addressRegion": "TN",
      "postalCode": "37211",
      "addressCountry": "US"
    }
  },
  "areaServed": "Nashville, TN, Brentwood, TN, Franklin, TN, Antioch, TN, Donelson, TN",
  "description": "Professional mobile automotive lock picking and vehicle unlocking across Greater Nashville with zero body or electrical damage."
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/nashville-car-unlock-service/" schema={[serviceSchema, faqSchema]} image="/images/sako-armstrong-locksmith-technecian-unlocking-a-car-scaled.jpg">
  
  <!-- ==================== HERO SECTION ==================== -->
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
      
