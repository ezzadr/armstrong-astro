---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Nashville Locksmith Storefront | 208 Thompson Ln Shop";
const seoDescription = "Visit our physical locksmith shop at 208 Thompson Ln in Nashville for walk-in car key duplication, lock rekeying & sales. (615) 625-8000.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/nashville-locksmith-storefront/">
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Physical Storefront Location &bull; TN Lic #406</span>
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
        Nashville Locksmith Storefront
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Visit our physical shop at 208 Thompson Ln, Nashville, TN 37211 for discount in-store key cutting, European key programming, and deadbolt hardware.
      </p>
      <div class="flex pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 text-white font-extrabold text-base shadow">Call (615) 625-8000</a>
      </div>
    </div>
  </header>
</Layout>