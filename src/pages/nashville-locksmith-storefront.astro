---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Locksmith Shop Nashville | 208 Thompson Ln | Armstrong";
const seoDescription = "Visit our real Nashville shop at 208 Thompson Ln. Licensed locksmith (#406) with 769+ 5-star reviews. Walk-in key duplication & fobs. Call (615) 625-8000.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Locksmith",
  "name": "Armstrong Locksmith Storefront",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "208 Thompson Ln",
    "addressLocality": "Nashville",
    "addressRegion": "TN",
    "postalCode": "37211",
    "addressCountry": "US"
  },
  "telephone": "+1-615-625-8000"
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/nashville-locksmith-storefront/" schema={schema} image="/images/armstrong-locksmith-shop.jpeg">
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">Verified Physical Storefront</span>
          <span>&bull;</span>
          <span class="text-slate-300">TN License #406</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">&#9733; 4.9 Star Rating</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Nashville's Trusted <br />
          <span class="text-amber-400">Locksmith Shop &amp; Storefront</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Armstrong Locksmith Inc operates a fully equipped shop in South Nashville. Located at <strong>208 Thompson Ln</strong> in the Woodbine area, our storefront is your dependable home base for car key replacement, walk-in key cutting, lock rekeying, and commercial hardware—without waiting on a mobile dispatch window.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-base flex items-center justify-center gap-2.5 shadow-2xl transition active:scale-95 whitespace-nowrap">
            <span>Get Shop Directions &rarr;</span>
          </a>
          <a href="tel:6156258000" class="px-7 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 rounded-3xl overflow-hidden border border-slate-700 shadow-2xl bg-slate-900">
        <picture>
          <source type="image/webp" srcset="/shop-600.webp 600w, /shop-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 600px" />
          <img src="/shop.jpeg" alt="Armstrong Locksmith Storefront 208 Thompson Ln Nashville" class="w-full h-80 object-cover" width="600" height="400" loading="lazy" />
        </picture>
        <div class="p-6 bg-slate-950 text-white text-xs space-y-2 border-t border-slate-800">
          <div class="flex justify-between">
            <span class="text-slate-400">Address:</span>
            <span class="font-bold text-white">208 Thompson Ln, Nashville, TN 37211</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Storefront Hours:</span>
            <span class="font-bold text-amber-400">Mon–Fri 8AM–6PM | Sat 10AM–4PM</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Mobile Dispatch:</span>
            <span class="font-bold text-emerald-400">Mon–Fri 8AM–11:30PM</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-[#0a192f] text-white px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-20">

      <!-- In Shop Services -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <p class="text-lg font-bold text-amber-400 mb-2">Save on Service Calls</p>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Drive your vehicle to our shop or bring your lock cylinders to eliminate mobile dispatch trip fees.</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <p class="text-lg font-bold text-amber-400 mb-2">High-Precision Key Machines</p>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Equipped with computerized laser cutters (Condor XC-Mini, Futura Auto) for factory-spec key blades.</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <p class="text-lg font-bold text-amber-400 mb-2">Dealer Diagnostic Benches</p>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Bench testing and EEPROM programming for complex European immobilizers (BMW, Mercedes, Audi, Land Rover).</p>
        </div>
      </section>

      <!-- Requirements for Key Services -->
      <section class="bg-[#10233d] rounded-3xl p-8 sm:p-12 border border-slate-700/80 shadow-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-white mb-4">
          What to Bring for Automotive Key Service
        </h2>
        <p class="text-slate-300 text-xs sm:text-sm mb-6">In compliance with Tennessee state locksmith regulations and vehicle security standards, please bring:</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-200">
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-3">
            <span class="text-emerald-400 font-bold">&#10003;</span>
            <span><strong>Valid Government Photo ID:</strong> Driver's license or state ID matching the vehicle registration.</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-3">
            <span class="text-emerald-400 font-bold">&#10003;</span>
            <span><strong>Proof of Vehicle Ownership:</strong> Vehicle title, active registration card, or official insurance document.</span>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>