---
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';
const { reviewCount, ratingValue } = await getReviewStats();
import ServiceReviews from '../components/ServiceReviews.astro';

const seoTitle = "Mercedes-Benz Key Replacement Nashville | Armstrong";
const seoDescription = "Mercedes-Benz key programming & EIS/FBS3/FBS4 diagnostics in Nashville. Save vs dealer towing & backorders. Call (615) 625-8000.";

const mercedesSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "name": "Mercedes-Benz Key Replacement & EIS Programming",
    "description": "Dealer-level Mercedes-Benz smart key programming and EIS/EZS diagnostics in Nashville, TN.",
    "image": "https://armstronglocksmithinc.com/images/mercedes-Benz_20250627_002342_0000-1-scaled.jpg",
    "brand": {
      "@type": "Brand",
      "name": "Mercedes-Benz"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "225",
      "highPrice": "425",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Mercedes G 550 Key Replacement in Nashville | Armstrong Locksmith Inc",
    "description": "Watch Armstrong Locksmith Inc demonstrate the process of replacing and programming a new key for a Mercedes-Benz G 550 in Nashville, TN.",
    "thumbnailUrl": [
      "https://i.ytimg.com/vi/b7D_mmGUabI/hqdefault.jpg"
    ],
    "uploadDate": "2025-06-27T08:54:03-07:00",
    "embedUrl": "https://www.youtube.com/embed/b7D_mmGUabI",
    "contentUrl": "https://www.youtube.com/watch?v=b7D_mmGUabI",
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/mercedes-benz/" schema={mercedesSchema} image="/images/mercedes-Benz_20250627_002342_0000-1-scaled.jpg">
  
  <!-- Premium Hero Header -->
  <header class="bg-gradient-to-b from-[#0a192f] via-[#0f274a] to-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Hero Left Column -->
      <div class="lg:col-span-7 text-left flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">
            Mercedes-Benz Automotive Locksmith
          </span>
          <span>&bull;</span>
          <span class="text-slate-300">Certified & Insured</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">&#10003; Prompt Mobile Dispatch</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Mercedes-Benz Key Replacement <br />
          <span class="text-amber-400">Luxury Key Specialist</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          C-Class, E-Class, S-Class, GLC, GLE, GLS, CLA, Sprinter, and Metris. Smart chrome fobs, Keyless-Go, and EIS / EZS electronic ignition programming.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 whitespace-nowrap"
          >
            <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <span>Book Online Appointment</span>
          </a>
        </div>
      </div>

      <!-- Hero Right: Quick Feature Card -->
      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-6 sm:p-8 border border-white/20 shadow-2xl text-white">
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-300">Why Armstrong Locksmith?</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30">Verified Local Shop</span>
        </div>

        <div class="flex flex-col gap-3.5 text-xs sm:text-sm">
          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-white block">No Dealership Towing Required</strong><span class="text-slate-300 text-xs">We bring our mobile van equipped with laser cutters to your car.</span></div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-white block">Fast Same-Day Turnaround</strong><span class="text-slate-300 text-xs">Skip the 5 to 10-day dealership ordering delay. Cut &amp; programmed on-site.</span></div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-white block">Physical Storefront on Thompson Ln</strong><span class="text-slate-300 text-xs">Drop into our shop at 208 Thompson Ln for discount walk-in service.</span></div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-emerald-300 block font-bold">Save $300-$700 vs Dealership</strong><span class="text-slate-300 text-xs">Transparent upfront pricing with zero hidden fees.</span></div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Key Metrics Strip -->
  <section class="bg-white border-b border-slate-200 py-4 px-4 sm:px-6 lg:px-8 shadow-sm">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center shadow-sm"><svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        <div><strong class="block text-emerald-800 font-bold">Save $300-$700 vs Dealership</strong><span class="text-slate-500 text-[11px]">vs Dealership Quotes</span></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center shadow-sm"><svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
        <div><strong class="block text-slate-900 font-bold">Certified & Insured</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center shadow-sm"><svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></div>
        <div><strong class="block text-slate-900 font-bold">4.9★ Google Rating</strong><span class="text-slate-500 text-[11px]"><span class="arm-review-count">{reviewCount}+</span> Verified Reviews</span></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center shadow-sm"><svg class="w-5 h-5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        <div><strong class="block text-slate-900 font-bold">Same-Day Mobile Dispatch</strong><span class="text-slate-500 text-[11px]">Mon&ndash;Fri until 11:30 PM</span></div>
      </div>
    </div>
  </section>

  <!-- Main Body Content -->
  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Real Job Spotlight / Video Section -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-900 text-xs font-bold w-fit border border-amber-500/20">
            <span>&#128295;</span> Real Nashville Case Study
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            Dealer-Level Mercedes EIS & Chrome Fob Programming
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Avoid 7 to 10-day backorders from Germany with same-day on-site Mercedes key generation.
          </p>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-700 leading-relaxed">
            Dealerships order pre-coded keys linked to the VIN from overseas warehouses. Armstrong Locksmith uses dealer-grade diagnostic benches to extract password data directly from the EIS ignition and program brand new Chrome Smart Keys on-site.
          </div>
          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs font-bold text-slate-700">
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1.5 rounded-lg">&#10003; 100% On-Site Solution</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; Laser Cut Factory Key</span>
          </div>
        </div>

        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-200 aspect-video bg-slate-900 flex items-center justify-center">
          <YouTubeFacade id="b7D_mmGUabI" title="Mercedes G 550 Key Replacement in Nashville | Armstrong Locksmith Inc" />
        </div>
      </section>

      <!-- 3 Core Services -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 border-t-4 border-t-amber-500 shadow-sm hover:border-amber-500 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Chrome Smart Key Fobs</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">OEM-grade Mercedes infrared smart keys programmed directly through EIS interfaces.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-5 block pt-4 border-t border-slate-100">Same-Day Service Available &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 border-t-4 border-t-amber-500 shadow-sm hover:border-amber-500 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Sprinter & Metris Fleet Keys</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Commercial fleet key duplication, transponder programming, and emergency lockout dispatch.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-5 block pt-4 border-t border-slate-100">Same-Day Service Available &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 border-t-4 border-t-amber-500 shadow-sm hover:border-amber-500 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">EIS / EZS Ignition Bench Fix</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Electronic ignition switch repair, password extraction, and ESL steering lock bypass.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-5 block pt-4 border-t border-slate-100">Same-Day Service Available &rarr;</span>
          </div>
        
      </section>

      <!-- Verified Review Card -->
      <section class="bg-gradient-to-br from-[#0f274a] via-[#14325a] to-[#0f274a] text-white rounded-3xl p-8 sm:p-12 shadow-xl border-t-4 border-amber-500 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 flex flex-col gap-3">
          <div class="flex items-center gap-1 text-amber-400 text-lg">
            &#9733;&#9733;&#9733;&#9733;&#9733;
          </div>
          <p class="text-slate-100 text-sm sm:text-base lg:text-lg font-medium leading-relaxed italic">
            "Mercedes dealer told me 10 days for a key replacement. Called Rahim at Armstrong Locksmith - he came to my driveway in Belle Meade with his diagnostic computer and had a brand new chrome smart key programmed the same day."
          </p>
          <div class="flex items-center gap-3 pt-2 text-xs">
            <span class="font-bold text-amber-300">Anthony DeLuca</span>
            <span>&bull;</span>
            <span class="text-slate-300">2018 Mercedes-Benz E350</span>
            <span>&bull;</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">&#10003; Verified Google Review</span>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col gap-3 justify-center items-start lg:items-end">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-sm shadow transition active:scale-95 whitespace-nowrap">
            Call (615) 625-8000
          </a>
          <span class="text-xs text-slate-300">Prompt Mobile Dispatch</span>
        </div>
      </section>

      <!-- Supported Models Grid -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">Coverage</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] mb-4">
          Mercedes-Benz Models We Cut &amp; Program in Middle TN
        </h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-3xl mb-8 leading-relaxed">
          From classic mechanical keys to modern proximity push-to-start smart fobs, our mobile vans stock keys and programming hardware for the following models:
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz C-Class (C300, C43)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz E-Class (E350, E450)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz S-Class (S550, S580)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz GLC 300</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz GLE 350 / 450</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz GLS 450 / 580</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz CLA 250</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz Sprinter 2500/3500</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz Metris</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz G-Wagon (G550, G63)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz A-Class</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 hover:border-amber-400 hover:bg-amber-50/60 transition font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Mercedes-Benz GLA / GLB</span>
            </div>
          
        </div>
      </section>

      <!-- Storefront & Shop Visit Section -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-200 shadow-md">
          <picture>
            <source type="image/webp" srcset="/shop-600.webp 600w, /shop-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 600px" />
