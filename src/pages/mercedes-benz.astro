---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Mercedes-Benz Key Replacement Nashville | Chrome Smart Keys";
const seoDescription = "Lost your Mercedes key in Nashville? Fast same-day Mercedes key programming & cutting for C-Class, E-Class, S-Class, GLE, GLC & Sprinter. Call (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/mercedes-benz/">
  
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-amber-300 w-fit">
          <span>TN License #406 &bull; European Automotive Specialist</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
          Mercedes-Benz Key <br />
          <span class="text-amber-400">Replacement Nashville</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          Fast same-day Mercedes key programming and cutting. Avoid the 2-week dealership delay and excessive tow charges. We stock Mercedes chrome smart keys right here in Nashville.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center shadow-md transition">
            <span>Book Online</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xl border border-slate-200 text-slate-900">
          <h2 class="text-xl font-bold text-[#0f274a] font-serif pb-3 border-b border-slate-100">
            Mercedes Models Covered
          </h2>
          <ul class="flex flex-col gap-2.5 my-4 text-xs sm:text-sm text-slate-700">
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Sedans & Coupes:</strong> C-Class, E-Class, S-Class, CLA, CLS</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>SUVs & Crossovers:</strong> GLA, GLB, GLC, GLE, GLS, G-Wagon</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Commercial Vans:</strong> Sprinter & Metris fleet keys</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>FBS3 Immobilizer:</strong> Electronic Ignition Switch (EIS/EZS) sync</span>
            </li>
          </ul>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 font-medium">
            📍 Storefront available at 208 Thompson Ln for walk-in duplicate key cutting.
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Complete Original WordPress Long-Form Content -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto flex flex-col gap-10 text-slate-800 leading-relaxed text-sm sm:text-base">
      
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-4">
          Dealer-Level Mercedes Key Programming Without Dealership Delays
        </h2>
        <p class="mb-3">
          Mercedes-Benz vehicles utilize a sophisticated infrared and radio frequency security system known as FBS (Fahrberechtigungssystem). When you lose a Mercedes key, traditional key cutters cannot program it.
        </p>
        <p class="mb-3">
          At Armstrong Locksmith, we invest in factory-grade European key calculation tooling. We calculate the password directly from your vehicle's Electronic Ignition Switch (EIS) or Electronic Steering Lock (ESL), flash the data to a genuine replacement chrome key fob, and laser-cut the emergency mechanical blade on-site.
        </p>
        <p>
          Whether you drive a daily commuter C300, an AMG performance coupe, or manage a fleet of Mercedes Sprinter delivery vans across Middle Tennessee, we can have you back on the road the same day.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-3">
          Mercedes Sprinter Key Specialist
        </h2>
        <p class="mb-3">
          Downed delivery vehicles cost your business money every hour they sit idle. We prioritize commercial Mercedes Sprinter van key replacement and duplication for delivery companies, trades, and RV conversions throughout Nashville, Brentwood, and Antioch.
        </p>
        <p>
          We provide on-site mobile service directly at your job site or company depot to cut and sync replacement transponders immediately.
        </p>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0f274a] text-white py-14 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-4">
      <h2 class="text-2xl sm:text-4xl font-bold font-serif text-white">Need a Mercedes Key Made Today?</h2>
      <p class="text-slate-200 text-sm sm:text-base">Call now to get an upfront quote for your Mercedes-Benz.</p>
      <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
        <a href="tel:6156258000" class="px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base shadow">
          Call (615) 625-8000
        </a>
      </div>
    </div>
  </section>
</Layout>
