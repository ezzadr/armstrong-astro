---
import Layout from '../layouts/Layout.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "BMW Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Affordable BMW car key cutting, transponder & smart proximity fob programming in Nashville. Mobile on-site service & shop at 208 Thompson Ln. (615) 625-8000.";

// Rich Schema for BMW Service
const bmwSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "BMW Car Key Replacement",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+1-615-625-8000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211",
        "addressCountry": "US"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Belle Meade", "Green Hills"],
    "description": "Mobile and storefront BMW smart key fob cutting and immobilizer programming for CAS1, CAS2, CAS3, CAS4, FEM, and BDC systems in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you make a BMW key if all keys are lost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! We decode the mechanical door lock cylinder with specialized Lishi tools and program brand-new smart proximity keys directly to your BMW's CAS, FEM, or BDC immobilizer module on-site. No towing to the dealership is required."
        }
      },
      {
        "@type": "Question",
        "name": "How much does BMW key replacement cost compared to the dealership?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BMW dealerships typically charge $650 to $1,200+ plus mandatory towing fees and require a 7 to 10-day wait. Armstrong Locksmith provides same-day on-site BMW key replacement typically saving customers $300 to $650 with all-inclusive upfront pricing."
        }
      },
      {
        "@type": "Question",
        "name": "Will the Comfort Access push-to-start and keyless entry features work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We supply and program OEM-quality high-security smart keys that fully support BMW Comfort Access, proximity engine push-button starting, remote trunk release, and panic functions."
        }
      },
      {
        "@type": "Question",
        "name": "Which BMW immobilizer systems can you program in Nashville?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our master automotive locksmiths are equipped with dealer-level diagnostic tools (Autohex II, Autel IM608 Pro) capable of programming EWS, CAS2, CAS3, CAS3+, CAS4, CAS4+, FEM, and BDC systems across all 3, 4, 5, 7 Series, X Series, and M models."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "BMW Key Replacement & Programming Service",
    "description": "Dealer-level BMW key cutting and CAS/FEM/BDC smart proximity key fob programming in Nashville, TN.",
    "image": "https://armstronglocksmithinc.com/images/BMW-car-key-nashville.png",
    "brand": {
      "@type": "Brand",
      "name": "BMW"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "195",
      "highPrice": "385",
      "offerCount": "1",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Locksmith",
        "name": "Armstrong Locksmith Inc"
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "142",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Marcus Vance" },
        "datePublished": "2026-06-15",
        "reviewBody": "Saved me over $600 compared to the BMW dealership! Rahim came out with dealer-level equipment, cut the emergency physical blade, and programmed the smart key fob the same day right on-site.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "David R." },
        "datePublished": "2026-05-20",
        "reviewBody": "Lost my only key for my 2021 BMW X5. Dealership told me 10 days wait and $1,100 with towing. Armstrong came to my driveway and had a brand-new Comfort Access fob working in 45 minutes.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        }
      }
    ]
  }
];

const bmwModels = [
  { name: "BMW 3 Series", series: "Sedan / Touring", years: "E90, F30, G20" },
  { name: "BMW 4 Series", series: "Coupe / Gran Coupe", years: "F32, F36, G22" },
  { name: "BMW 5 Series", series: "Executive Sedan", years: "E60, F10, G30" },
  { name: "BMW 7 Series", series: "Luxury Flagship", years: "E65, F01, G11" },
  { name: "BMW X1 & X2", series: "Compact SAV", years: "E84, F48, F39" },
  { name: "BMW X3 & X4", series: "Mid-Size SAV", years: "E83, F25, G01" },
  { name: "BMW X5 & X6", series: "Sports Activity", years: "E70, F15, G05" },
  { name: "BMW X7", series: "Full-Size Luxury SAV", years: "G07" },
  { name: "BMW M3 & M4", series: "High Performance", years: "E92, F80, G80" },
  { name: "BMW M5 & M8", series: "Motorsport V8", years: "F10, F90, F92" },
  { name: "BMW Z4", series: "Roadster", years: "E85, E89, G29" },
  { name: "BMW 1 & 2 Series", series: "Sport Coupe / Gran", years: "E82, F22, F44" }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/bmw/" schema={bmwSchema} image="/images/BMW-car-key-nashville.png">
  
  <!-- Hero Section with Rich Visual Contrast -->
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <!-- Decorative Ambient Glow -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
      
      <!-- Left Column: Title & Information -->
      <div class="lg:col-span-7 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-black uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>European Key Specialist</span>
          <span>&bull;</span>
          <span>Certified & Insured</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          BMW Key Replacement <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500">in Nashville, TN</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-4 font-normal leading-relaxed">
          Lost your only BMW smart key or need a spare? Skip the 10-day dealership wait and expensive towing. We cut factory laser blades and program BMW proximity smart keys on-site or at our Thompson Ln storefront.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-8">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-xl transition-all duration-200 active:scale-95 shadow-emerald-950/40"
          >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a 
            href="/book-online/" target="_blank" rel="noopener noreferrer" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition-all duration-200 active:scale-95 border border-amber-300/40"
          >
            <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Book Online Appointment</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Visual BMW Trust Badge Card -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-md rounded-2xl p-6 border border-white/15 shadow-2xl flex flex-col gap-5">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-400 font-black text-sm">
                BMW
              </div>
              <div>
                <h3 class="text-sm font-bold text-white">Dealer-Level Diagnostic Rig</h3>
                <span class="text-xs text-slate-300">Autohex II &bull; Autel IM608 Pro</span>
              </div>
            </div>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              Same-Day
            </span>
          </div>

          <!-- Featured BMW Key Photo -->
          <div class="relative rounded-xl overflow-hidden bg-slate-900/60 border border-white/10 flex items-center justify-center p-4">
            <img 
              src="/images/BMW-car-key-nashville.png" 
              alt="BMW Key Replacement Nashville" 
              class="h-36 sm:h-44 w-auto object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-300"
              loading="eager"
            />
            <div class="absolute bottom-2 left-2 bg-[#07152b] bg-navy-grid/90 text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-md border border-amber-400/30 backdrop-blur-sm">
              Comfort Access Proximity Fobs
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="bg-white/5 rounded-lg p-3 border border-white/10">
              <span class="block text-slate-300 text-[11px]">Average Dealer Cost</span>
              <strong class="text-red-400 font-extrabold text-sm line-through">$650 - $1,100</strong>
            </div>
            <div class="bg-emerald-500/15 rounded-lg p-3 border border-emerald-400/30">
              <span class="block text-emerald-200 text-[11px]">Armstrong Locksmith</span>
              <strong class="text-emerald-300 font-extrabold text-sm">Save $300 - $650</strong>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Quick Key Takeaways Bar with Sharp Vector Icons -->
  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">Same-Day Mobile Dispatch</strong>
          <span class="text-slate-600 text-[11px]">Fast Mobile Van Dispatch</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">208 Thompson Ln</strong>
          <span class="text-slate-600 text-[11px]">Walk-In Nashville Storefront</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300">
          <svg class="w-5 h-5 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-emerald-900 font-bold text-xs sm:text-sm">Save $300-$650</strong>
          <span class="text-emerald-700 text-[11px]">vs Dealership Invoices</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">Certified & Insured</strong>
          <span class="text-slate-600 text-[11px]">Verified Master Locksmith</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="py-14 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-14 sm:gap-16">
      
      <!-- Video Showcase Section with Real Job Badge -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-md grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 text-red-700 text-xs font-extrabold w-fit border border-red-200">
            <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
            <span>Live Demonstration Video</span>
          </div>
          
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            Watch Us Make a BMW Key On-Site (Real Job)
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Watch Rahim on location cutting a high-security emergency mechanical key blade and programming a BMW smart proximity remote through OBD2 on-site with zero delay. Real work on real Nashville vehicles.
          </p>
          
          <div class="flex flex-wrap items-center gap-2.5 pt-2 text-xs font-bold text-slate-700">
            <span class="bg-slate-100 text-slate-800 px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 border border-slate-200">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              No Towing Needed
            </span>
            <span class="bg-slate-100 text-slate-800 px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 border border-slate-200">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              OEM-Quality Fobs
            </span>
            <span class="bg-slate-100 text-slate-800 px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 border border-slate-200">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              CAS & FEM Programming
            </span>
          </div>
        </div>
        
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-2xl border-2 border-slate-200 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/fWY-TUZffZA" 
            title="Watch Us Make a BMW Key On-Site (Real Job)" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>

      <!-- Interactive BMW Key Estimator -->
      <CarKeyEstimator 
        defaultMake="BMW" 
        title="BMW Key Replacement & Fitment Guide" 
        subtitle="Select your BMW series year range and situation to check instant CAS/FEM/BDC key compatibility, dealer savings, and response times in Nashville." 
      />

      <!-- 3 Core Service Cards with Depth & Hover Elevation -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 text-amber-700 flex items-center justify-center mb-5 border border-amber-300/40 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Smart Push-to-Start Fobs</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Factory proximity keyless entry remotes programmed directly through OBD2 diagnostics on-site without dealership waiting lists.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>OEM &amp; Aftermarket In Stock</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 text-amber-700 flex items-center justify-center mb-5 border border-amber-300/40 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Laser Key Blade CNC Cutting</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              High-precision computer-controlled laser cutting for high-security internal track sidewinder key blades to exact 0.01mm factory tolerances.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>Automated CNC Precision</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 text-amber-700 flex items-center justify-center mb-5 border border-amber-300/40 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">All Keys Lost Emergency Dispatch</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Lost your only BMW key? We decode your door lock cylinder and generate brand new programmed keys on-site. No towing required.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>Prompt Mobile Dispatch</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

      </section>

      <!-- Supported Models Section with Badges & Clear Checkmarks -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-md">
        <div class="flex items-center gap-2 mb-2">
