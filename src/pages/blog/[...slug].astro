---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .slice(0, 3);

// Map authentic thumbnail images for each blog article
const blogImages: Record<string, string> = {
  "audi-key-replacement-near-donelson-hermitage-nashville-airport": "/images/rahim-made-audi-keys-in-nashville-1.png",
  "car-key-fob-stops-working-cold-weather-nashville": "/images/toyota-key-replacement-1536x2048.webp",
  "home-rekey-vs-lock-replacement-whats-best-for-brentwood-residents": "/images/lock-rekeyed-by-armstrong-locksmith-technician.jpg",
  "how-we-saved-a-customer-over-600-on-a-bmw-key-replacement-in-brentwood-tn": "/images/Bmw-key-replacement-in-Brentwood-tn_20250629_163626_0000.jpg",
  "real-locksmith-vs-dispatch-center-nashville": "/shop.jpeg",
  "reasons-need-locksmith-nashville": "/images/sako-armstrong-locksmith-technecian-unlocking-a-car-scaled.jpg"
};

const postImage = blogImages[post.id] || "/shop.jpeg";

// BlogPosting JSON-LD Schema
const blogSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://armstronglocksmithinc.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://armstronglocksmithinc.com/blog/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": post.data.title,
        "item": `https://armstronglocksmithinc.com/blog/${post.id}/`
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate,
    "dateModified": post.data.pubDate,
    "author": {
      "@type": "Person",
      "name": post.data.author || "Rahim Ezzadpanah",
      "jobTitle": "Master Locksmith & Owner",
      "worksFor": {
        "@type": "Locksmith",
        "name": "Armstrong Locksmith Inc"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/shop.jpeg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://armstronglocksmithinc.com/blog/${post.id}/`
    }
  }
];
const computedTitle = post.data.title.length > 45 
  ? post.data.title 
  : `${post.data.title} | Armstrong Locksmith`;
---

<Layout 
  title={computedTitle} 
  description={post.data.description} 
  canonical={`/blog/${post.id}/`}
  schema={blogSchema}
>
  <!-- Breadcrumbs -->
  <nav class="bg-[#0b162a] text-slate-400 py-3 px-4 sm:px-8 text-xs border-b border-slate-800" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-amber-400">Home</a>
      <span>&rsaquo;</span>
      <a href="/blog/" class="hover:text-amber-400">Blog</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200 truncate max-w-xs sm:max-w-md">{post.data.title}</span>
    </div>
  </nav>

  <!-- Article Header -->
  <header class="bg-[#0f274a] text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto">
      
      <div class="flex items-center gap-2.5 text-xs font-bold text-amber-300 uppercase tracking-wider mb-4">
        <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30 text-amber-300">
          {post.data.category || "Security Guide"}
        </span>
        <span>&bull;</span>
        <span>4 Min Read</span>
        <span>&bull;</span>
        <span>Updated 2026</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black font-serif tracking-tight leading-tight text-white mb-6 max-w-4xl">
        {post.data.title}
      </h1>

      <!-- Author Card Header -->
      <div class="flex items-center gap-3.5 pt-4 border-t border-white/10 w-fit">
        <img 
          src="/images/rahim-face.jpg" 
          alt="Rahim Ezzadpanah" 
          class="w-12 h-12 rounded-full object-cover border-2 border-amber-500 shadow"
        />
        <div class="text-left">
          <div class="flex items-center gap-1.5 text-sm font-bold text-white">
            <span class="text-amber-300 font-medium text-xs">Written by</span>
            <span>{post.data.author || "Rahim Ezzadpanah"}</span>
            <span class="text-emerald-400 text-xs" title="Verified Master Locksmith">✓</span>
          </div>
          <span class="text-xs text-slate-300">Owner & Lead Locksmith &bull; Certified & Insured</span>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Article Body + Sticky Sidebar Layout -->
  <div class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-[#f8fafc]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- MAIN ARTICLE COLUMN (Span 8) -->
      <main class="lg:col-span-8 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
        
        <!-- Featured Image Banner -->
        <div class="rounded-2xl overflow-hidden mb-8 border border-slate-200 shadow-sm max-h-96">
          <img 
            src={postImage} 
            alt={post.data.title} 
            class="w-full h-auto object-cover"
          />
        </div>

        <!-- Quick Facts / Key Takeaway Card -->
        <div class="mb-8 p-5 sm:p-6 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-slate-900">
          <div class="flex items-center gap-2 mb-2.5">
            <span class="text-base">⚡</span>
            <span class="text-xs font-black uppercase tracking-wider text-amber-900">Quick Key Takeaways</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200/60 shadow-sm">
              <span class="text-slate-500 block text-[10px] uppercase font-bold">Mobile ETA</span>
              <strong class="text-[#0f274a] font-black text-sm">Prompt Mobile ETA</strong>
            </div>
            <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200/60 shadow-sm">
              <span class="text-slate-500 block text-[10px] uppercase font-bold">Storefront</span>
              <strong class="text-[#0f274a] font-black text-sm">208 Thompson</strong>
            </div>
            <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200/60 shadow-sm">
              <span class="text-slate-500 block text-[10px] uppercase font-bold">Dealership Save</span>
              <strong class="text-emerald-700 font-black text-sm">Save $200–$600</strong>
            </div>
            <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200/60 shadow-sm">
              <span class="text-slate-500 block text-[10px] uppercase font-bold">State License</span>
              <strong class="text-amber-800 font-black text-sm">Certified & Insured</strong>
            </div>
          </div>
        </div>

        <!-- Rendered Markdown Body with Rich Typography -->
        <article class="article-content max-w-none text-slate-800 leading-relaxed font-sans">
          <Content />
        </article>

        <!-- In-Article Emergency Dispatch Banner -->
        <div class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-[#0f274a] via-[#16335c] to-[#0f274a] text-white shadow-xl border-t-4 border-amber-500 flex flex-col md:flex-row items-center justify-between gap-6 text-left">
          <div>
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-300 bg-white/10 px-2.5 py-1 rounded-full">
              🚨 24/7 Mobile Dispatch Across Greater Nashville
            </span>
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-white mt-2 mb-1">
              Need A Replacement Key or Rekey Today?
            </h3>
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed max-w-md">
              Skip the dealership delays. Our mobile locksmith vans are equipped with factory key programmers and precision laser cutters.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto flex-shrink-0">
            <a 
              href="tel:6156258000" 
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm text-center shadow-lg transition active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap"
            >
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
              <span>Call (615) 625-8000</span>
            </a>
            <a 
              href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-5 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs text-center shadow transition active:scale-95 flex items-center justify-center whitespace-nowrap"
            >
              <span>Book Online</span>
            </a>
          </div>
        </div>

        <style is:inline>
          .article-content h2 {
            font-family: 'Fraunces', serif;
            font-size: 1.85rem;
            font-weight: 800;
            color: #0f274a;
            margin-top: 2.25rem;
            margin-bottom: 0.85rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #f1f5f9;
            line-height: 1.3;
          }
          .article-content h3 {
            font-family: 'Fraunces', serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: #1e3a8a;
            margin-top: 1.75rem;
            margin-bottom: 0.65rem;
            line-height: 1.35;
          }
          .article-content h4 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0f274a;
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
          }
          .article-content p {
            font-size: 1.05rem;
            line-height: 1.85;
            color: #334155;
            margin-bottom: 1.35rem;
          }
          .article-content strong {
            color: #0f172a;
            font-weight: 800;
          }
          .article-content a {
            color: #d97706;
            text-decoration: underline;
            font-weight: 600;
            text-underline-offset: 3px;
            transition: color 0.15s ease;
          }
          .article-content a:hover {
            color: #b45309;
          }
          .article-content ul {
            list-style-type: disc;
            padding-left: 1.75rem;
            margin-bottom: 1.35rem;
            color: #334155;
          }
          .article-content ol {
            list-style-type: decimal;
            padding-left: 1.75rem;
            margin-bottom: 1.35rem;
            color: #334155;
          }
          .article-content li {
            font-size: 1.05rem;
            line-height: 1.75;
            margin-bottom: 0.5rem;
          }
          .article-content blockquote {
            border-left: 4px solid #f59e0b;
            background: #fffbeb;
            padding: 1.15rem 1.5rem;
            border-radius: 0.75rem;
            color: #92400e;
            font-size: 1.05rem;
            font-style: italic;
            margin: 1.75rem 0;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.08);
          }
          .article-content img {
            border-radius: 1rem;
            margin: 1.75rem 0;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);
            border: 1px solid #e2e8f0;
            width: 100%;
            height: auto;
            object-fit: cover;
          }
          .article-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.75rem 0;
            font-size: 0.95rem;
            border-radius: 0.75rem;
            overflow: hidden;
            border: 1px solid #e2e8f0;
          }
          .article-content th {
            background: #0f274a;
            color: #ffffff;
            padding: 0.85rem 1rem;
            text-align: left;
            font-weight: 700;
          }
          .article-content td {
            padding: 0.85rem 1rem;
            border: 1px solid #e2e8f0;
            color: #334155;
          }
          .article-content tr:nth-child(even) {
            background: #f8fafc;
          }
          @media (max-width: 640px) {
            .article-content h2 { font-size: 1.5rem; }
            .article-content h3 { font-size: 1.25rem; }
            .article-content p, .article-content li { font-size: 0.98rem; }
          }
        </style>

        <!-- Author Signature Card -->
        <div class="mt-12 p-6 sm:p-7 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center sm:items-start gap-5">
          <img 
            src="/images/rahim-face.jpg" 
            alt="Rahim Ezzadpanah, Owner of Armstrong Locksmith Nashville" 
            class="w-24 h-24 rounded-2xl object-cover border-2 border-amber-500 shadow-md flex-shrink-0"
          />
          <div class="text-left flex-grow">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 block mb-0.5">Written by</span>
            <h3 class="text-xl font-bold text-[#0f274a] font-serif mb-1.5 flex items-center gap-2">
              <span>Rahim Ezzadpanah</span>
              <span class="text-xs font-sans font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">Verified Master Locksmith</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
              Rahim is the founder and lead automotive security specialist at Armstrong Locksmith with over 20 years of hands-on experience in European immobilizer programming, commercial door hardware, and residential rekeying.
            </p>
            <div class="flex items-center gap-3 text-xs font-bold text-slate-700">
              <span class="text-amber-700 font-extrabold">📜 Certified & Insured</span>
              <span>&bull;</span>
              <span>📍 Nashville Storefront: 208 Thompson Ln</span>
            </div>
          </div>
        </div>

      </main>

      <!-- STICKY SIDEBAR COLUMN (Span 4) -->
      <aside class="lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-24">
        
        <!-- Emergency Dispatch / Fast Call Box -->
        <div class="bg-[#0f274a] text-white rounded-3xl p-6 sm:p-7 shadow-xl border-t-4 border-amber-500 text-left flex flex-col gap-4">
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-400 bg-amber-400/20 px-2 py-0.5 rounded">
              ⚡ Prompt Mobile Dispatch
            </span>
            <h3 class="text-xl font-bold font-serif text-white mt-2">
              Need Locksmith Help in Nashville?
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 mt-1">
              Speak directly with Rahim or an on-duty technician. Upfront quotes with zero hidden fees.
            </p>
          </div>

          <div class="flex flex-col gap-2.5 pt-2">
            <a 
              href="tel:6156258000" 
              class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm text-center shadow flex items-center justify-center gap-2 transition active:scale-95"
            >
              <svg class="w-4 h-4 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
              <span>Call (615) 625-8000</span>
            </a>

            <a 
              href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs text-center shadow transition active:scale-95"
            >
              <span>Book Appointment Online</span>
            </a>
          </div>
        </div>

        <!-- Storefront Drop-In Card -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm text-left">
          <div class="rounded-xl overflow-hidden mb-3">
            <img src="/shop.jpeg" alt="Armstrong Locksmith Storefront" class="w-full h-32 object-cover" />
          </div>
          <h4 class="text-sm font-bold text-[#0f274a] font-serif mb-1">Visit Our Nashville Shop</h4>
          <p class="text-xs text-slate-600 mb-3">Save mobile dispatch fees by visiting our physical store on Thompson Lane.</p>
          <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-700 flex flex-col gap-1">
            <span>📍 <strong>208 Thompson Ln, Nashville</strong></span>
            <span>🕒 Mon-Fri: 8AM–11:30PM | Sat: 10AM–4PM</span>
          </div>
        </div>

        <!-- Quick Services Menu Box -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm text-left">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Popular Services</h4>
          <ul class="flex flex-col gap-2 text-xs font-bold text-slate-700">
            <li><a href="/european-car-key-specialist/" class="hover:text-amber-600 flex items-center justify-between py-1 border-b border-slate-100"><span>🏎️ European Keys</span> <span>&rarr;</span></a></li>
            <li><a href="/car-key-replacement-nashville/" class="hover:text-amber-600 flex items-center justify-between py-1 border-b border-slate-100"><span>🔑 Car Key Replacement</span> <span>&rarr;</span></a></li>
            <li><a href="/residential-locksmith-nashville/" class="hover:text-amber-600 flex items-center justify-between py-1 border-b border-slate-100"><span>🏡 Residential Rekeying</span> <span>&rarr;</span></a></li>
            <li><a href="/commercial-locksmith/" class="hover:text-amber-600 flex items-center justify-between py-1 border-b border-slate-100"><span>🏢 Storefront Locks</span> <span>&rarr;</span></a></li>
            <li><a href="/locksmith-pricing-nashville/" class="hover:text-amber-600 flex items-center justify-between py-1"><span>💵 2026 Price Guide</span> <span>&rarr;</span></a></li>
          </ul>
        </div>

      </aside>

    </div>
  </div>

  <!-- Related Articles Grid Section -->
  {relatedPosts.length > 0 && (
    <section class="py-14 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-8">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0f274a] font-serif">
            Related Locksmith Articles
          </h2>
          <a href="/blog/" class="text-xs font-bold text-amber-700 hover:text-amber-800">
            View All Guides &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relatedPosts.map((rPost) => (
            <article class="bg-slate-50 rounded-2xl p-5 border border-slate-200 hover:border-amber-500 transition flex flex-col justify-between group">
              <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-amber-600 mb-2">
                  {rPost.data.category || "Insights"}
                </div>
                <h3 class="font-bold text-[#0f274a] font-serif text-base mb-2 group-hover:text-amber-600 transition leading-snug">
                  <a href={`/blog/${rPost.id}/`}>
                    {rPost.data.title}
                  </a>
                </h3>
                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                  {rPost.data.description}
                </p>
              </div>
              <div class="pt-4 mt-4 border-t border-slate-200 text-xs font-bold text-[#0f274a] group-hover:text-amber-600">
                Read Article &rarr;
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>
