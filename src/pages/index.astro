  <script is:inline>
    (function () {
      // 1. Form Interaction & Twilio SMS Dispatch
      const toggleBtn = document.getElementById('toggle-optional-fields');
      const optionalFields = document.getElementById('optional-fields-container');
      const form = document.getElementById('hero-quote-form');
      const successMsg = document.getElementById('quote-success-msg');
      const submitBtn = document.getElementById('quote-submit-btn');

      if (toggleBtn && optionalFields) {
        toggleBtn.addEventListener('click', function () {
          const isHidden = optionalFields.classList.contains('hidden');
          if (isHidden) {
            optionalFields.classList.remove('hidden');
            optionalFields.classList.add('flex');
            toggleBtn.textContent = '- Hide extra details';
          } else {
            optionalFields.classList.add('hidden');
            optionalFields.classList.remove('flex');
            toggleBtn.textContent = '+ Add email or extra details';
          }
        });
      }

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>⚡ Dispatching SMS Alert...</span>';
          }

          const formData = {
            name: form.name.value,
            phone: form.phone.value,
            service: form.service.value,
            details: form.details.value,
            email: form.email ? form.email.value : '',
            notes: form.notes ? form.notes.value : ''
          };

          try {
            // POST to Twilio SMS Handler endpoint
            const res = await fetch('/api/contact.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            await res.json();
          } catch (err) {
            console.log('Form submitted:', err);
          }

          form.classList.add('hidden');
          if (successMsg) {
            successMsg.classList.remove('hidden');
          }
        });
      }

      // 2. Reviews Slider Controls & Live Auto-Sync
      const prevBtn = document.getElementById('reviews-prev-btn');
      const nextBtn = document.getElementById('reviews-next-btn');
      const slider = document.getElementById('reviews-grid-container');

      if (prevBtn && nextBtn && slider) {
        prevBtn.addEventListener('click', () => {
          slider.scrollBy({ left: -360, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          slider.scrollBy({ left: 360, behavior: 'smooth' });
        });
      }

      async function syncLiveGoogleReviews() {
        try {
          const res = await fetch('/api/reviews.php');
          if (!res.ok) return;
          const data = await res.json();
          
          if (data && data.reviews && data.reviews.length > 0) {
            const container = document.getElementById('reviews-grid-container');
            const ratingText = document.getElementById('google-rating-text');
            
            if (ratingText && data.rating) {
              ratingText.textContent = `Google Verified Business • ${data.rating} Star Rating (${data.user_ratings_total || '750+'} Reviews)`;
            }

            if (container && data.reviews.length >= 3) {
              container.innerHTML = data.reviews.map(rev => `
                <div class="min-w-[85%] sm:min-w-[320px] lg:min-w-[350px] max-w-[380px] snap-start shrink-0 card-clean rounded-2xl p-6 flex flex-col justify-between relative bg-white border border-slate-200 shadow-sm hover:shadow-md transition">
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-3">
                      <div>
                        <h3 class="font-bold text-[#0f274a] text-sm sm:text-base leading-tight">${rev.author_name || rev.name}</h3>
                        <div class="text-[11px] text-slate-400 mt-0.5">Nashville, TN &bull; ${rev.relative_time_description || 'Recently'}</div>
                      </div>
                      <div class="flex items-center text-amber-500 text-sm tracking-tighter">
                        ★★★★★
                      </div>
                    </div>

                    <div class="inline-block px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold uppercase tracking-wider mb-3">
                      ${rev.service || 'Verified Customer'}
                    </div>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal line-clamp-4">
                      "${rev.text}"
                    </p>
                  </div>

                  <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                    <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Verified Google Review
                    </span>
                    <span class="font-semibold text-slate-400">${rev.rating || 5.0} ★</span>
                  </div>
                </div>
              `).join('');
            }
          }
        } catch (e) {
          // Keep existing rendered reviews if network fails
        }
      }

      // Sync live reviews non-blockingly during idle time
      if ('requestIdleCallback' in window) {
        requestIdleCallback(syncLiveGoogleReviews, { timeout: 3000 });
      } else {
        setTimeout(syncLiveGoogleReviews, 1500);
      }
    })();
  </script>

</Layout>
