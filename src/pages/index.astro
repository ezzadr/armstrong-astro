---
import Layout from '../layouts/Layout.astro';
import TextPhotoCTA from '../components/TextPhotoCTA.astro';
import RecentWorkGallery from '../components/RecentWorkGallery.astro';

const seoTitle = "Nashville Locksmith — Car Keys, Rekeys & Lockouts | Armstrong";
const seoDescription = "Owner-led Nashville locksmith with a real storefront on Thompson Ln. Car keys, rekeys, lockouts & commercial service. Certified & Insured. Call (615) 625-8000.";

// Initial Verified Reviews (Instant SSR load with live client sync)
const initialReviews = [
  {
    name: "Marcus Vance",
    location: "Nashville, TN",
    service: "BMW Key Replacement",
    rating: 5,
    date: "2 weeks ago",
    text: "Saved me over $600 compared to the BMW dealership! The dealer wanted to tow my 2021 BMW 5-Series and keep it for 10 days. Rahim came out with dealer-level equipment, cut the emergency physical blade, and programmed the smart key fob the same day right on-site. Unbelievable service.",
    verified: true
  },
  {
    name: "Jessica Holloway",
    location: "Nashville, TN",
    service: "Residential Rekeying",
    rating: 5,
    date: "1 month ago",
    text: "We just bought our home and needed all exterior deadbolts rekeyed immediately. Armstrong gave me an upfront quote over the phone with zero hidden fees. The technician arrived right on time, repinned all locks to one master key, and provided 4 copies on the spot. Highly recommended!",
    verified: true
  },
  {
    name: "Carlos Mendez",
    location: "Nashville, TN",
    service: "Audi Smart Key Fob",
    rating: 5,
    date: "3 weeks ago",
    text: "Having an actual physical storefront made all the difference. I walked in during my lunch break, Rahim cut and programmed a second smart key for my Audi A6 in less than 20 minutes. Clean shop, honest pricing, and friendly master locksmith.",
    verified: true
  },
  {
    name: "Brittany Sterling",
    location: "Nashville, TN",
    service: "Emergency Car Lockout",
    rating: 5,
    date: "2 months ago",
    text: "Accidentally locked my keys in the car on a Sunday evening. Armstrong had a mobile technician at my location promptly. Used non-destructive air wedges and had me back inside in under 3 minutes with zero damage to the door trim.",
    verified: true
  },
  {
    name: "David Kowalski",
    location: "Nashville, TN",
    service: "Commercial Storefront Hardware",
    rating: 5,
    date: "1 month ago",
    text: "We run a retail storefront and our mortise lock broke right before opening. Armstrong Locksmith arrived with full Adams Rite commercial hardware in their van, replaced the broken cylinder, and rekeyed our staff keys. True professionals.",
    verified: true
  },
  {
    name: "Amanda Chen",
    location: "Nashville, TN",
    service: "Mercedes Push-To-Start Fob",
    rating: 5,
    date: "3 months ago",
    text: "Dealer told me 3 weeks backorder for a replacement Mercedes key fob. Called Armstrong, Rahim confirmed he had the OEM blank in stock at the shop, drove out, and had it fully synced to my EIS computer that afternoon. Fast, courteous, and transparent pricing.",
    verified: true
  }
];

// Advanced Local Ranking Authority Schema for Homepage
const homepageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://armstronglocksmithinc.com/#website",
    "url": "https://armstronglocksmithinc.com/",
    "name": "Armstrong Locksmith Nashville",
    "description": "Certified local locksmith with physical storefront at 208 Thompson Ln, Nashville TN.",
    "publisher": {
      "@id": "https://armstronglocksmithinc.com/#locksmith"
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/" schema={homepageSchema}>
  
  <!-- ==================== HERO SECTION WITH REAL STOREFRONT IDENTITY ==================== -->
  <section class="relative bg-[#07152b] text-white py-12 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <!-- Subtle Shop Background Layer -->
    <div class="absolute inset-0 bg-cover bg-center opacity-20 pointer-events-none" style="background-image: url('/shop.jpeg');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#07152b] via-[#07152b]/95 to-[#07152b]/80 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center relative z-10">
      
      <!-- Left Hero Content -->
      <div class="lg:col-span-7 flex flex-col gap-4 sm:gap-5 text-left">
        
        <!-- Gold Dash Eyebrow -->
        <div class="flex items-center gap-2 text-xs sm:text-sm font-black tracking-widest text-[#f59e0b] uppercase font-sans">
          <span class="w-6 h-1 bg-[#f59e0b] rounded-full inline-block"></span>
          <span>FAMILY-OWNED &bull; 20 YEARS OF LOCKSMITH EXPERIENCE</span>
        </div>

        <!-- Massive Bold Storefront Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-sans uppercase text-white tracking-tight leading-[1.08]">
          NASHVILLE LOCKSMITH WITH A REAL STOREFRONT
        </h1>

        <!-- Trust Grounded Sub-Copy -->
        <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed font-normal max-w-2xl">
          Armstrong Locksmith Inc is a family-owned shop at <strong>208 Thompson Ln</strong> in Nashville, TN. Visit us for car keys and key programming, or call for mobile help with lockouts, home rekeys, commercial locks, and door hardware during posted hours.
        </p>

        <!-- Direct Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <!-- Primary Call Button -->
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-lg bg-[#f59e0b] hover:bg-amber-400 text-slate-950 font-black text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 border-b-2 border-amber-600"
            aria-label="Call Armstrong Locksmith at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>CALL (615) 625-8000</span>
          </a>

          <!-- Secondary Text Photo Button -->
          <a 
            href="sms:6156258000" 
            class="px-8 py-4 rounded-lg bg-[#07152b]/90 hover:bg-[#0f274a] text-white font-black text-base uppercase tracking-wider flex items-center justify-center gap-2 border-2 border-slate-500 hover:border-slate-300 shadow-xl transition active:scale-95"
            aria-label="Text Armstrong Locksmith a photo at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Text Us a Photo</span>
          </a>
        </div>

        <!-- Streamlined Non-Busy Trust Credibility Bar -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 pt-6 border-t border-white/10 text-xs sm:text-sm text-slate-300">
          <div class="inline-flex items-center gap-2">
            <span class="text-amber-400 font-bold tracking-tighter text-sm">★★★★★</span>
            <span><strong class="text-white font-bold">4.9/5 Rating</strong> (750+ Reviews)</span>
          </div>
          <span class="hidden sm:inline text-slate-600 font-bold">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">🛡️</span>
            <span><strong class="text-white font-bold">Certified & Insured</strong></span>
          </div>
          <span class="hidden sm:inline text-slate-600 font-bold">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">📍</span>
            <span><strong class="text-white font-bold">Storefront:</strong> 208 Thompson Ln</span>
          </div>
          <span class="hidden lg:inline text-slate-600 font-bold">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">🔑</span>
            <span>Auto &bull; Residential &bull; Commercial</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Hero Contact / Instant Quote Form Card -->
      <div class="lg:col-span-5" id="quote-form-section">
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border-2 border-amber-400/90 ring-4 ring-amber-400/20 text-slate-900 relative overflow-hidden">
          <!-- Top Accent Banner -->
          <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500"></div>

          <div class="pb-3 mb-4 border-b border-slate-100">
            <h2 class="text-2xl sm:text-3xl font-black text-[#0f274a] font-serif tracking-tight">
              Get a Quote
            </h2>
          </div>

          <form id="hero-quote-form" class="flex flex-col gap-3.5 text-left">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="quote-name" class="block text-xs font-bold text-slate-800 mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  id="quote-name" 
                  name="name" 
                  required 
                  placeholder="e.g. John Smith" 
                  class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 transition-all font-medium"
                />
              </div>
              <div>
                <label for="quote-phone" class="block text-xs font-bold text-slate-800 mb-1">Phone Number *</label>
                <input 
                  type="tel" 
                  id="quote-phone" 
                  name="phone" 
                  required 
                  placeholder="(615) 000-0000" 
                  class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 transition-all font-medium"
                />
              </div>
            </div>

            <div>
              <label for="quote-service" class="block text-xs font-bold text-slate-800 mb-1">Service Needed *</label>
              <select 
                id="quote-service" 
                name="service" 
                required 
                class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 transition-all font-medium"
              >
                <option value="">Select a service...</option>
                <option value="Car Key Replacement">🔑 Car Key Replacement (All Makes)</option>
                <option value="European Specialist">🏎️ European Key (BMW, Benz, Audi, Land Rover)</option>
                <option value="Key Fob Programming">📶 Key Fob & Remote Programming</option>
                <option value="Emergency Car Lockout">🚨 Emergency Car Lockout</option>
                <option value="House Lockout / Rekey">🏡 House Lockout or Rekey</option>
                <option value="Commercial Locksmith">🏢 Commercial Door Hardware & Storefront</option>
                <option value="Other">🛠️ Other Locksmith Service</option>
              </select>
            </div>

            <div>
              <label for="quote-details" class="block text-xs font-bold text-slate-800 mb-1">Vehicle Make / Model or Details</label>
              <input 
                type="text" 
                id="quote-details" 
                name="details" 
                placeholder="e.g. 2021 BMW X5, locked out, or 3 deadbolts" 
                class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 transition-all font-medium"
              />
            </div>

            <div>
              <button 
                type="button" 
                id="toggle-optional-fields" 
                class="text-xs font-bold text-amber-700 hover:text-amber-900 underline flex items-center gap-1 cursor-pointer py-1"
              >
                <span>+ Add email or extra details (optional)</span>
              </button>
              
              <div id="optional-fields-container" class="hidden flex-col gap-2.5 mt-2 pt-2 border-t border-slate-100">
                <div>
                  <label for="quote-email" class="block text-xs font-medium text-slate-600 mb-0.5">Email Address</label>
                  <input 
                    type="email" 
                    id="quote-email" 
                    name="email" 
                    placeholder="john@example.com" 
                    class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900"
                  />
                </div>
                <div>
                  <label for="quote-notes" class="block text-xs font-medium text-slate-600 mb-0.5">Special Instructions / Message</label>
                  <textarea 
                    id="quote-notes" 
                    name="notes" 
                    rows="2" 
                    placeholder="Describe your situation..." 
                    class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900"
                  ></textarea>
                </div>
              </div>
            </div>

            <button 
              type="submit" 
              id="quote-submit-btn"
              class="w-full mt-1 py-4 px-6 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-black text-base uppercase tracking-wider shadow-xl transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer border border-amber-300"
            >
              <span>Get My Free Quote Now &rarr;</span>
            </button>
            <div class="text-[11px] text-slate-500 text-center font-medium flex items-center justify-center gap-1">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Sent directly to on-duty technician via SMS &bull; Certified & Insured</span>
            </div>
          </form>

          <div id="quote-success-msg" class="hidden p-6 rounded-2xl bg-emerald-50 border-2 border-emerald-400 text-emerald-900 text-center">
            <div class="text-4xl mb-2">📱</div>
            <strong class="block text-base font-black text-emerald-950">Quote Dispatched to On-Duty Locksmith!</strong>
            <p class="text-xs text-emerald-800 mt-1.5 leading-relaxed font-medium">
              A text notification was sent to our mobile team. We will call or text you promptly with upfront pricing.
            </p>
            <div class="mt-4 pt-3 border-t border-emerald-200">
              <a href="tel:6156258000" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 text-white font-bold text-xs shadow hover:bg-emerald-700 transition">
                <span>Need immediate emergency help? Call (615) 625-8000 &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== OVERLAPPING FEATURE BOXES (CARSERVICE THEME STYLE) ==================== -->
  <section class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-10 mb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      
      <!-- Feature 1 -->
      <a href="/european-car-key-specialist/" class="group bg-[#0f274a] text-white p-6 rounded-2xl shadow-2xl border-t-4 border-amber-500 hover:bg-[#16335c] transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-black text-xl mb-4 group-hover:scale-110 transition-transform">
            🏎️
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-amber-400 block mb-1">Dealer Alternative</span>
          <h3 class="text-lg font-black text-white font-serif mb-2 leading-tight">European Specialists</h3>
          <p class="text-xs text-slate-300 leading-relaxed font-medium">
            BMW (CAS/FEM), Mercedes (FBS3/4), Audi (BCM2), & Land Rover (KVM) keys programmed same day.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between text-xs font-bold text-amber-400 group-hover:text-white transition">
          <span>Explore European &rarr;</span>
        </div>
      </a>

      <!-- Feature 2 -->
      <a href="/car-key-replacement-nashville/" class="group bg-white text-slate-900 p-6 rounded-2xl shadow-xl border-t-4 border-[#0f274a] hover:border-amber-500 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between border-x border-b border-slate-200">
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-100 text-[#0f274a] flex items-center justify-center font-black text-xl mb-4 group-hover:bg-amber-500 group-hover:text-slate-950 transition-all">
            🔑
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-500 block mb-1">Mobile & In-Shop</span>
          <h3 class="text-lg font-black text-[#0f274a] font-serif mb-2 leading-tight">All-Keys-Lost Service</h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            Lost your only key? We laser-cut precision factory blades and program smart fobs on-site.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#0f274a] group-hover:text-amber-600 transition">
          <span>Car Key Pricing &rarr;</span>
        </div>
      </a>

      <!-- Feature 3 -->
      <a href="/nashville-locksmith-storefront/" class="group bg-white text-slate-900 p-6 rounded-2xl shadow-xl border-t-4 border-[#0f274a] hover:border-amber-500 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between border-x border-b border-slate-200">
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-100 text-[#0f274a] flex items-center justify-center font-black text-xl mb-4 group-hover:bg-amber-500 group-hover:text-slate-950 transition-all">
            🏬
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-500 block mb-1">Walk-Ins Welcome</span>
          <h3 class="text-lg font-black text-[#0f274a] font-serif mb-2 leading-tight">208 Thompson Lane</h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            Real storefront location in Nashville. Drop in for quick key duplicates, fob batteries, and lock rekeys.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#0f274a] group-hover:text-amber-600 transition">
          <span>Visit Our Shop &rarr;</span>
        </div>
      </a>

      <!-- Feature 4 -->
      <a href="/emergency-car-lockout/" class="group bg-white text-slate-900 p-6 rounded-2xl shadow-xl border-t-4 border-[#0f274a] hover:border-amber-500 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between border-x border-b border-slate-200">
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-100 text-[#0f274a] flex items-center justify-center font-black text-xl mb-4 group-hover:bg-amber-500 group-hover:text-slate-950 transition-all">
            🚨
          </div>
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-600 font-bold block mb-1">Prompt Mobile Dispatch</span>
          <h3 class="text-lg font-black text-[#0f274a] font-serif mb-2 leading-tight">Emergency Unlock</h3>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            Locked keys in the trunk or car? Fast dispatch across Nashville with 100% damage-free air wedges.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-[#0f274a] group-hover:text-amber-600 transition">
          <span>Emergency Help &rarr;</span>
        </div>
      </a>

    </div>
  </section>

  <!-- ==================== INSTANT ESTIMATOR SMS CTA ==================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-8 mb-8">
    <TextPhotoCTA />
  </section>

  <!-- ==================== RECENT WORK SECTION (LIVE WORK SAMPLES) ==================== -->
  <RecentWorkGallery />

  <!-- ==================== CORE SERVICES (AUTO WORKSHOP THEME STYLE) ==================== -->
  <section class="py-16 sm:py-24 bg-slate-100 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-14">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-black uppercase tracking-wider mb-3 border border-amber-200">
            <span>⚙️</span>
            <span>Master Automotive & Security Services</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#0f274a] font-serif tracking-tight mt-1">
            Our Core Locksmith Services
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl font-medium">
            Full-service automotive, commercial, and residential locksmithing backed by over 20 years of hands-on experience and TN State License #406.
          </p>
        </div>
        <a href="/locksmith-pricing-nashville/" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-slate-300 text-xs sm:text-sm font-black text-[#0f274a] hover:border-amber-500 shadow-sm transition shrink-0">
          <span>View 2026 Upfront Pricing Guide</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Services Grid with Automotive Workshop Theme Styling -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Card 1: European -->
        <div class="bg-white rounded-3xl p-8 flex flex-col justify-between border-2 border-amber-400 shadow-xl relative overflow-hidden group hover:border-[#0f274a] transition-all duration-300">
          <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-widest px-4 py-1 rounded-bl-xl">
            Specialty
          </div>
          <div>
            <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-[#0f274a] group-hover:text-amber-400 transition-all duration-300">
              🏎️
            </div>
