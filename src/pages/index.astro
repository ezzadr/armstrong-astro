---
import Layout from '../layouts/Layout.astro';
import TextPhotoCTA from '../components/TextPhotoCTA.astro';
import RecentWorkGallery from '../components/RecentWorkGallery.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "Nashville Locksmith — Car Keys, Rekeys & Lockouts | Armstrong";
const seoDescription = "Owner-led Nashville locksmith with a real storefront on Thompson Ln. Car keys, rekeys, lockouts & commercial service. Certified & Insured. Call (615) 625-8000.";

// Initial Verified Reviews (Instant SSR load with live client sync)
const initialReviews = [
  {
    name: "Marcus Vance",
    location: "Nashville, TN",
    service: "BMW Key Replacement",
    rating: 5,
    date: "2 weeks ago",
    text: "Saved me over $600 compared to the BMW dealership! The dealer wanted to tow my 2021 BMW 5-Series and keep it for 10 days. Rahim came out with dealer-level equipment, cut the emergency physical blade, and programmed the smart key fob the same day right on-site. Unbelievable service.",
    verified: true
  },
  {
    name: "Jessica Holloway",
    location: "Nashville, TN",
    service: "Residential Rekeying",
    rating: 5,
    date: "1 month ago",
    text: "We just bought our home and needed all exterior deadbolts rekeyed immediately. Armstrong gave me an upfront quote over the phone with zero hidden fees. The technician arrived right on time, repinned all locks to one master key, and provided 4 copies on the spot. Highly recommended!",
    verified: true
  },
  {
    name: "Carlos Mendez",
    location: "Nashville, TN",
    service: "Audi Smart Key Fob",
    rating: 5,
    date: "3 weeks ago",
    text: "Having an actual physical storefront made all the difference. I walked in during my lunch break, Rahim cut and programmed a second smart key for my Audi A6 in less than 20 minutes. Clean shop, honest pricing, and friendly master locksmith.",
    verified: true
  },
  {
    name: "Brittany Sterling",
    location: "Nashville, TN",
    service: "Emergency Car Lockout",
    rating: 5,
    date: "2 months ago",
    text: "Accidentally locked my keys in the car on a Sunday evening. Armstrong had a mobile technician at my location promptly. Used non-destructive air wedges and had me back inside in under 3 minutes with zero damage to the door trim.",
    verified: true
  },
  {
    name: "David Kowalski",
    location: "Nashville, TN",
    service: "Commercial Storefront Hardware",
    rating: 5,
    date: "1 month ago",
    text: "We run a retail storefront and our mortise lock broke right before opening. Armstrong Locksmith arrived with full Adams Rite commercial hardware in their van, replaced the broken cylinder, and rekeyed our staff keys. True professionals.",
    verified: true
  },
  {
    name: "Amanda Chen",
    location: "Nashville, TN",
    service: "Mercedes Push-To-Start Fob",
    rating: 5,
    date: "3 months ago",
    text: "Dealer told me 3 weeks backorder for a replacement Mercedes key fob. Called Armstrong, Rahim confirmed he had the OEM blank in stock at the shop, drove out, and had it fully synced to my EIS computer that afternoon. Fast, courteous, and transparent pricing.",
    verified: true
  }
];

// Advanced Local Ranking Authority Schema for Homepage
const homepageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://armstronglocksmithinc.com/#website",
    "url": "https://armstronglocksmithinc.com/",
    "name": "Armstrong Locksmith Nashville",
    "description": "Certified local locksmith with physical storefront at 208 Thompson Ln, Nashville TN.",
    "publisher": {
      "@id": "https://armstronglocksmithinc.com/#locksmith"
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/" schema={homepageSchema}>
  
  <!-- ==================== HERO SECTION (CAR SHIRE SHARP INDUSTRIAL AESTHETIC) ==================== -->
  <section class="relative bg-[#07152b] text-white py-14 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden font-sans">
    <!-- Dark Workshop Background -->
    <div class="absolute inset-0 bg-cover bg-center opacity-25 pointer-events-none" style="background-image: url('/shop.jpeg');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#07152b] via-[#07152b]/95 to-[#07152b]/85 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center relative z-10">
      
      <!-- Left Hero Column -->
      <div class="lg:col-span-7 flex flex-col gap-5 text-left">
        
        <!-- Sharp Amber Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-amber-500 text-slate-950 text-xs font-black uppercase tracking-widest self-start">
          <span>🛡️</span>
          <span>NASHVILLE'S CERTIFIED MASTER LOCKSMITH &bull; LIC #406</span>
        </div>

        <!-- Massive Sharp Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white leading-[1.08]">
          PRECISION CAR KEYS, REKEYS &amp; EMERGENCY LOCKOUTS
        </h1>

        <!-- Trust Grounded Subtext -->
        <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed font-normal max-w-2xl">
          Family-owned and owner-operated with a physical storefront at <strong>208 Thompson Ln</strong>. Skip the high dealership markups and long delays—our mobile locksmith vans cut and program keys on-site across Middle TN.
        </p>

        <!-- Sharp Value-Prop Checklist (Car Shire Style) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm font-bold text-slate-200">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 bg-amber-500 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">&#10003;</span>
            <span>Dealer-Level Key Programming On-Site</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 bg-amber-500 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">&#10003;</span>
            <span>BMW, Mercedes, Audi &amp; Range Rover</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 bg-amber-500 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">&#10003;</span>
            <span>Upfront Phone Quotes &bull; No Hidden Fees</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 bg-amber-500 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">&#10003;</span>
            <span>Prompt Nashville Mobile Dispatch</span>
          </div>
        </div>

        <!-- Sharp Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <!-- Primary Call Button -->
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 border-b-2 border-amber-600"
            aria-label="Call Armstrong Locksmith at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>CALL (615) 625-8000</span>
          </a>

          <!-- Secondary Text Photo Button -->
          <a 
            href="sms:6156258000" 
            class="px-8 py-4 bg-slate-900/90 hover:bg-slate-900 text-white font-black text-base uppercase tracking-wider flex items-center justify-center gap-2 border border-slate-700 hover:border-slate-500 shadow-xl transition active:scale-95"
            aria-label="Text Armstrong Locksmith a photo at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Text Us a Photo</span>
          </a>
        </div>

        <!-- Trust Stats Bar -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-6 border-t border-white/10 text-xs sm:text-sm text-slate-300">
          <div class="inline-flex items-center gap-2">
            <span class="text-amber-400 font-black">★★★★★</span>
            <span><strong class="text-white font-bold">4.9/5 Rating</strong> (750+ Reviews)</span>
          </div>
          <span class="hidden sm:inline text-slate-600">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400">📍</span>
            <span><strong class="text-white font-bold">Storefront:</strong> 208 Thompson Ln</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Sharp Precision Quote Form -->
      <div class="lg:col-span-5" id="quote-form-section">
        <div class="bg-white p-6 sm:p-8 shadow-2xl text-slate-900 relative overflow-hidden border-t-4 border-amber-500">
          
          <div class="pb-3 mb-4 border-b border-slate-200 flex items-center justify-between">
            <div>
              <h2 class="text-xl sm:text-2xl font-black text-[#0f274a] uppercase tracking-tight">
                Get an Upfront Quote
              </h2>
              <p class="text-xs text-slate-500 font-medium">Direct notification to on-duty technician</p>
            </div>
            <span class="text-xs font-black px-2.5 py-1 bg-[#0f274a] text-amber-400 uppercase tracking-wider">Fast Dispatch</span>
          </div>

          <form id="hero-quote-form" class="flex flex-col gap-3 text-left">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="quote-name" class="block text-xs font-bold text-slate-700 mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  id="quote-name" 
                  name="name" 
                  required 
                  placeholder="e.g. John Smith" 
                  class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition font-medium"
                />
              </div>
              <div>
                <label for="quote-phone" class="block text-xs font-bold text-slate-700 mb-1">Phone Number *</label>
                <input 
                  type="tel" 
                  id="quote-phone" 
                  name="phone" 
                  required 
                  placeholder="(615) 000-0000" 
                  class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition font-medium"
                />
              </div>
            </div>

            <div>
              <label for="quote-service" class="block text-xs font-bold text-slate-700 mb-1">Service Required *</label>
              <select 
                id="quote-service" 
                name="service" 
                required 
                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition font-medium"
              >
                <option value="">Select a service...</option>
                <option value="Car Key Replacement">🔑 Car Key Replacement (All Makes)</option>
                <option value="European Specialist">🏎️ European Key (BMW, Benz, Audi, Land Rover)</option>
                <option value="Key Fob Programming">📶 Key Fob & Remote Programming</option>
                <option value="Emergency Car Lockout">🚨 Emergency Car Lockout</option>
                <option value="House Lockout / Rekey">🏡 House Lockout or Rekey</option>
                <option value="Commercial Locksmith">🏢 Commercial Door Hardware & Storefront</option>
                <option value="Other">🛠️ Other Locksmith Service</option>
              </select>
            </div>

            <div>
              <label for="quote-details" class="block text-xs font-bold text-slate-700 mb-1">Vehicle Year, Make, Model or Lock Details</label>
              <input 
                type="text" 
                id="quote-details" 
                name="details" 
                placeholder="e.g. 2021 BMW X5 all keys lost or 3 deadbolts" 
                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition font-medium"
              />
            </div>

            <div>
              <button 
                type="button" 
                id="toggle-optional-fields" 
                class="text-xs font-bold text-amber-700 hover:text-amber-900 underline flex items-center gap-1 cursor-pointer py-1"
              >
                <span>+ Add email or notes (optional)</span>
              </button>
              
              <div id="optional-fields-container" class="hidden flex-col gap-2 mt-2 pt-2 border-t border-slate-100">
                <div>
                  <label for="quote-email" class="block text-xs font-medium text-slate-600 mb-0.5">Email Address</label>
                  <input 
                    type="email" 
                    id="quote-email" 
                    name="email" 
                    placeholder="john@example.com" 
                    class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900"
                  />
                </div>
                <div>
                  <label for="quote-notes" class="block text-xs font-medium text-slate-600 mb-0.5">Message / Details</label>
                  <textarea 
                    id="quote-notes" 
                    name="notes" 
                    rows="2" 
                    placeholder="Describe your situation..." 
                    class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900"
                  ></textarea>
                </div>
              </div>
            </div>

            <button 
              type="submit" 
              id="quote-submit-btn"
              class="w-full mt-2 py-4 px-6 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm uppercase tracking-wider shadow-lg transition active:scale-95 flex items-center justify-center gap-2 cursor-pointer border-b-2 border-amber-600"
            >
              <span>Get My Upfront Quote &rarr;</span>
            </button>
            <div class="text-[11px] text-slate-500 text-center font-medium flex items-center justify-center gap-1">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Dispatched directly via SMS to on-duty technician</span>
            </div>
          </form>

          <div id="quote-success-msg" class="hidden p-6 bg-emerald-50 border-2 border-emerald-400 text-emerald-900 text-center">
            <div class="text-4xl mb-2">📱</div>
            <strong class="block text-base font-black text-emerald-950">Quote Dispatched to On-Duty Locksmith!</strong>
            <p class="text-xs text-emerald-800 mt-1.5 leading-relaxed font-medium">
              A text notification was sent to our mobile team. We will call or text you promptly with upfront pricing.
            </p>
            <div class="mt-4 pt-3 border-t border-emerald-200">
              <a href="tel:6156258000" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-emerald-600 text-white font-bold text-xs shadow hover:bg-emerald-700 transition">
                <span>Need immediate help? Call (615) 625-8000 &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== CAR SHIRE SIGNATURE 4-FEATURE STRIP ==================== -->
  <section class="bg-[#0f274a] text-white border-b-2 border-amber-500 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
        
        <!-- Strip 1: European -->
        <a href="/european-car-key-specialist/" class="p-6 sm:py-8 group hover:bg-[#16335c] transition flex items-start gap-4">
          <div class="w-12 h-12 bg-amber-500 text-slate-950 flex items-center justify-center text-xl shrink-0 font-black group-hover:scale-105 transition-transform">
            🏎️
          </div>
          <div>
            <span class="text-[10px] font-black text-amber-400 uppercase tracking-widest block">Dealer Alternative</span>
            <h3 class="text-base font-black text-white uppercase tracking-tight mt-0.5">European Specialist</h3>
            <p class="text-xs text-slate-300 mt-1 font-medium leading-normal">BMW, Mercedes, Audi & Range Rover keys made on-site.</p>
          </div>
        </a>

        <!-- Strip 2: Car Keys -->
        <a href="/car-key-replacement-nashville/" class="p-6 sm:py-8 group hover:bg-[#16335c] transition flex items-start gap-4">
          <div class="w-12 h-12 bg-white text-[#0f274a] flex items-center justify-center text-xl shrink-0 font-black group-hover:bg-amber-500 group-hover:text-slate-950 transition-all">
            🔑
          </div>
          <div>
            <span class="text-[10px] font-black text-amber-400 uppercase tracking-widest block">All Makes & Models</span>
            <h3 class="text-base font-black text-white uppercase tracking-tight mt-0.5">Key Replacement</h3>
            <p class="text-xs text-slate-300 mt-1 font-medium leading-normal">Lost your only key? CNC laser cutting & fob sync on-site.</p>
          </div>
        </a>

        <!-- Strip 3: Storefront -->
        <a href="/nashville-locksmith-storefront/" class="p-6 sm:py-8 group hover:bg-[#16335c] transition flex items-start gap-4">
          <div class="w-12 h-12 bg-white text-[#0f274a] flex items-center justify-center text-xl shrink-0 font-black group-hover:bg-amber-500 group-hover:text-slate-950 transition-all">
            🏬
          </div>
          <div>
            <span class="text-[10px] font-black text-amber-400 uppercase tracking-widest block">Nashville Storefront</span>
            <h3 class="text-base font-black text-white uppercase tracking-tight mt-0.5">208 Thompson Lane</h3>
            <p class="text-xs text-slate-300 mt-1 font-medium leading-normal">Walk-ins welcome for quick copies, fobs & deadbolts.</p>
          </div>
        </a>

        <!-- Strip 4: Lockouts -->
        <a href="/emergency-car-lockout/" class="p-6 sm:py-8 group hover:bg-[#16335c] transition flex items-start gap-4">
          <div class="w-12 h-12 bg-red-600 text-white flex items-center justify-center text-xl shrink-0 font-black group-hover:scale-105 transition-transform">
            🚨
          </div>
          <div>
            <span class="text-[10px] font-black text-amber-400 uppercase tracking-widest block">Rapid Dispatch</span>
            <h3 class="text-base font-black text-white uppercase tracking-tight mt-0.5">Emergency Lockouts</h3>
            <p class="text-xs text-slate-300 mt-1 font-medium leading-normal">Damage-free vehicle & home door unlocking in minutes.</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ==================== "WHY CHOOSE ARMSTRONG" SPLIT SECTION (CAR SHIRE SIGNATURE) ==================== -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Authentic Craftsmanship Photo with Gold Badge -->
        <div class="lg:col-span-5 relative">
          <div class="relative border-4 border-[#0f274a] shadow-xl">
            <img 
              src="/images/rahim-ezzadpanah-the-owner-of-armstrong-locksmith.jpeg" 
              alt="Rahim Ezzadpanah, Master Locksmith in Nashville" 
              class="w-full h-auto object-cover"
              loading="lazy"
              width="500"
              height="500"
            />
            <!-- Sharp Floating Badge -->
            <div class="absolute bottom-0 left-0 right-0 bg-[#0f274a] text-white p-4 border-t-4 border-amber-500 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest block">Founder & Master Locksmith</span>
                <strong class="text-sm font-black uppercase text-white">Rahim Ezzadpanah</strong>
              </div>
              <span class="text-xs font-black bg-amber-500 text-slate-950 px-2.5 py-1 uppercase">Lic #406</span>
            </div>
          </div>
        </div>

        <!-- Right: Authority Copy & 4 Sharp Counter Tiles -->
        <div class="lg:col-span-7 flex flex-col gap-5 text-left">
          
          <div class="flex items-center gap-2">
            <span class="w-8 h-1 bg-amber-500 inline-block"></span>
            <span class="text-xs font-black text-amber-600 uppercase tracking-widest">Why Choose Armstrong Locksmith</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#0f274a] uppercase tracking-tight">
            Over 20 Years of Honest Locksmithing in Nashville
          </h2>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-medium">
            Unlike out-of-state call centers that farm your call out to unvetted contractors, Armstrong Locksmith is a real, family-owned business established right here in Nashville. When you call us, you speak directly with our licensed locksmiths who quote upfront and arrive in fully equipped mobile vans.
          </p>

          <!-- 4 Sharp Stats Boxes -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2">
            
            <div class="p-5 bg-slate-50 border-t-4 border-[#0f274a] border-x border-b border-slate-200 text-center">
              <span class="text-3xl font-black text-[#0f274a] block font-sans">20+</span>
              <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mt-1 block">Years Experience</span>
            </div>

            <div class="p-5 bg-slate-50 border-t-4 border-amber-500 border-x border-b border-slate-200 text-center">
              <span class="text-3xl font-black text-amber-600 block font-sans">750+</span>
              <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mt-1 block">5-Star Reviews</span>
            </div>

            <div class="p-5 bg-slate-50 border-t-4 border-[#0f274a] border-x border-b border-slate-200 text-center">
              <span class="text-3xl font-black text-[#0f274a] block font-sans">#406</span>
              <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mt-1 block">TN State License</span>
            </div>

            <div class="p-5 bg-slate-50 border-t-4 border-emerald-600 border-x border-b border-slate-200 text-center">
              <span class="text-3xl font-black text-emerald-700 block font-sans">100%</span>
              <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mt-1 block">Mobile On-Site</span>
            </div>

          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- ==================== CAR SHIRE IMAGE-TOPPED SERVICE CARDS ==================== -->
  <section class="py-16 sm:py-24 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200 font-sans">
    <div class="max-w-7xl mx-auto">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-8 h-1 bg-amber-500 inline-block"></span>
            <span class="text-xs font-black text-amber-600 uppercase tracking-widest">Our Capabilities</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#0f274a] uppercase tracking-tight">
