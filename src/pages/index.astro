---
import Layout from '../layouts/Layout.astro';
import RecentWorkGallery from '../components/RecentWorkGallery.astro';
import { getReviewStats, getLiveReviews } from '../lib/reviewStats.mjs';
import { storeWeekdays, storeSaturday } from '../data/hours.mjs';

// Live Google rating/count plus the newest real 5-star reviews, fetched once at
// build time (src/lib/reviewStats.mjs). The cards below are server-rendered
// from that data and then refreshed in the browser by syncLiveGoogleReviews().
// Nothing here is hand-written: if the endpoint is unreachable at build the
// list is empty and the browser fills the cards in on load.
const { reviewCount, ratingValue } = await getReviewStats();

const seoTitle = `Locksmith Nashville TN | Car Keys, Lockouts & Rekey Service`;
const seoDescription = `Real Nashville locksmith shop at 208 Thompson Ln & mobile vans. Car keys, smart fobs, lockouts, home rekeying & commercial locks. ${reviewCount}+ 5-star reviews. (615) 625-8000.`;

const initialReviews = (await getLiveReviews())
  .filter((r) => Number(r.rating) === 5)
  .slice(0, 6)
  .map((r) => ({
    name: r.author_name,
    location: "Google Review",
    service: r.service || "Verified Customer",
    rating: 5,
    date: r.relative_time_description || "",
    text: r.text,
    verified: true
  }));

// Advanced Local Ranking Authority Schema for Homepage
const homepageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://armstronglocksmithinc.com/#website",
    "url": "https://armstronglocksmithinc.com/",
    "name": "Armstrong Locksmith Nashville",
    "description": "Certified local locksmith with physical storefront at 208 Thompson Ln, Nashville TN.",
    "publisher": {
      "@id": "https://armstronglocksmithinc.com/#locksmith"
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/" schema={homepageSchema} image="/shop.jpeg">
  
  <!-- ==================== HERO SECTION WITH REAL STOREFRONT IDENTITY ==================== -->
  <section class="relative bg-showroom text-white pt-6 pb-10 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 border-b-2 border-amber-500/80 overflow-hidden font-sans">
    <!-- Subtle Shop Background Layer (Desktop only to guarantee 100/100 Mobile Speed) -->
    <div class="hidden sm:block absolute inset-0 bg-cover bg-center opacity-15 pointer-events-none" style="background-image: url('/shop-1200.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a1c38] via-[#0a1c38]/90 to-[#0a1c38]/75 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-14 items-center relative z-10">
      
      <!-- Left Hero Content -->
      <div class="lg:col-span-7 flex flex-col gap-3.5 sm:gap-6 text-left">
        
        <!-- Local Owner Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 pr-3.5 pl-1.5 py-1 bg-amber-500/10 border border-amber-500/30 rounded-full w-fit">
          <img
            src="/images/rahim-face-96.webp"
            alt="Rahim, Owner of Armstrong Locksmith"
            width="28"
            height="28"
            decoding="async"
            class="w-7 h-7 rounded-full object-cover border border-amber-400 shrink-0"
          />
          <span class="text-[11px] sm:text-xs font-bold tracking-wider text-amber-300 uppercase">
            Owner-Operated by Rahim &bull; Walk-In Shop at 208 Thompson Ln
          </span>
        </div>

        <!-- Massive Bold Storefront Headline with Luxury Gold Gradient Accent -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading uppercase text-white tracking-tight leading-[1.08]">
          Nashville Locksmith With a <span class="text-gold-gradient">Real Storefront</span>
        </h1>

        <!-- Trust Grounded Sub-Copy -->
        <p class="text-xs sm:text-base lg:text-lg text-slate-200 leading-relaxed font-normal max-w-2xl">
          Armstrong Locksmith Inc is a family-owned local locksmith in Nashville, TN. Stop by our walk-in shop for key cutting and programming, or have our mobile van come to your car, home, or business. Upfront pricing before we start.
        </p>

        <!-- Direct Action Buttons (Single-Line Text on Both Mobile & Desktop) -->
        <div class="hidden md:flex md:flex-row items-center gap-3 pt-1">
          <!-- Primary Call Button -->
          <a 
            href="tel:6156258000" 
            class="px-2.5 sm:px-5 xl:px-7 py-3 sm:py-3.5 bg-gold-metallic text-slate-950 font-black text-[11px] sm:text-sm xl:text-base uppercase tracking-wide sm:tracking-wider rounded flex items-center justify-center gap-1.5 sm:gap-2 shadow-xl transition active:scale-[0.98] border-b-2 border-amber-600 cursor-pointer whitespace-nowrap"
          >
            <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-slate-950 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span class="sm:hidden">(615) 625-8000</span>
            <span class="hidden sm:inline">CALL (615) 625-8000</span>
          </a>

          <!-- Storefront Directions Button (Single-Line High-Contrast White Button) -->
          <a 
            href="/nashville-locksmith-storefront/" 
            class="px-2.5 sm:px-5 xl:px-6 py-3 sm:py-3.5 bg-white hover:bg-amber-50 text-[#07152b] font-black text-[11px] sm:text-sm xl:text-base uppercase tracking-wide sm:tracking-wider rounded flex items-center justify-center gap-1.5 sm:gap-2 border-2 border-amber-400 shadow-xl transition active:scale-[0.98] cursor-pointer whitespace-nowrap"
          >
            <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/>
            </svg>
            <span class="sm:hidden">Visit Our Shop</span>
            <span class="hidden sm:inline">Visit Our Walk-In Shop</span>
          </a>
        </div>



      </div>

      <!-- Right Column: Hero Contact / Instant Quote Form Card -->
      <div class="lg:col-span-5 relative z-20" id="quote-form-section">
        <div class="bg-white rounded-xl shadow-xl border border-slate-200 text-slate-900 relative overflow-hidden">
          
          <div class="bg-slate-50 px-4 py-3.5 sm:px-6 sm:py-4 border-b border-slate-200">
            <h2 class="text-lg sm:text-xl font-black font-heading text-[#0f274a]">
              Get an Upfront Price Quote
            </h2>
            <p class="text-xs text-slate-600 mt-0.5">Goes straight to Rahim &amp; our Nashville shop</p>
          </div>

          <div class="p-4 sm:p-6">
            <form id="hero-quote-form" class="flex flex-col gap-3 sm:gap-3.5 text-left" novalidate>
              <!-- Invisible Honeypot Field (Anti-bot) -->
              <div class="hidden" aria-hidden="true" style="display:none!important;">
                <label for="hp_leave_empty">Leave this field empty</label>
                <input type="text" id="hp_leave_empty" name="hp_leave_empty" tabindex="-1" autocomplete="off" value="" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="quote-name" class="block text-xs font-extrabold text-slate-900 mb-1">Your Full Name *</label>
                  <input 
                    type="text" 
                    id="quote-name" 
                    name="name" 
                    required 
                    placeholder="e.g. John Smith" 
                    class="w-full px-3.5 py-2.5 sm:py-3 text-sm bg-white border border-slate-300 rounded-md focus:border-amber-500 outline-none text-slate-950 placeholder:text-slate-400 font-medium"
                  />
                  <span id="name-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your full name.</span>
                </div>
                <div>
                  <label for="quote-phone" class="block text-xs font-extrabold text-slate-900 mb-1">Phone Number *</label>
                  <input 
                    type="tel" 
                    id="quote-phone" 
                    name="phone" 
                    required 
                    placeholder="(615) 000-0000" 
                    class="w-full px-3.5 py-2.5 sm:py-3 text-sm bg-white border border-slate-300 rounded-md focus:border-amber-500 outline-none text-slate-950 placeholder:text-slate-400 font-medium"
                  />
                  <span id="phone-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter a valid phone number.</span>
                </div>
              </div>

              <div class="relative" id="quote-service-wrap">
                <label for="quote-service-btn" class="block text-xs font-extrabold text-slate-900 mb-1">Service Needed *</label>
                <select 
                  id="quote-service" 
                  name="service" 
                  tabindex="-1"
                  aria-hidden="true"
                  class="sr-only"
                >
                  <option value="">Select a service...</option>
                  <option value="Car Key Replacement">Car Key Replacement</option>
                  <option value="Key Fob Programming">Spare Key &amp; Fob Programming</option>
                  <option value="European Specialist">European Car Keys (BMW, Benz, Audi)</option>
                  <option value="Emergency Car Lockout">Emergency Car Lockout</option>
                  <option value="House Lockout / Rekey">House Rekey or Lockout</option>
                  <option value="Commercial Locksmith">Commercial Locks &amp; Hardware</option>
                  <option value="Other">Other Locksmith Service</option>
                </select>
                <button
                  type="button"
                  id="quote-service-btn"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  class="arm-service-btn w-full px-3.5 py-2.5 sm:py-3 text-sm bg-white border border-slate-300 rounded-md focus:border-amber-500 outline-none text-slate-500 font-medium cursor-pointer text-left truncate"
                >
                  <span id="quote-service-label">Select a service...</span>
                </button>
                <div id="quote-service-menu" role="listbox" class="arm-service-menu hidden">
                  <button type="button" role="option" data-value="Car Key Replacement" class="arm-service-item"><span>Car Key Replacement</span><span class="arm-service-check">&#10003;</span></button>
                  <button type="button" role="option" data-value="Key Fob Programming" class="arm-service-item"><span>Spare Key &amp; Fob Programming</span><span class="arm-service-check">&#10003;</span></button>
                  <button type="button" role="option" data-value="European Specialist" class="arm-service-item"><span>European Car Keys (BMW, Benz, Audi)</span><span class="arm-service-check">&#10003;</span></button>
                  <button type="button" role="option" data-value="Emergency Car Lockout" class="arm-service-item"><span>Emergency Car Lockout</span><span class="arm-service-check">&#10003;</span></button>
                  <button type="button" role="option" data-value="House Lockout / Rekey" class="arm-service-item"><span>House Rekey or Lockout</span><span class="arm-service-check">&#10003;</span></button>
                  <button type="button" role="option" data-value="Commercial Locksmith" class="arm-service-item"><span>Commercial Locks &amp; Hardware</span><span class="arm-service-check">&#10003;</span></button>
                  <button type="button" role="option" data-value="Other" class="arm-service-item"><span>Other Locksmith Service</span><span class="arm-service-check">&#10003;</span></button>
                </div>
                <span id="service-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please select a service.</span>
              </div>

              <!-- Dynamic Emergency Lockout Alert (Hidden by default, slides open if Emergency Lockout is chosen) -->
              <div id="lockout-alert-box" class="hidden p-2.5 bg-red-50 border-l-4 border-red-600 border-y border-r border-red-200 text-red-950 text-xs rounded-md flex items-center justify-between gap-2 transition-all">
                <div class="leading-tight">
                  <span class="font-black text-red-900 block">Locked out right now?</span>
                  <span class="text-[11px] text-red-800">Call the shop directly for the fastest response.</span>
                </div>
                <a href="tel:6156258000" class="shrink-0 px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white font-black text-xs uppercase tracking-wider rounded active:scale-95 transition shadow-sm">
                  Call (615) 625-8000
                </a>
              </div>

              <div>
                <label for="quote-details" class="block text-xs font-extrabold text-slate-900 mb-1">Vehicle, Home or Business Details (Optional)</label>
                <input 
                  type="text" 
                  id="quote-details" 
                  name="details" 
                  placeholder="e.g. 3 deadbolts rekeyed, storefront door, or 2021 BMW X5" 
                  class="w-full px-3.5 py-2.5 sm:py-3 text-sm bg-white border border-slate-300 rounded-md focus:border-amber-500 outline-none text-slate-950 placeholder:text-slate-400 font-medium"
                />
              </div>

              <!-- Server / Network Error Alert -->
              <div id="quote-error-msg" class="hidden p-3 bg-red-50 border border-red-400 text-red-800 text-xs font-bold text-center rounded-md">
                We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-black text-red-950">615-625-8000</a>.
              </div>

              <button 
                type="submit" 
                id="quote-submit-btn"
                class="w-full mt-1 py-3.5 sm:py-4 px-6 bg-gradient-to-r from-emerald-600 via-emerald-500 to-emerald-600 hover:from-emerald-500 hover:to-emerald-600 text-white font-black text-sm sm:text-base uppercase tracking-wider rounded-lg shadow-[0_8px_20px_-2px_rgba(5,150,105,0.45)] transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer border-b-2 border-emerald-800 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span>Text Me a Flat Quote &rarr;</span>
              </button>
              <div class="text-[11px] text-slate-500 text-center font-medium flex items-center justify-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span>Sent Directly to Rahim &amp; Our Nashville Shop &bull; Upfront Flat Rates</span>
              </div>
            </form>

            <div id="quote-success-msg" class="hidden p-6 bg-emerald-50 border-2 border-emerald-500 text-emerald-900 text-center rounded-lg">
              <strong id="quote-success-title" class="block text-lg font-black text-emerald-950">Thank you! Your message is at our shop.</strong>
              <p id="quote-success-desc" class="text-xs text-emerald-800 mt-2 leading-relaxed font-medium">
                We received your request and will call or text you right back with an upfront flat price.
              </p>
              <div class="mt-4 pt-3 border-t border-emerald-200">
                <a href="tel:6156258000" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider rounded shadow transition">
                  <span>Need help right now? Call (615) 625-8000 &rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>



      </div>

    </div>
  </section>

  <!-- ==================== GOOGLE CUSTOMER REVIEWS ==================== -->
  <section class="py-12 sm:py-16 bg-white px-4 sm:px-8 border-b border-slate-200 font-sans" id="google-reviews-section">
    <div class="max-w-7xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 mb-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
            <span id="google-rating-text">Google Verified Business &bull; {ratingValue} Star Rating (<span class="arm-review-count">{reviewCount}+</span> Reviews)</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black font-heading text-[#0f274a] tracking-tight">
            Customer Reviews on Google
          </h2>
        </div>

        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 mr-1">
            <button
              id="reviews-prev-btn"
              aria-label="Previous Reviews"
              class="w-9 h-9 rounded-md bg-slate-50 hover:bg-slate-100 border border-slate-300 flex items-center justify-center text-slate-700 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button
              id="reviews-next-btn"
              aria-label="Next Reviews"
              class="w-9 h-9 rounded-md bg-slate-50 hover:bg-slate-100 border border-slate-300 flex items-center justify-center text-slate-700 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>

          <a 
            href="https://g.page/r/CQS5BtikwbmqEBM/review" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#0f274a] hover:bg-slate-800 text-white text-xs sm:text-sm font-bold transition"
          >
            <span>Leave a Review</span>
          </a>
          <a 
            href="https://g.page/r/CQS5BtikwbmqEBM" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-slate-50 hover:bg-slate-100 text-[#0f274a] text-xs sm:text-sm font-bold border border-slate-300 transition"
          >
            <span>Read All (<span class="arm-review-count">{reviewCount}+</span>)</span>
          </a>
        </div>
      </div>

      <div 
        class="flex gap-5 overflow-x-auto pb-3 pt-1 snap-x snap-mandatory scroll-smooth" 
        id="reviews-grid-container"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {initialReviews.map((rev) => (
          <div class="min-w-[85%] sm:min-w-[320px] lg:min-w-[350px] max-w-[380px] snap-start shrink-0 flex flex-col justify-between bg-slate-50 rounded-xl border border-slate-200 p-6 shadow-sm">
            <div>
              <div class="flex items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-full bg-white border border-slate-300 flex items-center justify-center text-[#0f274a] font-bold text-xs shrink-0">
                    {rev.name.split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase()}
                  </div>
                  <div>
                    <h3 class="font-bold text-[#0f274a] text-sm leading-tight">{rev.name}</h3>
                    <div class="text-[11px] text-slate-500 mt-0.5">{rev.date}</div>
                  </div>
                </div>
                <div class="text-amber-500 text-sm tracking-tight">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              </div>

              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
                "{rev.text}"
              </p>
            </div>

            <div class="pt-3 mt-4 border-t border-slate-200/80 text-[11px] text-slate-500 font-medium">
              Google Review &bull; Nashville, TN
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ==================== RECENT WORK SECTION (LIVE WORK SAMPLES) ==================== -->
  <RecentWorkGallery />

  <!-- ==================== WHY NASHVILLE CALLS OUR SHOP ==================== -->
  <section class="bg-white py-14 sm:py-20 border-b border-slate-200 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: Real Shop Photo & Storefront Card -->
        <div class="lg:col-span-5">
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-md bg-[#0f274a] text-white">
            <picture>
              <source
                type="image/webp"
                srcset="/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP-600.webp 600w, /images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP-1200.webp 1200w"
                sizes="(max-width: 1024px) 100vw, 480px"
              />
              <img
                src="/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg"
                alt="High-security key cutting machines and key wall inside Armstrong Locksmith in Nashville"
                class="w-full h-64 sm:h-72 object-cover block"
                loading="lazy"
                decoding="async"
                width="600"
                height="450"
              />
            </picture>
            <div class="p-5 sm:p-6">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-amber-500/20 text-amber-300 text-xs font-bold mb-2">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>208 Thompson Ln, Nashville, TN 37211</span>
              </div>
              <h3 class="text-lg sm:text-xl font-bold font-heading text-white mb-1.5">
                Walk Into Our Shop or Call a Mobile Van
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
                Our locksmith shop is stocked with OEM smart fobs, transponder keys, residential deadbolts, and commercial mortise hardware.
              </p>
              <div class="pt-3 border-t border-slate-700/80 flex flex-wrap items-center justify-between gap-2 text-xs">
                <span class="text-slate-200 font-semibold">Shop: Mon–Fri {storeWeekdays} &bull; Sat {storeSaturday}</span>
                <a href="/nashville-locksmith-storefront/" class="inline-flex items-center gap-1 font-bold text-amber-400 hover:text-amber-300">
                  <span>Visit Our Storefront</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: 3 Clear Reasons with Icons -->
