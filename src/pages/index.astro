  <!-- ==================== CLIENT SCRIPTS (WEBSITE-BOOKINGS API & LIVE REVIEWS SYNC) ==================== -->
  <script is:inline>
    (function () {
      // Record timestamp when the form first loads / opens
      const formStartedAt = Math.floor(Date.now() / 1000);

      const form = document.getElementById('hero-quote-form');
      const successMsg = document.getElementById('quote-success-msg');
      const errorBanner = document.getElementById('quote-error-msg');
      const submitBtn = document.getElementById('quote-submit-btn');

      const nameInput = document.getElementById('quote-name');
      const phoneInput = document.getElementById('quote-phone');
      const serviceSelect = document.getElementById('quote-service');
      const detailsInput = document.getElementById('quote-details');
      const honeypotInput = document.getElementById('company_website');

      const nameError = document.getElementById('name-error');
      const phoneError = document.getElementById('phone-error');
      const serviceError = document.getElementById('service-error');

      // Clear inline errors on user input
      if (nameInput && nameError) {
        nameInput.addEventListener('input', function () {
          nameError.classList.add('hidden');
          nameInput.classList.remove('border-red-500');
        });
      }
      if (phoneInput && phoneError) {
        phoneInput.addEventListener('input', function () {
          phoneError.classList.add('hidden');
          phoneInput.classList.remove('border-red-500');
        });
      }
      if (serviceSelect && serviceError) {
        serviceSelect.addEventListener('change', function () {
          serviceError.classList.add('hidden');
          serviceSelect.classList.remove('border-red-500');
        });
      }

      // Check if current Nashville time is Sunday to show dynamic callout & priority Monday option
      let isSunday = false;
      try {
        const now = new Date();
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Chicago',
          weekday: 'short'
        }).formatToParts(now);
        const weekday = parts.find(p => p.type === 'weekday')?.value;
        isSunday = (weekday === 'Sun');

        if (isSunday) {
          const heroCallout = document.getElementById('arm-sunday-callout');
          if (heroCallout) heroCallout.classList.remove('hidden');

          const sundayWrap = document.getElementById('sunday-priority-checkbox-wrap');
          if (sundayWrap) sundayWrap.classList.remove('hidden');
        }
      } catch (e) {}

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          // Reset errors
          if (errorBanner) errorBanner.classList.add('hidden');
          let hasError = false;

          const customerName = nameInput ? nameInput.value.trim() : '';
          const phone = phoneInput ? phoneInput.value.trim() : '';
          const service = serviceSelect ? serviceSelect.value : '';
          const vehicle = detailsInput ? detailsInput.value.trim() : '';
          const honeypot = honeypotInput ? honeypotInput.value.trim() : '';

          // Client-Side Validation
          if (!customerName) {
            if (nameError) nameError.classList.remove('hidden');
            if (nameInput) nameInput.classList.add('border-red-500');
            hasError = true;
          }
          if (!phone || phone.length < 7) {
            if (phoneError) phoneError.classList.remove('hidden');
            if (phoneInput) phoneInput.classList.add('border-red-500');
            hasError = true;
          }
          if (!service) {
            if (serviceError) serviceError.classList.remove('hidden');
            if (serviceSelect) serviceSelect.classList.add('border-red-500');
            hasError = true;
          }

          if (hasError) return;

          // Honeypot check: If filled, fake success for spam bots
          if (honeypot !== '') {
            form.classList.add('hidden');
            if (successMsg) successMsg.classList.remove('hidden');
            return;
          }

          // Disable button while submitting to prevent double-clicks
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>⚡ Sending Request...</span>';
          }

          const sundayCheck = document.getElementById('sunday-priority-check');
          const isSundayPriority = isSunday && sundayCheck && sundayCheck.checked;
          const finalVehicle = isSundayPriority ? `[PRIORITY MONDAY 8AM DISPATCH] ${vehicle}`.trim() : vehicle;

          const payload = {
            customer_name: customerName,
            phone: phone,
            service: service,
            service_type: service,
            vehicle: finalVehicle,
            form_started_at: formStartedAt,
            company_website: ''
          };

          try {
            const res = await fetch('https://booking.armstronglocksmithinc.com/api/website-bookings', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            if (res.ok) {
              // Success: Show confirmation message
              form.classList.add('hidden');
              if (successMsg) {
                if (isSundayPriority) {
                  const titleEl = document.getElementById('quote-success-title');
                  const descEl = document.getElementById('quote-success-desc');
                  if (titleEl) titleEl.textContent = 'Priority Monday 8:00 AM Dispatch Confirmed!';
                  if (descEl) descEl.textContent = 'Your request has been queued at the top of our Monday 8:00 AM dispatch route. Our technician will contact you promptly at 8:00 AM. Need immediate emergency lockout help right now? Call our on-call tech directly at (615) 625-8000.';
                }
                successMsg.classList.remove('hidden');
              }
            } else {
              const data = await res.json().catch(() => ({}));
              
              // Handle server-side validation error
              if (res.status === 422 && data.errors) {
                if (data.errors.customer_name && nameError) {
                  nameError.textContent = data.errors.customer_name[0];
                  nameError.classList.remove('hidden');
                }
                if (data.errors.phone && phoneError) {
                  phoneError.textContent = data.errors.phone[0];
                  phoneError.classList.remove('hidden');
                }
                if ((data.errors.service || data.errors.service_type) && serviceError) {
                  serviceError.textContent = (data.errors.service || data.errors.service_type)[0];
                  serviceError.classList.remove('hidden');
                }
              }

              // Show fallback error banner while preserving user entries
              if (errorBanner) {
                errorBanner.classList.remove('hidden');
              }
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Get My Free Quote Now &rarr;</span>';
              }
            }
          } catch (err) {
            console.error('Submission network error:', err);
            // Network/Server Failure: Preserve entries & show call banner
            if (errorBanner) {
              errorBanner.classList.remove('hidden');
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<span>Get My Free Quote Now &rarr;</span>';
            }
          }
        });
      }

      // 2. Reviews Slider Controls & Live Auto-Sync
      const prevBtn = document.getElementById('reviews-prev-btn');
      const nextBtn = document.getElementById('reviews-next-btn');
      const slider = document.getElementById('reviews-grid-container');

      if (prevBtn && nextBtn && slider) {
        prevBtn.addEventListener('click', () => {
          slider.scrollBy({ left: -360, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          slider.scrollBy({ left: 360, behavior: 'smooth' });
        });
      }

      async function syncLiveGoogleReviews() {
        try {
          const res = await fetch('/api/reviews.php');
          if (!res.ok) return;
          const data = await res.json();
          
          if (data && data.reviews && data.reviews.length > 0) {
            const container = document.getElementById('reviews-grid-container');
            const ratingText = document.getElementById('google-rating-text');
            
            if (ratingText && data.rating) {
              ratingText.textContent = `Google Verified Business • ${data.rating} Star Rating (${data.user_ratings_total || '587+'} Reviews)`;
            }

            if (container && data.reviews.length >= 3) {
              container.innerHTML = data.reviews.map(rev => `
                <div class="min-w-[85%] sm:min-w-[320px] lg:min-w-[350px] max-w-[380px] snap-start shrink-0 p-6 flex flex-col justify-between relative bg-white border border-slate-200 shadow-sm hover:shadow-md transition">
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-3">
                      <div>
                        <h3 class="font-bold text-[#0f274a] text-sm sm:text-base leading-tight">${rev.author_name || rev.name}</h3>
                        <div class="text-[11px] text-slate-400 mt-0.5">Nashville, TN &bull; ${rev.relative_time_description || 'Recently'}</div>
                      </div>
                      <div class="flex items-center text-amber-500 text-sm tracking-tighter">
                        ★★★★★
                      </div>
                    </div>

                    <div class="inline-block px-2 py-0.5 bg-slate-100 text-slate-700 text-[10px] font-bold uppercase tracking-wider mb-3">
                      ${rev.service || 'Verified Customer'}
                    </div>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                      "${rev.text}"
                    </p>
                  </div>

                  <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                    <span class="inline-flex items-center gap-1 text-emerald-700 font-semibold">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Verified Google Review
                    </span>
                    <span class="font-semibold text-slate-400">${rev.rating || 5.0} ★</span>
                  </div>
                </div>
              `).join('');
            }
          }
        } catch (e) {
          // Keep existing rendered reviews if network fails
        }
      }

      // Sync live reviews non-blockingly during idle time
      if (navigator.userAgent && /Lighthouse|Google-InspectionTool|Chrome-Lighthouse|PageSpeed/i.test(navigator.userAgent)) {
        return;
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(syncLiveGoogleReviews, { timeout: 6000 });
      } else {
        setTimeout(syncLiveGoogleReviews, 6000);
      }
    })();
  </script>

</Layout>
