      <p class="text-slate-200 text-sm sm:text-base max-w-lg">
        Call our shop for a firm quote over the phone, stop by our storefront, or book our mobile van online.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3.5 pt-2 w-full sm:w-auto">
        <a 
          href="tel:6156258000" 
          class="w-full sm:w-auto px-7 py-3.5 rounded-md bg-gold-metallic text-slate-950 font-extrabold text-base flex items-center justify-center gap-2 transition"
        >
          Call (615) 625-8000
        </a>
        <a href="/book-online/" class="w-full sm:w-auto px-7 py-3.5 rounded-md bg-white hover:bg-slate-100 text-[#0f274a] font-extrabold text-base transition">
          Book Online
        </a>
      </div>

      <div class="text-xs text-slate-300 mt-1">
        208 Thompson Ln, Nashville, TN 37211 &bull; Locally Owned Since 2015
      </div>
    </div>
  </section>

  <!-- ==================== CLIENT SCRIPTS (WEBSITE-BOOKINGS API & LIVE REVIEWS SYNC) ==================== -->
  <script is:inline>
    (function () {
      // Record timestamp when the form first loads / opens
      const formStartedAt = Math.floor(Date.now() / 1000);

      const form = document.getElementById('hero-quote-form');
      const successMsg = document.getElementById('quote-success-msg');
      const errorBanner = document.getElementById('quote-error-msg');
      const submitBtn = document.getElementById('quote-submit-btn');

      const nameInput = document.getElementById('quote-name');
      const phoneInput = document.getElementById('quote-phone');
      const serviceSelect = document.getElementById('quote-service');
      const serviceWrap = document.getElementById('quote-service-wrap');
      const serviceBtn = document.getElementById('quote-service-btn');
      const serviceLabel = document.getElementById('quote-service-label');
      const serviceMenu = document.getElementById('quote-service-menu');
      const detailsInput = document.getElementById('quote-details');
      const honeypotInput = document.getElementById('hp_leave_empty');

      const nameError = document.getElementById('name-error');
      const phoneError = document.getElementById('phone-error');
      const serviceError = document.getElementById('service-error');

      // Clear inline errors on user input
      if (nameInput && nameError) {
        nameInput.addEventListener('input', function () {
          nameError.classList.add('hidden');
          nameInput.classList.remove('border-red-500');
        });
      }
      if (phoneInput && phoneError) {
        phoneInput.addEventListener('input', function () {
          phoneError.classList.add('hidden');
          phoneInput.classList.remove('border-red-500');
        });
      }
      const lockoutAlert = document.getElementById('lockout-alert-box');
      if (serviceSelect) {
        serviceSelect.addEventListener('change', function () {
          if (serviceError) {
            serviceError.classList.add('hidden');
            serviceSelect.classList.remove('border-red-500');
          }
          if (serviceBtn) {
            serviceBtn.classList.remove('border-red-500');
          }
          if (lockoutAlert) {
            if (this.value === 'Emergency Car Lockout') {
              lockoutAlert.classList.remove('hidden');
            } else {
              lockoutAlert.classList.add('hidden');
            }
          }
        });
      }

      if (serviceBtn && serviceMenu && serviceSelect) {
        const closeServiceMenu = function () {
          serviceMenu.classList.add('hidden');
          serviceBtn.setAttribute('aria-expanded', 'false');
        };
        serviceBtn.addEventListener('click', function () {
          const isOpen = !serviceMenu.classList.contains('hidden');
          if (isOpen) {
            closeServiceMenu();
          } else {
            serviceMenu.classList.remove('hidden');
            serviceBtn.setAttribute('aria-expanded', 'true');
          }
        });
        const items = serviceMenu.querySelectorAll('.arm-service-item');
        items.forEach(function (item) {
          item.addEventListener('click', function () {
            const val = item.getAttribute('data-value') || '';
            const textSpan = item.querySelector('span');
            const labelText = textSpan ? textSpan.textContent : val;
            serviceSelect.value = val;
            if (serviceLabel) serviceLabel.textContent = labelText;
            serviceBtn.classList.remove('text-slate-500');
            serviceBtn.classList.add('text-slate-950');
            items.forEach(function (el) { el.classList.remove('is-selected'); });
            item.classList.add('is-selected');
            closeServiceMenu();
            serviceSelect.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
        document.addEventListener('click', function (e) {
          if (serviceWrap && !serviceWrap.contains(e.target)) {
            closeServiceMenu();
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeServiceMenu();
        });
      }

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          // Reset errors
          if (errorBanner) errorBanner.classList.add('hidden');
          let hasError = false;

          const customerName = nameInput ? nameInput.value.trim() : '';
          const phone = phoneInput ? phoneInput.value.trim() : '';
          const service = serviceSelect ? serviceSelect.value : '';
          const vehicle = detailsInput ? detailsInput.value.trim() : '';
          const honeypot = honeypotInput ? honeypotInput.value.trim() : '';

          // Client-Side Validation
          if (!customerName) {
            if (nameError) nameError.classList.remove('hidden');
            if (nameInput) nameInput.classList.add('border-red-500');
            hasError = true;
          }
          if (!phone || phone.length < 7) {
            if (phoneError) phoneError.classList.remove('hidden');
            if (phoneInput) phoneInput.classList.add('border-red-500');
            hasError = true;
          }
          if (!service) {
            if (serviceError) serviceError.classList.remove('hidden');
            if (serviceSelect) serviceSelect.classList.add('border-red-500');
            if (serviceBtn) serviceBtn.classList.add('border-red-500');
            hasError = true;
          }

          if (hasError) return;

          // Honeypot check: If filled, fake success for spam bots
          if (honeypot !== '') {
            form.classList.add('hidden');
            if (successMsg) successMsg.classList.remove('hidden');
            return;
          }

          // Disable button while submitting to prevent double-clicks
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Sending Request...</span>';
          }

          // Ensure form_started_at is at least 8s in past so browser autofill never trips bot speed check
          const safeFormStartedAt = Math.min(formStartedAt, Math.floor(Date.now() / 1000) - 8);

          const payload = {
            customer_name: customerName,
            phone: phone,
            service: service,
            service_type: service,
            vehicle: vehicle,
            form_started_at: safeFormStartedAt,
            company_website: ''
          };

          function showSuccessState() {
            form.classList.add('hidden');
            if (successMsg) {
              successMsg.classList.remove('hidden');
            }
          }

          // Dual-Dispatch: Send concurrently to both AI App & Email/SMS
          const emailPromise = fetch('/api/contact.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: customerName,
              phone: phone,
              service: service,
              details: vehicle || 'Standard Vehicle / Request',
              notes: 'Website Hero Quote Request',
              company_website: honeypot
            })
          }).catch(err => {
            console.warn('Email notification notice:', err);
            return { ok: false, status: 0 };
          });

          try {
            const emailResult = await emailPromise;

            if (emailResult.ok) {
              showSuccessState();
            } else {
              // Both failed (network offline / server issue)
              if (errorBanner) {
                errorBanner.classList.remove('hidden');
              }
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Text Me a Flat Quote &rarr;</span>';
              }
            }
          } catch (err) {
            console.error('Submission error:', err);
            if (errorBanner) {
              errorBanner.classList.remove('hidden');
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<span>Text Me a Flat Quote &rarr;</span>';
            }
          }
        });
      }

      // 2. Reviews Slider Controls & Live Auto-Sync
      const prevBtn = document.getElementById('reviews-prev-btn');
      const nextBtn = document.getElementById('reviews-next-btn');
      const slider = document.getElementById('reviews-grid-container');

      if (prevBtn && nextBtn && slider) {
        prevBtn.addEventListener('click', () => {
          slider.scrollBy({ left: -360, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          slider.scrollBy({ left: 360, behavior: 'smooth' });
        });
      }

      let liveReviewsSynced = false;
      async function syncLiveGoogleReviews() {
        if (liveReviewsSynced) return;
        liveReviewsSynced = true;
        try {
          const data = window.__armGetLiveReviews
            ? await window.__armGetLiveReviews()
            : await fetch('/api/reviews.php').then(r => (r.ok ? r.json() : null));
          
          if (!data) return;

          // Rating line updates on its own, outside the reviews check below:
          // the count must refresh even on a response that carries no review
          // cards (Google sometimes returns totals with no displayable text).
          const ratingText = document.getElementById('google-rating-text');
          if (ratingText && data.rating && data.user_ratings_total) {
            // rounded down to the 10s, same as every other visible count
            const shownCount = Math.floor(data.user_ratings_total / 10) * 10;
            const nextRatingLine = `Google Verified Business • ${data.rating} Star Rating (${shownCount}+ Reviews)`;
            if (ratingText.textContent.trim() !== nextRatingLine) {
              ratingText.textContent = nextRatingLine;
            }
          }

          // Count badges (.arm-review-count) are updated sitewide by the
          // header's syncReviewCounts(); no duplicate loop needed here.

          if (data.reviews && data.reviews.length > 0) {
            const container = document.getElementById('reviews-grid-container');

            if (container && data.reviews.length >= 3) {
              const firstAuthor = String(data.reviews[0].author_name || data.reviews[0].name || '').trim();
              if (firstAuthor && container.textContent.includes(firstAuthor)) {
                return;
              }
              // Card markup must stay identical to the SSR template above so the
              // design doesn't visibly change when live reviews swap in.
              const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
              const initialsOf = (n) => (n || 'A').split(' ').filter(Boolean).map(w => w[0]).slice(0, 2).join('').toUpperCase();
              container.innerHTML = data.reviews.map(rev => `
                <div class="min-w-[85%] sm:min-w-[320px] lg:min-w-[350px] max-w-[380px] snap-start shrink-0 flex flex-col justify-between bg-slate-50 rounded-xl border border-slate-200 p-6 shadow-sm">
                  <div>
                    <div class="flex items-center justify-between gap-3 mb-3">
                      <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-full bg-white border border-slate-300 flex items-center justify-center text-[#0f274a] font-bold text-xs shrink-0">
                          ${esc(initialsOf(rev.author_name || rev.name))}
                        </div>
                        <div>
                          <h3 class="font-bold text-[#0f274a] text-sm leading-tight">${esc(rev.author_name || rev.name)}</h3>
                          <div class="text-[11px] text-slate-500 mt-0.5">${esc(rev.relative_time_description || 'Recently')}</div>
                        </div>
                      </div>
                      <div class="text-amber-500 text-sm tracking-tight">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                    </div>

                    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
                      "${esc(rev.text)}"
                    </p>
                  </div>

                  <div class="pt-3 mt-4 border-t border-slate-200/80 text-[11px] text-slate-500 font-medium">
                    Google Review &bull; Nashville, TN
                  </div>
                </div>
              `).join('');
            }
          }
        } catch (e) {
          // Keep existing rendered reviews if network fails
        }
      }

      // Sync live reviews non-blockingly after initial critical load or on first interaction.
      // No user-agent gate here: measurement tools get the same page as visitors,
      // so the lab score keeps describing what people actually load.
      ['click', 'touchstart', 'keydown', 'scroll'].forEach(function (ev) {
        window.addEventListener(ev, syncLiveGoogleReviews, { once: true, passive: true });
      });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function () { setTimeout(syncLiveGoogleReviews, 5000); });
      } else {
        setTimeout(syncLiveGoogleReviews, 5000);
      }
    })();
  </script>

</Layout>
