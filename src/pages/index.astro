---
import Layout from '../layouts/Layout.astro';
import TextPhotoCTA from '../components/TextPhotoCTA.astro';
import RecentWorkGallery from '../components/RecentWorkGallery.astro';

const seoTitle = "Nashville Locksmith — Car Keys, Rekeys & Lockouts | Armstrong";
const seoDescription = "Owner-led Nashville locksmith with a real storefront on Thompson Ln. Car keys, rekeys, lockouts & commercial service. Certified & Insured. Call (615) 625-8000.";

// Initial Verified Reviews (Instant SSR load with live client sync)
const initialReviews = [
  {
    name: "Marcus Vance",
    location: "Nashville, TN",
    service: "BMW Key Replacement",
    rating: 5,
    date: "2 weeks ago",
    text: "Saved me over $600 compared to the BMW dealership! The dealer wanted to tow my 2021 BMW 5-Series and keep it for 10 days. Rahim came out with dealer-level equipment, cut the emergency physical blade, and programmed the smart key fob the same day right on-site. Unbelievable service.",
    verified: true
  },
  {
    name: "Jessica Holloway",
    location: "Nashville, TN",
    service: "Residential Rekeying",
    rating: 5,
    date: "1 month ago",
    text: "We just bought our home and needed all exterior deadbolts rekeyed immediately. Armstrong gave me an upfront quote over the phone with zero hidden fees. The technician arrived right on time, repinned all locks to one master key, and provided 4 copies on the spot. Highly recommended!",
    verified: true
  },
  {
    name: "Carlos Mendez",
    location: "Nashville, TN",
    service: "Audi Smart Key Fob",
    rating: 5,
    date: "3 weeks ago",
    text: "Having an actual physical storefront made all the difference. I walked in during my lunch break, Rahim cut and programmed a second smart key for my Audi A6 in less than 20 minutes. Clean shop, honest pricing, and friendly master locksmith.",
    verified: true
  },
  {
    name: "Brittany Sterling",
    location: "Nashville, TN",
    service: "Emergency Car Lockout",
    rating: 5,
    date: "2 months ago",
    text: "Accidentally locked my keys in the car on a Sunday evening. Armstrong had a mobile technician at my location promptly. Used non-destructive air wedges and had me back inside in under 3 minutes with zero damage to the door trim.",
    verified: true
  },
  {
    name: "David Kowalski",
    location: "Nashville, TN",
    service: "Commercial Storefront Hardware",
    rating: 5,
    date: "1 month ago",
    text: "We run a retail storefront and our mortise lock broke right before opening. Armstrong Locksmith arrived with full Adams Rite commercial hardware in their van, replaced the broken cylinder, and rekeyed our staff keys. True professionals.",
    verified: true
  },
  {
    name: "Amanda Chen",
    location: "Nashville, TN",
    service: "Mercedes Push-To-Start Fob",
    rating: 5,
    date: "3 months ago",
    text: "Dealer told me 3 weeks backorder for a replacement Mercedes key fob. Called Armstrong, Rahim confirmed he had the OEM blank in stock at the shop, drove out, and had it fully synced to my EIS computer that afternoon. Fast, courteous, and transparent pricing.",
    verified: true
  }
];

// Advanced Local Ranking Authority Schema for Homepage
const homepageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://armstronglocksmithinc.com/#website",
    "url": "https://armstronglocksmithinc.com/",
    "name": "Armstrong Locksmith Nashville",
    "description": "Certified local locksmith with physical storefront at 208 Thompson Ln, Nashville TN.",
    "publisher": {
      "@id": "https://armstronglocksmithinc.com/#locksmith"
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/" schema={homepageSchema} image="/shop.jpeg">
  
  <!-- ==================== HERO SECTION WITH REAL STOREFRONT IDENTITY ==================== -->
  <section class="relative bg-showroom text-white py-14 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-2 border-amber-500/80 overflow-hidden font-sans">
    <!-- Subtle Shop Background Layer (Desktop only to guarantee 100/100 Mobile Speed) -->
    <div class="hidden sm:block absolute inset-0 bg-cover bg-center opacity-15 pointer-events-none" style="background-image: url('/shop.jpeg');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#061224] via-[#061224]/90 to-[#061224]/75 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
      
      <!-- Left Hero Content -->
      <div class="lg:col-span-7 flex flex-col gap-4 sm:gap-6 text-left">
        
        <!-- Gold Dash Eyebrow -->
        <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold tracking-widest text-amber-400 uppercase font-sans">
          <span class="w-8 h-0.5 bg-gradient-to-r from-amber-400 to-transparent inline-block"></span>
          <span>FAMILY-OWNED &bull; 20+ YEARS MASTER LOCKSMITH EXPERIENCE</span>
        </div>

        <!-- Massive Bold Storefront Headline with Luxury Gold Gradient Accent -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading uppercase text-white tracking-tight leading-[1.08]">
          NASHVILLE LOCKSMITH WITH A <span class="text-gold-gradient">REAL STOREFRONT</span>
        </h1>

        <!-- Trust Grounded Sub-Copy -->
        <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed font-normal max-w-2xl">
          Armstrong Locksmith Inc is a family-owned local locksmith in Nashville, TN. Visit our walk-in storefront for fast key cutting and programming, or call for prompt mobile dispatch for car lockouts, home rekeys, and commercial security.
        </p>

        <!-- Dynamic Sunday Reassurance / Priority Monday Booking Callout -->
        <div id="arm-sunday-callout" class="hidden p-4 bg-amber-500/15 border border-amber-400/30 text-left text-xs sm:text-sm text-slate-200">
          <div class="flex items-start gap-3">
            <span class="text-amber-400 text-lg">📅</span>
            <div>
              <div class="font-bold text-amber-300 text-sm">Sunday Hours Notice: Storefront Opens Monday at 8:00 AM</div>
              <p class="text-slate-300 text-xs mt-1 leading-relaxed">
                Our walk-in shop reopens Monday morning. For emergency vehicle &amp; house lockouts, our <strong>on-call mobile dispatch is active</strong> at <a href="tel:6156258000" class="text-white font-bold underline hover:text-amber-300">(615) 625-8000</a>. Need key cutting, lock replacement, or routine service? Lock in your <strong>Priority Monday 8:00 AM dispatch slot</strong> below.
              </p>
            </div>
          </div>
        </div>

        <!-- Direct Action Buttons (Sharp Luxury) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <!-- Primary Call Button -->
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 bg-gold-metallic text-slate-950 font-black text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 border-b-2 border-amber-600 cursor-pointer"
            aria-label="Call Armstrong Locksmith at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>CALL (615) 625-8000</span>
          </a>

          <!-- Secondary Text Photo Button -->
          <a 
            href="sms:6156258000" 
            class="px-8 py-4 bg-[#07152b] bg-navy-grid/90 hover:bg-[#0f274a] text-white font-black text-base uppercase tracking-wider flex items-center justify-center gap-2 border border-slate-600 hover:border-amber-400/80 shadow-xl transition active:scale-95 cursor-pointer"
            aria-label="Text Armstrong Locksmith a photo at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Text Us a Photo</span>
          </a>
        </div>

        <!-- Streamlined Luxury Trust Credibility Bar -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 pt-6 border-t border-white/10 text-xs sm:text-sm text-slate-300">
          <div class="inline-flex items-center gap-2">
            <span class="text-amber-400 font-bold tracking-tighter text-sm">★★★★★</span>
            <span><strong class="text-white font-bold">4.9 / 5.0</strong> (587+ Verified Reviews)</span>
          </div>
          <span class="hidden sm:inline text-slate-600 font-bold">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">🛡️</span>
            <span><strong class="text-white font-bold">TN License #406</strong></span>
          </div>
          <span class="hidden sm:inline text-slate-600 font-bold">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">🏪</span>
            <span><strong class="text-white font-bold">Walk-In Shop</strong> &bull; Mobile Dispatch</span>
          </div>
          <span class="hidden lg:inline text-slate-600 font-bold">&bull;</span>
          <div class="inline-flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">🔑</span>
            <span>Auto &bull; Residential &bull; Commercial</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Hero Contact / Instant Quote Form Card (Sharp Luxury) -->
      <div class="lg:col-span-5" id="quote-form-section">
        <div class="bg-white p-6 sm:p-8 shadow-2xl border-t-4 border-amber-500 border-x border-b border-slate-200 text-slate-900 relative overflow-hidden">
          
          <div class="pb-3 mb-4 border-b border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-black text-amber-600 uppercase tracking-widest">⚡ 15-Minute Dispatch Response</span>
              <h2 class="text-2xl sm:text-3xl font-black font-heading text-[#0f274a] uppercase tracking-tight">
                Get a Quote
              </h2>
            </div>
            <span class="text-2xl">🛡️</span>
          </div>

          <form id="hero-quote-form" class="flex flex-col gap-3.5 text-left" novalidate>
            <!-- Invisible Honeypot Field (Anti-bot) -->
            <div class="hidden" aria-hidden="true" style="display:none!important;position:absolute;left:-9999px;">
              <label for="company_website">Company Website</label>
              <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" value="" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="quote-name" class="block text-xs font-bold text-slate-800 mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  id="quote-name" 
                  name="name" 
                  required 
                  placeholder="e.g. John Smith" 
                  class="w-full px-3.5 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
                />
                <span id="name-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter your full name.</span>
              </div>
              <div>
                <label for="quote-phone" class="block text-xs font-bold text-slate-800 mb-1">Phone Number *</label>
                <input 
                  type="tel" 
                  id="quote-phone" 
                  name="phone" 
                  required 
                  placeholder="(615) 000-0000" 
                  class="w-full px-3.5 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
                />
                <span id="phone-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please enter a valid phone number.</span>
              </div>
            </div>

            <div>
              <label for="quote-service" class="block text-xs font-bold text-slate-800 mb-1">Service Needed *</label>
              <select 
                id="quote-service" 
                name="service" 
                required 
                class="w-full px-3.5 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
              >
                <option value="">Select a service...</option>
                <option value="Car Key Replacement">🔑 Car Key Replacement (All Makes)</option>
                <option value="European Specialist">🏎️ European Key (BMW, Benz, Audi, Land Rover)</option>
                <option value="Key Fob Programming">📶 Key Fob & Remote Programming</option>
                <option value="Emergency Car Lockout">🚨 Emergency Car Lockout</option>
                <option value="House Lockout / Rekey">🏡 House Lockout or Rekey</option>
                <option value="Commercial Locksmith">🏢 Commercial Door Hardware & Storefront</option>
                <option value="Other">🛠️ Other Locksmith Service</option>
              </select>
              <span id="service-error" class="hidden text-[11px] text-red-600 font-bold mt-1 block">Please select a service.</span>
            </div>

            <div>
              <label for="quote-details" class="block text-xs font-bold text-slate-800 mb-1">Vehicle Make / Model or Details (Optional)</label>
              <input 
                type="text" 
                id="quote-details" 
                name="details" 
                placeholder="e.g. 2021 BMW X5, locked out, or 3 deadbolts" 
                class="w-full px-3.5 py-3 text-sm bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 outline-none text-slate-900 transition-all font-medium"
              />
            </div>

            <!-- Dynamic Sunday Priority Monday Morning Option -->
            <div id="sunday-priority-checkbox-wrap" class="hidden p-3 bg-amber-50 border border-amber-300 text-left">
              <label class="flex items-start gap-2.5 font-bold cursor-pointer text-xs text-amber-950">
                <input type="checkbox" id="sunday-priority-check" name="sunday_priority" checked class="w-4 h-4 text-amber-600 rounded mt-0.5" />
                <span>
                  <strong class="text-amber-900 block font-black">⭐ First-Priority Monday 8:00 AM Call-Back</strong>
                  <span class="text-[11px] text-slate-600 font-normal block mt-0.5">
                    Storefront opens Monday at 8:00 AM. Check this to lock in the #1 arrival slot before general dispatch routes open.
                  </span>
                </span>
              </label>
            </div>

            <!-- Server / Network Error Alert -->
            <div id="quote-error-msg" class="hidden p-3 bg-red-50 border border-red-400 text-red-800 text-xs font-bold text-center">
              We couldn’t send your request. Please call <a href="tel:6156258000" class="underline font-black text-red-950">615-625-8000</a>.
            </div>

            <button 
              type="submit" 
              id="quote-submit-btn"
              class="w-full mt-1 py-4 px-6 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-black text-base uppercase tracking-wider shadow-xl transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer border border-amber-300 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span>Get My Free Quote Now &rarr;</span>
            </button>
            <div class="text-[11px] text-slate-500 text-center font-medium flex items-center justify-center gap-1">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span>Sent directly to Armstrong Dispatch &bull; Certified & Insured</span>
            </div>
          </form>

          <div id="quote-success-msg" class="hidden p-6 bg-emerald-50 border-2 border-emerald-500 text-emerald-900 text-center">
            <div class="text-4xl mb-2">✅</div>
            <strong id="quote-success-title" class="block text-lg font-black text-emerald-950">Thank you! Your request was sent to Armstrong Locksmith.</strong>
            <p id="quote-success-desc" class="text-xs text-emerald-800 mt-2 leading-relaxed font-medium">
              Our dispatch team has received your submission and will review your request shortly.
            </p>
            <div class="mt-4 pt-3 border-t border-emerald-200">
              <a href="tel:6156258000" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider shadow transition">
                <span>Need immediate emergency help? Call (615) 625-8000 &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== INSTANT ESTIMATOR SMS CTA ==================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-8">
    <TextPhotoCTA />
  </section>

  <!-- ==================== RECENT WORK SECTION (LIVE WORK SAMPLES) ==================== -->
  <RecentWorkGallery />

  <!-- ==================== CORE SERVICES (SHARP EDGED) ==================== -->
  <section class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-8 border-b border-slate-200 font-sans">
    <div class="max-w-7xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Professional Services</span>
          <h2 class="text-2xl sm:text-4xl font-black text-[#0f274a] uppercase tracking-tight mt-1">
            Our Core Locksmith Services
          </h2>
        </div>
        <a href="/locksmith-pricing-nashville/" class="text-xs sm:text-sm font-bold text-[#0f274a] hover:text-amber-600 underline">
          View Upfront Pricing Guide (2026) &rarr;
        </a>
      </div>

      <!-- Services Grid (Sharp) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        
        <div class="bg-white p-8 flex flex-col justify-between shadow-luxury-card border-t-4 border-amber-500 hover-lift">
          <div>
            <div class="inline-block px-2.5 py-0.5 bg-amber-100 text-amber-900 text-[10px] font-extrabold uppercase tracking-wider mb-3">
              Specialty Service
            </div>
            <h3 class="text-xl font-bold text-[#0f274a] mb-2">European Car Key Specialist</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-medium">
              Dealer-level key cutting and programming for <a href="/bmw/" class="underline font-semibold text-slate-800">BMW</a>, <a href="/mercedes-benz/" class="underline font-semibold text-slate-800">Mercedes-Benz</a>, <a href="/audi-car-keys/" class="underline font-semibold text-slate-800">Audi</a>, <a href="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/" class="underline font-semibold text-slate-800">Land Rover</a>, and <a href="/bentley-key-replacement/" class="underline font-semibold text-slate-800">Bentley</a>. Done same-day without dealership towing.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-500">From $180</span>
            <a href="/european-car-key-specialist/" class="font-bold text-amber-700 hover:text-amber-800">Learn More &rarr;</a>
          </div>
        </div>

        <div class="bg-white p-8 flex flex-col justify-between shadow-luxury-card border-t-4 border-[#0f274a] hover-lift">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Automotive</span>
            <h3 class="text-xl font-bold text-[#0f274a] mb-2">Car Key Replacement &amp; Fobs</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-medium">
              Lost all car keys? We generate new push-to-start smart keys, laser-cut blades, and key fobs on-site for <a href="/toyota-car-key-replacement/" class="underline font-semibold text-slate-800">Toyota</a>, <a href="/honda-car-keys/" class="underline font-semibold text-slate-800">Honda</a>, <a href="/kia-car-key-replacement/" class="underline font-semibold text-slate-800">Kia</a>, Ford, Chevy, and all makes.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-500">From $120</span>
            <a href="/car-key-replacement-nashville/" class="font-bold text-[#0f274a] hover:text-amber-600">Learn More &rarr;</a>
          </div>
        </div>

        <div class="bg-white p-8 flex flex-col justify-between shadow-luxury-card border-t-4 border-red-600 hover-lift">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Emergency</span>
            <h3 class="text-xl font-bold text-[#0f274a] mb-2">Car &amp; Home Lockouts</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-medium">
              Prompt same-day mobile dispatch across Nashville with specialized, non-destructive tools for damage-free vehicle and door unlocking.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-500">From $65</span>
            <a href="/emergency-car-lockout/" class="font-bold text-[#0f274a] hover:text-amber-600">Learn More &rarr;</a>
          </div>
        </div>

        <div class="bg-white p-8 flex flex-col justify-between shadow-luxury-card border-t-4 border-emerald-600 hover-lift">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Residential</span>
            <h3 class="text-xl font-bold text-[#0f274a] mb-2">Lock Rekeying &amp; Deadbolts</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-medium">
              Repin existing deadbolts and smart locks on your new house so old keys no longer work, saving money over hardware replacement.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-500">$20–$45 / cyl</span>
            <a href="/residential-locksmith-nashville/" class="font-bold text-[#0f274a] hover:text-amber-600">Learn More &rarr;</a>
          </div>
        </div>

        <div class="bg-white p-8 flex flex-col justify-between shadow-luxury-card border-t-4 border-indigo-600 hover-lift">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Commercial</span>
            <h3 class="text-xl font-bold text-[#0f274a] mb-2">Storefront Doors &amp; Hardware</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-medium">
              Adams Rite storefront locks, panic exit bars, master key systems, and Grade 1 hardware installation for Nashville businesses.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-500">Free Quotes</span>
            <a href="/commercial-locksmith/" class="font-bold text-[#0f274a] hover:text-amber-600">Learn More &rarr;</a>
          </div>
        </div>

        <div class="bg-white p-8 flex flex-col justify-between shadow-luxury-card border-t-4 border-amber-600 hover-lift">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Factory Keys</span>
            <h3 class="text-xl font-bold text-[#0f274a] mb-2">OEM Dealer Key Alternative</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-6 font-medium">
              Genuine factory keys without dealership prices or wait times. We carry OEM transponders and smart remotes programmed to your VIN.
