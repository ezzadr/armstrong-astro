---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Car Lockout Service Nashville TN | Fast Same-Day Mobile Dispatch";
const seoDescription = "Locked out of your car in Nashville? Damage-free car door unlocking by licensed locksmiths. Same-Day Mobile Dispatch. Call (615) 625-8000 now.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/emergency-car-lockout/" image="/images/sako-armstrong-locksmith-technecian-unlocking-a-car-scaled.jpg">
  
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold w-fit">
          <span>🚨 Prompt Same-Day Mobile Dispatch</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Emergency Car Lockout <br />
          <span class="text-amber-400">in Nashville, TN</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          Precision Over Force. We Don't Guess. We Decode. Safe, damage-free vehicle entry using precision automotive tools.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xl border border-slate-200 text-slate-900">
          <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase pb-3 border-b border-slate-100">
            Professional Lockout Tools
          </h2>
          <ul class="flex flex-col gap-3 my-4 text-xs sm:text-sm text-slate-700">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Lishi Laser Decoding:</strong> Picking the lock directly through the keyhole without touching door panels.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Soft-Touch Air Wedges:</strong> Non-marking vinyl wedges that protect weather seals and paint.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>OBD Trunk Release:</strong> Bypassing anti-theft deadlocked trunks safely.</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </header>

  <!-- Real Lockout Photo Section -->
  <section class="py-10 bg-slate-50 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md">
        <img 
          src="/images/sako-armstrong-locksmith-technecian-unlocking-a-car-scaled.jpg" 
          alt="Armstrong Locksmith Technician Sako Unlocking Vehicle Safely"
          class="w-full h-64 object-cover"
          width="600"
          height="400"
          loading="lazy"
        />
        <div class="p-3 bg-white text-xs font-bold text-[#0f274a] text-center border-t border-slate-100">
          Technician Sako performing damage-free automotive entry
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase">Fast Mobile Dispatch Across Metro Nashville</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Our marked mobile locksmith vans are stationed throughout Davidson County and Williamson County, equipped with automotive Lishi decoders, non-marring air wedges, and long-reach bypass tools.
        </p>
        <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-900 font-medium">
          🛡️ <strong>100% Damage-Free Guarantee:</strong> We never use destructive jimmy tools that ruin your door weather-stripping or side curtain airbags.
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Original WordPress Long-Form Content -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto flex flex-col gap-12 text-slate-800 leading-relaxed text-sm sm:text-base">
      
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-heading font-black uppercase mb-4">
          Why Nashville Residents Trust Armstrong for Car Lockouts
        </h2>
        <p class="mb-3">
          Amateur lockout operators often jam metal slim jims into door panels, slicing through internal side-airbag wiring, power window cables, and weatherstripping.
        </p>
        <p>
          At Armstrong Locksmith, we treat your vehicle with professional care. Our technicians use dedicated Lishi picks designed specifically for your vehicle's wafer lock, decoding the tumblers cleanly promptly with zero structural damage.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6 text-center">
          <span class="text-2xl font-bold text-[#0f274a] block font-heading font-black uppercase mb-1">Direct</span>
          <span class="text-xs text-slate-500 font-bold uppercase">Mobile Dispatch</span>
        </div>
        <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6 text-center">
          <span class="text-2xl font-bold text-amber-600 block font-heading font-black uppercase mb-1">100%</span>
          <span class="text-xs text-slate-500 font-bold uppercase">Zero Damage</span>
        </div>
        <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6 text-center">
          <span class="text-2xl font-bold text-emerald-600 block font-heading font-black uppercase mb-1">$65+</span>
          <span class="text-xs text-slate-500 font-bold uppercase">Upfront Pricing</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0f274a] bg-navy-grid text-white py-14 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-4">
      <h2 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-white">Locked Out Right Now?</h2>
      <p class="text-slate-200 text-sm sm:text-base">Call our emergency dispatch line for immediate mobile response.</p>
      <div class="flex items-center justify-center pt-2">
        <a href="tel:6156258000" class="px-8 py-3.5 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-base shadow">
          Call (615) 625-8000
        </a>
      </div>
    </div>
  </section>
</Layout>
