---
import Layout from '../layouts/Layout.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const { reviewCount } = await getReviewStats();

const seoTitle = `Car Key Replacement Nashville TN | Lost Car Keys Cut On-Site`;
const serviceSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Car Key Replacement",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Belle Meade", "Green Hills"],
    "description": "Mobile and storefront automotive key cutting, proximity fob programming, and laser key origination in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you make a replacement car key without the original?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! Our technicians decode your vehicle door lock cylinder on-site, cut a fresh key blade with high-security laser machines, and program the transponder chip or smart fob directly to your car."
        }
      },
      {
        "@type": "Question",
        "name": "How fast can you make a replacement key in Nashville?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our mobile locksmith vans arrive in prompt same-day service across Greater Nashville and complete key cutting and programming on-site with zero delay."
        }
      },
      {
        "@type": "Question",
        "name": "Which American, Asian, and European vehicle brands do you make keys for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We cut and program keys daily for American makes (Ford, Lincoln, Chevrolet, GMC, Cadillac, Buick, Dodge, RAM, Jeep, Chrysler), Asian makes (Toyota, Lexus, Honda, Acura, Nissan, Infiniti, Hyundai, Kia, Subaru, Mazda, Mitsubishi), and European makes (BMW, Mercedes-Benz, Audi, Volkswagen, Land Rover, Porsche, Bentley, Volvo, MINI)."
        }
      },
      {
        "@type": "Question",
        "name": "Can you program 2020–2026 Ford push-to-start keys that require the Ford FDRS dealer tool?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Newer 2020–2026 Ford and Lincoln push-to-start models (including the 2022 Ford Escape, F-150, Explorer, Bronco, and Transit) require the official Ford FDRS dealer tool rather than basic aftermarket tablets. Our mobile vans carry licensed Ford FDRS software and program smart keys on-site after owner verification."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "name": "Automotive Car Key Replacement & Programming",
    "description": "On-site mobile car key cutting, transponder keys, and proximity smart fobs in Nashville, TN.",
    "image": "https://armstronglocksmithinc.com/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg",
    "brand": {
      "@type": "Brand",
      "name": "Armstrong Locksmith"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "125",
      "highPrice": "345",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "2007 Porsche 911 New Keys Made | Porsche Locksmith Nashville TN",
    "description": "Watch Armstrong Locksmith make and program replacement keys for a 2007 Porsche 911 in Nashville, TN, showcasing on-site laser cutting and computer immobilizer synchronization.",
    "thumbnailUrl": [
      "https://i.ytimg.com/vi/pRr53jg4xw4/hqdefault.jpg"
    ],
    "uploadDate": "2026-07-27T12:18:56-07:00",
    "embedUrl": "https://www.youtube.com/embed/pRr53jg4xw4",
    "contentUrl": "https://www.youtube.com/watch?v=pRr53jg4xw4",
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  }
];

const seoDescription = `Lost your car keys in Nashville? We cut & program replacement car keys, transponders, and smart fobs on-site or at 208 Thompson Ln. Call (615) 625-8000.`;
---

<Layout title={seoTitle} description={seoDescription} canonical="/car-key-replacement-nashville/" schema={serviceSchema} image="/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg">
  
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-3">
        <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30">Auto Key Specialist</span>
        <span>&bull;</span>
        <span>Certified & Insured</span>
        <span>&bull;</span>
        <span>Storefront &amp; Mobile</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
        Car Key Replacement <br />
        <span class="text-amber-400">in Nashville, TN</span>
      </h1>

      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-3xl mt-4 font-normal leading-relaxed">
        Lost your only car key or need a backup spare? We cut and program transponder chip keys, smart proximity fobs, and high-security laser blades for domestic, Asian, and European vehicles on-site across Middle Tennessee.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-7">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-slate-950 font-black text-base flex items-center justify-center gap-2.5 shadow-lg transition active:scale-95 whitespace-nowrap">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>

        <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 whitespace-nowrap">
          <span>Book Online</span>
        </a>
      </div>
    </div>
  </header>

  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-2.5"><div><strong class="block text-slate-900 font-bold">Same-Day Mobile Service</strong><span class="text-slate-500 text-[11px]">Mobile van to your door</span></div></div>
      <div class="flex items-center gap-2.5"><div><strong class="block text-slate-900 font-bold">208 Thompson Ln</strong><span class="text-slate-500 text-[11px]">Storefront shop</span></div></div>
      <div class="flex items-center gap-2.5"><div><strong class="block text-emerald-800 font-bold">Save $150-$500</strong><span class="text-slate-500 text-[11px]">vs Dealership Quotes</span></div></div>
      <div class="flex items-center gap-2.5"><div><strong class="block text-slate-900 font-bold">Certified & Insured</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div></div>
    </div>
  </section>

  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Real Video Demo -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold w-fit">
            Live Nashville Demonstration
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a]">
            Watch Us Cut &amp; Program Keys Live On-Site
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Replacing a modern car key requires both laser mechanical cutting and electronic immobilizer programming. See how we originate keys on-site with zero delay, or <a href="/blog/2011-dodge-ram-fobik-key-replacement-nashville-shop/" class="font-bold text-[#0f274a] underline hover:text-amber-700">see a recent 2011 Dodge Ram FOBIK key programmed at our shop</a>.
          </p>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-300 aspect-video bg-black">
          <YouTubeFacade id="pRr53jg4xw4" title="Car Key Replacement Nashville Demonstration" />
        </div>
      </section>

      <!-- Interactive Car Key Estimator & Fitment Widget -->
      <section id="ford-fdrs-nashville" class="bg-white rounded-3xl p-6 sm:p-10 border-2 border-amber-400/70 shadow-md grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-200 shadow-lg bg-slate-100">
          <img
            src="/images/2022-ford-escape-push-to-start-key-fdrs-nashville-900.webp"
            srcset="/images/2022-ford-escape-push-to-start-key-fdrs-nashville-600.webp 600w, /images/2022-ford-escape-push-to-start-key-fdrs-nashville-900.webp 900w, /images/2022-ford-escape-push-to-start-key-fdrs-nashville-1200.webp 1200w"
            sizes="(max-width: 1024px) 100vw, 560px"
            alt="Armstrong Locksmith mobile locksmith van parked next to a 2022 Ford Escape in Nashville programming a push-to-start smart key with the Ford FDRS dealer tool"
            class="w-full h-auto object-cover"
            loading="lazy"
            decoding="async"
            width="1024"
            height="762"
          />
        </div>
        <div class="lg:col-span-6 flex flex-col gap-3.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-extrabold uppercase tracking-wider w-fit border border-amber-300">
            Real Mobile Job &bull; Official Ford FDRS Dealer Tool
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a]">
            2022 Ford Escape Push-to-Start — Key Made On-Site With Ford FDRS
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            We got a call for this <strong>2022 Ford Escape push-to-start</strong> that needed a key made on-site. On 2020–2026 Ford models (Escape, F-150, Explorer, Bronco, Expedition, and Transit), standard aftermarket locksmith tablets cannot bypass the security gateway—the job is <strong>only doable with the official Ford FDRS dealer tool</strong>.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            We drove our mobile locksmith van out to the customer, completed <strong>owner verification</strong>, connected with licensed Ford FDRS dealer software, and cut and programmed a brand-new push-to-start smart fob right on the spot—saving the customer a tow truck and days of waiting at the Ford dealership.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a href="tel:6156258000" class="px-5 py-3 rounded-xl bg-[#0f274a] hover:bg-[#16335c] text-white font-black text-xs sm:text-sm uppercase tracking-wider transition shadow">
              Call (615) 625-8000 for Ford Key Quotes</a> <a href="/ford-car-key-replacement/" class="px-4 py-3 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 font-extrabold text-xs sm:text-sm transition border border-amber-300">Ford Key Page &rarr;
            </a>
            <span class="text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-3 py-2 rounded-lg">
              All Ford &amp; Lincoln Models Up to 2026 Supported
            </span>
          </div>
        </div>
      </section>

      <CarKeyEstimator />

      <!-- Inside Our Mobile Locksmith Vans -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm text-left">
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-950 text-xs font-extrabold uppercase tracking-wider mb-2 border border-emerald-300">
            &#10003; Fully Equipped Locksmith Vans &bull; Dispatched Across Greater Nashville
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            Inside the Locksmith Vans We Bring to Your Driveway
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
            When you call us for an all-keys-lost car key, commercial door lock repair, or house re-key, we don't show up in an unmarked personal car. Our vans are full custom-built locksmith vans equipped with dual key-cutting benches, computerized high-security laser machines, mortise cylinder drawers, and stocked key fobs.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src="/images/armstrong-locksmith-mobile-workshop-van-interior-nashville-600.webp"
              srcset="/images/armstrong-locksmith-mobile-workshop-van-interior-nashville-600.webp 600w, /images/armstrong-locksmith-mobile-workshop-van-interior-nashville-900.webp 900w"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
              alt="Inside Armstrong Locksmith custom-built mobile locksmith van in Nashville TN featuring dual key cutting benches and high-security laser machines"
              class="w-full h-60 object-cover"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
            />
            <div class="p-3.5 bg-white border-t border-slate-100">
              <strong class="block text-xs font-bold text-[#0f274a]">Dual Key-Cutting Benches</strong>
              <span class="text-[11px] text-slate-600">Standard &amp; high-security laser machines mounted on board</span>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src="/images/armstrong-locksmith-van-laser-key-machines-nashville-600.webp"
              srcset="/images/armstrong-locksmith-van-laser-key-machines-nashville-600.webp 600w, /images/armstrong-locksmith-van-laser-key-machines-nashville-900.webp 900w"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
              alt="Computerized high-security laser key cutting machine and organized parts bins inside Armstrong Locksmith mobile service van in Nashville TN"
              class="w-full h-60 object-cover"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
            />
            <div class="p-3.5 bg-white border-t border-slate-100">
              <strong class="block text-xs font-bold text-[#0f274a]">Computerized Laser Cutters</strong>
              <span class="text-[11px] text-slate-600">Factory-code laser cutting for Ford, Honda, Toyota, Volvo &amp; BMW</span>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src="/images/armstrong-locksmith-van-mortise-cylinders-pinning-bench-nashville-600.webp"
              srcset="/images/armstrong-locksmith-van-mortise-cylinders-pinning-bench-nashville-600.webp 600w, /images/armstrong-locksmith-van-mortise-cylinders-pinning-bench-nashville-900.webp 900w"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
              alt="Commercial mortise cylinder drawers, pinning kits, and car unlock tools inside Armstrong Locksmith mobile locksmith van in Nashville TN"
              class="w-full h-60 object-cover"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
            />
            <div class="p-3.5 bg-white border-t border-slate-100">
              <strong class="block text-xs font-bold text-[#0f274a]">Mortise Cylinders &amp; Pin Kits</strong>
              <span class="text-[11px] text-slate-600">Labeled commercial cylinders, re-keying kits &amp; air-wedge tools</span>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src="/images/armstrong-locksmith-mobile-van-key-cutting-workstation-nashville-600.webp"
              srcset="/images/armstrong-locksmith-mobile-van-key-cutting-workstation-nashville-600.webp 600w, /images/armstrong-locksmith-mobile-van-key-cutting-workstation-nashville-900.webp 900w"
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
              alt="Key cutting bench, key cutting machines, and hardware storage inside Armstrong Locksmith mobile van in Nashville TN"
              class="w-full h-60 object-cover"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
            />
            <div class="p-3.5 bg-white border-t border-slate-100">
              <strong class="block text-xs font-bold text-[#0f274a]">Stocked Key Fobs &amp; Blades</strong>
              <span class="text-[11px] text-slate-600">Hundreds of smart fobs, FOBIKs &amp; transponder keys ready on-site</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 6 Service Pillars -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">All Keys Lost Origination</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">No working original? We decode your lock cylinder with Lishi tools and generate a new key from scratch.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Smart Push-to-Start Fobs</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Factory proximity remotes programmed directly through OBD2 diagnostics on-site.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">High-Security Laser Cutting</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Computerized laser cutting for internal track sidewinder key blades to exact factory tolerances.</p>
        </div>
      </section>

      <!-- Supported Makes Grid -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] mb-2">
          American, Asian &amp; European Car Keys We Replace Daily
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm mb-6 max-w-3xl">
          Most of our daily jobs are American trucks, SUVs, and sedans alongside Japanese and Korean vehicles—plus full in-house programming for European luxury cars.
        </p>

        <!-- 3-Column Regional Breakdown -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 block mb-1">Domestic Trucks, SUVs &amp; Cars</span>
            <h3 class="text-base font-black text-[#0f274a] uppercase mb-2">American Vehicles</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              <strong>Ford &amp; Lincoln:</strong> F-150, F-250, Explorer, Escape, Expedition, Mustang, Transit, Bronco.<br />
              <strong>Chevy, GMC &amp; Cadillac:</strong> Silverado, Sierra, Tahoe, Suburban, Equinox, Traverse, Escalade, Hummer.<br />
              <strong>Dodge, RAM, Jeep &amp; Chrysler:</strong> Ram 1500/2500, Wrangler, Grand Cherokee, Charger, Challenger, Pacifica (FOBIK &amp; smart fobs).
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 block mb-1">Japanese &amp; Korean Imports</span>
            <h3 class="text-base font-black text-[#0f274a] uppercase mb-2">Asian Vehicles</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              <strong>Toyota &amp; Lexus:</strong> Camry, RAV4, Tacoma, Tundra, Highlander, 4Runner, Corolla, RX350.<br />
              <strong>Honda &amp; Acura:</strong> Civic, Accord, CR-V, Pilot, Odyssey, MDX, RDX, TLX (plus stuck ignition repair).<br />
              <strong>Nissan, Infiniti, Subaru &amp; Mazda:</strong> Altima, Rogue, Sentra, Maxima, Pathfinder, Outback, Forester, CX-5.<br />
              <strong>Hyundai &amp; Kia:</strong> Tucson, Santa Fe, Elantra, Sonata, Palisade, Telluride, Sorento, Sportage, Forte, Soul.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 block mb-1">In-House Immobilizer Specialty</span>
            <h3 class="text-base font-black text-[#0f274a] uppercase mb-2">European Specialty</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              <strong>BMW &amp; MINI:</strong> 3, 5, 7 Series, X3, X5, X7 (CAS &amp; FEM/BDC).<br />
