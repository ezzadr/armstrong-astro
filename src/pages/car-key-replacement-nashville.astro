---
import Layout from '../layouts/Layout.astro';
import TextPhotoCTA from '../components/TextPhotoCTA.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "Car Key Replacement Nashville TN | Armstrong Locksmith";
const serviceSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Car Key Replacement",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+1-615-625-8000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211",
        "addressCountry": "US"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Belle Meade", "Green Hills"],
    "description": "Mobile and storefront automotive key cutting, proximity fob programming, and laser key origination in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you make a replacement car key without the original?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! Our technicians decode your vehicle door lock cylinder on-site, cut a fresh key blade with CNC laser machines, and program the transponder chip or smart fob directly to your car."
        }
      },
      {
        "@type": "Question",
        "name": "How fast can you make a replacement key in Nashville?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our mobile locksmith vans arrive in prompt same-day service across Greater Nashville and complete key cutting and programming on-site with zero delay."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Automotive Car Key Replacement & Programming",
    "description": "On-site mobile car key cutting, transponder keys, and proximity smart fobs in Nashville, TN.",
    "image": "https://armstronglocksmithinc.com/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg",
    "brand": {
      "@type": "Brand",
      "name": "Armstrong Locksmith"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "125",
      "highPrice": "345",
      "offerCount": "1",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Locksmith",
        "name": "Armstrong Locksmith Inc"
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "220",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Marcus Vance" },
        "datePublished": "2026-06-15",
        "reviewBody": "Saved me over $600 compared to the dealership! Rahim came out with dealer-level equipment, cut the emergency physical blade, and programmed the smart key fob the same day right on-site.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        }
      }
    ]
  }
];

const seoDescription = "Fast on-site car key cutting, transponder & smart key fob programming in Nashville. Mobile dispatch & 208 Thompson Ln shop. Call (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/car-key-replacement-nashville/" schema={serviceSchema} image="/images/ARMSTRONG-LOCKSMITH-KEY-MACHINES-INSIDE-THE-SHOP.jpg">
  
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-3">
        <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30">Auto Key Specialist</span>
        <span>&bull;</span>
        <span>Certified & Insured</span>
        <span>&bull;</span>
        <span>Storefront &amp; Mobile</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
        Car Key Replacement <br />
        <span class="text-amber-400">in Nashville, TN</span>
      </h1>

      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-3xl mt-4 font-normal leading-relaxed">
        Lost your only car key or need a backup spare? We cut and program transponder chip keys, smart proximity fobs, and high-security laser blades for domestic, Asian, and European vehicles on-site across Middle Tennessee.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-7">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-slate-950 font-black text-base flex items-center justify-center gap-2.5 shadow-lg transition active:scale-95 whitespace-nowrap">
          <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>

        <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 whitespace-nowrap">
          <span>Book Online</span>
        </a>
      </div>
    </div>
  </header>

  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-2.5"><span class="text-xl">⚡</span><div><strong class="block text-slate-900 font-bold">Same-Day Mobile Dispatch</strong><span class="text-slate-500 text-[11px]">Mobile van to your door</span></div></div>
      <div class="flex items-center gap-2.5"><span class="text-xl">⚡</span><div><strong class="block text-slate-900 font-bold">208 Thompson Ln</strong><span class="text-slate-500 text-[11px]">Storefront shop</span></div></div>
      <div class="flex items-center gap-2.5"><span class="text-xl">⚡</span><div><strong class="block text-emerald-800 font-bold">Save $150-$500</strong><span class="text-slate-500 text-[11px]">vs Dealership Quotes</span></div></div>
      <div class="flex items-center gap-2.5"><span class="text-xl">🛡️</span><div><strong class="block text-slate-900 font-bold">Certified & Insured</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div></div>
    </div>
  </section>

  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Real Video Demo -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold w-fit">
            <span>🎬</span> Live Nashville Demonstration
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a]">
            Watch Us Cut &amp; Program Keys Live On-Site
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Replacing a modern car key requires both laser mechanical cutting and electronic immobilizer programming. See how we originate keys on-site on-site with zero delay.
          </p>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-300 aspect-video bg-black">
          <iframe class="w-full h-full" src="https://www.youtube.com/embed/pRr53jg4xw4" title="Car Key Replacement Nashville Demonstration" allowfullscreen loading="lazy"></iframe>
        </div>
      </section>

      <!-- Interactive Car Key Estimator & Fitment Widget -->
      <CarKeyEstimator />

      <!-- 6 Service Pillars -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">All Keys Lost Origination</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">No working original? We decode your lock cylinder with Lishi tools and generate a new key from scratch.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Smart Push-to-Start Fobs</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Factory proximity remotes programmed directly through OBD2 diagnostics on-site.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">High-Security CNC Laser Cutting</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Computerized laser cutting for internal track sidewinder key blades to exact factory tolerances.</p>
        </div>
      </section>

      <!-- Supported Makes Grid -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] mb-6">
          Makes &amp; Brands We Replace Daily
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 text-xs font-bold text-slate-800">
          <a href="/toyota-car-key-replacement/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Toyota / Lexus</a>
          <a href="/honda-car-keys/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Honda / Acura</a>
          <a href="/bmw/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> BMW / MINI</a>
          <a href="/audi-car-keys/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Audi / VW</a>
          <a href="/mercedes-benz/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Mercedes-Benz</a>
          <a href="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Land Rover / Range Rover</a>
          <a href="/hyundai/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Hyundai</a>
          <a href="/kia-car-key-replacement/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-2"><span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span> Kia</a>
        </div>
      </section>

      <TextPhotoCTA />

      <!-- Emergency CTA -->
      <section class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-[#0f274a] via-[#16335c] to-[#0f274a] text-white shadow-xl border-t-4 border-amber-500 flex flex-col md:flex-row items-center justify-between gap-8 text-left">
        <div class="max-w-2xl">
          <span class="text-xs font-black uppercase tracking-wider text-amber-300 bg-white/10 px-3 py-1 rounded-full">🚨 Prompt Same-Day Mobile Dispatch</span>
          <h3 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-white mt-3 mb-2">Need A Replacement Car Key Today?</h3>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">Skip the dealer tow fee. Call Armstrong Locksmith for on-site key origination in prompt same-day service.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3.5 w-full md:w-auto flex-shrink-0">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-sm text-center shadow-lg transition active:scale-95 whitespace-nowrap">Call (615) 625-8000</a>
          <a href="/book-online/" class="px-6 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-xs text-center shadow transition active:scale-95 whitespace-nowrap">Book Online</a>
        </div>
      </section>

    </div>
  </main>
</Layout>
