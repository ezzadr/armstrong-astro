---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Contact Armstrong Locksmith Nashville | Phone, Address & Hours";
const seoDescription = "Visit our shop at 208 Thompson Ln or call (615) 625-8000 for fast mobile dispatch across Nashville. Certified & Insured. Walk-ins welcome.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/contact-armstrong-locksmith/">
  
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Get In Touch</span>
      <h1 class="text-3xl sm:text-5xl font-black font-heading font-black uppercase text-white tracking-tight">
        Contact Armstrong Locksmith
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Visit our physical storefront on Thompson Lane or submit a request for immediate mobile technician dispatch.
      </p>
    </div>
  </header>

  <section class="py-16 sm:py-24 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Contact Info & Shop Photo -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md">
          <img 
            src="/shop.jpeg" 
            alt="Armstrong Locksmith Storefront 208 Thompson Lane Nashville" 
            class="w-full h-56 object-cover"
          />
          <div class="p-4 bg-slate-50 border-t border-slate-200 text-center">
            <h3 class="text-base font-bold text-[#0f274a] font-heading font-black uppercase">Storefront at 208 Thompson Ln</h3>
            <span class="text-xs text-slate-500">Drop in during business hours for fast key copies</span>
          </div>
        </div>

        <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6 bg-slate-50 border border-slate-200">
          <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase mb-4 pb-2 border-b border-slate-200">Store Information</h2>
          
          <div class="flex flex-col gap-4 text-xs sm:text-sm text-slate-700">
            <div>
              <strong class="block text-[#0f274a] text-sm">📍 Physical Storefront:</strong>
              <span>208 Thompson Ln, Nashville, TN 37211</span>
              <a 
                href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="block text-amber-600 font-bold hover:underline mt-0.5"
              >
                Get Google Maps Directions &rarr;
              </a>
            </div>

            <div>
              <strong class="block text-[#0f274a] text-sm">📞 Phone / Dispatch:</strong>
              <a href="tel:6156258000" class="text-emerald-700 font-bold hover:underline">
                (615) 625-8000
              </a>
            </div>

            <div>
              <strong class="block text-[#0f274a] text-sm">🕒 Hours:</strong>
              <span><strong>Storefront:</strong> Mon – Fri: 8:00 AM – 6:00 PM • Sat: 10:00 AM – 4:00 PM</span><br />
              <span class="text-emerald-700 font-semibold"><strong>Mobile Dispatch:</strong> Mon – Fri: 8:00 AM – 11:30 PM • Weekends On-Call</span>
            </div>

            <div>
              <strong class="block text-[#0f274a] text-sm">🛡️ State Credential:</strong>
              <span>Certified & Fully Insured</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Twilio-Connected Contact & Dispatch Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border-2 border-amber-400/90 ring-4 ring-amber-400/20 text-slate-900 relative overflow-hidden">
          <!-- Top Accent Banner -->
          <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500"></div>

          <div class="pb-4 mb-6 border-b border-slate-100 flex items-center justify-between gap-2">
            <div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-metallic text-slate-950 font-black text-xs uppercase tracking-wider mb-2 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-slate-950 animate-pulse"></span>
                <span>Direct Dispatch Form</span>
              </span>
              <h2 class="text-2xl font-black text-[#0f274a] font-heading font-black uppercase">Send Us A Message</h2>
              <p class="text-xs text-slate-600 font-medium">Get a prompt upfront price directly to your mobile phone.</p>
            </div>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 shrink-0">
              ⚡ Direct SMS Alert
            </span>
          </div>

          <form id="contact-page-form" class="flex flex-col gap-4 text-left">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-slate-800 mb-1">Full Name *</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  placeholder="John Doe" 
                  class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 font-medium transition-all"
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-bold text-slate-800 mb-1">Phone Number *</label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="phone" 
                  required 
                  placeholder="(615) 000-0000" 
                  class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 font-medium transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-service" class="block text-xs font-bold text-slate-800 mb-1">Service Needed *</label>
                <select 
                  id="contact-service" 
                  name="service" 
                  required 
                  class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 font-medium transition-all"
                >
                  <option value="">Select service...</option>
                  <option value="Car Key Replacement">🔑 Car Key Replacement</option>
                  <option value="European Specialist">🏎️ European Key (BMW, Benz, Audi, etc.)</option>
                  <option value="Key Fob Programming">📶 Key Fob & Remote Programming</option>
                  <option value="Emergency Car Lockout">🚨 Emergency Car Lockout</option>
                  <option value="House Lockout / Rekey">🏡 House Lockout or Rekey</option>
                  <option value="Commercial Locksmith">🏢 Commercial Door Hardware</option>
                  <option value="Other">🛠️ Other Locksmith Service</option>
                </select>
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-bold text-slate-800 mb-1">Email Address</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  placeholder="john@example.com" 
                  class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 font-medium transition-all"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-slate-800 mb-1">How Can We Help You? *</label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="3" 
                required 
                placeholder="Vehicle year/make/model, address, or details of your lock issue..." 
                class="w-full px-3.5 py-3 text-sm rounded-xl bg-slate-50 border border-slate-300 focus:bg-white focus:border-amber-500 focus:ring-4 focus:ring-amber-200/50 outline-none text-slate-900 font-medium transition-all"
              ></textarea>
            </div>

            <button 
              type="submit" 
              id="contact-submit-btn"
              class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-black text-base uppercase tracking-wider shadow-xl transition-all duration-200 active:scale-95 flex items-center justify-center gap-2 cursor-pointer border border-amber-300"
            >
              <span>Send Message to On-Duty Locksmith &rarr;</span>
            </button>
            <div class="text-xs text-slate-500 text-center font-medium">
              🔒 Form transmits directly to our mobile team dispatch phone via Twilio.
            </div>
          </form>

          <div id="contact-success-msg" class="hidden p-6 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-center">
            <div class="text-3xl mb-1">📱</div>
            <strong class="block text-base font-bold">Message Dispatched!</strong>
            <p class="text-xs text-emerald-800 mt-1">
              Your inquiry has been sent via SMS directly to our mobile team. We will call or text you back in <strong>promptly</strong>.
            </p>
            <div class="mt-3 pt-3 border-t border-emerald-200">
              <a href="tel:6156258000" class="text-xs font-bold text-emerald-900 underline">
                Immediate emergency? Call (615) 625-8000 &rarr;
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Twilio Submission Script -->
  <script is:inline>
    (function () {
      const form = document.getElementById('contact-page-form');
      const successMsg = document.getElementById('contact-success-msg');
      const submitBtn = document.getElementById('contact-submit-btn');

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>⚡ Dispatching SMS...</span>';
          }

          const formData = {
            name: form.name ? form.name.value : '',
            phone: form.phone ? form.phone.value : '',
            service: form.service ? form.service.value : '',
            details: form.details ? form.details.value : '',
            email: form.email ? form.email.value : '',
            notes: form.message ? form.message.value : (form.notes ? form.notes.value : '')
          };

          try {
            const res = await fetch('/api/contact.php', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });
            await res.json();
          } catch (err) {
            console.log('Contact form error:', err);
          }

          form.classList.add('hidden');
          if (successMsg) {
            successMsg.classList.remove('hidden');
          }
        });
      }
    })();
  </script>

</Layout>
