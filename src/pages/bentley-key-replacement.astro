---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Bentley Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Ultra-luxury Bentley key cutting & transponder programming in Nashville, TN. Save time and towing fees with mobile service. (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/bentley-key-replacement/">
  
  <!-- Premium Hero Header -->
  <header class="bg-gradient-to-b from-[#0a192f] via-[#0f274a] to-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Hero Left Column -->
      <div class="lg:col-span-7 text-left flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">
            Bentley Automotive Locksmith
          </span>
          <span>&bull;</span>
          <span class="text-slate-300">Certified & Insured</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">&#10003; Prompt Mobile Dispatch</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
          Bentley Key Replacement <br />
          <span class="text-amber-400">Ultra-Luxury Key Specialist</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Continental GT, Flying Spur, Bentayga, Mulsanne, and Arnage. High-end automotive security handled with dealership-level care and zero tow fees.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 whitespace-nowrap"
          >
            <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a 
            href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap"
          >
            <span>Book Online Appointment</span>
          </a>
        </div>
      </div>

      <!-- Hero Right: Quick Feature Card -->
      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-6 sm:p-8 border border-white/20 shadow-2xl text-white">
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-300">Why Armstrong Locksmith?</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30">Verified Local Shop</span>
        </div>

        <div class="flex flex-col gap-3.5 text-xs sm:text-sm">
          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-white block">No Dealership Towing Required</strong><span class="text-slate-300 text-xs">We bring our mobile van equipped with laser cutters to your car.</span></div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-white block">Same-Day Turnaround (20-40 Mins)</strong><span class="text-slate-300 text-xs">Skip the 5 to 10-day dealership ordering delay.</span></div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-white block">Physical Storefront on Thompson Ln</strong><span class="text-slate-300 text-xs">Drop into our shop at 208 Thompson Ln for discount walk-in service.</span></div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-emerald-400 text-base">&#10003;</span>
            <div><strong class="text-emerald-300 block font-bold">Save $500-$1,000 vs Dealership</strong><span class="text-slate-300 text-xs">Transparent upfront pricing with zero hidden fees.</span></div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Key Metrics Strip -->
  <section class="bg-white border-b border-slate-200 py-4 px-4 sm:px-6 lg:px-8 shadow-sm">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center shadow-sm"><svg class="w-5 h-5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        <div><strong class="block text-emerald-800 font-bold">Save $500-$1,000 vs Dealership</strong><span class="text-slate-500 text-[11px]">vs Dealership Quotes</span></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center shadow-sm"><svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
        <div><strong class="block text-slate-900 font-bold">Certified & Insured</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div>
      </div>
    </div>
  </section>

  <!-- Main Body Content -->
  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Real Job Spotlight / Video Section -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-900 text-xs font-bold w-fit border border-amber-500/20">
            <span>&#128295;</span> Real Nashville Case Study
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] leading-tight">
            Watch A Real Bentley Key Replacement in Nashville
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Bentley-friendly handling: careful optical entry methods, correct immobilizer identification, and final start verification you can trust.
          </p>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-700 leading-relaxed">
            Bentley vehicles require specialized immobilizer matching and non-destructive optical lock reading. We originate and sync smart keys without risking delicate leather upholstery or door electronics.
          </div>
          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs font-bold text-slate-700">
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1.5 rounded-lg">&#10003; 100% On-Site Solution</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; Laser Cut Factory Key</span>
          </div>
        </div>

        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-200 aspect-video bg-slate-900 flex items-center justify-center">
          
            <iframe 
              class="w-full h-full" 
              src="https://www.youtube.com/embed/4p5EnSbJAWg" 
              title="Bentley Key Replacement Demonstration" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              loading="lazy"
            ></iframe>
          
        </div>
      </section>

      <!-- 3 Core Services -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 hover:shadow-md transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Bentley Smart Fobs</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">OEM smart proximity key fobs programmed directly to the vehicle immobilizer.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-5 block pt-4 border-t border-slate-100">Same-Day Service Available &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 hover:shadow-md transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">High-Precision Laser Cut</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Emergency mechanical key blades cut to exact 0.01mm factory tolerances.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-5 block pt-4 border-t border-slate-100">Same-Day Service Available &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 hover:shadow-md transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
              <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Non-Destructive Entry</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Specialized optical decoding picks to unlock doors without a single scratch.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-5 block pt-4 border-t border-slate-100">Same-Day Service Available &rarr;</span>
          </div>
        
      </section>

      <!-- Verified Review Card -->
      <section class="bg-gradient-to-br from-[#0f274a] via-[#14325a] to-[#0f274a] text-white rounded-3xl p-8 sm:p-12 shadow-xl border-t-4 border-amber-500 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 flex flex-col gap-3">
          <div class="flex items-center gap-1 text-amber-400 text-lg">
            &#9733;&#9733;&#9733;&#9733;&#9733;
          </div>
          <p class="text-slate-100 text-sm sm:text-base lg:text-lg font-medium leading-relaxed italic">
            "Rahim is the only locksmith in Middle Tennessee I trust with my Bentley. He handled the car with utmost care, cut the emergency blade to perfection, and programmed the key flawlessly."
          </p>
          <div class="flex items-center gap-3 pt-2 text-xs">
            <span class="font-bold text-amber-300">Charles Montgomery</span>
            <span>&bull;</span>
            <span class="text-slate-300">Bentley Continental GT</span>
            <span>&bull;</span>
            <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">&#10003; Verified Google Review</span>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col gap-3 justify-center items-start lg:items-end">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm shadow transition active:scale-95 whitespace-nowrap">
            Call (615) 625-8000
          </a>
          <span class="text-xs text-slate-300">Prompt Mobile Dispatch</span>
        </div>
      </section>

      <!-- Supported Models Grid -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">Coverage</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-4">
          Bentley Models We Cut &amp; Program in Middle TN
        </h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-3xl mb-8 leading-relaxed">
          From classic mechanical keys to modern proximity push-to-start smart fobs, our mobile vans stock keys and programming hardware for the following models:
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Continental GT</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Continental GTC</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Flying Spur</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Bentayga</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Mulsanne</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Arnage</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Azure</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">&#10003;</span>
              <span>Bentley Brooklands</span>
            </div>
          
        </div>
      </section>

      <!-- Storefront & Shop Visit Section -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-200 shadow-md">
          <img src="/shop.jpeg" alt="Armstrong Locksmith Storefront Nashville" class="w-full h-64 object-cover" />
          <div class="p-4 bg-slate-900 text-white text-xs flex justify-between items-center">
            <span>&#10003; 208 Thompson Ln, Nashville, TN 37211</span>
            <span class="text-amber-400 font-bold">Shop: 8AM-6PM &bull; Mobile: Until 11:30PM</span>
          </div>
        </div>

        <div class="lg:col-span-6 flex flex-col gap-4 text-left">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Physical Storefront Shop</span>
          <h3 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a]">
            Visit Our Storefront or We Come to You
          </h3>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">
            Need a spare Bentley key and want to save on mobile service fees? Bring your vehicle to our physical shop on <strong>Thompson Lane</strong>. We can cut and program your key in-store while you wait promptly!
          </p>
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <a href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-xl bg-[#0f274a] bg-navy-grid text-white font-bold text-xs text-center shadow hover:bg-slate-800 transition">
              Get Shop Directions &rarr;
            </a>
            <a href="tel:6156258000" class="px-6 py-3 rounded-xl bg-emerald-600 text-white font-bold text-xs text-center shadow hover:bg-emerald-500 transition">
              Call Shop: (615) 625-8000
            </a>
          </div>
        </div>
      </section>

      <!-- Brand FAQ -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Frequently Asked Questions About Bentley Keys
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
              <h4 class="font-bold text-[#0f274a] text-sm sm:text-base mb-2">Will my Bentley be damaged during unlocking?</h4>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Never. We use specialized German optical Lishi picks that read the internal tumblers directly without touching paint or weatherstripping.</p>
            </div>
          
        </div>
      </section>

      <!-- Emergency Dispatch CTA Banner -->
      <section class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-[#0f274a] via-[#16335c] to-[#0f274a] text-white shadow-xl border-t-4 border-amber-500 flex flex-col md:flex-row items-center justify-between gap-8 text-left">
        <div class="max-w-2xl">
          <span class="text-xs font-black uppercase tracking-wider text-amber-300 bg-white/10 px-3 py-1 rounded-full">
            &#10003; 24/7 Mobile Dispatch Across Middle Tennessee
          </span>
          <h3 class="text-2xl sm:text-3xl font-bold font-serif text-white mt-3 mb-2">
            Need A Bentley Key Made Today?
          </h3>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
            Skip dealership delays and high towing fees. Our mobile locksmith vans carry precision laser cutters and factory key programmers right to your vehicle.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3.5 w-full md:w-auto flex-shrink-0">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm text-center shadow-lg transition active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"></path></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-xs text-center shadow transition active:scale-95 flex items-center justify-center whitespace-nowrap">
            <span>Book Online</span>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
