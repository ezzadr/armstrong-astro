  <!-- Premium Hero Header -->
  <header class="bg-gradient-to-b from-[#0a192f] via-[#0f274a] to-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Hero Left Column -->
      <div class="lg:col-span-7 text-left flex flex-col gap-4">
