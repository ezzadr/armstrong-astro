---
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';
const { reviewCount, ratingValue } = await getReviewStats();

const seoTitle = `Armstrong Locksmith Reviews Nashville | 4.9★ (${reviewCount}+ Reviews)`;
const seoDescription = `Read ${reviewCount}+ verified 5-star Google reviews for Armstrong Locksmith at 208 Thompson Ln, Nashville. Real local shop for car keys, fobs, lockouts & rekeys.`;

const reviewsSchema = [
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "2020 Range Rover Key Replacement Customer Review in Nashville, TN | Armstrong Locksmith",
    "description": "Real customer review outside our Nashville locksmith shop at 208 Thompson Ln after we cut and programmed a new push-to-start smart key fob for his 2020 Land Rover Range Rover.",
    "thumbnailUrl": [
      "https://armstronglocksmithinc.com/images/2020-range-rover-customer-review-nashville.jpg",
      "https://i.ytimg.com/vi/IaOYSwz1IXk/hqdefault.jpg"
    ],
    "uploadDate": "2026-10-29T15:28:00-05:00",
    "duration": "PT11S",
    "embedUrl": "https://www.youtube.com/embed/IaOYSwz1IXk",
    "contentUrl": "https://www.youtube.com/watch?v=IaOYSwz1IXk",
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Armstrong Locksmith Our Reviews in Nashville TN | Our reviews do the talking",
    "description": "Watch client reviews and testimonials for Armstrong Locksmith Inc in Nashville, TN, showcasing fast car key replacement, shop walk-in services, and emergency lockouts.",
    "thumbnailUrl": [
      "https://i.ytimg.com/vi/DAPmg0fpzf4/hqdefault.jpg"
    ],
    "uploadDate": "2021-05-10T16:04:45-07:00",
    "embedUrl": "https://www.youtube.com/embed/DAPmg0fpzf4",
    "contentUrl": "https://www.youtube.com/watch?v=DAPmg0fpzf4",
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/google-reviews/" schema={reviewsSchema}>
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">&#9733; 4.9 / 5.0 Star Rating</span>
          <span>&bull;</span>
          <span class="text-slate-300"><span class="arm-review-count">{reviewCount}+</span> Verified Reviews</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">Verified Master Locksmith</span>
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Customer Reviews &amp; <br />
          <span class="text-amber-400">Testimonials in Nashville</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Read real customer feedback about Armstrong Locksmith Inc in Nashville. From emergency roadside car key origination to home rekeys and commercial storefront security, see why Middle Tennessee drivers and property owners trust Rahim and our team.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a href="https://g.page/r/CQS5BtikwbmqEBM" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-base flex items-center justify-center gap-2.5 shadow-2xl transition active:scale-95 whitespace-nowrap">
            <span>Read All Google Reviews &rarr;</span>
          </a>
          <a href="tel:6156258000" class="px-7 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <span>Call (615) 625-8000</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-8 border border-white/20 shadow-2xl text-white text-center">
        <div class="text-6xl font-black text-amber-400 mb-2">4.9</div>
        <div class="flex justify-center gap-1 text-amber-400 text-2xl mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="text-sm font-bold text-white mb-1">Based on <span class="arm-review-count">{reviewCount}+</span> Google Customer Reviews</p>
        <p class="text-xs text-slate-300">Verified Local Locksmith Storefront &bull; 208 Thompson Ln</p>
      </div>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-slate-50 text-slate-900 px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">

      <!-- Featured Shop Customer Testimonial: 2020 Land Rover Range Rover -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-lg grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6">
          <div
            class="relative rounded-2xl overflow-hidden border-2 border-amber-400/50 shadow-xl bg-slate-900 aspect-video group cursor-pointer"
            data-yt-facade="IaOYSwz1IXk"
            role="button"
            tabindex="0"
            aria-label="Play 2020 Range Rover Customer Video Review at 208 Thompson Ln Nashville"
          >
            <img
              src="/images/2020-range-rover-customer-review-nashville-900.webp"
              srcset="/images/2020-range-rover-customer-review-nashville-600.webp 600w, /images/2020-range-rover-customer-review-nashville-900.webp 900w, /images/2020-range-rover-customer-review-nashville-1200.webp 1200w"
              sizes="(max-width: 1024px) 100vw, 560px"
              alt="2020 Land Rover Range Rover owner thanking Armstrong Locksmith outside 208 Thompson Ln shop in Nashville, TN"
              width="1200"
              height="675"
              loading="lazy"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-500"
            />
            <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/10 transition flex items-center justify-center">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl ring-4 ring-white/80 group-hover:scale-110 transition">
                <svg class="w-8 h-8 sm:w-9 sm:h-9 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
            <div class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-sm border border-amber-400/40 rounded-lg px-3 py-1.5 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-300">Watch Customer Review (0:11)</span>
            </div>
          </div>
        </div>
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-100 border border-amber-300 text-amber-900 text-xs font-black uppercase tracking-wider w-fit">
            <span>208 Thompson Ln Storefront &bull; Customer Video</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black font-heading uppercase text-[#0f274a] leading-tight">
            2020 Range Rover Owner — Smart Key Made at Our Nashville Shop
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Hear directly from this <strong>2020 Land Rover Range Rover</strong> owner right outside our <strong>208 Thompson Ln</strong> locksmith shop after we cut and programmed a new push-to-start smart key fob for his SUV while he waited — saving hundreds compared to the dealership with no multi-day wait.
          </p>
          <div class="pt-1">
            <a
              href="https://youtu.be/IaOYSwz1IXk"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs sm:text-sm shadow transition"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <span>Watch on YouTube</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Video Review Feature -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg">
        <div class="max-w-4xl mx-auto flex flex-col items-center gap-6 text-center">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-100 border border-amber-300 text-amber-900 text-xs font-black uppercase tracking-wider">
            <span>Video Testimonials</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black font-heading uppercase text-[#0f274a] leading-tight">
            Our Reviews Do the Talking
          </h2>
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl">
            Hear directly from Middle Tennessee customers about their experience with Armstrong Locksmith's mobile and storefront service, honest pricing, and professional workmanship.
          </p>
          <div class="w-full overflow-hidden rounded-2xl shadow-lg border border-slate-200 aspect-video bg-black mt-2">
            <YouTubeFacade id="DAPmg0fpzf4" title="Armstrong Locksmith Our Reviews in Nashville TN | Our reviews do the talking" />
          </div>
        </div>
      </section>

      <!-- Testimonials Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-white border border-slate-200 border-t-4 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-4">
              "Lost the only smart key to my Audi Q5. The dealership wanted to tow it and said it would take 5 days. Rahim arrived promptly, cut the emergency blade, and had my new smart key programmed right in my driveway. Saved me over $400!"
            </p>
          </div>
          <div class="border-t border-slate-100 pt-3 text-xs text-slate-500">
            <strong class="text-[#0f274a] block font-bold">Marcus T.</strong>
            <span>Brentwood, TN &bull; Audi Key Replacement</span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 border-t-4 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-4">
              "Just bought a new house in Green Hills and needed all the deadbolts rekeyed. Rahim arrived right on time, rekeyed 6 locks to work on a single key, and even reinforced our strike plates with 3-inch screws. Super professional!"
            </p>
          </div>
          <div class="border-t border-slate-100 pt-3 text-xs text-slate-500">
            <strong class="text-[#0f274a] block font-bold">Sarah L.</strong>
            <span>Green Hills, Nashville &bull; Residential Rekey</span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 border-t-4 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-amber-500 text-sm mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-4">
              "Broke the key in my commercial storefront door on a Monday morning. Armstrong Locksmith arrived promptly on-site, extracted the broken key, and re-pinned the Adams Rite mortise cylinder. Fantastic local business!"
            </p>
          </div>
          <div class="border-t border-slate-100 pt-3 text-xs text-slate-500">
            <strong class="text-[#0f274a] block font-bold">David R.</strong>
            <span>The Gulch, Nashville &bull; Commercial Locksmith</span>
          </div>
        </div>

      </div>

    </div>
  </main>
  <script is:inline>
    document.querySelectorAll('[data-yt-facade]').forEach((el) => {
      const activate = () => {
        const id = el.getAttribute('data-yt-facade');
        if (!id || el.querySelector('iframe')) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = el.getAttribute('aria-label') || 'Armstrong Locksmith Customer Video Review';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.className = 'w-full h-full absolute inset-0 border-0';
        el.innerHTML = '';
        el.appendChild(iframe);
      };
      el.addEventListener('click', activate);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    });
  </script>
</Layout>
