---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Customer Reviews & Testimonials | Armstrong Locksmith Nashville";
const seoDescription = "Read verified 5-star customer reviews for Armstrong Locksmith in Nashville, TN. Top-rated for European car keys, quick dispatch, and fair pricing.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/google-reviews/">
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight">Customer Reviews &amp; Testimonials</h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Over 120+ verified 5-star Google reviews from homeowners, commercial property managers, and luxury car owners across Middle Tennessee.
      </p>
    </div>
  </header>
</Layout>