---
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';
const { reviewCount, ratingValue } = await getReviewStats();

const seoTitle = "Armstrong Locksmith Google Reviews | Nashville TN";
const seoDescription = "Read verified customer feedback for Armstrong Locksmith in Nashville, TN. Top-rated for European car keys, quick dispatch, lockouts, and fair pricing.";

const reviewsSchema = [
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "Armstrong Locksmith Our Reviews in Nashville TN | Our reviews do the talking",
    "description": "Watch client reviews and testimonials for Armstrong Locksmith Inc in Nashville, TN, showcasing fast car key replacement, shop walk-in services, and emergency lockouts.",
    "thumbnailUrl": [
      "https://i.ytimg.com/vi/DAPmg0fpzf4/hqdefault.jpg"
    ],
    "uploadDate": "2021-05-10T16:04:45-07:00",
    "embedUrl": "https://www.youtube.com/embed/DAPmg0fpzf4",
    "contentUrl": "https://www.youtube.com/watch?v=DAPmg0fpzf4",
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/google-reviews/" schema={reviewsSchema}>
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">&#9733; 4.9 / 5.0 Star Rating</span>
          <span>&bull;</span>
          <span class="text-slate-300"><span class="arm-review-count">{reviewCount}+</span> Verified Reviews</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">Verified Master Locksmith</span>
        </div>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Customer Reviews &amp; <br />
          <span class="text-amber-400">Testimonials in Nashville</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Read real customer feedback about Armstrong Locksmith Inc in Nashville. From emergency roadside car key origination to home rekeys and commercial storefront security, see why Middle Tennessee drivers and property owners trust Rahim and our team.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a href="https://g.page/r/CQS5BtikwbmqEBM" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-base flex items-center justify-center gap-2.5 shadow-2xl transition active:scale-95 whitespace-nowrap">
            <span>Read All Google Reviews &rarr;</span>
          </a>
          <a href="tel:6156258000" class="px-7 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <span>Call (615) 625-8000</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-8 border border-white/20 shadow-2xl text-white text-center">
        <div class="text-6xl font-black text-amber-400 mb-2">4.9</div>
        <div class="flex justify-center gap-1 text-amber-400 text-2xl mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="text-sm font-bold text-white mb-1">Based on <span class="arm-review-count">{reviewCount}+</span> Google Customer Reviews</p>
        <p class="text-xs text-slate-300">Verified Local Locksmith Storefront &bull; 208 Thompson Ln</p>
      </div>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-[#0a192f] text-white px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">

      <!-- Video Review Feature -->
      <section class="bg-[#10233d] rounded-3xl p-8 sm:p-12 border border-slate-700/80 shadow-2xl">
        <div class="max-w-4xl mx-auto flex flex-col items-center gap-6 text-center">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-amber-400/20 border border-amber-400/30 text-amber-300 text-xs font-black uppercase tracking-wider">
            <span>🎬 Video Testimonials</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black font-heading uppercase text-white leading-tight">
            Our Reviews Do the Talking
          </h2>
          <p class="text-slate-300 text-sm sm:text-base max-w-2xl">
            Hear directly from Middle Tennessee customers about their experience with Armstrong Locksmith's fast mobile dispatch, honest pricing, and professional workmanship.
          </p>
          <div class="w-full overflow-hidden shadow-2xl border border-slate-700 aspect-video bg-black mt-2">
            <YouTubeFacade id="DAPmg0fpzf4" title="Armstrong Locksmith Our Reviews in Nashville TN | Our reviews do the talking" />
          </div>
        </div>
      </section>

      <!-- Testimonials Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700 flex flex-col justify-between">
          <div>
            <div class="text-amber-400 text-sm mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed mb-4">
              "Lost the only smart key to my Audi Q5. The dealership wanted to tow it and said it would take 5 days. Rahim arrived promptly, cut the emergency blade, and had my new smart key programmed right in my driveway. Saved me over $400!"
            </p>
          </div>
          <div class="border-t border-slate-800 pt-3 text-xs text-slate-400">
            <strong class="text-white block font-bold">Marcus T.</strong>
            <span>Brentwood, TN &bull; Audi Key Replacement</span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700 flex flex-col justify-between">
          <div>
            <div class="text-amber-400 text-sm mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed mb-4">
              "Just bought a new house in Green Hills and needed all the deadbolts rekeyed. Rahim arrived right on time, rekeyed 6 locks to work on a single key, and even reinforced our strike plates with 3-inch screws. Super professional!"
            </p>
          </div>
          <div class="border-t border-slate-800 pt-3 text-xs text-slate-400">
            <strong class="text-white block font-bold">Sarah L.</strong>
            <span>Green Hills, Nashville &bull; Residential Rekey</span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700 flex flex-col justify-between">
          <div>
            <div class="text-amber-400 text-sm mb-3">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed mb-4">
              "Broke the key in my commercial storefront door on a Monday morning. Armstrong Locksmith arrived promptly on-site, extracted the broken key, and re-pinned the Adams Rite mortise cylinder. Fantastic local business!"
            </p>
          </div>
          <div class="border-t border-slate-800 pt-3 text-xs text-slate-400">
            <strong class="text-white block font-bold">David R.</strong>
            <span>The Gulch, Nashville &bull; Commercial Locksmith</span>
          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>