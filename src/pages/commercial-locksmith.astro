            <h3 class="font-bold text-[#0f274a] text-base mb-1.5">Commercial Van On-Site</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Our mobile technicians arrive with heavy-duty Adams Rite locks, panic bars, cylinders, and mortise tools.
            </p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm mb-4">3</div>
            <h3 class="font-bold text-[#0f274a] text-base mb-1.5">Testing &amp; Invoicing</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Complete hardware testing, key distribution, and prompt digital itemized invoicing for accounting records.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ==================== COMMERCIAL FAQ ==================== -->
  <section class="py-14 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto">
      
