---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Commercial Locksmith Nashville | Storefront & Master Keys";
const seoDescription = "Commercial door locks, crash exit panic bars, Adams Rite mortise cylinders & master key systems in Nashville, TN. Call (615) 625-8000.";

const commercialSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://armstronglocksmithinc.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Commercial Locksmith",
        "item": "https://armstronglocksmithinc.com/commercial-locksmith/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Commercial Locksmith & Door Hardware Services",
    "serviceType": "Commercial Locksmith",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+16156258000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Downtown Nashville"],
    "description": "Storefront glass door repair, Adams Rite mortise cylinders, UL-listed panic crash bars, master key hierarchies, and access control for Nashville businesses."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How fast can you respond to a business lockout?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our mobile technicians arrive in 15 to 25 minutes across Nashville, Downtown, Franklin, and Antioch to get your staff inside without business interruption."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide commercial invoice billing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we provide itemized receipts and accept corporate cards, digital invoicing, and Net-30 commercial terms for recurring property management accounts."
        }
      }
    ]
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/commercial-locksmith/" schema={commercialSchema}>
  
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-amber-300 w-fit">
          <span>TN License #406 &bull; Real Nashville Commercial Shop</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
          Commercial Locksmith <br />
          <span class="text-amber-400">in Nashville, TN</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          Businesses & Storefronts. Arriving in 20 Minutes or Less. Commercial glass doors, Adams Rite mortise cylinders, panic bars, and master key systems.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center shadow-md transition">
            <span>Book Online</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xl border border-slate-200 text-slate-900">
          <h2 class="text-xl font-bold text-[#0f274a] font-serif pb-3 border-b border-slate-100">
            Commercial Hardware Specialists
          </h2>
          <ul class="flex flex-col gap-2.5 my-4 text-xs sm:text-sm text-slate-700">
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Storefront Glass Doors:</strong> Mortise deadlatches & hookbolts</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Panic Hardware:</strong> Life-safety exit bars & crash bars</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Master Key Hierarchies:</strong> Multi-tenant & office suites</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Electronic Access:</strong> Keypads, card readers & strikes</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </header>

  <!-- Real Commercial Installation Photo Strip -->
  <section class="py-10 bg-slate-50 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md">
        <img 
          src="/images/before-keypad-installation-on-commercial-door.jpg" 
          alt="Commercial Electronic Keypad & Access Control Installation"
          class="w-full h-64 object-cover"
        />
        <div class="p-3 bg-white text-xs font-bold text-[#0f274a] text-center border-t border-slate-100">
          Commercial Keypad Installation on Heavy Aluminum Storefront Door
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xl font-bold text-[#0f274a] font-serif">Commercial Grade 1 Access & Life Safety</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          From retail glass storefronts on Broadway to industrial distribution centers in Antioch, we provide code-compliant panic exit bars, master key charts, and high-security mortise hardware.
        </p>
        <div class="p-3.5 bg-slate-100 border border-slate-200 rounded-xl text-xs text-slate-800 font-medium">
          🏢 <strong>Business Accounts Available:</strong> Same-day emergency response with itemized commercial billing.
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Original WordPress Long-Form Content -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto flex flex-col gap-12 text-slate-800 leading-relaxed text-sm sm:text-base">
      
      <!-- Section 1 -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-4">
          Beyond the "Trunk-Slammer": Expert Commercial Hardware
        </h2>
        <p class="mb-3">
          Commercial door hardware is fundamentally different from residential locks. A failure in an aluminum storefront door, pivot hinge, or exit device can violate fire codes, trap occupants, or leave retail merchandise vulnerable.
        </p>
        <p>
          Armstrong Locksmith maintains fully stocked commercial service vans with Adams Rite mortise cylinders, panic crash bars, Grade 1 cylindrical leversets, and door closers to complete commercial repairs on the first trip.
        </p>
      </div>

      <!-- Section 2: Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card-clean rounded-2xl p-6">
          <h3 class="font-bold text-[#0f274a] text-lg mb-2">Aluminum Storefront Door Repairs</h3>
          <p class="text-xs sm:text-sm text-slate-600">
            We service narrow-stile aluminum doors, replace stripped mortise cylinders, fix misaligned strike plates, and install Adams Rite 4510/4900 deadlatches.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6">
          <h3 class="font-bold text-[#0f274a] text-lg mb-2">Panic Exit Device Installation</h3>
          <p class="text-xs sm:text-sm text-slate-600">
            Ensure fire-safety compliance with UL-listed rim and vertical rod panic exit bars for commercial assembly spaces, restaurants, and retail spaces.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6">
          <h3 class="font-bold text-[#0f274a] text-lg mb-2">Master Key Systems</h3>
          <p class="text-xs sm:text-sm text-slate-600">
            Custom engineered master key charts so property managers carry one master key for all offices while employees only open their specific suite.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6">
          <h3 class="font-bold text-[#0f274a] text-lg mb-2">Electronic Access & Keypads</h3>
          <p class="text-xs sm:text-sm text-slate-600">
            Commercial standalone digital keypad leversets, electric strikes, and keyless access control systems for employee entrances.
          </p>
        </div>
      </div>

      <!-- Section 3: Commercial FAQ -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-6">
          Commercial Locksmith FAQ for Nashville Businesses
        </h2>

        <div class="flex flex-col gap-4">
          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-1">How fast can you respond to a business lockout?</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Our mobile technicians arrive in 15 to 25 minutes across Nashville, Downtown, Franklin, and Antioch to get your staff inside without business interruption.
            </p>
          </div>

          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-1">Do you provide commercial invoice billing?</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Yes, we provide itemized receipts and accept corporate cards, digital invoicing, and Net-30 commercial terms for recurring property management accounts.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0f274a] text-white py-14 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-4">
      <h2 class="text-2xl sm:text-4xl font-bold font-serif text-white">Need Commercial Hardware in Nashville?</h2>
      <p class="text-slate-200 text-sm sm:text-base">Speak directly with our team for honest pricing and rapid commercial dispatch.</p>
      <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
        <a href="tel:6156258000" class="px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base shadow">
          Call (615) 625-8000
        </a>
      </div>
    </div>
  </section>
</Layout>
