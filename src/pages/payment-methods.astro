---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Accepted Payment Methods | Armstrong Locksmith Nashville";
const seoDescription = "Armstrong Locksmith accepts all major credit cards, debit cards, Apple Pay, cash, and corporate invoicing for commercial accounts in Nashville.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/payment-methods/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight">Accepted Payment Methods</h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Convenient, secure payment options for all automotive, residential, and commercial locksmith services.
      </p>
    </div>
  </header>
</Layout>