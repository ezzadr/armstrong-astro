---
import Layout from '../layouts/Layout.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';

const { reviewCount } = await getReviewStats();

const seoTitle = "Payment Methods Accepted | Armstrong Locksmith Nashville";
const seoDescription = `We accept Visa, Mastercard, Amex, Discover, Apple Pay, Cash, Zelle & Venmo at our 208 Thompson Ln shop and mobile vans. Pay only when done. ${reviewCount}+ 5-star reviews.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Payment Methods Accepted at Armstrong Locksmith",
  "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/payment-methods/" schema={schema}>
  
  <!-- Hero Section (Matches Pricing Guide) -->
  <header class="relative bg-showroom text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-5xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 text-xs font-bold text-amber-300 w-fit mb-3 border border-amber-400/20">
        <span>208 Thompson Ln Shop &bull; Mobile Vans &bull; Pay Only When Done</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-heading uppercase text-white tracking-tight leading-tight">
        Payment Methods Accepted <br class="hidden sm:inline" />
        <span class="text-amber-400">at Armstrong Locksmith</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-3 font-normal leading-relaxed">
        Whether you walk into our Nashville shop at 208 Thompson Ln or our mobile locksmith van comes to your car, house, or business, you never pay a penny until the job is finished and you test your new key or lock.
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-slate-700/60 text-xs font-semibold text-slate-300">
        <span class="flex items-center gap-1.5 text-amber-300">
          <span class="text-base">&#10003;</span> Firm Phone Quote Before We Start
        </span>
        <span class="flex items-center gap-1.5 text-amber-300">
          <span class="text-base">&#10003;</span> Pay Only After Testing Your Key or Lock
        </span>
        <span class="flex items-center gap-1.5 text-amber-300">
          <span class="text-base">&#10003;</span> Printed or Digital Receipt Included
        </span>
      </div>
    </div>
  </header>

  <!-- Main Content (Light Slate Shop Design Matching Pricing Page) -->
  <main class="py-12 sm:py-16 bg-slate-50 text-slate-900 px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-5xl mx-auto flex flex-col gap-12">

      <!-- Accepted Payment Methods Grid -->
      <section class="flex flex-col gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 block mb-1">In-Shop &amp; Mobile Van Readers</span>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a]">How You Can Pay</h2>
          <p class="text-slate-600 text-sm mt-1">All our mobile locksmith vans carry wireless card readers, just like our shop counter on Thompson Ln:</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Credit & Debit Cards -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black uppercase font-heading text-[#0f274a]">Credit &amp; Debit Cards</h3>
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We take <strong>Visa, MasterCard, American Express, and Discover</strong> at our shop counter and right at your car or door.
            </p>
          </div>

          <!-- Apple Pay & Google Pay -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black uppercase font-heading text-[#0f274a]">Apple Pay &amp; Google Pay</h3>
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Tap to pay with your iPhone, Apple Watch, or Android phone using the contactless reader at our shop or on our mobile van.
            </p>
          </div>

          <!-- Cash -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black uppercase font-heading text-[#0f274a]">Cash</h3>
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Cash is always welcome at our shop and on mobile service calls once the job is finished and your new key or lock is working.
            </p>
          </div>

          <!-- Zelle -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black uppercase font-heading text-[#0f274a]">Zelle</h3>
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Direct bank-to-bank payment to our verified <strong>Armstrong Locksmith Inc</strong> business account, confirmed on-site by your technician.
            </p>
          </div>

          <!-- Venmo & Cash App -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black uppercase font-heading text-[#0f274a]">Venmo &amp; Cash App</h3>
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect width="6" height="6" x="3" y="3" rx="1"/><rect width="6" height="6" x="15" y="3" rx="1"/><rect width="6" height="6" x="3" y="15" rx="1"/><path d="M15 15h6v6h-6z"/></svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Scan our official company QR code directly from your technician when your key cutting, fob programming, or lock service is complete.
            </p>
          </div>

          <!-- Commercial Invoicing -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col gap-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black uppercase font-heading text-[#0f274a]">Commercial Accounts</h3>
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Itemized invoices and W-9 documentation available for established Nashville property managers, auto shops, and commercial accounts.
            </p>
          </div>
        </div>
      </section>

      <!-- Real Local Trust Section: Why Accepting Credit Cards Matters -->
      <section class="bg-white border-2 border-amber-500/40 rounded-2xl p-6 sm:p-8 shadow-xs">
        <div class="flex flex-col gap-3">
          <span class="text-xs font-black uppercase tracking-wider text-amber-700">Watch Out for the "Cash-Only" Call-Center Scam</span>
          <h2 class="text-xl sm:text-2xl font-bold font-heading font-black uppercase text-[#0f274a]">
            Why Real Locksmiths Gladly Take Credit Cards
          </h2>
          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed">
            One of the biggest red flags in the locksmith industry is an out-of-state dispatch center that quotes "$19" or "$29" on the phone, sends an unmarked car, drills out your working lock, and then demands <strong>$300+ in cash only</strong> so you cannot dispute the charge with your credit card company.
          </p>
          <p class="text-slate-700 text-xs sm:text-sm leading-relaxed">
            At <strong>Armstrong Locksmith Inc</strong>, we have a real brick-and-mortar shop at <strong>208 Thompson Ln</strong> and over <span class="arm-review-count font-bold">{reviewCount}+</span> verified 5-star Google reviews. We give you a firm quote before we start, we gladly accept all major credit cards, and we send you an itemized receipt with every job.
          </p>
        </div>
      </section>

      <!-- Simple 3-Step Process -->
      <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs">
        <h2 class="text-xl sm:text-2xl font-bold font-heading font-black uppercase text-[#0f274a] mb-6">How Billing Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
            <span class="w-7 h-7 rounded-full bg-[#0f274a] text-amber-400 text-xs font-black flex items-center justify-center mb-3">1</span>
            <h3 class="text-sm font-black uppercase font-heading text-[#0f274a] mb-1.5">Upfront Phone Quote</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Tell us your car year/make/model or lock issue and we give you a clear price before we head your way.</p>
          </div>
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
            <span class="w-7 h-7 rounded-full bg-[#0f274a] text-amber-400 text-xs font-black flex items-center justify-center mb-3">2</span>
            <h3 class="text-sm font-black uppercase font-heading text-[#0f274a] mb-1.5">Job Done &amp; Tested First</h3>
            <p class="text-xs text-slate-600 leading-relaxed">We unlock your door, rekey your cylinders, or program your new car key and test it in front of you before you pay.</p>
          </div>
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
            <span class="w-7 h-7 rounded-full bg-[#0f274a] text-amber-400 text-xs font-black flex items-center justify-center mb-3">3</span>
            <h3 class="text-sm font-black uppercase font-heading text-[#0f274a] mb-1.5">Pay &amp; Get Your Receipt</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Pay by card, tap-to-pay, cash, Zelle, or Venmo, and receive an itemized receipt by text, email, or print.</p>
          </div>
        </div>
      </section>

      <!-- Bottom CTA Linking to Price Guide & Direct Phone -->
      <section class="p-6 sm:p-10 rounded-2xl bg-[#0f274a] bg-navy-grid text-white shadow-lg border-t-4 border-amber-500 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-1">Upfront Nashville Locksmith Rates</span>
          <h2 class="text-2xl sm:text-3xl font-black font-heading uppercase text-white mb-2">
            Want to Check Prices First?
          </h2>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
            See our 2026 price guide for car keys, key fobs, lockouts, and home or business rekeying, or call Rahim and the shop directly for an exact quote.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto shrink-0">
          <a href="tel:6156258000" class="px-6 py-3.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider text-center">
            Call (615) 625-8000
          </a>
          <a href="/locksmith-pricing-nashville/" class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-bold text-xs sm:text-sm text-center transition">
            View 2026 Price Guide &rarr;
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
