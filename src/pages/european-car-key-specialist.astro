---
import Layout from '../layouts/Layout.astro';

const seoTitle = "European Car Key Replacement Specialist Nashville | Armstrong Locksmith";
const seoDescription = "Mobile & In-Shop European car key replacement for Nashville, Brentwood, and Franklin. Direct expert service from owner Rahim for BMW, Mercedes, Audi, Land Rover & Bentley. (615) 625-8000.";

const europeanSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://armstronglocksmithinc.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Car Keys",
        "item": "https://armstronglocksmithinc.com/car-key-replacement-nashville/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "European Specialist",
        "item": "https://armstronglocksmithinc.com/european-car-key-specialist/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "European Car Key Replacement & Programming",
    "serviceType": "Automotive Locksmith",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+16156258000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Belle Meade", "Green Hills"],
    "description": "Specialized dealer-level key cutting and programming for BMW (CAS/FEM), Mercedes-Benz (FBS3/FBS4), Audi (BCM2), Land Rover/Jaguar (KVM), and Bentley.",
    "offers": {
      "@type": "Offer",
      "price": "180.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    }
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/european-car-key-specialist/" schema={europeanSchema}>
  
  <!-- Breadcrumb -->
  <nav class="bg-[#0b162a] text-slate-400 py-2.5 px-4 sm:px-8 text-xs border-b border-slate-800" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-amber-400">Home</a>
      <span>&rsaquo;</span>
      <a href="/car-key-replacement-nashville/" class="hover:text-amber-400">Car Keys</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200">European Specialist</span>
    </div>
  </nav>

  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-amber-300 w-fit">
          <span>TN License #406 &bull; Nashville's Local European Specialist</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
          European Car Key <br />
          <span class="text-amber-400">Replacement Specialist</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          Mobile & In-Shop service for Nashville, Brentwood, and Franklin. Direct, expert service from owner Rahim for luxury European vehicles.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call Rahim: (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center shadow-md transition">
            <span>Book Online</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xl border border-slate-200 text-slate-900">
          <h2 class="text-xl font-bold text-[#0f274a] font-serif pb-3 border-b border-slate-100">
            Meet Your Lead Specialist
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 my-4 leading-relaxed">
            Our lead master locksmith Rahim personally handles luxury car key jobs to ensure your vehicle's complex security and immobilizer modules are handled with precision.
          </p>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600">
            📍 <strong>Visit Our Locksmith Shop:</strong> Located at 208 Thompson Ln. We aren't just a van; we are a fully established Nashville locksmith shop equipped with dealer-level technology.
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Real European Vehicle Photo Strip -->
  <section class="py-8 bg-slate-100 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img src="/images/mercedes-Benz_20250627_002342_0000-1-scaled.jpg" alt="Mercedes Benz Chrome Key Nashville" class="w-full h-36 object-cover" />
        <div class="p-2 text-center text-xs font-bold text-[#0f274a]">Mercedes-Benz FBS3 Keys</div>
      </div>
      <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img src="/images/Bmw-key-replacement-in-Brentwood-tn_20250629_163626_0000.jpg" alt="BMW Key Replacement in Brentwood" class="w-full h-36 object-cover" />
        <div class="p-2 text-center text-xs font-bold text-[#0f274a]">BMW FEM/BDC Smart Keys</div>
      </div>
      <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img src="/images/rahim-made-audi-keys-in-nashville-1.png" alt="Audi BCM2 Key Programming" class="w-full h-36 object-cover" />
        <div class="p-2 text-center text-xs font-bold text-[#0f274a]">Audi & VW BCM2 Proximity</div>
      </div>
      <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img src="/images/Maserati-key-cut-and-programmed--scaled.jpg" alt="Maserati and Bentley Luxury Keys" class="w-full h-36 object-cover" />
        <div class="p-2 text-center text-xs font-bold text-[#0f274a]">Maserati & Bentley Keys</div>
      </div>
    </div>
  </section>

  <!-- Complete Original WordPress Long-Form Content -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto flex flex-col gap-10 text-slate-800 leading-relaxed text-sm sm:text-base">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="card-clean rounded-2xl p-6">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">
            <a href="/bmw/" class="hover:text-amber-600 underline">BMW & Mini Cooper</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Avoid the Green Hills dealership wait. We provide same-day key replacement for all modern BMW models (CAS1-CAS4, FEM/BDC) and can have you driving again today.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">
            <a href="/audi-car-keys/" class="hover:text-amber-600 underline">Audi & Volkswagen</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            We handle high-security Audi and VW keys on-site in Nashville, including BCM2 smart keys and flip remotes for sedans and SUVs like the VW Atlas.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">
            <a href="/mercedes-benz/" class="hover:text-amber-600 underline">Mercedes-Benz & Sprinter</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            We stock Mercedes fobs locally to ensure you get same-day service for sedans, coupes, SUVs, and Sprinter vans while the dealer is still ordering parts from Germany.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">
            <a href="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/" class="hover:text-amber-600 underline">Range Rover & Jaguar</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Specializing in modern Range Rover and Jaguar security systems, we program on-the-spot keys for Defenders, Discoveries, Evoques, and Jaguars.
          </p>
        </div>

        <div class="card-clean rounded-2xl p-6 md:col-span-2">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">
            <a href="/bentley-key-replacement/" class="hover:text-amber-600 underline">Maserati, Bentley & Volvo</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            We bring specialized luxury care to your doorstep, from Maserati Ghibli smart keys to Bentley Continental GT fobs and Volvo PIN reading across Middle Tennessee.
          </p>
        </div>

      </div>

      <!-- Why Nashville Chooses Armstrong Section -->
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-6">
          Why Nashville Chooses Armstrong
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs sm:text-sm text-slate-700">
          <div>
            <h4 class="font-bold text-[#0f274a] text-base mb-1">Local Owner-Operated</h4>
            <p class="text-slate-600">No call centers. Deal directly with our owner-operated team for expert service and personalized care.</p>
          </div>
          <div>
            <h4 class="font-bold text-[#0f274a] text-base mb-1">Established Location</h4>
            <p class="text-slate-600">Unlike "phantom" locksmiths, we have a real locksmith shop you can visit at 208 Thompson Ln.</p>
          </div>
          <div>
            <h4 class="font-bold text-[#0f274a] text-base mb-1">Dealer-Level Tech</h4>
            <p class="text-slate-600">We use the exact same key quality as the dealership but without the 7-to-14 day wait times.</p>
          </div>
        </div>
      </div>

      <!-- Contextual Internal Linking Silo Box -->
      <div class="p-6 rounded-2xl bg-amber-50/60 border border-amber-200">
        <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Related Automotive Locksmith Guides</h3>
        <p class="text-xs text-slate-600 mb-3">Explore our specific brand key guides and upfront price estimates:</p>
        <div class="flex flex-wrap gap-2 text-xs font-bold">
          <a href="/bmw/" class="px-3 py-1.5 rounded-lg bg-white border border-amber-200 text-[#0f274a] hover:bg-amber-100">BMW Keys &rarr;</a>
          <a href="/mercedes-benz/" class="px-3 py-1.5 rounded-lg bg-white border border-amber-200 text-[#0f274a] hover:bg-amber-100">Mercedes Keys &rarr;</a>
          <a href="/audi-car-keys/" class="px-3 py-1.5 rounded-lg bg-white border border-amber-200 text-[#0f274a] hover:bg-amber-100">Audi Keys &rarr;</a>
          <a href="/dealer-key/" class="px-3 py-1.5 rounded-lg bg-white border border-amber-200 text-[#0f274a] hover:bg-amber-100">OEM Dealer Key Alternative &rarr;</a>
          <a href="/locksmith-pricing-nashville/" class="px-3 py-1.5 rounded-lg bg-white border border-amber-200 text-[#0f274a] hover:bg-amber-100">Price Guide &rarr;</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0f274a] text-white py-14 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-4">
