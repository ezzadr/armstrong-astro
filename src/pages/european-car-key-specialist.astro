---
import Layout from '../layouts/Layout.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "European Car Key Specialist Nashville | BMW, Audi, Mercedes";
const seoDescription = "Dealer-level key cutting & programming for BMW, Mercedes, Audi, Land Rover & Bentley in Nashville, TN. Same-day service. (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/european-car-key-specialist/">
  
  <!-- Hero Section -->
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-3">
        <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30">Luxury European Specialist</span>
        <span>&bull;</span>
        <span>Certified & Insured</span>
        <span>&bull;</span>
        <span>Storefront &amp; Mobile</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        European Car Key Specialist <br />
        <span class="text-amber-400">BMW, Mercedes, Audi, Range Rover & Porsche</span>
      </h1>

      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-3xl mt-4 font-normal leading-relaxed">
        Skip the dealership delays and high towing costs. We cut and program luxury European smart proximity keys on-site across Middle Tennessee.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-7">
        <a 
          href="tel:6156258000" 
          class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-lg transition active:scale-95 whitespace-nowrap"
        >
          <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>

        <a 
          href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 whitespace-nowrap"
        >
          <span>Book Online Appointment</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Quick Key Takeaways Bar -->
  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⚡</span>
        <div><strong class="block text-slate-900 font-bold">Same-Day Mobile Dispatch</strong><span class="text-slate-500 text-[11px]">Mobile unit to your location</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⚡</span>
        <div><strong class="block text-slate-900 font-bold">208 Thompson Ln</strong><span class="text-slate-500 text-[11px]">Nashville physical shop</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⚡</span>
        <div><strong class="block text-emerald-800 font-bold">Save $300-$800</strong><span class="text-slate-500 text-[11px]">vs Dealership Charges</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">🛡️</span>
        <div><strong class="block text-slate-900 font-bold">Certified & Insured</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Video Showcase Section (If video exists) -->
      
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold w-fit">
            <span>🎬</span> Live Nashville Demonstration
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] leading-tight">
            Dealer-Level European Key Programming in Nashville
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Watch how Rahim uses specialized European diagnostic platforms (Autohex, IM608 Pro, ACDP) to program luxury vehicle keys on-site in on-site with precision tools.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-bold text-slate-700">
            <span class="bg-slate-100 text-slate-800 px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 border border-slate-200"><svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>No Tow Truck Needed</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; OEM-Quality Parts</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; In-House Programming</span>
          </div>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-300 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/fvXPHQIMAOo" 
            title="Dealer-Level European Key Programming in Nashville" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>
      
      <!-- Interactive European Car Key Estimator -->
      <CarKeyEstimator 
        defaultMake="BMW" 
        title="Luxury European Key Estimator & Fitment Guide" 
        subtitle="Select your European vehicle make, year range, and situation to check instant key programming compatibility and dealership savings in Nashville." 
      />

      <!-- Services Grid -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
              <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">BMW CAS, FEM & BDC Sync</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Dealer-grade diagnostic computers program Comfort Access keys without towing.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-4 block">Fast On-Site Service &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Mercedes FBS3 & FBS4 Fobs</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Smart infrared chrome keys and EIS electronic ignition programming.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-4 block">Fast On-Site Service &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
              <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Audi & VW MQB / BCM2</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Proximity push-to-start smart keys and steering column lock repair.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-4 block">Fast On-Site Service &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
              <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Range Rover & Land Rover KVM</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">KVM module key writing for 2015+ models without replacing modules.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-4 block">Fast On-Site Service &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
              <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Porsche KESSY & BCM</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">911, Cayenne, Macan, Panamera, and Boxster key origination from scratch.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-4 block">Fast On-Site Service &rarr;</span>
          </div>
        
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
              <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Bentley & Maserati</h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Continental GT, Ghibli, and Levante key cutting and immobilizer programming.</p>
            </div>
            <span class="text-xs font-bold text-amber-600 mt-4 block">Fast On-Site Service &rarr;</span>
          </div>
        
      </section>

      <!-- Supported Models / Coverage -->
      
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">Coverage</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-4">
          European Brands We Service Daily
        </h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-3xl mb-8 leading-relaxed">
          Our fully equipped mobile vans carry OEM and premium aftermarket keys, high-security laser blanks, and dealer-level programming tablets for the following vehicles:
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>BMW (All Chassis)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Mercedes-Benz</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Audi (MQB & BCM2)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Land Rover / Range Rover</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Porsche (911, Macan, Cayenne)</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Bentley</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Maserati</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Volkswagen</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Volvo</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Jaguar</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>MINI Cooper</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300"><svg class="w-3 h-3 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></span>
              <span>Alfa Romeo</span>
            </div>
          
        </div>
      </section>
      

      <!-- 4-Step Process -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">How It Works</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Our 4-Step On-Site Service Process
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0f274a] bg-navy-grid text-white flex items-center justify-center font-bold text-sm">1</span>
              <h4 class="font-bold text-[#0f274a] text-base">Security Module Interfacing</h4>
              <p class="text-xs text-slate-600 leading-relaxed">We connect directly to the vehicle OBD2 port or bench programmer.</p>
            </div>
          
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0f274a] bg-navy-grid text-white flex items-center justify-center font-bold text-sm">2</span>
              <h4 class="font-bold text-[#0f274a] text-base">Security Certificate Pull</h4>
              <p class="text-xs text-slate-600 leading-relaxed">We extract the encrypted immobilizer data safely.</p>
            </div>
          
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0f274a] bg-navy-grid text-white flex items-center justify-center font-bold text-sm">3</span>
              <h4 class="font-bold text-[#0f274a] text-base">Precision CNC Laser Cut</h4>
              <p class="text-xs text-slate-600 leading-relaxed">We laser-cut the emergency mechanical insert blade.</p>
            </div>
          
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
              <span class="w-8 h-8 rounded-full bg-[#0f274a] bg-navy-grid text-white flex items-center justify-center font-bold text-sm">4</span>
              <h4 class="font-bold text-[#0f274a] text-base">Key Generation & Sync</h4>
              <p class="text-xs text-slate-600 leading-relaxed">We pair the new smart key and erase lost keys from memory.</p>
            </div>
          
        </div>
      </section>

      <!-- Comparison Table -->
      
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm overflow-hidden">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Dealership Solution vs. Armstrong Locksmith
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 bg-slate-50">
