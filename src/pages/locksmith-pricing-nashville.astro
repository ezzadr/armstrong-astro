---

<Layout title={seoTitle} description={seoDescription} canonical="/locksmith-pricing-nashville/" schema={pricingSchema}>
  
  <!-- Premium Hero Header -->
  <header class="relative bg-showroom text-white py-12 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-6">
      
      <!-- Top Trust Pills -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
        <span class="px-3.5 py-1 bg-amber-400/20 border border-amber-400/30 text-amber-300">
          🛡️ Upfront Firm Pricing &bull; Zero Hidden Fees
        </span>
        <span class="hidden sm:inline text-slate-400">&bull;</span>
        <span class="hidden sm:inline text-slate-300">Physical Storefront: 208 Thompson Ln</span>
        <span class="text-slate-400">&bull;</span>
        <span class="text-emerald-400 font-semibold">&#9733; 4.9 Stars (775+ Reviews)</span>
      </div>

      <!-- Main Headline -->
      <div class="max-w-4xl">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading uppercase text-white tracking-tight leading-tight">
          Nashville Locksmith <br />
          <span class="text-amber-400">Pricing &amp; Rates Guide</span>
        </h1>
        <p class="text-slate-200 text-sm sm:text-base lg:text-lg mt-3 font-normal leading-relaxed">
          Transparent, upfront pricing from a trusted local business. Compare our low starting rates with expensive dealership markups and out-of-state call center bait-and-switch ads.
        </p>
      </div>

      <!-- Dual Service Channels (In-Shop vs Mobile) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        
        <!-- Channel 1: In-Shop Storefront (Save the Fee) -->
        <div class="p-6 bg-[#10233d]/90 border-2 border-emerald-500/50 shadow-xl flex flex-col justify-between gap-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-emerald-500 text-slate-950 text-[10px] font-black uppercase px-3 py-1 tracking-wider">
            Most Economical
          </div>
          <div>
            <div class="flex items-center gap-2.5 text-emerald-400 font-bold text-xs uppercase tracking-wider mb-2">
              <span>🏪 Walk-In Shop Service</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl sm:text-4xl font-black text-white font-heading">$0</span>
              <span class="text-xs font-bold uppercase text-emerald-300 tracking-wider">Service Call Fee</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
              Drive your car directly to our shop or bring your door lock cylinders. You pay <strong>only for keys, programming, or parts</strong> with zero trip charges.
            </p>
            <div class="text-xs text-slate-400 mt-3 space-y-1">
              <p>📍 <strong>208 Thompson Ln, Nashville, TN 37211</strong></p>
              <p>⏰ Mon–Fri 8AM–6PM &bull; Sat 10AM–4PM</p>
            </div>
          </div>
          <a href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" target="_blank" rel="noopener noreferrer" class="w-full py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs uppercase tracking-wider text-center transition flex items-center justify-center gap-2">
            <span>Get Directions to Shop &rarr;</span>
          </a>
        </div>

        <!-- Channel 2: Mobile Van Dispatch -->
        <div class="p-6 bg-[#10233d]/90 border-2 border-amber-500/50 shadow-xl flex flex-col justify-between gap-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] font-black uppercase px-3 py-1 tracking-wider">
            We Come to You
          </div>
          <div>
            <div class="flex items-center gap-2.5 text-amber-300 font-bold text-xs uppercase tracking-wider mb-2">
              <span>🚐 Mobile Van Dispatch</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl sm:text-3xl font-black text-white font-heading">On-Site Service</span>
              <span class="text-xs font-bold uppercase text-amber-300 tracking-wider">Distance &amp; Time Based</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
              Fully equipped mobile workshop on wheels arrives at your home, driveway, office, or roadside. Service call rates depend on your location/distance and the time of call.
            </p>
            <div class="text-xs text-slate-400 mt-3 space-y-1">
              <p>⚡ <strong>Firm total confirmed by phone before dispatch</strong></p>
              <p>⏰ Mobile Hours: Mon–Fri 8AM–11:30PM</p>
            </div>
          </div>
          <a href="tel:6156258000" class="w-full py-3 bg-gold-metallic hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider text-center shadow-lg transition flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call for Upfront Quote: (615) 625-8000</span>
          </a>
        </div>

      </div>

    </div>
  </header>

  <!-- Interactive Filter & Live Search Section -->
  <section id="pricing-directory" class="py-8 bg-slate-900 text-white px-4 sm:px-6 lg:px-8 border-b border-slate-800 sticky top-0 z-30 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      
      <!-- Category Tabs (Horizontal scroll on mobile) -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 scrollbar-none text-xs font-bold" id="category-tab-bar" role="tablist">
        {serviceCategories.map((cat, idx) => (
          <button
            type="button"
            data-cat={cat.id}
            class={`category-tab px-3.5 py-2.5 whitespace-nowrap border text-xs font-black uppercase tracking-wider transition ${
              idx === 0 
                ? 'bg-amber-500 text-slate-950 border-amber-500 shadow-sm active-tab' 
                : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700 hover:text-white'
            }`}
          >
            <span>{cat.icon}</span>
            <span class="ml-1.5">{cat.label}</span>
          </button>
        ))}
      </div>

      <!-- Live Search Box -->
      <div class="relative min-w-[260px] sm:min-w-[320px]">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <input 
          type="text" 
          id="price-search-input" 
          placeholder="Filter pricing (e.g. BMW, rekey, lockout, fob)..." 
          class="w-full pl-10 pr-9 py-2.5 bg-slate-950 text-white placeholder-slate-400 text-xs sm:text-sm border border-slate-700 focus:border-amber-400 focus:outline-none transition"
        />
        <button 
          type="button" 
          id="clear-search-btn" 
          class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-white text-xs font-bold"
          aria-label="Clear filter"
        >
          &times;
        </button>
      </div>

    </div>

    <!-- Live Counter -->
    <div class="max-w-7xl mx-auto mt-3 flex items-center justify-between text-[11px] text-slate-400 font-medium">
      <div id="results-count">
        Showing all <span class="font-bold text-amber-400">24</span> transparent service prices
      </div>
      <div class="hidden sm:block text-slate-400">
        💡 Tap any service to call or view breakdown
      </div>
    </div>
  </section>

  <!-- Service Pricing Directory Cards (Mobile-First) -->
  <main class="py-12 sm:py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto">
      
      <!-- Responsive Pricing Card Grid -->
      <div id="pricing-card-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {pricingItems.map((item) => (
          <div 
            class="pricing-item-card bg-white border border-slate-200 hover:border-amber-500 shadow-sm hover:shadow-xl transition-all duration-200 flex flex-col justify-between p-5 sm:p-6 group relative"
            data-category={item.category}
            data-title={item.title.toLowerCase()}
            data-details={item.details.toLowerCase()}
            data-badge={item.badge.toLowerCase()}
          >
            {item.popular && (
              <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] font-black uppercase px-2.5 py-0.5 tracking-wider">
                Popular
              </div>
            )}
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="text-[11px] font-black uppercase tracking-wider text-slate-500 bg-slate-100 px-2.5 py-1 border border-slate-200">
                  {item.categoryLabel}
                </span>
                <span class="text-[11px] font-bold text-amber-700">
                  {item.badge}
                </span>
              </div>

              <h3 class="text-base sm:text-lg font-bold text-[#0f274a] font-heading uppercase leading-snug group-hover:text-amber-600 transition-colors">
                {item.title}
              </h3>

              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                {item.details}
