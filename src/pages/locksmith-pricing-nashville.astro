---
import Layout from '../layouts/Layout.astro';
import ServiceReviews from '../components/ServiceReviews.astro';

const seoTitle = "2026 Locksmith Pricing Nashville | No Hidden Fees | Armstrong";
const seoDescription = "Transparent Nashville locksmith prices for car keys, house rekeys, business locks & emergency lockouts. Real shop at 208 Thompson Ln. (615) 625-8000.";

const autoPricing = [
  {
    name: "Emergency Car Lockout (Standard Vehicles)",
    price: "$65+",
    badge: "Damage-Free Entry",
    note: "Gentle vehicle entry using soft vinyl air wedges and specialized bypass tools. Zero scratch guarantee."
  },
  {
    name: "Emergency Car Lockout (Luxury / High-Security)",
    price: "$85+",
    badge: "BMW / Audi / Benz / Lexus",
    note: "Decoded directly through the keyhole with German-made Lishi decoders. Bypasses double-locks."
  },
  {
    name: "Standard Non-Chip Metal Key Duplicate",
    price: "$35+",
    badge: "In-Shop or On-Site",
    note: "Single and double-sided mechanical keys cut on factory-calibrated key duplicators."
  },
  {
    name: "Transponder / Chipped Key Cut & Programmed",
    price: "$95+",
    badge: "Domestic & Asian",
    note: "Laser-cut key blade with embedded RFID chip synchronized to vehicle immobilizer on-site."
  },
  {
    name: "Remote Head Key (Cut & Programmed)",
    price: "$120+",
    badge: "Integrated Fob",
    note: "Integrated mechanical key blade and lock/unlock/trunk remote transmitter fully programmed."
  },
  {
    name: "Smart Proximity Push-to-Start Fob",
    price: "$145+",
    badge: "OEM & Aftermarket",
    note: "Smart keyless access fob pairing, proximity start programming, and emergency slide-out key cut."
  },
  {
    name: "European Car Key Specialist",
    price: "$180+",
    badge: "Dealer Alternative",
    note: "BMW (CAS/FEM/BDC), Mercedes-Benz (EIS/FBS3/FBS4), Audi, Land Rover, Porsche, Bentley key generation."
  },
  {
    name: "All Keys Lost (Originated at Vehicle)",
    price: "$165+",
    badge: "Full On-Site Solution",
    note: "No existing key required. Lock cylinder decoded, factory laser key cut to code, and ECU reprogrammed on the spot."
  },
  {
    name: "Broken Key Extraction from Lock or Ignition",
    price: "$75+",
    badge: "Clean Extraction",
    note: "Broken blade removal without damaging internal wafers, plus an on-site fresh replacement key cut."
  },
  {
    name: "Ignition Cylinder Repair / Replacement",
    price: "$140+",
    badge: "Parts & Labor",
    note: "Repairing stuck ignitions, rebuilding internal wafers, or installing new OEM ignition matched to your existing key."
  }
];

const residentialPricing = [
  {
    name: "Emergency House Lockout",
    price: "$85+",
    badge: "Damage-Free Picking",
    note: "Clean lock picking and latch bypass for deadbolts and entry doorknobs with zero door or frame damage."
  },
  {
    name: "Standard Lock Rekeying (Per Cylinder)",
    price: "$20 – $45",
    badge: "Most Popular",
    note: "Internal brass tumbler pins replaced to fit a brand-new key. Renders all previous lost or contractor keys useless."
  },
  {
    name: "High-Security Deadbolt Rekeying",
    price: "$45 – $65",
    badge: "Commercial Grade",
    note: "Rekeying Medeco, Mul-T-Lock, Schlage Primus, and restricted pick-resistant cylinders."
  },
  {
    name: "Deadbolt or Doorknob Replacement & Install",
    price: "$65 + Parts",
    badge: "Hardware Upgrade",
    note: "Professional installation and alignment of new Schlage, Kwikset, Yale, or Baldwin deadbolts."
  },
  {
    name: "Fresh Door Hole Drilling & Mortise Prep",
    price: "$75+",
    badge: "New Deadbolt Addition",
    note: "Template drilling and chisel mortising to add a brand-new deadbolt to an unprepared wooden or metal door."
  },
  {
    name: "Electronic Keypad & Smart Lock Installation",
    price: "$95+",
    badge: "Keyless Entry",
    note: "Mounting, door alignment, throw adjustment, and smartphone/Wi-Fi code setup for consumer smart locks."
  },
  {
    name: "Reinforced Security Strike Plate Installation",
    price: "$45+",
    badge: "Kick-In Defense",
    note: "Heavy-gauge steel strike plate anchored with 3-inch hardened steel screws directly into the wall framing stud."
  },
  {
    name: "Residential Master Key System Setup",
    price: "$65 + Rekey",
    badge: "Multi-Door Convenience",
    note: "Configure a single master key to open all house deadbolts while maintaining separate keys for tenant suites or guest rooms."
  }
];

const commercialPricing = [
  {
    name: "Emergency Commercial Business Lockout",
    price: "$125+",
    badge: "Storefront & Office",
    note: "Rapid mobile access for retail storefronts, office suites, mortise cylinders, and commercial aluminum doors."
  },
  {
    name: "Adams Rite Storefront Cylinder Rekeying",
    price: "$45 – $75",
    badge: "Retail Standard",
    note: "Rekeying aluminum glass storefront mortise cylinders after employee turnover or management transitions."
  },
  {
    name: "Commercial Storefront Lock Replacement",
    price: "$165 + Parts",
    badge: "Complete Lockbody",
    note: "Replacing worn hookbolt, maximum security deadlatch, or mortise cylinder on commercial glass entry doors."
  },
  {
    name: "Panic Exit Crash Bar Installation",
    price: "$285 + Parts",
    badge: "UL & Life Safety Code",
    note: "Installation and latch alignment of commercial rim exit devices and fire-rated panic push bars."
  },
  {
    name: "Commercial Grade 1 Heavy-Duty Leverset",
    price: "$125 + Parts",
    badge: "ADA Compliant",
    note: "High-traffic commercial cylindrical leversets engineered for heavy daily commercial use."
  },
  {
    name: "Master Key Hierarchy Charting & Setup",
    price: "$150 + Cylinders",
    badge: "Facility Management",
    note: "Complete key hierarchy architecture (Great Grandmaster, Master, Sub-Master, and Individual Tenant keys)."
  },
  {
    name: "Commercial Hydraulic Door Closer Install",
    price: "$175 + Parts",
    badge: "Controlled Closing",
    note: "Mounting commercial surface closers with dual-valve closing speed and latching power adjustment."
  }
];

const offerCatalogItems = [...autoPricing, ...residentialPricing, ...commercialPricing].map(item => {
  const match = item.price.match(/\d+/);
  return {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": item.name,
      "description": item.note
    },
    "price": match ? match[0] : "65",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://armstronglocksmithinc.com/locksmith-pricing-nashville/"
  };
});

// Rich Schema: BreadcrumbList + Locksmith OfferCatalog (All 25 Services) + FAQPage
const pricingSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://armstronglocksmithinc.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Locksmith Pricing",
        "item": "https://armstronglocksmithinc.com/locksmith-pricing-nashville/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Locksmith",
    "@id": "https://armstronglocksmithinc.com/#locksmith",
    "name": "Armstrong Locksmith Inc",
    "image": "https://armstronglocksmithinc.com/shop.jpeg",
    "telephone": "+1-615-625-8000",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "208 Thompson Ln",
      "addressLocality": "Nashville",
      "addressRegion": "TN",
      "postalCode": "37211",
      "addressCountry": "US"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Transparent Nashville Locksmith Pricing",
      "itemListElement": offerCatalogItems
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why do your prices say 'starting at'?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every vehicle year, key technology, and lock manufacturer is unique. A 2005 Ford key requires a basic mechanical cut and transponder chip, while a 2024 BMW requires high-security encrypted immobilizer pairing. When you call us, we ask for your vehicle year, make, and model to give you an exact, firm total quote before dispatching."
        }
      },
      {
        "@type": "Question",
        "name": "How does your service call fee work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you visit our physical storefront at 208 Thompson Ln, there is a $0 service call fee—you pay only for keys, cutting, and hardware. For mobile on-site service, our service call fee varies depending on your travel distance from our shop and the time of call (standard hours vs. late night/weekend emergency). We provide an exact, firm total quote over the phone before dispatching our van."
        }
      },
      {
        "@type": "Question",
        "name": "How does your pricing compare to the car dealership?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dealerships often charge $400 to $900+ for replacement smart keys, require you to pay $100–$200 for flatbed towing, and make you wait 5 to 10 business days for key delivery. Armstrong Locksmith comes directly to your driveway or parking spot with dealer-level diagnostic equipment, saving you 40% to 60% with same-day on-site delivery."
        }
      },
      {
        "@type": "Question",
        "name": "How can I avoid cheap '$15 locksmith' scams in Nashville?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Out-of-state call centers place Google Ads advertising fake '$15' or '$19' service fees. Once on-site, untrained subcontractors drill out working locks and bill victims $250 to $450. Always verify a real physical Nashville address (like our shop at 208 Thompson Ln) and insist on a firm phone total before dispatch."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide written or firm estimates before starting work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, 100%. We provide upfront pricing over the phone and confirm all costs in person before touching your vehicle or locks. There are never surprise fees or hidden add-ons."
        }
      },
      {
        "@type": "Question",
        "name": "What payment methods do you accept?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We accept all major credit cards (Visa, MasterCard, American Express, Discover), Apple Pay, Google Pay, debit cards, cash, and commercial invoicing for approved business accounts."
        }
      }
    ]
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/locksmith-pricing-nashville/" schema={pricingSchema} breadcrumb={false}>

  <!-- Hero Section -->
  <header class="relative bg-showroom text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-5xl mx-auto text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 text-xs font-bold text-amber-300 w-fit mb-3 border border-amber-400/20">
        <span>Upfront Estimates &bull; Zero Hidden Fees &bull; Certified &amp; Insured</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black font-heading uppercase text-white tracking-tight leading-tight">
        Nashville Locksmith <br class="hidden sm:inline" />
        <span class="text-amber-400">Pricing Guide (2026)</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-3 font-normal leading-relaxed">
        Honest, straightforward rates from our physical shop at 208 Thompson Ln. We quote your exact, firm total over the phone before dispatching.
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-slate-700/60 text-xs font-semibold text-slate-300">
        <span class="flex items-center gap-1.5 text-amber-300">
          <span class="text-base">&#10003;</span> Firm Quotes Before Van Dispatch
        </span>
        <span class="flex items-center gap-1.5 text-amber-300">
          <span class="text-base">&#10003;</span> $0 Dispatch Fee for In-Store Walk-Ins
        </span>
        <span class="flex items-center gap-1.5 text-amber-300">
          <span class="text-base">&#10003;</span> 100% Damage-Free Guarantee
        </span>
      </div>
    </div>
  </header>

  <!-- Quick Starting Prices Bar (Clean 5-Item Grid) -->
  <section class="py-8 sm:py-10 bg-slate-100 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-base sm:text-lg font-bold text-[#0f274a] font-heading uppercase tracking-wide">
          Quick Rate Overview
        </h2>
        <span class="text-xs font-bold text-slate-500">Starting Prices</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 text-left">
        <div class="p-4 bg-white border border-slate-200 border-t-2 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Auto</span>
            <strong class="text-sm font-bold text-slate-800 block mt-0.5">Car Lockout</strong>
            <span class="text-[11px] text-slate-500 block mt-1">Damage-free entry</span>
          </div>
          <span class="text-2xl font-black text-[#0f274a] font-heading mt-3 block">$65+</span>
        </div>

        <div class="p-4 bg-white border border-slate-200 border-t-2 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Key Cut</span>
            <strong class="text-sm font-bold text-slate-800 block mt-0.5">Transponder Key</strong>
            <span class="text-[11px] text-slate-500 block mt-1">Cut &amp; programmed</span>
          </div>
          <span class="text-2xl font-black text-amber-600 font-heading mt-3 block">$95+</span>
        </div>

        <div class="p-4 bg-white border border-slate-200 border-t-2 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Home</span>
            <strong class="text-sm font-bold text-slate-800 block mt-0.5">House Lockout</strong>
            <span class="text-[11px] text-slate-500 block mt-1">Clean lock picking</span>
          </div>
          <span class="text-2xl font-black text-[#0f274a] font-heading mt-3 block">$85+</span>
        </div>

        <div class="p-4 bg-white border border-slate-200 border-t-2 border-t-amber-500 shadow-sm flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Security</span>
            <strong class="text-sm font-bold text-slate-800 block mt-0.5">Lock Rekeying</strong>
            <span class="text-[11px] text-slate-500 block mt-1">Per lock cylinder</span>
          </div>
          <span class="text-2xl font-black text-amber-600 font-heading mt-3 block">$20–$45</span>
        </div>

        <div class="p-4 bg-white border border-slate-200 border-t-2 border-t-amber-500 shadow-sm col-span-2 sm:col-span-1 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Business</span>
            <strong class="text-sm font-bold text-slate-800 block mt-0.5">Storefront Lockout</strong>
            <span class="text-[11px] text-slate-500 block mt-1">Commercial entry</span>
          </div>
          <span class="text-2xl font-black text-emerald-700 font-heading mt-3 block">$125+</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Call & Transparency Notice Box -->
  <section class="py-8 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto">
      <div class="border border-amber-300 bg-amber-50/60 p-5 sm:p-6 text-slate-800">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-amber-200/80">
          <div>
            <span class="inline-block text-[11px] font-extrabold uppercase tracking-wider text-amber-800 bg-amber-200/60 px-2 py-0.5 mb-1">
              Clear Pricing Policy
            </span>
            <h2 class="text-lg sm:text-xl font-bold font-heading uppercase text-[#0f274a]">
              How Our Service Call &amp; Dispatch Pricing Works
            </h2>
          </div>
          <a href="tel:6156258000" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0f274a] hover:bg-[#14325a] text-white text-xs font-bold uppercase tracking-wider shrink-0 transition">
            <span>Call For Exact Quote</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-4 text-xs sm:text-sm leading-relaxed text-slate-700">
          <div class="flex items-start gap-3">
            <span class="text-lg text-emerald-600 shrink-0 mt-0.5">&#10003;</span>
            <div>
              <strong class="text-slate-900 block font-bold">In-Shop Walk-In ($0 Service Call):</strong>
              Bring your vehicle, keys, or loose lock cylinders directly to our physical storefront at <strong>208 Thompson Ln, Nashville, TN 37211</strong>. There is never a service call or travel fee in the shop—you pay only for the key cutting, fob programming, or rekeying service.
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-lg text-amber-600 shrink-0 mt-0.5">&#10003;</span>
            <div>
              <strong class="text-slate-900 block font-bold">Mobile On-Site Dispatch (Distance &amp; Time-Based):</strong>
              When you need our fully equipped mobile locksmith van dispatched to your driveway, business, or roadside location, our service call rate adjusts fairly based on your exact travel distance and the time of call (standard daytime vs. late-night or weekend emergency). We give you a firm total before dispatching.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Organized Rate Sections -->
  <main class="py-12 sm:py-16 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-12">

      <!-- SECTION 1: Automotive Locksmith Pricing -->
      <section id="automotive-rates">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-3 border-b-2 border-[#0f274a] mb-4">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600">Category 01</span>
            <h2 class="text-xl sm:text-2xl font-bold font-heading uppercase text-[#0f274a]">
              Automotive Locksmith Pricing
            </h2>
          </div>
          <span class="text-xs text-slate-500 font-medium">On-site mobile vans &bull; In-shop key cutting</span>
        </div>

        <div class="border border-slate-200 bg-white divide-y divide-slate-100 shadow-sm">
          {autoPricing.map((item) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/80 transition">
              <div class="space-y-1 sm:max-w-2xl">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-bold text-slate-900 text-sm sm:text-base">{item.name}</h3>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-slate-100 text-slate-700 border border-slate-200">
                    {item.badge}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.note}</p>
              </div>
              <div class="text-left sm:text-right shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 flex sm:flex-col justify-between items-center sm:items-end">
                <span class="text-xl sm:text-2xl font-black font-heading text-[#0f274a]">{item.price}</span>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Starting Price</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 2: Residential Locksmith Pricing -->
      <section id="residential-rates">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-3 border-b-2 border-[#0f274a] mb-4">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600">Category 02</span>
            <h2 class="text-xl sm:text-2xl font-bold font-heading uppercase text-[#0f274a]">
              Residential Locksmith Pricing
            </h2>
          </div>
          <span class="text-xs text-slate-500 font-medium">Home rekeying &bull; Lockouts &bull; Hardware installation</span>
        </div>

        <div class="border border-slate-200 bg-white divide-y divide-slate-100 shadow-sm">
          {residentialPricing.map((item) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/80 transition">
              <div class="space-y-1 sm:max-w-2xl">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-bold text-slate-900 text-sm sm:text-base">{item.name}</h3>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-slate-100 text-slate-700 border border-slate-200">
                    {item.badge}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.note}</p>
              </div>
              <div class="text-left sm:text-right shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 flex sm:flex-col justify-between items-center sm:items-end">
                <span class="text-xl sm:text-2xl font-black font-heading text-[#0f274a]">{item.price}</span>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Starting Price</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 3: Commercial Locksmith Pricing -->
      <section id="commercial-rates">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-3 border-b-2 border-[#0f274a] mb-4">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600">Category 03</span>
            <h2 class="text-xl sm:text-2xl font-bold font-heading uppercase text-[#0f274a]">
              Commercial Locksmith Pricing
            </h2>
          </div>
          <span class="text-xs text-slate-500 font-medium">Business storefronts &bull; Panic hardware &bull; Master keys</span>
        </div>

        <div class="border border-slate-200 bg-white divide-y divide-slate-100 shadow-sm">
          {commercialPricing.map((item) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/80 transition">
              <div class="space-y-1 sm:max-w-2xl">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-bold text-slate-900 text-sm sm:text-base">{item.name}</h3>
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-slate-100 text-slate-700 border border-slate-200">
                    {item.badge}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.note}</p>
              </div>
              <div class="text-left sm:text-right shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 flex sm:flex-col justify-between items-center sm:items-end">
                <span class="text-xl sm:text-2xl font-black font-heading text-[#0f274a]">{item.price}</span>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Starting Price</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Scam Advisory Banner -->
      <section class="border border-slate-300 bg-white p-6 sm:p-8">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 bg-rose-50 text-rose-700 border border-rose-200">
