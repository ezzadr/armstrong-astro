<!-- Client-Side Filter & Live Search Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.category-tab');
    const searchInput = document.getElementById('price-search-input');
    const clearBtn = document.getElementById('clear-search-btn');
    const cards = document.querySelectorAll('.pricing-item-card');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results-message');

    let activeCategory = 'all';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const details = card.getAttribute('data-details') || '';
        const badge = card.getAttribute('data-badge') || '';

        const matchesCat = (activeCategory === 'all' || cardCat === activeCategory);
        const matchesSearch = (!searchQuery || 
          title.includes(searchQuery) || 
          details.includes(searchQuery) || 
          badge.includes(searchQuery)
        );

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          card.classList.add('flex');
          visibleCount++;
        } else {
          card.classList.add('hidden');
          card.classList.remove('flex');
        }
      });

      // Update counter
      if (resultsCount) {
        if (searchQuery || activeCategory !== 'all') {
          resultsCount.innerHTML = `Showing <span class="font-bold text-amber-400">${visibleCount}</span> of ${cards.length} services`;
        } else {
          resultsCount.innerHTML = `Showing all <span class="font-bold text-amber-400">${cards.length}</span> transparent service prices`;
        }
      }

      // No results message
      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      // Clear button visibility
      if (clearBtn) {
        if (searchQuery.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    // Category tab click
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-amber-500', 'text-slate-950', 'border-amber-500', 'active-tab');
          t.classList.add('bg-slate-800', 'text-slate-300', 'border-slate-700');
        });

        tab.classList.remove('bg-slate-800', 'text-slate-300', 'border-slate-700');
        tab.classList.add('bg-amber-500', 'text-slate-950', 'border-amber-500', 'active-tab');

        activeCategory = tab.getAttribute('data-cat') || 'all';
        filterCards();
      });
    });

    // Live search typing
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        filterCards();
      });
    }

    // Clear search
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          searchInput.focus();
          filterCards();
        }
      });
    }
  });
</script>
