  { id: "auto", label: "Car Keys & Auto", icon: "🚗" },
  { id: "lockout", label: "Emergency Lockouts", icon: "🚨" },
  { id: "residential", label: "Home & Rekey", icon: "🏠" },
  { id: "commercial", label: "Business & Commercial", icon: "🏢" }
