---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Refund & Cancellation Policy | Armstrong Locksmith Nashville";
const seoDescription = "Refund and cancellation policy for Armstrong Locksmith Inc. Clear, transparent terms for mobile dispatches, key fobs, and hardware.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/refund-and-cancellation-policy/">
  <header class="bg-[#0f274a] bg-navy-grid text-white py-12 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold font-heading font-black uppercase text-white mb-2">Refund & Cancellation Policy</h1>
      <p class="text-slate-300 text-sm">Last updated: January 2026 &bull; Armstrong Locksmith Inc</p>
    </div>
  </header>

  <main class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto prose prose-slate text-slate-800 text-sm sm:text-base leading-relaxed flex flex-col gap-6">
      
      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase mb-2">1. Mobile Dispatch Cancellations</h2>
        <p>
          You may cancel a requested mobile service call at no charge prior to the technician's dispatch. If a technician has already arrived on-site or is en route within your immediate vicinity, a standard trip fee may apply to cover vehicle dispatch and fuel expenses.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase mb-2">2. Key Cutting & Programming Warranty</h2>
        <p>
          All keys, smart proximity fobs, and transponder chips supplied and programmed by Armstrong Locksmith include a <strong>90-day operational guarantee</strong> against programming defects. If a key fails to start the vehicle under normal use, we will re-program or replace the key free of charge.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase mb-2">3. Hardware & Commercial Locks</h2>
        <p>
          Deadbolts, commercial leversets, and exit hardware installed by our technicians carry standard manufacturer warranties plus our 30-day installation workmanship guarantee.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase mb-2">4. Questions or Warranty Claims</h2>
        <p>
          For warranty claims or service questions, please call us directly at <a href="tel:6156258000" class="text-amber-700 font-bold underline">(615) 625-8000</a> or visit our shop at 208 Thompson Ln, Nashville, TN 37211.
        </p>
      </div>

    </div>
  </main>
</Layout>
