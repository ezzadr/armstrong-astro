---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Terms and Conditions | Armstrong Locksmith Nashville";
const seoDescription = "Terms and Conditions of service for Armstrong Locksmith Inc. Professional locksmith services, state licensing, and pricing transparency.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/terms-and-conditions/">
  <header class="bg-[#0f274a] bg-navy-grid text-white py-12 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-white mb-2">Terms & Conditions</h1>
      <p class="text-slate-300 text-sm">Last updated: January 2026 &bull; Armstrong Locksmith Inc &bull; Certified & Insured</p>
    </div>
  </header>

  <main class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto prose prose-slate text-slate-800 text-sm sm:text-base leading-relaxed flex flex-col gap-6">
      
      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">1. Agreement to Terms</h2>
        <p>
          By accessing our website or requesting mobile/in-shop locksmith services from Armstrong Locksmith Inc, you agree to be bound by these Terms & Conditions.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">2. Proof of Ownership Verification</h2>
        <p>
          In accordance with Tennessee state law and professional locksmith standards, our technicians require valid government-issued photo identification and proof of vehicle or property ownership (registration, title, lease, or utility bill) prior to opening locked doors, cutting new keys, or decoding immobilizers.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">3. Estimates & Transparent Pricing</h2>
        <p>
          We provide upfront quotes over the phone or in person. Any unexpected complications (e.g. damaged ignition cylinders, modified aftermarket wiring, or drill-resistant high security hardware) will be explained to the customer with an updated quote before work proceeds.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">4. Storefront & Licensing</h2>
        <p>
          Armstrong Locksmith Inc operates under Certified & Fully Insured with physical storefront premises located at: <br />
          208 Thompson Ln, Nashville, TN 37211 &bull; Phone: (615) 625-8000.
        </p>
      </div>

    </div>
  </main>
</Layout>
