  <!-- Client-Side Filter Script -->
  <script is:inline>
    function setupAreaFilters() {
      const container = document.getElementById('area-filter-buttons');
      if (!container) return;

      const buttons = container.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.area-card');

      buttons.forEach(btn => {
        btn.onclick = function(e) {
          e.preventDefault();
          const filter = this.getAttribute('data-filter');

          // Update active button state
          buttons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');

          // Filter cards
          cards.forEach(card => {
            const county = card.getAttribute('data-county');
            if (filter === 'all' || county === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupAreaFilters);
    } else {
      setupAreaFilters();
    }
    document.addEventListener('astro:page-load', setupAreaFilters);
  </script>

