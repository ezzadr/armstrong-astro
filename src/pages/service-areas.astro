---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Locksmith Service Areas Nashville TN | Armstrong Locksmith";
const seoDescription = "Certified mobile locksmith & storefront serving Nashville, Brentwood, Franklin, Antioch, Donelson & Middle TN. 208 Thompson Ln. Call (615) 625-8000.";

const serviceAreas = [
  {
    name: "Downtown & Metro Nashville",
    county: "davidson",
    zips: "37201, 37203, 37219",
    tag: "Broadway & High-Rises",
    desc: "Rapid vehicle unlocks, parking garage lockouts, high-rise condo deadbolt rekeys, and commercial panic hardware for Broadway venues.",
    features: ["Emergency Car Unlocking", "Condo & Apartment Rekeys", "Storefront Panic & Mortise Locks"]
  },
  {
    name: "South Nashville & Thompson Ln",
    county: "davidson",
    zips: "37211, 37210",
    tag: "Physical Storefront HQ",
    desc: "Our walk-in storefront located at 208 Thompson Lane. Drop in for instant key copying, smart fob programming, and ignition rebuilds.",
    features: ["Walk-In Key Copying", "European Transponder Cutting", "Ignition Cylinder Rebuilding"],
    isHQ: true
  },
  {
    name: "Brentwood",
    county: "williamson",
    zips: "37027",
    tag: "Luxury European Specialist",
    desc: "Dealer-grade proximity key replacement for BMW, Mercedes, Audi, and Porsche. High-security residential deadbolt installation and estate rekeying.",
    features: ["BMW & Mercedes Smart Keys", "Mul-T-Lock & Medeco Systems", "Driveway On-Site Service"]
  },
  {
    name: "Franklin & Cool Springs",
    county: "williamson",
    zips: "37064, 37067, 37069",
    tag: "Corporate & Estates",
    desc: "Commercial master key charting, electronic access keypads, office rekeying, and roadside automotive key replacement for corporate campuses.",
    features: ["Commercial Master Keying", "Panic Bar & ADA Latches", "Smart Remote Programming"]
  },
  {
    name: "Donelson & Nashville Airport (BNA)",
    county: "davidson",
    zips: "37214",
    tag: "BNA Airport Priority",
    desc: "Priority roadside response for airport parking lot travelers with lost fobs or trunk lockouts. On-site laser cutting and transponder generation.",
    features: ["BNA Long-Term Parking Unlocks", "All Keys Lost Origination", "Same-Day Emergency Dispatch"]
  },
  {
    name: "Green Hills & Belle Meade",
    county: "davidson",
    zips: "37215, 37205",
    tag: "High-Security Residential",
    desc: "Premium residential locks, smart keypad installation, Baldwin and Emtek mortise repair, and luxury vehicle key programming on location.",
    features: ["Baldwin Hardware Service", "Luxury SUV Smart Fobs", "Decorative Entryway Locks"]
  },
  {
    name: "Antioch & Priest Lake",
    county: "davidson",
    zips: "37013, 37217",
    tag: "Domestic & Asian Vehicles",
    desc: "Affordable Ford, Chevy, Dodge, Toyota, Honda, Hyundai, and Kia key replacements, fast house lockout rescue, and deadbolt rekeying.",
    features: ["Toyota, Honda & Ford Smart Keys", "House & Vehicle Lockouts", "Deadbolt Hardware Upgrades"]
  },
  {
    name: "Hermitage & Mt. Juliet",
    county: "wilson",
    zips: "37076, 37122",
    tag: "Residential & Retail",
    desc: "Full mobile locksmith coverage for residential subdivisions, retail storefronts, flip key replacements, and mailbox lock replacements.",
    features: ["Subdivision House Rekeys", "Storefront Glass Locks", "Remote Head Key Cutting"]
  },
  {
    name: "Nolensville & Berry Hill",
    county: "davidson",
    zips: "37135, 37204",
    tag: "New Builds & Design Studios",
    desc: "Prompt lock rekeying for newly purchased construction homes, studio locksets, keypad conversions, and duplicate key cutting directly on-site.",
    features: ["New Construction Rekeys", "Electronic Keyless Locks", "Precision Laser Blade Copy"]
  },
  {
    name: "East Nashville & Inglewood",
    county: "davidson",
    zips: "37206, 37216",
    tag: "Historic & Vintage Locks",
    desc: "Specialized restoration and modern cylinder retrofitting for historic Craftsman & Victorian entry doors, mortise locks, and fast vehicle lockouts.",
    features: ["Vintage Mortise Retrofitting", "Antique Lock Servicing", "Mobile Roadside Lockout"]
  },
  {
    name: "Hendersonville & Madison",
    county: "sumner",
    zips: "37075, 37115",
    tag: "North Metro & Lakes",
    desc: "Complete mobile locksmith services for lakefront residential properties, fleet commercial locks, and transponder chip generation.",
    features: ["Residential Rekeying", "Fleet Vehicle Keys", "Transponder Chip Syncing"]
  },
  {
    name: "Murfreesboro & Smyrna",
    county: "rutherford",
    zips: "37129, 37130, 37167",
    tag: "Commercial & Fleet",
    desc: "Commercial access control, master keying for multi-unit buildings, automotive key replacement, and emergency lockout dispatch.",
    features: ["Multi-Unit Master Keys", "Commercial Exit Devices", "Heavy-Duty Door Hardware"]
  }
];

const serviceAreasSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://armstronglocksmithinc.com/service-areas/#service",
    "name": "Locksmith Service Areas Greater Nashville",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+1-615-625-8000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211",
        "addressCountry": "US"
      }
    },
    "areaServed": [
      { "@type": "City", "name": "Nashville" },
      { "@type": "City", "name": "Brentwood" },
      { "@type": "City", "name": "Franklin" },
      { "@type": "City", "name": "Antioch" },
      { "@type": "City", "name": "Donelson" },
      { "@type": "City", "name": "Hermitage" },
      { "@type": "City", "name": "Belle Meade" },
      { "@type": "City", "name": "Green Hills" },
      { "@type": "City", "name": "Nolensville" },
      { "@type": "City", "name": "Berry Hill" },
      { "@type": "City", "name": "Hendersonville" },
      { "@type": "City", "name": "Murfreesboro" },
      { "@type": "City", "name": "Smyrna" }
    ],
    "description": "Certified mobile locksmith and walk-in storefront providing car key replacement, residential rekeying, commercial door hardware, and emergency lockout services across Middle Tennessee."
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/service-areas/" schema={serviceAreasSchema}>
  
  <!-- ==================== CLEAN HERO HEADER ==================== -->
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-5xl mx-auto text-center relative z-10 flex flex-col items-center">
      
      <!-- Eyebrow Tag -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-bold text-amber-300 mb-4">
        <span>STOREFRONT &bull; MOBILE VANS &bull; MIDDLE TENNESSEE</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight max-w-4xl">
        Locksmith Service Areas <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500">Across Metro Nashville</span>
      </h1>

      <!-- Grounded Subtext -->
      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-4 leading-relaxed font-normal">
        Visit our central shop on <strong>Thompson Lane</strong> for instant key programming, or call for fast mobile dispatch to your driveway, office, or roadside anywhere in Middle Tennessee.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-6 w-full max-w-md">
        <a 
          href="tel:6156258000" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-black text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 border-b-2 border-amber-600"
        >
          <svg class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>

        <a 
          href="/book-online/" target="_blank" rel="noopener noreferrer" 
          class="w-full sm:w-auto px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base uppercase tracking-wider flex items-center justify-center gap-2 border border-white/25 shadow-lg transition active:scale-95"
        >
          <span>Book Online &rarr;</span>
        </a>
      </div>

      <!-- Clean Credibility Row -->
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 pt-6 mt-4 border-t border-white/10 text-xs sm:text-sm text-slate-300">
        <div class="flex items-center gap-1.5">
          <span class="text-amber-400 font-bold">★★★★★</span>
          <span><strong class="text-white">4.9/5</strong> (750+ Reviews)</span>
        </div>
        <span class="hidden sm:inline text-slate-500">&bull;</span>
        <div class="flex items-center gap-1.5">
          <span class="text-amber-400">🛡️</span>
          <span><strong class="text-white">Certified &amp; Insured</strong></span>
        </div>
        <span class="hidden sm:inline text-slate-500">&bull;</span>
        <div class="flex items-center gap-1.5">
          <span class="text-amber-400">📍</span>
          <span><strong class="text-white">Shop:</strong> 208 Thompson Ln</span>
        </div>
      </div>

    </div>
  </header>

  <!-- ==================== TWO WAYS WE SERVE YOU (CLEAN DUAL CARDS) ==================== -->
  <section class="py-12 sm:py-16 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        
        <!-- Card 1: Walk-In Storefront -->
        <div class="bg-slate-50 rounded-2xl p-7 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-amber-400 transition">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-8 h-8 rounded-lg bg-gold-metallic text-slate-950 flex items-center justify-center font-bold text-sm">📍</span>
              <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase">Walk-In Storefront</h2>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Bring your car, key fobs, or door locks directly to our Nashville shop. Save on mobile service call fees with instant bench service while you wait.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium mb-6">
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span><strong>Address:</strong> 208 Thompson Ln, Nashville, TN 37211</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span><strong>Store Hours:</strong> Mon–Fri 8 AM – 6 PM &bull; Sat 10 AM – 4 PM</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Full stock of European, Domestic & Asian smart key fobs</span>
              </li>
            </ul>
          </div>
          <a 
            href="https://maps.google.com/?cid=10860533355523991515" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider text-center transition"
          >
            Get Directions to Shop &rarr;
          </a>
        </div>

        <!-- Card 2: Mobile Van Dispatch -->
        <div class="card-clean shadow-sharp hover-lift reveal-up rounded-3xl p-6 sm:p-8 flex flex-col justify-between border-2 border-amber-400/40 bg-white relative">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-2xl">🚐</span>
              <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase">Direct Mobile Dispatch</h2>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Stranded on the roadside, at work, or at home? Our mobile locksmith vans bring laser key cutters, OEM programming computers, and lock hardware straight to you.
            </p>
            <ul class="space-y-2 text-xs text-slate-700 font-medium mb-6">
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span><strong>Dispatch Hours:</strong> Mon–Fri 8 AM – 11:30 PM &bull; Weekends On-Call</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span><strong>Coverage:</strong> Davidson, Williamson, Rutherford & Wilson</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Keys cut & programmed in your driveway with zero towing</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Damage-free vehicle and residential lockouts</span>
              </li>
            </ul>
          </div>
          <a 
            href="tel:6156258000" 
            class="py-2.5 px-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-white font-bold text-xs uppercase tracking-wider text-center transition"
          >
            Request Mobile Dispatch &rarr;
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ==================== INTERACTIVE SERVICE AREA DIRECTORY ==================== -->
  <section class="py-14 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200" id="coverage-grid">
    <div class="max-w-6xl mx-auto">
      
      <!-- Section Title & Filter Tabs -->
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-4xl font-black text-[#0f274a] font-heading font-black uppercase tracking-tight">
          Find Your Neighborhood
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm mt-2">
          Select a county or area below to explore local locksmith services and emergency dispatch:
        </p>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6" id="area-filter-buttons">
          <button 
            type="button" 
            data-filter="all" 
            class="filter-btn active px-4 py-2 rounded-full text-xs font-bold transition bg-[#0f274a] bg-navy-grid text-white shadow-sm"
          >
            All Areas (12)
          </button>
          <button 
            type="button" 
            data-filter="davidson" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-bold transition bg-white text-slate-700 hover:bg-slate-100 border border-slate-300"
          >
            Davidson County
          </button>
          <button 
            type="button" 
            data-filter="williamson" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-bold transition bg-white text-slate-700 hover:bg-slate-100 border border-slate-300"
          >
            Williamson County
          </button>
          <button 
            type="button" 
            data-filter="other" 
            class="filter-btn px-4 py-2 rounded-full text-xs font-bold transition bg-white text-slate-700 hover:bg-slate-100 border border-slate-300"
          >
            Rutherford &amp; Neighboring
          </button>
        </div>
      </div>

      <!-- Clean Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="areas-container">
        {serviceAreas.map((area) => (
          <div 
            class="area-card bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between"
            data-county={area.county === 'davidson' ? 'davidson' : (area.county === 'williamson' ? 'williamson' : 'other')}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                  {area.tag}
                </span>
                {area.isHQ && (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gold-metallic text-slate-950">
                    ★ Shop HQ
                  </span>
                )}
              </div>

              <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-1.5">{area.name}</h3>
              
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {area.desc}
              </p>

              <div class="space-y-1.5 mb-4">
                {area.features.map((feat) => (
                  <div class="flex items-center gap-2 text-xs text-slate-700 font-medium">
                    <span class="text-emerald-600 font-bold text-[11px]">✓</span>
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-[11px] text-slate-500 font-mono">ZIP: {area.zips}</span>
              <a 
                href="tel:6156258000" 
                class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-gold-metallic hover:text-slate-950 text-white font-bold text-[11px] uppercase tracking-wider transition"
              >
                Call Now
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ==================== LOCATION & GOOGLE MAP ==================== -->
  <section class="py-12 sm:py-16 bg-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-6 text-left">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-1">Central Storefront</span>
        <h2 class="text-2xl sm:text-3xl font-black font-heading font-black uppercase text-[#0f274a] mb-3">
          Visit Us on Thompson Lane
        </h2>

        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-5">
          Convenient central location with dedicated parking. Drop in during posted hours or call our dispatch team for on-site mobile service.
        </p>

        <div class="space-y-2.5 text-xs text-slate-700 mb-6">
          <div class="flex items-center gap-2.5">
            <span class="text-base">📍</span>
            <span><strong>208 Thompson Ln, Nashville, TN 37211</strong></span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-base">📞</span>
            <a href="tel:6156258000" class="text-[#0f274a] font-bold hover:text-amber-600">(615) 625-8000</a>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-base">🕒</span>
            <div>
              <div><strong>Storefront:</strong> Mon–Fri 8:00 AM – 6:00 PM &bull; Sat 10:00 AM – 4:00 PM</div>
              <div class="text-emerald-700 font-semibold"><strong>Mobile Dispatch:</strong> Mon–Fri 8:00 AM – 11:30 PM &bull; Weekends On-Call</div>
            </div>
          </div>
        </div>

        <!-- Google Verified Review Trust Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800 mb-4">
          <svg class="w-4 h-4 text-[#4285F4]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <span>4.9 ★★★★★ (750+ Google Reviews)</span>
        </div>

        <div class="flex flex-wrap gap-3">
          <a 
            href="tel:6156258000" 
            class="px-5 py-2.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-bold text-xs uppercase tracking-wider shadow transition"
          >
            Call (615) 625-8000
          </a>
          <a 
            href="https://maps.google.com/?cid=10860533355523991515" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-900 font-bold text-xs uppercase tracking-wider border border-slate-300 transition"
          >
            Directions &rarr;
          </a>
        </div>
      </div>

      <!-- Google Map -->
      <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-lg border border-slate-200 h-72 sm:h-80">
        <iframe 
          title="Armstrong Locksmith Storefront Location Map"
          src="https://maps.google.com/maps?q=Armstrong+Locksmith+Inc,+208+Thompson+Ln,+Nashville,+TN+37211&t=&z=14&ie=UTF8&iwloc=&output=embed" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>

    </div>
  </section>

  <!-- Client-Side Filter Script -->
  <script is:inline>
    (function() {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.area-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');

          // Update active button state
          buttons.forEach(b => {
            b.classList.remove('bg-[#0f274a] bg-navy-grid', 'text-white', 'shadow-sm');
            b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-300');
          });
          this.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-300');
          this.classList.add('bg-[#0f274a] bg-navy-grid', 'text-white', 'shadow-sm');

          // Filter cards
          cards.forEach(card => {
            const county = card.getAttribute('data-county');
            if (filter === 'all' || county === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    })();
  </script>

</Layout>

