---
import Layout from '../layouts/Layout.astro';
import { storeWeekdays, storeSaturday, mobileWeekdays, mobileSaturday, mobileUntil } from '../data/hours.mjs';
import { getReviewStats } from '../lib/reviewStats.mjs';

const { reviewCount, ratingValue } = await getReviewStats();

const seoTitle = "Nashville Locksmith FAQ | Car Keys, Rekeying & Lockout Cost";
const seoDescription = "Straight answers to common Nashville locksmith questions: lost car key replacement, smart fob programming, home lock rekeying, lockouts & upfront pricing.";

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are Armstrong Locksmith Inc's hours of operation? Are you open 24/7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Our walk-in storefront at 208 Thompson Ln, Nashville, TN 37211 is open Monday–Friday ${storeWeekdays} and Saturday ${storeSaturday} (Closed Sunday). Our mobile locksmith vans run extended hours Monday–Friday ${mobileWeekdays} and Saturday ${mobileSaturday} (Closed Sunday). Note: Armstrong Locksmith Inc is not a 24/7 or overnight locksmith service.`
      }
    },
    {
      "@type": "Question",
      "name": "How do I contact Armstrong Locksmith Inc or book an appointment online?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can call or text (615) 625-8000, email locksmith@armstronglocksmithinc.com, visit our walk-in shop at 208 Thompson Ln, Nashville, TN 37211 ($0 walk-in service call fee), or book directly on our official website at https://armstronglocksmithinc.com/book-online/."
      }
    },
    {
      "@type": "Question",
      "name": "What car brands and lock services does Armstrong Locksmith Inc offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide all-keys-lost car key replacement, push-to-start smart fobs, high-security laser key cutting, ignition repair, and damage-free car lockouts for American (Ford, Lincoln, Chevy, GMC, Dodge, RAM, Jeep, Chrysler, Cadillac, Hummer), Asian (Toyota, Lexus, Honda, Acura, Nissan, Infiniti, Hyundai, Genesis, Kia, Subaru, Mazda), and European/Exotic vehicles (BMW, MINI, Mercedes-Benz, Audi, VW, Volvo up to 2026, Land Rover, Range Rover, Porsche, Bentley, Ferrari, Lamborghini, Rolls-Royce, Maserati, Alfa Romeo)—plus residential lock rekeying ($20/cylinder in-shop) and commercial storefront locks (Adams Rite, Alarm Lock keypads, Detex panic bars, master key systems)."
      }
    },
    {
      "@type": "Question",
      "name": "Can you replace a car key if I lost all my keys?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If you have lost all working keys, we decode your vehicle's lock cylinder directly on-site with Lishi decoding tools, cut a new blade, and program the transponder chip or proximity fob directly into your vehicle's ECU immobilizer."
      }
    },
    {
      "@type": "Question",
      "name": "How is Armstrong Locksmith different from the dealership?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dealerships typically require you to tow your car to their service lane and wait 3 to 7 business days for keys to be ordered and programmed. Armstrong Locksmith comes directly to your location with a mobile locksmith van, completes the job on-site same-day, and saves you 30-50% compared to dealer prices."
      }
    },
    {
      "@type": "Question",
      "name": "Do you have a physical locksmith shop in Nashville?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! We are located at 208 Thompson Ln, Nashville, TN 37211 ($0 walk-in service call fee). You can visit our walk-in shop for key duplication, fob programming, and lock rekeying during storefront hours."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between rekeying and replacing locks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rekeying changes only the internal pins inside your existing lock cylinder so old keys stop working, allowing you to keep your existing deadbolt and handle hardware at a fraction of the cost ($20/cylinder in shop)."
      }
    }
  ]
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/faq/" schema={schema}>
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
        <span>Nashville Locksmith FAQ &bull; 20+ Years Experience</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
        Frequently Asked Questions <br />
        <span class="text-amber-400">About Nashville Locksmith Services</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-4 font-normal leading-relaxed">
        Straightforward, transparent answers from our master locksmith team regarding automotive key programming, same-day mobile service, storefront walk-ins, and pricing.
      </p>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-slate-50 text-slate-900 px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-4xl mx-auto space-y-6">

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          What are Armstrong Locksmith Inc's hours of operation? Are you open 24/7?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Our walk-in storefront at <strong>208 Thompson Ln, Nashville, TN 37211</strong> ($0 walk-in service call fee) is open <strong>Monday–Friday ({storeWeekdays})</strong> and <strong>Saturday ({storeSaturday})</strong>, and closed on Sunday. Our mobile locksmith vans operate extended hours <strong>Monday–Friday ({mobileWeekdays})</strong> and <strong>Saturday ({mobileSaturday})</strong>, and are closed on Sunday. <strong>Note:</strong> Armstrong Locksmith Inc does not offer 24/7 or overnight locksmith service; our mobile vans run until {mobileUntil} on weekdays.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          How do I contact Armstrong Locksmith Inc or book an appointment online?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Call or text <a href="tel:6156258000" class="text-emerald-700 font-bold hover:underline">(615) 625-8000</a>, email <a href="mailto:locksmith@armstronglocksmithinc.com" class="text-emerald-700 font-bold hover:underline">locksmith@armstronglocksmithinc.com</a>, walk into our shop at <strong>208 Thompson Ln, Nashville, TN 37211</strong>, or schedule directly on our official booking page at <a href="/book-online/" class="text-amber-700 font-bold hover:underline">armstronglocksmithinc.com/book-online/</a>.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          What car brands and lock services does Armstrong Locksmith Inc offer?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Founded in Nashville in 2015 by Master Locksmith <strong>Rahim Ezzadpanah</strong> (over 20 years of hands-on locksmith experience in the field; {ratingValue} ★ with <span class="arm-review-count">{reviewCount}+</span> verified Google reviews), we handle:
          <br />&bull; <strong>Automotive Keys &amp; Smart Fobs:</strong> American (Ford, Lincoln, Chevy, GMC, Dodge, RAM, Jeep, Chrysler, Cadillac, Hummer), Asian (Toyota, Lexus, Honda, Acura, Nissan, Infiniti, Hyundai, Genesis, Kia, Subaru, Mazda), and European/Exotic vehicles (BMW, MINI, Mercedes-Benz, Audi, VW, Volvo up to 2026, Land Rover, Range Rover, Porsche, Bentley, Ferrari, Lamborghini, Rolls-Royce, Maserati, Alfa Romeo).
          <br />&bull; <strong>Residential &amp; Commercial Locks:</strong> $20/cylinder in-shop rekeying, mobile home rekeying (Schlage, Kwikset, Yale, Baldwin), smart deadbolts, house/car lockouts, Adams Rite storefront mortise locks, Alarm Lock Trilogy keypads, Detex exit alarms, and master key systems across Nashville, Brentwood, Franklin, Antioch, Donelson, Hermitage, Green Hills, Belle Meade, Oak Hill, Forest Hills, Berry Hill, and Nolensville.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          Can you make a replacement car key if I lost all my keys?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Yes! In an "all-keys-lost" scenario, you do not need to tow your car to the dealer. Our mobile locksmith van comes directly to your location in Nashville or Middle Tennessee. We decode your door lock cylinder using Lishi decoding tools, cut factory-spec laser key blades, and program the transponder chip or smart fob directly into your vehicle's immobilizer ECU on-site.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          How much money do I save compared to the car dealership?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Most customers save between 30% and 50% compared to dealership quotes. You also eliminate the $150+ towing fee and the typical 3-to-7 day dealership delay because we complete the job on-site with prompt same-day service.
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          Do you have a real physical shop I can visit?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Yes! We are not an out-of-state call center or a trunk-only operation. We own and operate a physical storefront at <strong>208 Thompson Ln, Nashville, TN 37211</strong>. You are welcome to walk in for key duplication, spare fob programming, and lock rekeying during our storefront hours (Mon–Fri {storeWeekdays}, Sat {storeSaturday}).
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          What is the difference between rekeying and replacing locks?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Rekeying changes only the internal tumbler pins inside your existing lock cylinder so old keys no longer work. Replacing involves removing and buying entirely new deadbolts and handle sets. Rekeying is 90% of the time the smarter, faster, and much cheaper choice ($20/cylinder in shop).
        </p>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 border-l-4 border-l-amber-500 shadow-sm">
        <h2 class="text-lg sm:text-xl font-bold font-heading font-black uppercase text-[#0f274a] mb-3">
          How fast can a locksmith arrive for emergency lockouts?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          We run same-day mobile service vans across Nashville, Brentwood, Franklin, Antioch, Green Hills, East Nashville, and Donelson. When you call our shop, we give you an honest arrival window based on live traffic and where our van is working.
        </p>
      </div>

      <!-- FAQ CTA -->
      <div class="p-8 rounded-3xl bg-gradient-to-br from-[#0f274a] via-[#16335c] to-[#0f274a] text-white border-t-4 border-amber-500 flex flex-col sm:flex-row items-center justify-between gap-6 mt-8 shadow-xl">
        <div>
          <h2 class="text-xl font-bold font-heading font-black uppercase text-white mb-1">Have a Question Not Listed Here?</h2>
          <p class="text-xs text-slate-300">Call Rahim and the Armstrong Locksmith team directly for an honest upfront quote.</p>
        </div>
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-sm text-center shadow-lg transition active:scale-95 whitespace-nowrap">
          Call (615) 625-8000
        </a>
      </div>

    </div>
  </main>
</Layout>
