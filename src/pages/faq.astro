---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Frequently Asked Questions | Armstrong Locksmith Nashville";
const seoDescription = "Answers to common questions about car key replacement, dealership savings, emergency lockouts, and residential rekeying in Nashville, TN.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/faq/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight">Frequently Asked Questions</h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Clear, straightforward answers about automotive key programming, response times, and locksmith licensing in Tennessee.
      </p>
    </div>
  </header>
</Layout>