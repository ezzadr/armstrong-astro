---
// review.astro - Instant 5-Star Google Review Funnel Shortlink
// Automatically forwards customers directly to Armstrong Locksmith's Google Review form.
const reviewUrl = "https://g.page/r/CQS5BtikwbmqEBM/review";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leave a Review for Armstrong Locksmith Nashville</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`0; url=${reviewUrl}`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline define:vars={{ reviewUrl }}>
    window.location.replace(reviewUrl);
  </script>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #061224;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
      text-align: center;
    }
    .review-card {
      background: #0d1e38;
      border: 2px solid #f59e0b;
      border-radius: 0px;
      padding: 40px 24px;
      max-width: 440px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    }
    .stars {
      color: #f59e0b;
      font-size: 32px;
      margin-bottom: 16px;
      letter-spacing: 6px;
    }
    h1 {
      font-size: 22px;
      font-weight: 900;
      margin: 0 0 10px 0;
      letter-spacing: -0.5px;
    }
    p {
      font-size: 14px;
      color: #cbd5e1;
      line-height: 1.6;
      margin: 0 0 24px 0;
    }
    .btn {
      display: inline-block;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #061224;
      font-weight: 900;
      padding: 16px 32px;
      border-radius: 0px;
      text-decoration: none;
      font-size: 16px;
      box-shadow: 0 10px 25px rgba(245, 158, 11, 0.4);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px rgba(245, 158, 11, 0.5);
    }
  </style>
</head>
<body>
  <div class="review-card">
    <div class="stars">★★★★★</div>
    <h1>Thank You for Choosing Armstrong Locksmith!</h1>
    <p>Opening Google Reviews... If your browser doesn't redirect you in 2 seconds, tap below:</p>
    <a href={reviewUrl} class="btn">Write a Review on Google &rarr;</a>
  </div>
</body>
</html>
