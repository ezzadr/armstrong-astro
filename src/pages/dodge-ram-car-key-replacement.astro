---
import Layout from '../layouts/Layout.astro';
import { getReviewStats } from '../lib/reviewStats.mjs';
import ServiceReviews from '../components/ServiceReviews.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';
import RelatedPost from '../components/RelatedPost.astro';

const { reviewCount } = await getReviewStats();

const seoTitle = `Dodge & RAM Key Replacement Nashville TN | FOBIK & Smart Fobs`;
const seoDescription = `Dodge, RAM, Jeep & Chrysler key replacement in Nashville, TN. RAM 1500/2500, Charger, Challenger, Durango, ProMaster & FOBIK remotes. Call (615) 625-8000.`;

const shopPlace = {
  "@type": "Place",
  "name": "Armstrong Locksmith Inc",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "208 Thompson Ln",
    "addressLocality": "Nashville",
    "addressRegion": "TN",
    "postalCode": "37211",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 36.1118,
    "longitude": -86.7378
  }
};

const dodgeRamSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Dodge & RAM Car Key Replacement",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Mount Juliet", "Murfreesboro"],
    "description": "Walk-in and mobile Dodge, RAM, Jeep, and Chrysler car key replacement, FOBIK remote programming, and 2018–2026 SGW proximity smart fob programming in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you replace a broken Dodge RAM FOBIK remote key if the rubber buttons stopped working?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. On 2008–2018 Dodge RAM trucks, Dodge Grand Caravan, Charger, Challenger, and Chrysler Town & Country vehicles, the rubber FOBIK buttons often wear out over time. We stock replacement 4-button and remote-start FOBIK keys at our shop and in our mobile vans, cut the emergency door blade, and program the new FOBIK in minutes."
        }
      },
      {
        "@type": "Question",
        "name": "Do you program 2018–2026 RAM 1500/2500, Dodge, and Jeep push-to-start smart fobs with Security Gateway (SGW)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Vehicles built from 2018 through 2026 use Stellantis/FCA Security Gateway (SGW) modules and RF Hub immobilizers. Our technicians carry the proper SGW interface adapters and dealer-grade programmers to pair proximity fobs on-site or at our shop."
        }
      },
      {
        "@type": "Question",
        "name": "How much does Dodge or RAM key replacement cost compared to the dealership?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dodge and RAM dealerships typically charge $290 to $580+ plus towing fees. Our Dodge and RAM key replacement starts at $120 for transponder and FOBIK keys and $145 to $295 for push-to-start proximity smart fobs—saving most Nashville truck owners $150 to $300."
        }
      },
      {
        "@type": "Question",
        "name": "Do you make keys for RAM ProMaster commercial cargo vans?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We cut high-security SIP22 laser flip keys and program proximity fobs for RAM ProMaster 1500, 2500, 3500, and ProMaster City fleet vans on-site across Middle Tennessee."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "name": "Dodge, RAM, Jeep & Chrysler Key Replacement & FOBIK Programming",
    "description": "Storefront and mobile Dodge RAM FOBIK remote programming, push-to-start RF Hub smart fobs, and RAM ProMaster SIP22 laser key cutting in Nashville, TN.",
    "image": [
      "https://armstronglocksmithinc.com/images/2011-dodge-ram-fobik-key-replacement-nashville-shop.jpg",
      "https://armstronglocksmithinc.com/images/2011-dodge-ram-fobik-remote-key-programmed-nashville.jpg"
    ],
    "brand": [
      { "@type": "Brand", "name": "RAM" },
      { "@type": "Brand", "name": "Dodge" },
      { "@type": "Brand", "name": "Jeep" }
    ],
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "120",
      "highPrice": "295",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": { "@id": "https://armstronglocksmithinc.com/#locksmith" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ImageObject",
    "@id": "https://armstronglocksmithinc.com/images/2011-dodge-ram-fobik-key-replacement-nashville-shop.jpg#image",
    "contentUrl": "https://armstronglocksmithinc.com/images/2011-dodge-ram-fobik-key-replacement-nashville-shop.jpg",
    "url": "https://armstronglocksmithinc.com/images/2011-dodge-ram-fobik-key-replacement-nashville-shop.jpg",
    "name": "2011 Dodge Ram Broken FOBIK Key Replaced at Armstrong Locksmith Nashville",
    "caption": "2011 Dodge Ram parked in front of Armstrong Locksmith 208 Thompson Ln Nashville after programming a new remote FOBIK key",
    "width": 1024,
    "height": 576,
    "creditText": "Armstrong Locksmith Inc",
    "creator": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "copyrightHolder": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "contentLocation": shopPlace
  }
];

const dodgeRamModels = [
  { name: "RAM 1500 / 2500 / 3500", type: "Full-Size & Heavy Duty Trucks", keys: "FOBIK & Push-to-Start Smart Fob" },
  { name: "RAM ProMaster 1500/2500/3500", type: "Commercial Cargo & Fleet Van", keys: "SIP22 Laser Flip Key & Smart Fob" },
  { name: "Dodge Charger (Up to 2026)", type: "Full-Size Performance Sedan", keys: "Proximity Smart Fob & FOBIK" },
  { name: "Dodge Challenger", type: "Performance Coupe", keys: "Push-to-Start Fob & FOBIK" },
  { name: "Dodge Durango (Up to 2026)", type: "3-Row SUV", keys: "Proximity Smart Key & FOBIK" },
  { name: "Dodge Grand Caravan / Journey", type: "Minivan & Crossover", keys: "WIN Module FOBIK & Proximity" },
  { name: "Jeep Wrangler / Gladiator", type: "Off-Road SUV & Pickup", keys: "SGW Smart Flip Fob & Remote Head" },
  { name: "Jeep Grand Cherokee / Wagoneer", type: "Mid-Size & Full-Size SUVs", keys: "Push-to-Start Smart Fob & FOBIK" }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/dodge-ram-car-key-replacement/" schema={dodgeRamSchema} image="/images/2011-dodge-ram-fobik-key-replacement-nashville-shop.jpg">
  
  <!-- Hero Section with Real 2011 Dodge Ram FOBIK Shop Photo -->
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
      
      <!-- Hero Left Column -->
      <div class="lg:col-span-7 text-left flex flex-col gap-4">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-black uppercase tracking-wider w-fit">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Dodge, RAM, Jeep &amp; Chrysler Keys</span>
          <span>&bull;</span>
          <span>FOBIK &amp; SGW Smart Fobs</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Dodge &amp; RAM Key Replacement <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500">in Nashville, TN</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          RAM 1500/2500/3500, ProMaster cargo vans, Dodge Charger, Challenger, Durango, Grand Caravan, and Jeep Wrangler/Grand Cherokee. We stock and program <strong>Dodge &amp; RAM FOBIK remotes, SIP22 laser flip keys, and 2018–2026 push-to-start smart fobs</strong> at our walk-in shop or right at your truck.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-xl transition-all duration-200 active:scale-95 shadow-emerald-950/40"
          >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition-all duration-200 active:scale-95 border border-amber-300/40">
            <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Book Online Appointment</span>
          </a>
        </div>
      </div>

      <!-- Hero Right: Real 2011 Dodge Ram Shop Card -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-md rounded-2xl p-6 border border-white/15 shadow-2xl flex flex-col gap-5">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-400 font-black text-xs">
                RAM
              </div>
              <div>
                <p class="text-sm font-bold text-white">FOBIK &amp; SGW Smart Keys</p>
                <span class="text-xs text-slate-300">RAM, Dodge, Jeep &amp; Chrysler</span>
              </div>
            </div>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              In-Stock
            </span>
          </div>

          <div class="relative rounded-xl overflow-hidden bg-slate-900/60 border border-white/10">
            <img 
              src="/images/2011-dodge-ram-fobik-key-replacement-nashville-shop-900.webp" 
              srcset="/images/2011-dodge-ram-fobik-key-replacement-nashville-shop-600.webp 600w, /images/2011-dodge-ram-fobik-key-replacement-nashville-shop-900.webp 900w, /images/2011-dodge-ram-fobik-key-replacement-nashville-shop-1200.webp 1200w"
              sizes="(max-width: 1024px) 100vw, 480px"
              alt="2011 Dodge Ram parked at Armstrong Locksmith in Nashville after programming a new remote FOBIK key" 
              class="w-full h-52 sm:h-60 object-cover"
              width="1024"
              height="576"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute bottom-2 left-2 bg-[#07152b]/90 text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-md border border-amber-400/30 backdrop-blur-sm">
              Real Shop Job: 2011 Dodge Ram Broken FOBIK Replaced ($150 Saved)
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="bg-white/5 rounded-lg p-3 border border-white/10">
              <span class="block text-slate-300 text-[11px]">Dealer / Call-Center</span>
              <strong class="text-red-400 font-extrabold text-sm line-through">$290 - $580+</strong>
            </div>
            <div class="bg-emerald-500/15 rounded-lg p-3 border border-emerald-400/30">
              <span class="block text-emerald-200 text-[11px]">Armstrong Locksmith</span>
              <strong class="text-emerald-300 font-extrabold text-sm">From $120+ (Save $150+)</strong>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Quick Key Takeaways Bar -->
  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">FOBIK &amp; SGW Fobs</strong>
          <span class="text-slate-600 text-[11px]">All Models Up to 2026</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">Walk-In or Mobile Van</strong>
          <span class="text-slate-600 text-[11px]">Shop Counter &amp; On-Site</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300">
          <svg class="w-5 h-5 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-emerald-900 font-bold text-xs sm:text-sm">Save $150-$300</strong>
          <span class="text-emerald-700 text-[11px]">vs Dealer &amp; Call-Center Quotes</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">Trucks, Vans &amp; SUVs</strong>
          <span class="text-slate-600 text-[11px]">RAM, Charger, ProMaster, Jeep</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Body Content -->
  <main class="py-14 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-14 sm:gap-16">
      
      <!-- Real Nashville Shop Job Case Study: 2011 Dodge Ram Broken FOBIK -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border-2 border-amber-400/70 shadow-md">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
              <img
                src="/images/2011-dodge-ram-fobik-key-replacement-nashville-shop-600.webp"
                srcset="/images/2011-dodge-ram-fobik-key-replacement-nashville-shop-600.webp 600w, /images/2011-dodge-ram-fobik-key-replacement-nashville-shop-900.webp 900w"
                sizes="(max-width: 639px) 100vw, 280px"
                alt="2011 Dodge Ram parked at Armstrong Locksmith in Nashville for broken FOBIK key replacement"
                class="w-full h-64 object-cover"
                loading="lazy"
                decoding="async"
                width="1024"
                height="576"
              />
              <div class="p-3 bg-white border-t border-slate-100 text-xs">
                <strong class="block text-[#0f274a]">1. Walk-In Truck Service</strong>
                <span class="text-slate-600 text-[11px]">2011 Dodge Ram pulled right up to our front door</span>
              </div>
            </div>

            <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
              <img
                src="/images/2011-dodge-ram-fobik-remote-key-programmed-nashville-600.webp"
                srcset="/images/2011-dodge-ram-fobik-remote-key-programmed-nashville-600.webp 600w, /images/2011-dodge-ram-fobik-remote-key-programmed-nashville-900.webp 900w"
                sizes="(max-width: 639px) 100vw, 280px"
                alt="New 4-button Dodge Ram FOBIK remote key programmed alongside worn customer FOBIK at Armstrong Locksmith Nashville"
                class="w-full h-64 object-cover"
                loading="lazy"
                decoding="async"
                width="576"
                height="1024"
              />
              <div class="p-3 bg-white border-t border-slate-100 text-xs">
                <strong class="block text-[#0f274a]">2. New 4-Button Remote Start FOBIK</strong>
                <span class="text-slate-600 text-[11px]">Programmed to the WIN module &amp; emergency blade cut</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6 flex flex-col gap-3.5 text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-extrabold uppercase tracking-wider w-fit border border-amber-300">
              Real Nashville Shop Job &bull; Saved $150 vs Other Quotes
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
              2011 Dodge Ram Broken FOBIK Replaced at the Curb
            </h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              A driver pulled up to our shop in his <strong>2011 Dodge Ram</strong> because the rubber buttons on his original FOBIK remote had worn out and stopped locking or remote-starting the truck. Before driving over, he had called several phone-only locksmith companies around Nashville.
            </p>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              Our walk-in shop price for a brand-new 4-button remote-start Dodge Ram FOBIK—cut and programmed right at the curb—was <strong>$150 less than the quotes he got on the phone</strong>. As he told us: <em>"You guys had a storefront — that's why I brought it to y'all."</em>
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1 text-xs font-bold text-slate-700">
              <a href="/blog/2011-dodge-ram-fobik-key-replacement-nashville-shop/" class="bg-[#0f274a] hover:bg-slate-800 text-white px-4 py-2 rounded-lg transition">
                Read Full Job Case Study &rarr;
              </a>
              <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1.5 rounded-lg">&#10003; Done in 15 Minutes</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Inside Our Mobile Locksmith Vans Showcase -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-md">
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-950 text-xs font-extrabold uppercase tracking-wider mb-2 border border-emerald-300">
            &#10003; Fully Equipped Locksmith Vans &bull; Dispatched Across Greater Nashville
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            Lost All Keys? Look Inside the Locksmith Van We Send to Your Truck
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl leading-relaxed">
            When you lose all keys to your RAM truck, Dodge Charger, ProMaster van, or Jeep, we don't show up in an unmarked sedan. Our custom-built mobile locksmith vans carry dual key-cutting workbenches, computerized high-security laser cutters, and a full wall of OEM &amp; aftermarket FOBIKs and smart fobs.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src="/images/armstrong-locksmith-mobile-workshop-van-interior-nashville-600.webp"
              srcset="/images/armstrong-locksmith-mobile-workshop-van-interior-nashville-600.webp 600w, /images/armstrong-locksmith-mobile-workshop-van-interior-nashville-900.webp 900w"
              sizes="(max-width: 639px) 100vw, 33vw"
              alt="Inside Armstrong Locksmith custom-built mobile locksmith van in Nashville TN featuring dual key cutting benches"
              class="w-full h-64 object-cover"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
            />
            <div class="p-3.5 bg-white border-t border-slate-100">
              <strong class="block text-xs font-bold text-[#0f274a]">Dual Key-Cutting Workbenches</strong>
              <span class="text-[11px] text-slate-600">Standard &amp; high-security laser cutters mounted inside our van</span>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
            <img
              src="/images/armstrong-locksmith-van-mortise-cylinders-pinning-bench-nashville-600.webp"
              srcset="/images/armstrong-locksmith-van-mortise-cylinders-pinning-bench-nashville-600.webp 600w, /images/armstrong-locksmith-van-mortise-cylinders-pinning-bench-nashville-900.webp 900w"
              sizes="(max-width: 639px) 100vw, 33vw"
              alt="Organized key stock, pinning kits, and car unlock tools inside Armstrong Locksmith mobile locksmith van in Nashville TN"
              class="w-full h-64 object-cover"
              loading="lazy"
              decoding="async"
              width="1024"
              height="768"
