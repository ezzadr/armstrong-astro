---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Lock Rekeying Nashville | Home & Business Rekey Service";
const seoDescription = "Need locks rekeyed in Nashville? Armstrong Locksmith rekeys homes, rentals and businesses with same-day mobile service available. Call (615) 625-8000.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Lock Rekeying Service Nashville",
  "provider": { "@type": "Locksmith", "name": "Armstrong Locksmith Inc", "telephone": "+1-615-625-8000" },
  "areaServed": "Nashville, TN"
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/nashville-rekey-service/" schema={schema}>
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3.5 py-1 rounded-full bg-emerald-600 text-white">Nashville Rekey Service</span>
          <span>&bull;</span>
          <span class="text-slate-300">Lic #406</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">&#10003; Prompt Mobile Dispatch</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Secure Your Home <br />
          <span class="text-amber-400">Without Replacing Hardware</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Rekeying changes the internal bottom pins so old keys no longer work. It is the most cost-effective way to regain key control after moving into a new home or changing tenants. 90% of customers don't need new locks—they just need key control.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center gap-2.5 shadow-2xl transition active:scale-95 whitespace-nowrap">
            <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <span>Book Rekey Service</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-7 sm:p-9 border border-white/20 shadow-2xl text-white">
        <p class="text-sm font-bold uppercase tracking-wider text-amber-300 mb-3">2 Ways to Rekey with Armstrong</p>
        <div class="space-y-4 text-xs sm:text-sm text-slate-200">
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block text-sm mb-1">🏪 In-Shop Drop-Off ($20/cylinder):</strong>
            <span>Remove your deadbolt or knob cylinders and bring them to our storefront at 208 Thompson Ln to save on service call fees.</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block text-sm mb-1">🚐 Mobile On-Site Service:</strong>
            <span>Our mobile van drives directly to your home or business anywhere in Nashville, Brentwood, Franklin, or Antioch.</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-[#0a192f] text-white px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-20">

      <!-- Why Recommend Rekeying -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <p class="text-lg font-bold text-amber-400 mb-2">Cost Efficiency</p>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Pay only for labor and small internal pins ($20/cylinder), not expensive brand new lock hardware.</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <p class="text-lg font-bold text-amber-400 mb-2">Immediate Security</p>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Previous owners, contractors, realtors, or former tenants holding old keys are immediately locked out.</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <p class="text-lg font-bold text-amber-400 mb-2">Keyed Alike Convenience</p>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">We match front door, back door, and garage deadbolts to all operate smoothly with a single master key.</p>
        </div>
      </section>

      <!-- Step by Step Process -->
      <section class="bg-[#10233d] rounded-3xl p-8 sm:p-12 border border-slate-700/80 shadow-2xl">
        <h2 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-white mb-6">Our Nashville Rekeying Process</h2>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">Step 1</span>
            <strong class="text-white block mb-1">Cylinder Removal</strong>
            <span class="text-slate-300">We extract the lock cylinder from the door housing.</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">Step 2</span>
            <strong class="text-white block mb-1">Dump Old Pins</strong>
            <span class="text-slate-300">We remove all old factory tumbler pins.</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">Step 3</span>
            <strong class="text-white block mb-1">Precision Pinning</strong>
            <span class="text-slate-300">We insert new color-coded bottom pins matching your new key.</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">Step 4</span>
            <strong class="text-white block mb-1">Shear Line Test</strong>
            <span class="text-slate-300">We verify 100% smooth rotation with zero catching.</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">Step 5</span>
            <strong class="text-white block mb-1">Lubrication &amp; Fit</strong>
            <span class="text-slate-300">We reinstall and lubricate the mechanism with Teflon/graphite.</span>
          </div>
        </div>
      </section>

      <!-- Storefront CTA -->
      <section class="bg-gradient-to-br from-[#10233d] to-[#0f274a] rounded-3xl p-8 sm:p-12 border border-slate-700/80 shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-700 shadow-xl">
          <img src="/shop.jpeg" alt="Armstrong Locksmith Storefront Nashville" class="w-full h-72 object-cover" width="600" height="256" loading="lazy" />
          <div class="p-4 bg-slate-950 text-white text-xs flex justify-between items-center border-t border-slate-800">
            <span class="text-slate-300">📍 208 Thompson Ln, Nashville, TN 37211</span>
            <span class="text-amber-400 font-bold">Mon–Fri 8AM–11:30PM | Sat 10AM–4PM</span>
          </div>
        </div>
        <div class="lg:col-span-6 flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Physical Storefront Shop</span>
          <h3 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-white">Stop Overpaying for New Hardware</h3>
          <p class="text-slate-300 leading-relaxed text-xs sm:text-sm">
            Bring your deadbolt cylinders to our shop at 208 Thompson Ln for <strong>$20/cylinder</strong> or call for same-day mobile dispatch across Middle Tennessee.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 pt-3">
            <a href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-xs text-center shadow transition whitespace-nowrap">Get Shop Directions &rarr;</a>
            <a href="tel:6156258000" class="px-6 py-3.5 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-xs text-center shadow transition whitespace-nowrap">Call (615) 625-8000</a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>