---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Honda Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Fast Honda key cutting, transponder & smart key fob programming in Nashville. Mobile vans & storefront at 208 Thompson Ln. Call today at (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/honda-car-keys/">
  
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Automotive Locksmith</span>
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight">
        Honda Key Replacement in Nashville
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Civic, Accord, CR-V, Pilot, Odyssey, HR-V, and all Honda vehicles. Precision laser high-security key cutting and immobilizer pairing.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card-clean rounded-2xl p-7 bg-white">
        <h2 class="text-lg font-bold text-[#0f274a] font-serif mb-2">High-Security Laser Cutting</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Precision center-milled laser high security key cutting for all Honda models.</p>
      </div>
      <div class="card-clean rounded-2xl p-7 bg-white">
        <h2 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Honda Smart Entry Fobs</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Push-to-start smart entry remote keys synced directly to your Honda ECU.</p>
      </div>
      <div class="card-clean rounded-2xl p-7 bg-white">
        <h2 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Ignition Repair & Rekeys</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Honda ignitions commonly jam from worn tumblers. We repair and rebuild Honda ignition cylinders on-site.</p>
      </div>
    </div>
  </section>
</Layout>
