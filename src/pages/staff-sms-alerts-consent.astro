---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Staff SMS Alerts & Consent Policy | Armstrong Locksmith";
const seoDescription = "Staff notification and dispatch messaging consent terms for Armstrong Locksmith field technicians.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/staff-sms-alerts-consent/">
  <header class="bg-[#0f274a] text-white py-14 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <h1 class="text-2xl sm:text-4xl font-black font-serif text-white tracking-tight">Staff SMS Alerts Consent Policy</h1>
    </div>
  </header>
</Layout>