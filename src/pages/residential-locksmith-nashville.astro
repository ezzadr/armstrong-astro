        <!-- Service Card 5 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center text-lg font-bold mb-4">🔩</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Door Jamb Reinforcement</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Most kick-ins break the wooden door jamb, not the lock. We install heavy-duty reinforced strike plates with 3-inch screws anchored directly into wall studs.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Anti-Kick Defense</span>
            <span class="text-purple-700 font-bold">3-Inch Anchors</span>
          </div>
        </div>

        <!-- Service Card 6 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-sky-600 text-white flex items-center justify-center text-lg font-bold mb-4">✂️</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Broken Key Extraction</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Key snapped in the deadbolt or handle? We extract broken fragments cleanly and cut you a brand new, factory-accurate replacement key on the spot.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">On-Site Key Cutting</span>
            <span class="text-sky-700 font-bold">Clean Extraction</span>
          </div>
        </div>

