---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Residential Locksmith Nashville | Rekey & Deadbolt Repair";
const seoDescription = "Expert home lock rekeying, deadbolt replacement & door lock repair in Nashville & Brentwood. Certified & fully insured. Call (615) 625-8000.";

const residentialSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://armstronglocksmithinc.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Residential Locksmith",
        "item": "https://armstronglocksmithinc.com/residential-locksmith-nashville/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Residential Locksmith & Rekeying Services",
    "serviceType": "Residential Locksmith",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+16156258000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson"],
    "description": "Comprehensive residential security: deadbolt rekeying, high-security lock installation, smart keypad locks, and emergency home lockout assistance."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Should I rekey or replace my locks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If your current hardware is in good physical shape, rekeying is much more affordable than replacing. We simply change the internal pins so old keys no longer work."
        }
      },
      {
        "@type": "Question",
        "name": "Can you make all my home locks work with one key?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, as long as the locks share the same keyway brand (e.g. all Kwikset or all Schlage). We can repin front, back, and garage entry doors to a single master key."
        }
      }
    ]
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/residential-locksmith-nashville/" schema={residentialSchema}>
  
  <!-- Hero Section -->
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-amber-300 w-fit">
          <span>Certified & Insured &bull; Storefront at 208 Thompson Ln</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
          Residential Locksmith <br />
          <span class="text-amber-400">Services in Nashville</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          Rekeying, lock changes, high-security deadbolt installations, and emergency house lockout assistance across Nashville, Brentwood, and Franklin.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center shadow-md transition">
            <span>Book Online</span>
          </a>
        </div>
      </div>

      <!-- Quick Action Cards -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-white rounded-2xl p-5 shadow-xl border border-slate-200 text-slate-900">
          <div class="text-2xl mb-1">🚨</div>
          <h3 class="font-bold text-[#0f274a] text-base font-serif mb-1">Locked Out?</h3>
          <p class="text-xs text-slate-600 mb-3">Fast Prompt same-day mobile dispatch. Damage-free picking and bypass.</p>
          <span class="text-xs font-bold text-emerald-700">From $85</span>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-xl border border-slate-200 text-slate-900">
          <div class="text-2xl mb-1">🔑</div>
          <h3 class="font-bold text-[#0f274a] font-serif text-base mb-1">Rekey & Upgrades</h3>
          <p class="text-xs text-slate-600 mb-3">Keep existing hardware, change internal pins so old keys don't work.</p>
          <span class="text-xs font-bold text-amber-700">$20–$45 / cylinder</span>
        </div>
      </div>

    </div>
  </header>

  <!-- Real Residential Photos -->
  <section class="py-8 bg-slate-100 px-4 sm:px-8 border-b border-slate-200">
    <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img src="/images/lock-rekeyed-by-armstrong-locksmith-technician.jpg" alt="Deadbolt Rekeyed by Armstrong Locksmith" class="w-full h-52 object-cover" />
        <div class="p-3 text-center text-xs font-bold text-[#0f274a]">Deadbolt Cylinder Rekeying On-Site</div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img src="/images/Rekey-lock-vs-lock-replacement.jpg" alt="Rekey vs Lock Replacement Hardware" class="w-full h-52 object-cover" />
        <div class="p-3 text-center text-xs font-bold text-[#0f274a]">Hardware Repinning & Key Matching</div>
      </div>
    </div>
  </section>

  <!-- Complete Original WordPress Long-Form Content -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto flex flex-col gap-12 text-slate-800 leading-relaxed text-sm sm:text-base">
      
      <!-- Section 1 -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-4">
          Rekeying, Lock Changes & Installations
        </h2>
        <p class="mb-3">
          Whether you just closed on a new home in Nashville, had a tenant move out of a rental property, or are locked out on your porch, Armstrong Locksmith provides comprehensive residential security services.
        </p>
        <p>
          We don't just swap locks blindly. We inspect door frames, strike plates, and deadbolt alignments to ensure your home is physically fortified against forced entry.
        </p>
      </div>

      <!-- Section 2: What service do you need? -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-6">
          What Service Do You Need?
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-lg mb-2">Home Lock Rekeying</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              We alter the internal tumbler pins inside your existing Schlage, Kwikset, Yale, or Baldwin deadbolts so all previous keys stop working, matching all doors to one convenient master key.
            </p>
          </div>

          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-lg mb-2">Deadbolt & Knob Replacement</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Replace tarnished, broken, or low-security locks with Grade 1 or Grade 2 commercial-duty residential deadbolts resistant to bumping, drilling, and picking.
            </p>
          </div>

          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-lg mb-2">Keyless Smart Lock Installation</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Professional keypad and smart lock installation (Schlage Encode, August, Yale, Eufy). We mortise and adjust the door latch properly so motor drives don't bind.
            </p>
          </div>

          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-lg mb-2">Broken Key Extraction & Repairs</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Key snapped inside the cylinder? We extract broken fragments without damaging the lock mechanism and cut you a brand new replacement key on the spot.
            </p>
          </div>
        </div>
      </div>

      <!-- Section 3: Want a stronger door without a full hardware swap? -->
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-3">
          Want a Stronger Door Without a Full Hardware Swap?
        </h2>
        <p class="mb-3 text-slate-700">
          Most residential kick-ins fail not at the lock itself, but at the wooden door jamb. Standard builders use 3/4-inch screws that barely catch the decorative trim.
        </p>
        <p class="text-slate-700">
          We install heavy-duty reinforced steel strike plates anchored with 3-inch hardened steel screws directly into the wall studs, dramatically increasing resistance to kick-in attacks.
        </p>
      </div>

      <!-- Section 4: What affects cost (and how we quote) -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-4">
          What Affects Cost (And How We Quote)
        </h2>
        <p class="mb-3">
          Pricing for residential locksmith work depends on the number of lock cylinders, whether doors require fresh hole drilling or standard replacement, and hardware grades.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <strong class="text-[#0f274a] block font-bold mb-1">1. Tell Us The Job</strong>
            <span class="text-slate-600">Number of locks to rekey, hardware type, or lockout emergency.</span>
          </div>
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <strong class="text-[#0f274a] block font-bold mb-1">2. Get Firm Quote</strong>
            <span class="text-slate-600">We give you an upfront total before dispatching our technician.</span>
          </div>
          <div class="p-4 bg-white rounded-xl border border-slate-200">
            <strong class="text-[#0f274a] block font-bold mb-1">3. Fast Mobile Arrival</strong>
            <span class="text-slate-600">Prompt same-day response time with fully stocked locksmith vans.</span>
          </div>
        </div>
      </div>

      <!-- Section 5: Residential FAQ -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-serif mb-6">
          Residential Locksmith FAQ
        </h2>

        <div class="flex flex-col gap-4">
          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-1">Should I rekey or replace my locks?</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              If your current hardware is in good physical shape, rekeying is much more affordable than replacing. We simply change the internal pins so old keys no longer work.
            </p>
          </div>

          <div class="card-clean rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-1">Can you make all my home locks work with one key?</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Yes, as long as the locks share the same keyway brand (e.g. all Kwikset or all Schlage). We can repin front, back, and garage entry doors to a single master key.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0f274a] text-white py-14 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-4">
      <h2 class="text-2xl sm:text-4xl font-bold font-serif text-white">Call (615) 625-8000 or Visit Thompson Ln</h2>
      <p class="text-slate-200 text-sm sm:text-base">Speak directly with our team for honest pricing and fast mobile response.</p>
      <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
        <a href="tel:6156258000" class="px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base shadow">
          Call (615) 625-8000
        </a>
      </div>
    </div>
  </section>
</Layout>
