---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Residential Locksmith Nashville | Rekey & Deadbolt Repair";
const seoDescription = "Expert home lock rekeying, deadbolt replacement & door lock repair in Nashville & Brentwood. Certified & fully insured. Call (615) 625-8000.";

const residentialSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://armstronglocksmithinc.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Residential Locksmith",
        "item": "https://armstronglocksmithinc.com/residential-locksmith-nashville/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Residential Locksmith & Rekeying Services",
    "serviceType": "Residential Locksmith",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+16156258000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Green Hills", "Belle Meade"],
    "description": "Comprehensive residential home security: deadbolt rekeying, high-security lock installation, smart keypad locks, and emergency home lockout assistance."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Should I rekey or replace my locks when moving into a new home?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If your existing locks are in good working condition, rekeying is far more cost-effective than replacing. We simply change the internal pins so all previous keys stop working, saving you up to 70% in hardware costs."
        }
      },
      {
        "@type": "Question",
        "name": "Can you make all my house doors open with one single key?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! As long as the lock cylinders share the same brand keyway (e.g. all Schlage or all Kwikset), we can repin your front door, back door, garage entry, and patio deadbolts to work seamlessly with one master key."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly can a locksmith arrive for an emergency house lockout?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our mobile service vans provide prompt same-day dispatch across Greater Nashville, arriving with non-destructive picking tools to unlock your home safely with zero damage to your door or trim."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Residential Lock Rekeying & Home Security",
    "description": "Professional home deadbolt rekeying, smart lock keypad installation, and lock repairs in Nashville, TN.",
    "image": "https://armstronglocksmithinc.com/images/lock-rekeyed-by-armstrong-locksmith-technician.jpg",
    "brand": {
      "@type": "Brand",
      "name": "Armstrong Locksmith"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "75",
      "highPrice": "250",
      "offerCount": "1",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Locksmith",
        "name": "Armstrong Locksmith Inc"
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "180",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": [
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Jessica Holloway" },
        "datePublished": "2026-05-18",
        "reviewBody": "We just bought our home and needed all exterior deadbolts rekeyed immediately. Armstrong gave me an upfront quote over the phone with zero hidden fees. The technician arrived right on time, repinned all locks to one master key, and provided 4 copies on the spot. Highly recommended!",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5",
          "bestRating": "5"
        }
      }
    ]
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/residential-locksmith-nashville/" schema={residentialSchema} image="/images/lock-rekeyed-by-armstrong-locksmith-technician.jpg">
  
  <!-- ==================== LUXURY HERO SECTION ==================== -->
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-xs font-bold text-amber-300 w-fit border border-white/15 backdrop-blur">
          <span>HOME SECURITY &bull; REKEYING &bull; STOREFRONT ON THOMPSON LN</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Nashville Residential <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500">Locksmith &amp; Rekeying</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg leading-relaxed font-normal max-w-2xl">
          Family-owned and operator-led. We secure Nashville homes with professional deadbolt rekeying, high-security cylinder replacements, smart keypad installations, and damage-free lockout rescue—backed by upfront pricing and prompt mobile dispatch.
        </p>

        <!-- Direct Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-black text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-95 border-b-2 border-amber-600"
          >
            <svg class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a href="/book-online/" class="px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-base uppercase tracking-wider flex items-center justify-center gap-2 border border-white/25 shadow-lg transition active:scale-95">
            <span>Book Online &rarr;</span>
          </a>
        </div>

        <!-- Credibility Row -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-4 border-t border-white/10 text-xs sm:text-sm text-slate-300">
          <div class="flex items-center gap-1.5">
            <span class="text-amber-400 font-bold">★★★★★</span>
            <span><strong class="text-white">4.9/5 Rating</strong> (<span class="arm-review-count">771+</span> Reviews)</span>
          </div>
          <span class="hidden sm:inline text-slate-500">&bull;</span>
          <div class="flex items-center gap-1.5">
            <span class="text-amber-400">🛡️</span>
            <span><strong class="text-white">Certified &amp; Fully Insured</strong></span>
          </div>
          <span class="hidden sm:inline text-slate-500">&bull;</span>
          <div class="flex items-center gap-1.5">
            <span class="text-amber-400">📍</span>
            <span><strong class="text-white">Storefront:</strong> 208 Thompson Ln</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Hero Visual Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-2xl border border-slate-200 text-slate-900">
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <h2 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase">Home Locksmith Services</h2>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800">
              ⚡ Same-Day Mobile Dispatch
            </span>
          </div>

          <div class="space-y-3.5 text-xs sm:text-sm">
            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-amber-300 transition">
              <span class="w-8 h-8 rounded-lg bg-gold-metallic text-slate-950 flex items-center justify-center font-bold text-sm shrink-0">🔑</span>
              <div>
                <strong class="block text-slate-900 font-bold text-sm">Full House Rekeying</strong>
                <span class="text-slate-600">Repin all exterior deadbolts so previous owners, tenants, or contractors lose access.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-amber-300 transition">
              <span class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm shrink-0">🛡️</span>
              <div>
                <strong class="block text-slate-900 font-bold text-sm">Deadbolt Upgrades &amp; Repairs</strong>
                <span class="text-slate-600">Install Grade 1/2 pick-resistant deadbolts (Schlage, Kwikset, Baldwin, Medeco).</span>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-amber-300 transition">
              <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shrink-0">📱</span>
              <div>
                <strong class="block text-slate-900 font-bold text-sm">Smart Keypad Deadbolts</strong>
                <span class="text-slate-600">Expert installation &amp; calibration for keyless electronic deadbolts &amp; smart locks.</span>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
            <span>Upfront Phone Pricing</span>
            <strong class="text-emerald-700 font-bold">Zero Hidden Surcharges</strong>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- ==================== REAL TECHNICIAN JOB SHOWCASE ==================== -->
  <section class="py-12 sm:py-16 bg-slate-50 px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-black uppercase tracking-wider text-amber-600 block mb-1">Authentic Craftsmanship</span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#0f274a] font-heading font-black uppercase tracking-tight">
          Real Residential Work In Nashville
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm mt-2">
          Photos of real lock rekeying and hardware service completed by our mobile technicians across Middle Tennessee:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        <!-- Photo 1: Yale Keypad Lock (Belle Meade) -->
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-md group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden h-60 bg-slate-900">
              <picture>
                <source type="image/webp" srcset="/images/yale-keypad-lock-installation-belle-meade-nashville-600.webp 600w, /images/yale-keypad-lock-installation-belle-meade-nashville-1200.webp 1200w" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
                <img 
                  src="/images/yale-keypad-lock-installation-belle-meade-nashville.jpg" 
                  alt="Armstrong Locksmith installing Yale keypad smart lock in Belle Meade Nashville TN 37205" 
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="450"
                />
              </picture>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600">Smart Lock Install</span>
                <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">📍 Belle Meade 37205</span>
              </div>
              <h3 class="text-base font-bold text-[#0f274a] font-heading font-black uppercase mb-1.5">Yale Keypad Touchscreen Deadbolt</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Installed high-security keyless touchscreen smart deadbolt on a residential front door in Belle Meade, providing PIN-code access and automated locking.
              </p>
            </div>
          </div>
          <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-700">
            <span class="text-[11px] text-slate-500 font-medium">Verified Job</span>
            <span class="text-amber-600 font-bold">Keyless Entry &rarr;</span>
          </div>
        </div>

        <!-- Photo 2: Deadbolt Rekeying -->
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-md group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden h-60 bg-slate-100">
              <picture>
                <source type="image/webp" srcset="/images/lock-rekeyed-by-armstrong-locksmith-technician-600.webp 600w, /images/lock-rekeyed-by-armstrong-locksmith-technician-1200.webp 1200w" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
                <img 
                  src="/images/lock-rekeyed-by-armstrong-locksmith-technician.jpg" 
                  alt="Residential Deadbolt Rekeyed by Armstrong Locksmith Technician" 
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="450"
                />
              </picture>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-600">On-Site Rekeying</span>
                <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">📍 Nashville, TN</span>
              </div>
              <h3 class="text-base font-bold text-[#0f274a] font-heading font-black uppercase mb-1.5">Deadbolt Cylinder Repinning</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Our technician re-pinned this residential deadbolt so all previous tenant keys stopped working, while syncing front and back doors to a single master key.
              </p>
            </div>
          </div>
          <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-700">
            <span class="text-[11px] text-slate-500 font-medium">Verified Job</span>
            <span class="text-amber-600 font-bold">1 Key All Doors &rarr;</span>
          </div>
        </div>

        <!-- Photo 3: Hardware Comparison -->
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-md group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden h-60 bg-slate-100">
              <picture>
                <source type="image/webp" srcset="/images/Rekey-lock-vs-lock-replacement-600.webp 600w, /images/Rekey-lock-vs-lock-replacement-1200.webp 1200w" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" />
                <img 
                  src="/images/Rekey-lock-vs-lock-replacement.jpg" 
                  alt="Rekeying vs Lock Replacement Hardware Comparison" 
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="450"
                />
              </picture>
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600">Cost-Saving Solution</span>
                <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">📍 Middle TN</span>
              </div>
              <h3 class="text-base font-bold text-[#0f274a] font-heading font-black uppercase mb-1.5">Rekeying vs Full Lock Replacement</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                We inspect the internal tumblers to determine if your existing hardware can be preserved and re-pinned, saving you substantial hardware replacement costs.
              </p>
            </div>
          </div>
          <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-700">
            <span class="text-[11px] text-slate-500 font-medium">Verified Job</span>
            <span class="text-amber-600 font-bold">Save 70% vs Replace &rarr;</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== CORE RESIDENTIAL SERVICES GRID ==================== -->
  <section class="py-14 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-4xl font-black text-[#0f274a] font-heading font-black uppercase tracking-tight">
          Complete Home Lock &amp; Security Services
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm mt-2">
          From historic bungalows in East Nashville to modern luxury estates in Brentwood, we service every type of home locking hardware:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Service Card 1 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-gold-metallic text-slate-950 flex items-center justify-center text-lg font-bold mb-4">🔑</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Whole-Home Rekeying</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Alter internal tumbler pins so old keys no longer operate the locks. Ideal for new homeowners, landlords, or after changing housekeepers.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">All Doors 1 Key</span>
            <span class="text-amber-600 font-bold">From $20 / cylinder</span>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#0f274a] bg-navy-grid text-white flex items-center justify-center text-lg font-bold mb-4">🛡️</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Deadbolt Replacement</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Upgrade worn, sticky, or builders-grade locks with ANSI Grade 1 &amp; Grade 2 pick-resistant, drill-resistant deadbolts from Schlage, Yale &amp; Kwikset.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Heavy Duty Steel</span>
            <span class="text-emerald-700 font-bold">Grade 1 &amp; 2 Rated</span>
          </div>
        </div>

        <!-- Service Card 3 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-lg font-bold mb-4">📱</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Smart Lock Installation</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Professional keypad and smart lock installation (Schlage Encode, Yale Assure, August, Eufy). We align the door latch so motorized bolts don't jam.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Keyless Entry</span>
            <span class="text-slate-900 font-bold">Precision Fit</span>
          </div>
        </div>

        <!-- Service Card 4 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm hover:border-amber-400 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center text-lg font-bold mb-4">🚨</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Emergency House Lockouts</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Locked out of your house or condo? Our mobile technicians arrive promptly to pick the cylinder cleanly with zero damage to your door or paint.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-medium">Fast Mobile Arrival</span>
            <span class="text-rose-700 font-bold">Damage-Free Entry</span>
