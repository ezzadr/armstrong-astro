const seoTitle = "Land Rover & Range Rover Key Replacement Nashville TN";
const seoDescription = "Range Rover, Defender, Discovery & Evoque smart key cutting and push-to-start fob programming in Nashville, TN without dealer towing. Call (615) 625-8000.";

const landRoverSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Land Rover Car Key Replacement",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Belle Meade", "Green Hills", "Williamson County"],
    "description": "On-site Land Rover, Range Rover, Defender, and Discovery smart push-to-start key replacement and programming in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
