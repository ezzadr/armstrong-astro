      "https://armstronglocksmithinc.com/images/2019-land-rover-range-rover-smart-key-replacement-nashville.jpg",
      "https://i.ytimg.com/vi/uslppU1bDZU/hqdefault.jpg"
    ],
    "uploadDate": "2026-10-27T20:54:00-05:00",
    "duration": "PT57S",
