---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Land Rover Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Affordable Land Rover car key cutting, transponder & smart proximity fob programming in Nashville. Mobile on-site service & shop at 208 Thompson Ln. (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/">
  
  <!-- Hero Section -->
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-3">
        <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30">Automotive Locksmith</span>
        <span>&bull;</span>
        <span>TN State License #406</span>
        <span>&bull;</span>
        <span>Storefront &amp; Mobile</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        Land Rover Key Replacement <br />
        <span class="text-amber-400">in Nashville, TN</span>
      </h1>

      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-3xl mt-4 font-normal leading-relaxed">
        Lost your only Land Rover key or need a duplicate smart fob? We cut and program factory-grade Land Rover proximity fobs, laser-cut emergency key blades, and transponder chips on-site across Greater Nashville.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-7">
        <a 
          href="tel:6156258000" 
          class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-lg transition active:scale-95 whitespace-nowrap"
        >
          <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>

        <a 
          href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-7 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 whitespace-nowrap"
        >
          <span>Book Online Appointment</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Quick Key Takeaways Bar -->
  <section class="bg-amber-500/10 border-b border-amber-500/20 py-4 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">&#9201;</span>
        <div><strong class="block text-slate-900 font-bold">15�25 Min Arrival</strong><span class="text-slate-500 text-[11px]">Mobile van to your door</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">&#9201;</span>
        <div><strong class="block text-slate-900 font-bold">208 Thompson Ln</strong><span class="text-slate-500 text-[11px]">Physical Nashville storefront</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">&#9201;</span>
        <div><strong class="block text-emerald-800 font-bold">Save $400�$800</strong><span class="text-slate-500 text-[11px]">vs Dealership Quotes</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">&#128737;</span>
        <div><strong class="block text-slate-900 font-bold">TN License #406</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Video Showcase Section -->
      
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold w-fit">
            <span>&#127909;</span> Live Nashville Demonstration
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] leading-tight">
            Range Rover KVM Smart Key Programming Live
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Land Rover vehicles use ultra-secure KVM and RFA anti-theft modules. Watch Rahim program a Land Rover smart key without replacing the KVM module.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-bold text-slate-700">
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">? No Tow Truck Needed</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; OEM-Quality Fobs</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; OBD2 Diagnostics</span>
          </div>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-300 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/9gJuwldKGnc" 
            title="Range Rover KVM Smart Key Programming Live" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>
      

      <!-- 3 Service Cards -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-2xl mb-4">&#128273;</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Smart Push-to-Start Fobs</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Factory proximity keyless entry remotes programmed directly through OBD2 diagnostics on-site without dealership waiting lists.
            </p>
          </div>
          <span class="text-xs font-bold text-amber-600 mt-4 block">OEM &amp; Aftermarket Available &rarr;</span>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-2xl mb-4">&#128273;</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Laser Key Blade CNC Cutting</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              High-precision computer-controlled laser cutting for high-security internal track sidewinder key blades to exact 0.01mm factory tolerances.
            </p>
          </div>
          <span class="text-xs font-bold text-amber-600 mt-4 block">Precision Guaranteed &rarr;</span>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-2xl mb-4">?</div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">All Keys Lost Emergency Dispatch</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Lost your only key? We decode your door lock cylinder and generate brand new programmed keys on-site. No towing required.
            </p>
          </div>
          <span class="text-xs font-bold text-amber-600 mt-4 block">15�25 Min Mobile Arrival &rarr;</span>
        </div>
      </section>

      <!-- Supported Models Section -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">Coverage</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-4">
          Land Rover Models We Service in Greater Nashville
        </h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-3xl mb-8 leading-relaxed">
          From early transponder chip keys to modern encrypted smart proximity push-button start systems, our mobile technicians carry keys and programming hardware for the following models:
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Range Rover</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Range Rover Sport</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Evoque</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Velar</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Defender</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Discovery</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover Discovery Sport</span>
            </div>
          
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 font-bold text-xs text-slate-800 flex items-center gap-2">
              <span class="text-emerald-600">?</span>
              <span>Land Rover LR4</span>
            </div>
          
        </div>
      </section>

      <!-- Process Breakdown -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">How It Works</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Our 4-Step On-Site Key Replacement Process
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">1</span>
            <h4 class="font-bold text-[#0f274a] text-base">ID &amp; Ownership Verification</h4>
            <p class="text-xs text-slate-600 leading-relaxed">We check registration/title and ID to ensure vehicle security compliance.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">2</span>
            <h4 class="font-bold text-[#0f274a] text-base">Lock Decoding &amp; Laser Cut</h4>
            <p class="text-xs text-slate-600 leading-relaxed">We decode the door lock and CNC laser-cut the emergency metal mechanical blade.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">3</span>
            <h4 class="font-bold text-[#0f274a] text-base">Immobilizer Programming</h4>
            <p class="text-xs text-slate-600 leading-relaxed">We write keys directly to KVM and RFA modules for 2015+ models, avoiding expensive $2,000+ module replacement dealer charges.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">4</span>
            <h4 class="font-bold text-[#0f274a] text-base">Testing &amp; Key Deletion</h4>
            <p class="text-xs text-slate-600 leading-relaxed">We test start, lock/unlock, and Comfort Access, then delete lost keys from vehicle memory.</p>
          </div>
        </div>
      </section>

      <!-- Dealership vs Armstrong Comparison -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm overflow-hidden">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Dealership vs. Armstrong Locksmith
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 bg-slate-50">
                <th class="py-3.5 px-4 font-bold text-slate-700">Feature</th>
                <th class="py-3.5 px-4 font-bold text-slate-700">Dealership</th>
                <th class="py-3.5 px-4 font-bold text-emerald-800 bg-emerald-50/50">Armstrong Locksmith</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr>
                <td class="py-3.5 px-4 font-semibold text-slate-800">Towing Required?</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">Yes ($150�$250 Tow)</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700 bg-emerald-50/50">No (We Come to Your Car)</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-slate-800">Turnaround Time</td>
                <td class="py-3.5 px-4 text-slate-600">3 to 7 Business Days</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700 bg-emerald-50/50">Same-Day (25�45 Mins On-Site)</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-slate-800">Key Cut &amp; Programmed</td>
                <td class="py-3.5 px-4 text-slate-600">Extra Labor Fees</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700 bg-emerald-50/50">All-Inclusive Upfront Price</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-slate-800">Physical Storefront</td>
                <td class="py-3.5 px-4 text-slate-600">Dealership Service Bay</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700 bg-emerald-50/50">208 Thompson Ln Shop</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Frequently Asked Questions About Land Rover Keys
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
              <h4 class="font-bold text-[#0f274a] text-sm sm:text-base mb-2">Dealer says I must replace the KVM module. Is that true?</h4>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">No! Dealerships often claim the KVM module must be replaced. We can program new smart keys without replacing your expensive original modules.</p>
            </div>
          
        </div>
      </section>
      

      <!-- Emergency Dispatch CTA Banner -->
      <section class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-[#0f274a] via-[#16335c] to-[#0f274a] text-white shadow-xl border-t-4 border-amber-500 flex flex-col md:flex-row items-center justify-between gap-8 text-left">
        <div class="max-w-2xl">
          <span class="text-xs font-black uppercase tracking-wider text-amber-300 bg-white/10 px-3 py-1 rounded-full">
            &#128680; 24/7 Mobile Dispatch Across Middle Tennessee
          </span>
          <h3 class="text-2xl sm:text-3xl font-bold font-serif text-white mt-3 mb-2">
            Need A Land Rover Key Made Today?
          </h3>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
            Skip the dealership delays and high towing fees. Our mobile locksmith vans carry precision laser cutters and factory key programmers right to your vehicle.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3.5 w-full md:w-auto flex-shrink-0">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm text-center shadow-lg transition active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"></path></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs text-center shadow transition active:scale-95 flex items-center justify-center whitespace-nowrap">
