---

<Layout title={seoTitle} description={seoDescription} canonical="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/" schema={landRoverSchema}>
  
  <!-- Hero Section -->
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center text-left">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-3">
          <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30">European Car Key Specialist</span>
          <span>&bull;</span>
          <span>Up to 2026 Models</span>
          <span>&bull;</span>
          <span>Storefront &amp; Mobile</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading uppercase text-white tracking-tight leading-tight">
          Land Rover &amp; Range Rover Keys <br />
          <span class="text-amber-400">in Nashville, TN</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-4 font-normal leading-relaxed">
          Lost your only Range Rover or Land Rover key, or need a spare push-to-start smart fob? We cut high-security emergency blades and program Range Rover, Defender, Discovery, Velar, and Evoque smart keys on-site across Greater Nashville — starting at <strong>$350+</strong> with no dealer tow.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-7">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-black text-base flex items-center justify-center gap-2.5 shadow-lg transition active:scale-95 whitespace-nowrap"
          >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 whitespace-nowrap">
            <span>Book Online Appointment</span>
          </a>
        </div>
      </div>

      <!-- Right: Click-to-Play 2019 Land Rover Range Rover Job Video -->
      <div class="lg:col-span-5">
        <div
          class="relative rounded-2xl overflow-hidden border-2 border-amber-400/50 shadow-2xl bg-slate-900 aspect-[4/3] group cursor-pointer"
          data-yt-facade="uslppU1bDZU"
          role="button"
          tabindex="0"
          aria-label="Play 2019 Land Rover Range Rover Smart Key Replacement Video in Nashville TN"
        >
          <img
            src="/images/2019-land-rover-range-rover-smart-key-replacement-nashville-900.webp"
            srcset="/images/2019-land-rover-range-rover-smart-key-replacement-nashville-600.webp 600w, /images/2019-land-rover-range-rover-smart-key-replacement-nashville-900.webp 900w, /images/2019-land-rover-range-rover-smart-key-replacement-nashville-1200.webp 1200w"
            sizes="(max-width: 1024px) 100vw, 480px"
            alt="Two 2019 Land Rover Range Rover smart push-to-start key fobs cut and programmed on-site in Nashville, TN by Armstrong Locksmith Inc"
            width="1200"
            height="900"
            fetchpriority="high"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-500"
          />
          <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/10 transition flex items-center justify-center">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl ring-4 ring-white/80 group-hover:scale-110 transition">
              <svg class="w-8 h-8 sm:w-9 sm:h-9 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-sm border border-amber-400/40 rounded-lg px-3 py-1.5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-300">Watch Real Nashville Job (0:57)</span>
          </div>
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/75 to-transparent p-4">
            <span class="inline-block px-2.5 py-0.5 rounded bg-amber-400 text-slate-950 text-[11px] font-black uppercase tracking-wider mb-1">
              Recent Nashville Mobile Job
            </span>
            <p class="text-white text-xs sm:text-sm font-bold leading-snug">
              2019 Land Rover Range Rover — Two New Smart Key Fobs Cut &amp; Programmed On-Site
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Quick Key Takeaways Bar -->
  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-2.5">
        <div><strong class="block text-slate-900 font-bold">Same-Day Mobile Service</strong><span class="text-slate-500 text-[11px]">Mobile van to your door</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <div><strong class="block text-slate-900 font-bold">208 Thompson Ln</strong><span class="text-slate-500 text-[11px]">Physical Nashville storefront</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <div><strong class="block text-emerald-800 font-bold">Starting at $350+</strong><span class="text-slate-500 text-[11px]">Save $400–$800 vs Dealership</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <div><strong class="block text-slate-900 font-bold">Up to 2026 Models</strong><span class="text-slate-500 text-[11px]">Range Rover, Defender &amp; Discovery</span></div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- Recent Nashville Job Showcase: 2019 Land Rover Range Rover -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-slate-900">
            <img
              src="/images/2019-land-rover-range-rover-smart-key-replacement-nashville-600.webp"
              srcset="/images/2019-land-rover-range-rover-smart-key-replacement-nashville-600.webp 600w, /images/2019-land-rover-range-rover-smart-key-replacement-nashville-900.webp 900w"
              sizes="(max-width: 640px) 100vw, 320px"
              alt="Two programmed 2019 Land Rover Range Rover smart key fobs with Armstrong Locksmith card and mobile van in Nashville, TN"
              width="900"
              height="675"
              loading="lazy"
              class="w-full h-60 sm:h-64 object-cover object-center"
            />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-slate-900">
            <img
              src="/images/2019-range-rover-key-fob-programmed-nashville-600.webp"
              srcset="/images/2019-range-rover-key-fob-programmed-nashville-600.webp 600w, /images/2019-range-rover-key-fob-programmed-nashville-900.webp 900w"
              sizes="(max-width: 640px) 100vw, 320px"
              alt="Black 2019 Land Rover Range Rover serviced on-site in Nashville, TN by Armstrong Locksmith Inc"
              width="900"
              height="506"
              loading="lazy"
              class="w-full h-60 sm:h-64 object-cover object-center"
            />
          </div>
        </div>
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold w-fit">
            Verified Nashville Mobile Job &bull; 2019 Range Rover
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            2019 Land Rover Range Rover — Two Smart Key Fobs Cut &amp; Programmed On-Site
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            We pulled our mobile locksmith van right up to this <strong>2019 Land Rover Range Rover</strong> in Nashville, TN and programmed two brand-new 5-button smart push-to-start fobs plus laser-cut the emergency door blades on the spot. Both remotes tested for keyless entry, trunk release, and push-button start before we left.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs font-bold text-slate-700">
            <span class="bg-slate-100 text-slate-800 px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 border border-slate-200">
              <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Two 5-Button Smart Fobs Programmed
            </span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">&#10003; High-Security Laser Emergency Blades</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">&#10003; No Dealership Tow Required</span>
          </div>
          <div class="pt-2">
            <a
              href="https://youtu.be/uslppU1bDZU"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs sm:text-sm shadow transition"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <span>Watch 2019 Range Rover Video on YouTube</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Customer Video Testimonial: 2020 Land Rover Range Rover at 208 Thompson Ln -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold w-fit">
            Verified Customer Video Review &bull; 208 Thompson Ln Shop
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            2020 Range Rover Owner — Smart Key Cut &amp; Programmed at Our Shop
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Watch this <strong>2020 Land Rover Range Rover</strong> owner right outside our <strong>208 Thompson Ln</strong> shop in Nashville after we cut and programmed a new push-to-start smart key fob for his Range Rover while he waited — skipping the dealership wait and saving hundreds.
          </p>
          <div class="pt-1">
            <a
              href="https://youtu.be/IaOYSwz1IXk"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs sm:text-sm shadow transition"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <span>Watch 2020 Range Rover Customer Review on YouTube</span>
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div
            class="relative rounded-2xl overflow-hidden border-2 border-amber-400/50 shadow-xl bg-slate-900 aspect-video group cursor-pointer"
            data-yt-facade="IaOYSwz1IXk"
            role="button"
            tabindex="0"
            aria-label="Play 2020 Range Rover Customer Video Review at Armstrong Locksmith Nashville"
          >
            <img
              src="/images/2020-range-rover-customer-review-nashville-900.webp"
              srcset="/images/2020-range-rover-customer-review-nashville-600.webp 600w, /images/2020-range-rover-customer-review-nashville-900.webp 900w, /images/2020-range-rover-customer-review-nashville-1200.webp 1200w"
              sizes="(max-width: 1024px) 100vw, 560px"
              alt="2020 Land Rover Range Rover customer thanking Armstrong Locksmith outside 208 Thompson Ln shop in Nashville, TN"
              width="1200"
              height="675"
              loading="lazy"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-500"
            />
            <div class="absolute inset-0 bg-slate-950/20 group-hover:bg-slate-950/10 transition flex items-center justify-center">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl ring-4 ring-white/80 group-hover:scale-110 transition">
                <svg class="w-8 h-8 sm:w-9 sm:h-9 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
            <div class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-sm border border-amber-400/40 rounded-lg px-3 py-1.5 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-300">Watch Customer Review (0:11)</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Additional Video Showcase Section: 2017 Range Rover -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold w-fit">
            Live Nashville Demonstration
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading font-black uppercase text-[#0f274a] leading-tight">
            2017 Range Rover Smart Key Programming Live
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            When you lose all keys to a Range Rover or Land Rover, the dealership often quotes thousands of dollars to replace the car's factory security box. Watch Rahim program two new Range Rover smart keys directly to the vehicle on-site in Nashville.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-bold text-slate-700">
            <span class="bg-slate-100 text-slate-800 px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 border border-slate-200"><svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>No Tow Truck Needed</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; OEM-Quality Fobs</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; Same-Day Mobile Service</span>
          </div>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-300 aspect-video bg-black">
          <YouTubeFacade id="9gJuwldKGnc" title="2017 Range Rover Smart Key Programming Live in Nashville" />
        </div>
      </section>
      

      <!-- 3 Service Cards -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">Smart Push-to-Start Fobs</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Factory push-to-start keyless entry remotes programmed directly at your vehicle or at our 208 Thompson Ln shop without dealership wait times.
            </p>
          </div>
          <span class="text-xs font-bold text-amber-600 mt-4 block">OEM &amp; Aftermarket Available &rarr;</span>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#07152b] text-amber-400 flex items-center justify-center mb-4 shadow-md"><svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-heading font-black uppercase mb-2">High-Security Laser Key Cutting</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              High-security laser cutting for the slide-out metal emergency key blade inside your Range Rover or Land Rover fob so you can always unlock your door manually.
            </p>
          </div>
          <span class="text-xs font-bold text-amber-600 mt-4 block">Cut to Factory Spec &rarr;</span>
        </div>

