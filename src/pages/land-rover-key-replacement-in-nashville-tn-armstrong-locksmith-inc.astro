---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Land Rover Key Replacement Nashville TN | Range Rover Specialist";
const seoDescription = "Dealer-alternative Land Rover key replacement in Nashville. We cut and program Range Rover, Sport, Evoque, Velar, and Defender smart keys on-site. (615) 625-8000.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Luxury European Specialist &bull; TN Lic #406</span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        Land Rover Key Replacement <br />
        <span class="text-amber-400">in Nashville, TN</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-3 font-normal leading-relaxed">
        Range Rover, Range Rover Sport, Evoque, Velar, Discovery, and Defender key replacement. Advanced KVM module key programming on-site.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition active:scale-95">
          <span>Call (615) 625-8000</span>
        </a>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Video Demonstration</span>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a]">Range Rover KVM Smart Key Programming Live</h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Land Rover vehicles use ultra-secure KVM and RFA anti-theft modules. Watch Rahim program a Land Rover smart key without replacing the KVM module.
          </p>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-lg border border-slate-200 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/9gJuwldKGnc" 
            title="Land Rover Key Replacement Nashville" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>