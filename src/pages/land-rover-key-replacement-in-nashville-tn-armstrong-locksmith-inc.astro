      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "2017 Range Rover Keys Made On-Site | Fast Mobile Service in Nashville",
    "description": "Watch Armstrong Locksmith program two brand-new smart proximity keys for a 2017 Range Rover on-site in Nashville, TN, solving All Keys Lost directly at the vehicle.",
    "thumbnailUrl": [
      "https://i.ytimg.com/vi/9gJuwldKGnc/hqdefault.jpg"
    ],
    "uploadDate": "2025-12-23T13:32:05-08:00",
    "embedUrl": "https://www.youtube.com/embed/9gJuwldKGnc",
    "contentUrl": "https://www.youtube.com/watch?v=9gJuwldKGnc",
    "publisher": {
      "@type": "Organization",
      "name": "Armstrong Locksmith Inc",
      "logo": {
        "@type": "ImageObject",
        "url": "https://armstronglocksmithinc.com/logo.webp"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you program a Range Rover or Land Rover smart key when all keys are lost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. While franchise dealerships often tell owners they have to replace the entire factory security computer when all keys are lost, we program new smart push-to-start fobs directly to your Land Rover or Range Rover on-site in Nashville."
        }
      },
      {
        "@type": "Question",
        "name": "Which Land Rover and Range Rover models do you service?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We cut emergency blades and program smart push-to-start fobs for Range Rover Full Size, Range Rover Sport, Range Rover Velar, Evoque, Land Rover Defender, Discovery, and LR4 up to 2026 models across Nashville, Brentwood, and Franklin."
