  <script is:inline>
    document.querySelectorAll('[data-yt-facade]').forEach((el) => {
      const activate = () => {
        const id = el.getAttribute('data-yt-facade');
        if (!id || el.querySelector('iframe')) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = el.getAttribute('aria-label') || 'Land Rover Key Replacement Video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.className = 'w-full h-full absolute inset-0 border-0';
        el.innerHTML = '';
        el.appendChild(iframe);
      };
      el.addEventListener('click', activate);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate();
        }
      });
    });
  </script>
