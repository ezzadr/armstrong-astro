---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Hummer Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Hummer H2, H3 & EV key cutting and transponder chip programming on-site across Greater Nashville. Call (615) 625-8000 today.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/hummer-key-replacement-nashville/">
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Automotive Locksmith &bull; TN Lic #406</span>
      <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight leading-tight">
        Hummer Key Replacement in Nashville
      </h1>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mt-2 font-light">
        Hummer H2, H3, and H3T key replacement, remote key fob programming, and Passlock anti-theft bypass service across Middle Tennessee.
      </p>
      <div class="flex pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 text-white font-extrabold text-base shadow">Call (615) 625-8000</a>
      </div>
    </div>
  </header>
</Layout>