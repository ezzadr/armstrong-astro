---
import Layout from '../layouts/Layout.astro';
import { storeWeekdays, storeSaturday, mobileUntil } from '../data/hours.mjs';
import ServiceReviews from '../components/ServiceReviews.astro';

const seoTitle = "Hummer Key Replacement Nashville TN | H1, H2 & H3 Car Keys";
const seoDescription = "Lost your Hummer keys in Nashville? On-site Hummer H1, H2 & H3 key cutting, Passlock transponder programming & remote fobs. Call (615) 625-8000.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Hummer Key Replacement Nashville",
    "provider": { "@id": "https://armstronglocksmithinc.com/#locksmith" },
    "areaServed": "Nashville, TN",
    "description": "On-site and in-shop Hummer H1, H2, and H3 key cutting, Passlock transponder programming, and keyless remote fobs in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you make a key and remote fob for a Hummer H2 or Hummer H3 in Nashville?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We stock keys and remote keyless entry fobs for Hummer H1, H2, and H3 trucks and program GM Passlock and PK3+ immobilizer systems on-site or at our 208 Thompson Ln shop in Nashville."
        }
      },
      {
        "@type": "Question",
        "name": "What if my Hummer H3 or H2 security light is flashing and it won't start?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A flashing security light on a Hummer H2 or H3 usually points to a worn ignition cylinder or a Passlock sensor out of sync. We repair Hummer ignition cylinders and perform Passlock immobilizer relearns on-site."
        }
      },
      {
        "@type": "Question",
        "name": "Do you also make replacement keys and smart fobs for Chevrolet, GMC, and Cadillac trucks and SUVs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Because Hummer shares GM immobilizer and lock architecture with Chevrolet, GMC, and Cadillac, we cut and program smart proximity fobs, flip keys, and transponder keys for Chevy Silverado, Tahoe, Suburban, GMC Sierra, Yukon, and Cadillac Escalade at our 208 Thompson Ln shop ($0 walk-in service call fee) or via mobile locksmith van."
        }
      }
    ]
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/hummer-key-replacement-nashville/" schema={schema} image="/images/hummer-1536x832-1.webp">
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">Hummer Key Specialist</span>
          <span>&bull;</span>
          <span class="text-slate-300">Passlock &amp; Transponders</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">&#10003; Same-Day Mobile Service</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Hummer Key Replacement <br />
          <span class="text-amber-400">in Nashville, TN</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Lost every key to your Hummer, need a dependable spare, or dealing with a worn ignition key? Armstrong Locksmith Inc cuts and programs Hummer keys and keyless remotes at our Nashville storefront or on-site at your vehicle across Middle Tennessee.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 font-extrabold text-base flex items-center justify-center gap-2.5 shadow-2xl transition active:scale-95 whitespace-nowrap">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="/book-online/" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <span>Book Hummer Service</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-7 sm:p-9 border border-white/20 shadow-2xl text-white">
        <h2 class="text-sm font-bold uppercase tracking-wider text-amber-300 mb-3">Hummer Models Supported</h2>
        <ul class="text-xs sm:text-sm space-y-3 text-slate-200">
          <li class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block font-bold">Hummer H2 (2003–2009):</strong>
            <span>Transponder keys (PK3 / Circle Plus) &amp; factory keyless entry remote fobs.</span>
          </li>
          <li class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block font-bold">Hummer H3 &amp; H3T (2006–2010):</strong>
            <span>Passlock II / GM transponder chip keys cut from lock cylinder decoding.</span>
          </li>
          <li class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block font-bold">Hummer H1:</strong>
            <span>High-durability mechanical double-sided key cutting and ignition service.</span>
          </li>
        </ul>
      </div>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-slate-50 text-slate-900 px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-20">

      <!-- Hummer Key Services -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 border-t-4 border-t-amber-500 shadow-sm">
          <h3 class="text-lg font-extrabold text-[#0f274a] mb-2">No Key Code Needed</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Even if you lost every single key, we decode the door or ignition cylinder directly using professional GM Lishi decoders.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 border-t-4 border-t-amber-500 shadow-sm">
          <h3 class="text-lg font-extrabold text-[#0f274a] mb-2">Broken Key Extraction</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">If your Hummer key snapped off inside the ignition or door lock, we extract the broken blade without replacing the lock.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 border-t-4 border-t-amber-500 shadow-sm">
          <h3 class="text-lg font-extrabold text-[#0f274a] mb-2">Ignition Tumbler Repair</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Fix sticky, stuck, or binding Hummer ignitions caused by worn wafers so your key turns smoothly every time.</p>
        </div>
      </section>

      <!-- GM, Chevy, GMC, Cadillac & Hummer Coverage + Real Photos -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 flex flex-col gap-4">
          <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600">General Motors &amp; Hummer Key Specialist</span>
          <h2 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-[#0f274a]">
            Hummer, Chevrolet, GMC &amp; Cadillac Keys Cut &amp; Programmed
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">
            Hummer H2 and H3 trucks share General Motors Passlock, PK3+, and remote keyless entry architecture with Chevy, GMC, and Cadillac trucks and SUVs. We stock keys, remotes, push-to-start smart fobs, and ignition cylinders for the full GM lineup at <strong>208 Thompson Ln ($0 walk-in service call fee)</strong> and on our mobile locksmith vans:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm pt-2">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <strong class="text-[#0f274a] block mb-1">Hummer H1, H2, H3 &amp; H3T</strong>
              <span class="text-slate-600">B102/B111 transponder keys, 3-button keyless remotes, Passlock II relearns, and worn GM sidebar ignition cylinder rebuilds.</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <strong class="text-[#0f274a] block mb-1">Chevrolet Silverado, Tahoe &amp; Suburban</strong>
              <span class="text-slate-600">Push-to-start proximity fobs, high-security laser flip keys (HU100), and transponder keys for Silverado 1500/2500HD, Tahoe, Suburban, Equinox, Traverse &amp; Express vans.</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <strong class="text-[#0f274a] block mb-1">GMC Sierra, Yukon &amp; Acadia</strong>
              <span class="text-slate-600">Smart tailgate/remote-start proximity fobs, transponder keys, and all-keys-lost on-site programming for Sierra, Yukon XL, Terrain &amp; Savana vans.</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <strong class="text-[#0f274a] block mb-1">Cadillac Escalade, XT5, CT5 &amp; Buick</strong>
              <span class="text-slate-600">5-button and 6-button Cadillac smart proximity fobs, laser emergency blades, and worn remote shell/button replacements.</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 grid grid-cols-1 gap-4">
          <figure class="rounded-2xl overflow-hidden border border-slate-200 shadow-md bg-slate-900">
            <img src="/images/hummer-1536x832-1.webp" alt="Hummer key replacement and transponder programming in Nashville TN by Armstrong Locksmith" class="w-full h-48 object-cover" width="600" height="325" loading="lazy" />
            <figcaption class="p-3 bg-[#0f274a] text-slate-200 text-xs">
              On-site Hummer H2 &amp; H3 key origination and GM Passlock programming across Nashville.
            </figcaption>
          </figure>
          <figure class="rounded-2xl overflow-hidden border border-slate-200 shadow-md bg-slate-900">
            <img src="/images/chevy-remote-buttons-gone-1.jpg" alt="Chevrolet and GM worn remote key fob replacement at Armstrong Locksmith Nashville shop" class="w-full h-44 object-cover" width="600" height="400" loading="lazy" />
            <figcaption class="p-3 bg-slate-900 text-slate-300 text-xs">
              Broken or worn-out GM, Chevy, GMC &amp; Hummer remote fobs replaced at 208 Thompson Ln ($0 walk-in fee).
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- Visible FAQs -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg">
        <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600 block mb-2">Common Questions</span>
        <h2 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-[#0f274a] mb-6">
          Hummer &amp; GM Key Replacement FAQs
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs sm:text-sm">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="font-bold text-[#0f274a] text-sm sm:text-base mb-2">Can you make a key and remote fob for a Hummer H2 or Hummer H3 in Nashville?</h3>
            <p class="text-slate-600 leading-relaxed">
              Yes. We stock keys and remote keyless entry fobs for Hummer H1, H2, and H3 trucks and program GM Passlock and PK3+ immobilizer systems on-site or at our <strong>208 Thompson Ln</strong> shop in Nashville.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="font-bold text-[#0f274a] text-sm sm:text-base mb-2">What if my Hummer H3 or H2 security light is flashing and it won't start?</h3>
            <p class="text-slate-600 leading-relaxed">
              A flashing security light on a Hummer H2 or H3 usually points to a worn ignition cylinder or a Passlock sensor out of sync. We repair Hummer ignition cylinders and perform Passlock immobilizer relearns on-site.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="font-bold text-[#0f274a] text-sm sm:text-base mb-2">Do you also make replacement keys and smart fobs for Chevrolet, GMC, and Cadillac trucks and SUVs?</h3>
            <p class="text-slate-600 leading-relaxed">
              Yes. Because Hummer shares GM immobilizer and lock architecture with Chevrolet, GMC, and Cadillac, we cut and program smart proximity fobs, flip keys, and transponder keys for Chevy Silverado, Tahoe, Suburban, GMC Sierra, Yukon, and Cadillac Escalade at our 208 Thompson Ln shop ($0 walk-in service call fee) or via mobile locksmith van.
            </p>
          </div>
        </div>
      </section>

      <!-- Storefront CTA -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-200 shadow-md">
          <picture>
            <source type="image/webp" srcset="/shop-600.webp 600w, /shop-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 600px" />
            <img src="/shop.jpeg" alt="Armstrong Locksmith Storefront Nashville" class="w-full h-72 object-cover" width="600" height="256" loading="lazy" />
          </picture>
          <div class="p-4 bg-[#0f274a] text-white text-xs flex justify-between items-center border-t border-slate-800">
            <span class="text-slate-200">208 Thompson Ln, Nashville, TN 37211</span>
            <span class="text-amber-400 font-bold">Shop Mon–Fri {storeWeekdays}, Sat {storeSaturday} &bull; Mobile until {mobileUntil}</span>
          </div>
        </div>
        <div class="lg:col-span-6 flex flex-col gap-4">
          <span class="text-xs font-extrabold uppercase tracking-wider text-amber-600">Physical Storefront Shop</span>
          <h2 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-[#0f274a]">Visit Our Locksmith Shop</h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">
            Drive your Hummer to 208 Thompson Ln to get a spare key or keyless entry fob programmed in minutes.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 pt-3">
            <a href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-xs text-center shadow transition whitespace-nowrap">Get Shop Directions &rarr;</a>
            <a href="tel:6156258000" class="px-6 py-3.5 rounded-xl bg-[#0f274a] hover:bg-slate-800 text-white font-extrabold text-xs text-center shadow transition whitespace-nowrap">Call (615) 625-8000</a>
          </div>
        </div>
      </section>

    </div>
  </main>
  <ServiceReviews service="hummer" label="Hummer" />
</Layout>
