---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Hummer Key Replacement Nashville | Fast & Affordable | Armstrong Locksmith";
const seoDescription = "Lost your Hummer keys in Nashville? Armstrong Locksmith provides on-the-spot key replacement for all Hummer models: H1, H2, H3. No key code needed. Call (615) 625-8000.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Hummer Key Replacement Nashville",
  "provider": { "@type": "Locksmith", "name": "Armstrong Locksmith Inc", "telephone": "+1-615-625-8000" },
  "areaServed": "Nashville, TN"
};
---

<Layout title={seoTitle} description={seoDescription} canonical="/hummer-key-replacement-nashville/" schema={schema} image="/images/hummer-1536x832-1.webp">
  
  <header class="relative bg-showroom text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden text-left">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-5">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span class="px-3.5 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300">Hummer Key Specialist</span>
          <span>&bull;</span>
          <span class="text-slate-300">Passlock &amp; Transponders</span>
          <span>&bull;</span>
          <span class="text-emerald-400 font-semibold">&#10003; 15–25 Min Mobile Dispatch</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          Hummer Key Replacement <br />
          <span class="text-amber-400">in Nashville, TN</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Lost every key to your Hummer, need a dependable spare, or dealing with a worn ignition key? Armstrong Locksmith Inc. cuts and programs Hummer keys and keyless remotes at our Nashville storefront or on-site at your vehicle across Middle Tennessee.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-2xl transition active:scale-95 whitespace-nowrap">
            <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="/book-online/" target="_blank" rel="noopener noreferrer" class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition active:scale-95 whitespace-nowrap">
            <span>Book Hummer Service</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/10 backdrop-blur-md rounded-3xl p-7 sm:p-9 border border-white/20 shadow-2xl text-white">
        <h3 class="text-sm font-bold uppercase tracking-wider text-amber-300 mb-3">Hummer Models Supported</h3>
        <ul class="text-xs sm:text-sm space-y-3 text-slate-200">
          <li class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block font-bold">Hummer H2 (2003–2009):</strong>
            <span>Transponder keys (PK3 / Circle Plus) &amp; factory keyless entry remote fobs.</span>
          </li>
          <li class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block font-bold">Hummer H3 &amp; H3T (2006–2010):</strong>
            <span>Passlock II / GM transponder chip keys cut from lock cylinder decoding.</span>
          </li>
          <li class="p-3 rounded-xl bg-slate-900/60 border border-slate-700">
            <strong class="text-white block font-bold">Hummer H1:</strong>
            <span>High-durability mechanical double-sided key cutting and ignition service.</span>
          </li>
        </ul>
      </div>
    </div>
  </header>

  <main class="py-16 sm:py-24 bg-[#0a192f] text-white px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-7xl mx-auto flex flex-col gap-20">

      <!-- Hummer Key Services -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <h3 class="text-lg font-bold text-amber-400 mb-2">No Key Code Needed</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Even if you lost every single key, we decode the door or ignition cylinder directly using professional GM Lishi decoders.</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <h3 class="text-lg font-bold text-amber-400 mb-2">Broken Key Extraction</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">If your Hummer key snapped off inside the ignition or door lock, we extract the broken blade without replacing the lock.</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#10233d] border border-slate-700/80">
          <h3 class="text-lg font-bold text-amber-400 mb-2">Ignition Tumbler Repair</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">Fix sticky, stuck, or binding Hummer ignitions caused by worn wafers so your key turns smoothly every time.</p>
        </div>
      </section>

      <!-- Storefront CTA -->
      <section class="bg-gradient-to-br from-[#10233d] to-[#0f274a] rounded-3xl p-8 sm:p-12 border border-slate-700/80 shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-slate-700 shadow-xl">
          <img src="/shop.jpeg" alt="Armstrong Locksmith Storefront Nashville" class="w-full h-72 object-cover" />
          <div class="p-4 bg-slate-950 text-white text-xs flex justify-between items-center border-t border-slate-800">
            <span class="text-slate-300">📍 208 Thompson Ln, Nashville, TN 37211</span>
            <span class="text-amber-400 font-bold">Mon–Fri 8AM–11:30PM | Sat 10AM–4PM</span>
          </div>
        </div>
        <div class="lg:col-span-6 flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Physical Storefront Shop</span>
          <h3 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-white">Visit Our Locksmith Shop</h3>
          <p class="text-slate-300 leading-relaxed text-xs sm:text-sm">
            Drive your Hummer to 208 Thompson Ln to get a spare key or keyless entry fob programmed in minutes.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 pt-3">
            <a href="https://www.google.com/maps/dir/?api=1&destination=208%20Thompson%20Ln%2C%20Nashville%2C%20TN%2037211" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-xs text-center shadow transition whitespace-nowrap">Get Shop Directions &rarr;</a>
            <a href="tel:6156258000" class="px-6 py-3.5 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-white font-extrabold text-xs text-center shadow transition whitespace-nowrap">Call (615) 625-8000</a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>