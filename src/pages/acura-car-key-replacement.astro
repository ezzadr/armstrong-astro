---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Acura Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Expert Acura key replacement, transponder chip key cutting, and smart key fob programming in Nashville. Fast mobile dispatch & storefront. (615) 625-8000.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/acura-car-key-replacement/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Automotive Locksmith &bull; TN Lic #406</span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        Acura Key Replacement <br />
        <span class="text-amber-400">in Nashville, TN</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-3 font-normal leading-relaxed">
        MDX, RDX, TLX, ILX, TSX, RLX, and all Acura models. Smart proximity push-to-start fobs, laser key cutting, and all-keys-lost mobile programming across Nashville.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition active:scale-95">
          <span>Call (615) 625-8000</span>
        </a>
        <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-7 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95">
          <span>Book Online</span>
        </a>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      
      <!-- Video Showcase Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Video Demonstration</span>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a]">Watch Us Cut &amp; Program Acura Keys Live in Nashville</h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            See how our mobile diagnostic computers connect directly to the Acura immobilizer to generate high-security smart keys on-site in under 30 minutes without towing to the dealership.
          </p>
          <div class="flex items-center gap-4 text-xs font-bold text-slate-700">
            <span>?? 20�30 Min Turnaround</span>
            <span>&bull;</span>
            <span>?? Save $150�$350 vs Dealer</span>
          </div>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-lg border border-slate-200 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/Uja6naTWCVw" 
            title="Acura Key Replacement Nashville Demonstration" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Smart Proximity Fobs</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Push-to-start keyless access fobs programmed on-site via OBD2 diagnostic computers.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">High-Security Laser Cutting</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Precision computer CNC cutting for Acura internal track sidewinder key blades.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
          <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">All Keys Lost Service</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Fast on-site key origination and immobilizer syncing without expensive dealer towing.</p>
        </div>
      </div>

    </div>
  </section>
</Layout>