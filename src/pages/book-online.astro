---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.astro';

const seoTitle = "Request An Appointment | Armstrong Locksmith Nashville";
const seoDescription = "Send your service request directly to Armstrong Dispatch. Car keys, residential rekeys, lockouts, and commercial door security in Nashville, TN.";

const bookingSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://armstronglocksmithinc.com/book-online/#webpage",
    "url": "https://armstronglocksmithinc.com/book-online/",
    "name": "Request An Appointment | Armstrong Locksmith",
    "description": "Send your service request directly to Armstrong Dispatch in Nashville, TN."
  }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/book-online/" schema={bookingSchema}>
  
  <!-- Clean Background Wrapper -->
  <section class="py-8 sm:py-16 px-4 sm:px-6 lg:px-8 bg-slate-100 min-h-[85vh] flex flex-col items-center justify-center font-sans">
    <div class="w-full max-w-2xl mx-auto mb-6 text-center">
      <h1 class="text-2xl sm:text-3xl font-black font-heading uppercase text-slate-900 tracking-tight">
        Book Locksmith Service Online
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1.5 font-medium">
        Direct dispatch to our mobile technicians and 208 Thompson Ln walk-in shop
      </p>
    </div>
    <div class="w-full max-w-6xl">
      <!-- The Minimalist Booking Engine Card -->
      <BookingForm />
    </div>
  </section>

</Layout>
