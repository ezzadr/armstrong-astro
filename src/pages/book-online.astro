---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.astro';

const seoTitle = "Book a Locksmith Online Nashville TN | Car Keys & Lock Service";
const seoDescription = "Request same-day mobile locksmith service or schedule an appointment in Nashville, TN. Car key replacement, lockouts, home rekeys & commercial locks. (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/book-online/">
  <div class="bg-[#f3f7f9] min-h-[85vh]">
    <BookingForm />
  </div>
</Layout>
