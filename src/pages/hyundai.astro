---
import Layout from '../layouts/Layout.astro';
import ServiceReviews from '../components/ServiceReviews.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "Hyundai Key Replacement Nashville | Keys & Smart Fobs";
const seoDescription = "Lost your Hyundai key in Nashville? We cut laser blades and program proximity smart keys & flip fobs on-site across Middle TN. Save vs dealer. (615) 625-8000.";

// Rich Schema for Hyundai Service
const hyundaiSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Hyundai Car Key Replacement",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+1-615-625-8000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211",
        "addressCountry": "US"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Belle Meade", "Green Hills"],
    "description": "On-site Hyundai smart key fob cutting and immobilizer programming for Elantra, Sonata, Tucson, Santa Fe, Palisade, Kona, and Ioniq in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you program Hyundai smart push-to-start keys on-site?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! We carry OEM-quality Hyundai proximity smart fobs and connect directly to your vehicle's OBD2 diagnostic port to extract the security PIN and program the new key on-site on-site with zero delay."
        }
      },
      {
        "@type": "Question",
        "name": "What if I lost all keys to my Hyundai?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No problem and no towing required! We decode your door lock cylinder using Lishi decoding tools, laser-cut the emergency high-security metal blade, and program the transponder/smart remote on location."
        }
      },
      {
        "@type": "Question",
        "name": "How much does a replacement Hyundai key cost compared to the dealership?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dealerships often charge $350 to $650+ plus towing fees and require a 5 to 7-day wait. Armstrong Locksmith provides same-day on-site replacement starting from $150-$280, saving you $150 to $350."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Hyundai Key Replacement & Smart Fob Programming",
    "description": "On-site Hyundai laser key cutting, transponder programming, and proximity key fobs in Nashville, TN.",
    "image": "https://armstronglocksmithinc.com/images/Hyundai-car-key.png",
    "brand": {
      "@type": "Brand",
      "name": "Hyundai"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "145",
      "highPrice": "285",
      "offerCount": "1",
      "priceValidUntil": "2026-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Locksmith",
        "name": "Armstrong Locksmith Inc"
      }
    }
  }
];

const hyundaiModels = [
  { name: "Hyundai Elantra", type: "Compact Sedan / GT", keys: "Smart Fob & Flip Key" },
  { name: "Hyundai Sonata", type: "Mid-Size Sedan / Hybrid", keys: "Proximity & High Security" },
  { name: "Hyundai Tucson", type: "Compact SUV", keys: "Smart Fob & Transponder" },
  { name: "Hyundai Santa Fe", type: "Mid-Size SUV", keys: "Push-To-Start & Flip Key" },
  { name: "Hyundai Palisade", type: "3-Row Flagship SUV", keys: "Smart Proximity Key" },
  { name: "Hyundai Kona", type: "Crossover / EV", keys: "Smart Proximity Key" },
  { name: "Hyundai Ioniq / Ioniq 5 / 6", type: "Electric Vehicle", keys: "Smart Proximity Fob" },
  { name: "Hyundai Venue", type: "Subcompact Crossover", keys: "Smart Key & Flip Blade" },
  { name: "Hyundai Santa Cruz", type: "Sport Adventure Vehicle", keys: "Smart Proximity Key" },
  { name: "Hyundai Accent", type: "Subcompact Sedan", keys: "Transponder & Remote Key" },
  { name: "Hyundai Veloster", type: "Sport Hatchback", keys: "Proximity Smart Key" },
  { name: "Hyundai Genesis (Pre-2017)", type: "Luxury Sedan / Coupe", keys: "Smart Key System" }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/hyundai/" schema={hyundaiSchema} image="/images/Hyundai-car-key.png">
  
  <!-- ==================== HERO SECTION ==================== -->
  <header class="relative bg-showroom text-white py-12 sm:py-18 lg:py-20 px-4 sm:px-6 lg:px-8 border-b-2 border-amber-500/80 overflow-hidden font-sans">
    <!-- Ambient Lighting Effects -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
      
      <!-- Hero Left Column: Core Value Proposition -->
      <div class="lg:col-span-7 text-left flex flex-col gap-4 sm:gap-5">
        
        <!-- Live Status Eyebrow Badge -->
        <div class="flex flex-wrap items-center gap-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-black uppercase tracking-wider w-fit shadow-xs">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Hyundai Key Specialist</span>
            <span>&bull;</span>
            <span>Nashville Storefront &bull; Mobile Fleet</span>
          </div>

          <a 
            href="/google-reviews/" 
            class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/10 hover:bg-white/15 border border-white/20 text-slate-200 text-xs font-bold transition shadow-xs"
          >
            <span class="text-amber-400">★★★★★</span>
            <span class="text-white font-extrabold">4.9</span>
            <span class="text-slate-300">(775+ Reviews)</span>
          </a>
        </div>

        <!-- Headline with Gold Gradient Accent -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-heading uppercase text-white tracking-tight leading-[1.08]">
          Hyundai Key Replacement <br class="hidden sm:inline" />
          <span class="text-gold-gradient">in Nashville, TN</span>
        </h1>

        <!-- High-Trust Copy -->
        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Lost your only Hyundai key or need an extra proximity smart fob? We cut factory laser blades and program genuine smart keys directly at your vehicle across Greater Nashville, or walk into our <strong>208 Thompson Ln</strong> storefront. Zero dealership towing required.
        </p>

        <!-- Signature Brand Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <!-- Primary Call Button -->
          <a 
            href="tel:6156258000" 
            class="px-8 py-3.5 sm:py-4 bg-gold-metallic text-slate-950 font-black text-sm sm:text-base uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl transition active:scale-[0.98] border-b-2 border-amber-600 cursor-pointer group"
            aria-label="Call Armstrong Locksmith at (615) 625-8000"
          >
            <svg class="w-5 h-5 text-slate-950 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/>
            </svg>
            <span>CALL (615) 625-8000</span>
          </a>

          <!-- Storefront Directions Button -->
          <a 
            href="/nashville-locksmith-storefront/" 
            class="px-6 py-3.5 sm:py-4 bg-white hover:bg-amber-50 text-[#07152b] font-black text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-2 border-2 border-amber-400 shadow-xl transition active:scale-[0.98] cursor-pointer"
            aria-label="Visit Armstrong Locksmith storefront at 208 Thompson Ln"
          >
            <svg class="w-4 h-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/>
            </svg>
            <span>Visit Shop: 208 Thompson Ln</span>
          </a>
        </div>

        <!-- Reassurance Micro-Pills -->
        <div class="flex flex-wrap items-center gap-2 pt-2 text-xs text-slate-300">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-900/80 border border-slate-700/80">
            <span class="text-amber-400 font-bold">⚡</span>
            <span>Same-Day 15–30 Min Arrival</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-900/80 border border-slate-700/80">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>All Push-to-Start &amp; Flip Keys</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-900/80 border border-slate-700/80">
            <span class="text-amber-400 font-bold">🛡️</span>
            <span>Upfront Flat Rates Guaranteed</span>
          </span>
        </div>

      </div>

      <!-- Hero Right Column: Real Key Showcase Card -->
      <div class="lg:col-span-5">
        <div class="bg-white text-slate-900 border-2 border-amber-500/60 shadow-[0_20px_50px_rgba(0,0,0,0.6)] flex flex-col overflow-hidden">
          
          <!-- Card Header Bar -->
          <div class="bg-gradient-to-r from-[#07152b] via-[#0b203e] to-[#07152b] px-5 py-3.5 border-b border-amber-500/40 flex items-center justify-between text-left">
            <div>
              <span class="text-[10px] uppercase font-black tracking-wider text-amber-400 block">OEM Key Lab &bull; Nashville</span>
              <p class="text-sm sm:text-base font-black font-heading text-white uppercase tracking-tight">Hyundai Proximity &amp; Smart Keys</p>
            </div>
            <span class="px-2.5 py-1 bg-emerald-950 border border-emerald-500/50 text-emerald-400 text-[10px] font-black uppercase tracking-wider">
              In Stock
            </span>
          </div>

          <!-- Featured Key Photo -->
          <div class="p-5 flex flex-col gap-4 bg-slate-50">
            <div class="relative bg-white border border-slate-200 flex items-center justify-center p-4 shadow-inner">
              <picture>
                <source type="image/webp" srcset="/images/Hyundai-car-key-300.webp 300w, /images/Hyundai-car-key-600.webp 600w" sizes="(max-width: 640px) 100vw, 300px" />
                <img 
                  src="/images/Hyundai-car-key.png" 
                  alt="Hyundai Car Key Replacement Nashville" 
                  class="h-36 sm:h-44 w-auto object-contain drop-shadow-md hover:scale-105 transition-transform duration-300"
                  width="300"
                  height="176"
                  loading="eager"
                />
              </picture>
              <div class="absolute bottom-2 left-2 bg-[#07152b] text-amber-300 text-[10px] font-bold px-2 py-0.5 border border-amber-400/30">
                Direct OBD2 PIN Extraction
              </div>
            </div>

            <!-- Pricing Comparison -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="bg-white p-3 border border-slate-200 text-left">
                <span class="block text-slate-500 text-[11px] font-semibold">Dealer Price + Tow</span>
                <strong class="text-red-600 font-black text-sm line-through">$350 – $650+</strong>
                <span class="block text-[10px] text-slate-400 mt-0.5">5–7 Day Wait Time</span>
              </div>
              <div class="bg-emerald-50 p-3 border border-emerald-300 text-left">
                <span class="block text-emerald-800 text-[11px] font-bold">Armstrong Locksmith</span>
                <strong class="text-emerald-700 font-black text-sm">$145 – $285</strong>
                <span class="block text-[10px] text-emerald-600 font-bold mt-0.5">Same-Day On-Site &bull; Save $150+</span>
              </div>
            </div>

            <!-- Instant Phone Dispatch Callout -->
            <a 
              href="tel:6156258000" 
              class="w-full py-3 bg-gold-metallic hover:brightness-105 text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-2 border-b-2 border-amber-600 shadow-sm transition active:scale-95 cursor-pointer"
            >
              <span>Get Immediate Quote: (615) 625-8000</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </header>

  <!-- ==================== QUICK VALUE TAKEAWAYS BAR ==================== -->
  <section class="bg-amber-500/10 border-b border-amber-500/30 py-4 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-500/20 text-amber-800 flex items-center justify-center shrink-0 border border-amber-500/40">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-950 font-extrabold text-xs sm:text-sm">Prompt Mobile Vans</strong>
          <span class="text-slate-600 text-[11px]">15–30 Min Arrival Across Nashville</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-500/20 text-amber-800 flex items-center justify-center shrink-0 border border-amber-500/40">
          <svg class="w-5 h-5 text-amber-800" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5Z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-950 font-extrabold text-xs sm:text-sm">208 Thompson Ln</strong>
          <span class="text-slate-600 text-[11px]">Physical Nashville Key Shop</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-emerald-500/20 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-500/40">
          <svg class="w-5 h-5 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-emerald-950 font-extrabold text-xs sm:text-sm">Save $150–$350</strong>
          <span class="text-emerald-700 text-[11px]">vs Dealership Invoices</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-500/20 text-amber-800 flex items-center justify-center shrink-0 border border-amber-500/40">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-950 font-extrabold text-xs sm:text-sm">Certified &amp; Insured</strong>
          <span class="text-slate-600 text-[11px]">TN Locksmith Lic #0285</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== MAIN CONTENT ==================== -->
  <main class="py-14 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-7xl mx-auto flex flex-col gap-12 sm:gap-16">
      
      <!-- Interactive Hyundai Key Estimator -->
      <CarKeyEstimator 
        defaultMake="Hyundai" 
        title="Hyundai Key Replacement & Fitment Guide" 
        subtitle="Select your Hyundai model year range and situation to check instant key compatibility, dealer savings, and on-site response times in Nashville." 
      />

      <!-- 3 Core Services with Architectural Sharp Elevation -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Service Card 1 -->
        <div class="bg-white p-7 border border-slate-200 border-t-4 border-t-amber-500 shadow-sm hover:shadow-xl hover:border-amber-400 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 bg-[#07152b] text-amber-400 flex items-center justify-center mb-5 border border-amber-400/30 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            </div>
            <h3 class="text-lg font-black font-heading uppercase text-[#0f274a] mb-2">Smart Push-To-Start Fobs</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              OEM-quality proximity keyless entry remotes programmed on-site via OBD2 diagnostics without dealership backorders or towing delays.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>In Stock for All Hyundai Models</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div class="bg-white p-7 border border-slate-200 border-t-4 border-t-[#0f274a] shadow-sm hover:shadow-xl hover:border-amber-400 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 bg-[#07152b] text-amber-400 flex items-center justify-center mb-5 border border-amber-400/30 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg>
            </div>
            <h3 class="text-lg font-black font-heading uppercase text-[#0f274a] mb-2">Laser Key Cutting</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Computerized laser cutting for Hyundai high-security sidewinder emergency mechanical blades to exact 0.01mm factory tolerances.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-[#0f274a]">
            <span>Precision Computerized Mill</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <!-- Service Card 3 -->
        <div class="bg-white p-7 border border-slate-200 border-t-4 border-t-red-600 shadow-sm hover:shadow-xl hover:border-red-400 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 bg-red-900/10 text-red-600 flex items-center justify-center mb-5 border border-red-200 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-lg font-black font-heading uppercase text-[#0f274a] mb-2">All Keys Lost Replacement</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Lost your only Hyundai key? We decode your door lock cylinder and generate brand new programmed keys on-site. No towing required.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-red-700">
            <span>Prompt Emergency Dispatch</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

      </section>

      <!-- Verified Customer Review Spotlight -->
      <section class="bg-showroom text-white p-8 sm:p-12 shadow-xl border-l-4 border-amber-500 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="lg:col-span-8 flex flex-col gap-3 relative z-10 text-left">
          <div class="flex items-center gap-1 text-amber-400 text-lg">
            ★★★★★
          </div>
          <p class="text-slate-100 text-sm sm:text-base lg:text-lg font-medium leading-relaxed italic">
            "Lost my smart key in Antioch and was stuck in my driveway. Armstrong Locksmith had a technician at my house the same day with a brand new smart fob for my Hyundai Tucson. Tested push-to-start and remote lock perfectly!"
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="font-bold text-amber-300">Megan Sullivan</span>
            <span>&bull;</span>
            <span class="text-slate-300">2021 Hyundai Tucson (Antioch, TN)</span>
            <span>&bull;</span>
            <span class="px-2.5 py-0.5 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold inline-flex items-center gap-1">
              <svg class="w-3 h-3 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Verified Google Review
            </span>
          </div>
        </div>

