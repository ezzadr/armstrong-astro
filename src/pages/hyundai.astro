---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Hyundai Key Replacement Nashville | Keys & Smart Fobs | Armstrong";
const seoDescription = "Lost your Hyundai key in Nashville? We cut laser blades and program proximity smart keys & flip fobs on-site across Middle TN. Save vs dealer. (615) 625-8000.";

// Rich Schema for Hyundai Service
const hyundaiSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Hyundai Car Key Replacement",
    "provider": {
      "@type": "Locksmith",
      "name": "Armstrong Locksmith Inc",
      "telephone": "+1-615-625-8000",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "208 Thompson Ln",
        "addressLocality": "Nashville",
        "addressRegion": "TN",
        "postalCode": "37211",
        "addressCountry": "US"
      }
    },
    "areaServed": ["Nashville", "Brentwood", "Franklin", "Antioch", "Donelson", "Hermitage", "Belle Meade", "Green Hills"],
    "description": "On-site Hyundai smart key fob cutting and immobilizer programming for Elantra, Sonata, Tucson, Santa Fe, Palisade, Kona, and Ioniq in Nashville, TN."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can you program Hyundai smart push-to-start keys on-site?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! We carry OEM-quality Hyundai proximity smart fobs and connect directly to your vehicle's OBD2 diagnostic port to extract the security PIN and program the new key on-site on-site with zero delay."
        }
      },
      {
        "@type": "Question",
        "name": "What if I lost all keys to my Hyundai?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No problem and no towing required! We decode your door lock cylinder using Lishi precision tools, laser-cut the emergency high-security metal blade, and program the transponder/smart remote on location."
        }
      },
      {
        "@type": "Question",
        "name": "How much does a replacement Hyundai key cost compared to the dealership?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dealerships often charge $350 to $650+ plus towing fees and require a 5 to 7-day wait. Armstrong Locksmith provides same-day on-site replacement starting from $150-$280, saving you $150 to $350."
        }
      }
    ]
  }
];

const hyundaiModels = [
  { name: "Hyundai Elantra", type: "Compact Sedan / GT", keys: "Smart Fob & Flip Key" },
  { name: "Hyundai Sonata", type: "Mid-Size Sedan / Hybrid", keys: "Proximity & High Security" },
  { name: "Hyundai Tucson", type: "Compact SUV", keys: "Smart Fob & Transponder" },
  { name: "Hyundai Santa Fe", type: "Mid-Size SUV", keys: "Push-To-Start & Flip Key" },
  { name: "Hyundai Palisade", type: "3-Row Flagship SUV", keys: "Smart Proximity Key" },
  { name: "Hyundai Kona", type: "Crossover / EV", keys: "Smart Proximity Key" },
  { name: "Hyundai Ioniq / Ioniq 5 / 6", type: "Electric Vehicle", keys: "Smart Proximity Fob" },
  { name: "Hyundai Venue", type: "Subcompact Crossover", keys: "Smart Key & Flip Blade" },
  { name: "Hyundai Santa Cruz", type: "Sport Adventure Vehicle", keys: "Smart Proximity Key" },
  { name: "Hyundai Accent", type: "Subcompact Sedan", keys: "Transponder & Remote Key" },
  { name: "Hyundai Veloster", type: "Sport Hatchback", keys: "Proximity Smart Key" },
  { name: "Hyundai Genesis (Pre-2017)", type: "Luxury Sedan / Coupe", keys: "Smart Key System" }
];
---

<Layout title={seoTitle} description={seoDescription} canonical="/hyundai/" schema={hyundaiSchema}>
  
  <!-- Hero Section with Rich Visual Contrast & Real Hyundai Key Photo -->
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <!-- Ambient Glow Effects -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
      
      <!-- Hero Left Column -->
      <div class="lg:col-span-7 text-left flex flex-col gap-4">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-black uppercase tracking-wider w-fit">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Hyundai Key Specialist</span>
          <span>&bull;</span>
          <span>Certified & Insured</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
          Hyundai Key Replacement <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500">in Nashville, TN</span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl font-normal leading-relaxed">
          Lost your only Hyundai key or need a spare proximity remote? Elantra, Sonata, Tucson, Santa Fe, Palisade, Kona, and Ioniq. We laser-cut emergency key blades and program factory smart keys directly at your vehicle.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
          <a 
            href="tel:6156258000" 
            class="px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-xl transition-all duration-200 active:scale-95 shadow-emerald-950/40"
          >
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>

          <a 
            href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-7 py-4 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-xl transition-all duration-200 active:scale-95 border border-amber-300/40"
          >
            <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Book Online Appointment</span>
          </a>
        </div>
      </div>

      <!-- Hero Right: Real Hyundai Key Showcase Card -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-md rounded-2xl p-6 border border-white/15 shadow-2xl flex flex-col gap-5">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-400 font-black text-sm">
                HYU
              </div>
              <div>
                <h3 class="text-sm font-bold text-white">Direct OBD2 PIN Extraction</h3>
                <span class="text-xs text-slate-300">Push-to-Start & Flip Key Specialists</span>
              </div>
            </div>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              Same-Day
            </span>
          </div>

          <!-- Featured Real Hyundai Key Photo -->
          <div class="relative rounded-xl overflow-hidden bg-slate-900/60 border border-white/10 flex items-center justify-center p-4">
            <img 
              src="/images/Hyundai-car-key.png" 
              alt="Hyundai Car Key Replacement Nashville" 
              class="h-36 sm:h-44 w-auto object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-300"
              loading="eager"
            />
            <div class="absolute bottom-2 left-2 bg-[#07152b] bg-navy-grid/90 text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-md border border-amber-400/30 backdrop-blur-sm">
              Smart Proximity Fobs in Stock
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="bg-white/5 rounded-lg p-3 border border-white/10">
              <span class="block text-slate-300 text-[11px]">Dealer Price + Towing</span>
              <strong class="text-red-400 font-extrabold text-sm line-through">$350 - $650</strong>
            </div>
            <div class="bg-emerald-500/15 rounded-lg p-3 border border-emerald-400/30">
              <span class="block text-emerald-200 text-[11px]">Armstrong Locksmith</span>
              <strong class="text-emerald-300 font-extrabold text-sm">Save $150 - $350</strong>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Quick Key Takeaways Bar with Vector SVGs -->
  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">Same-Day Mobile Dispatch</strong>
          <span class="text-slate-600 text-[11px]">Mobile Service to Your Car</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">208 Thompson Ln</strong>
          <span class="text-slate-600 text-[11px]">Walk-In Nashville Storefront</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300">
          <svg class="w-5 h-5 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <strong class="block text-emerald-900 font-bold text-xs sm:text-sm">Save $150-$350</strong>
          <span class="text-emerald-700 text-[11px]">vs Dealership Invoices</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-700 flex items-center justify-center shrink-0 border border-amber-300">
          <svg class="w-5 h-5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <strong class="block text-slate-900 font-bold text-xs sm:text-sm">Certified & Insured</strong>
          <span class="text-slate-600 text-[11px]">Verified Master Locksmith</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Main Body Content -->
  <main class="py-14 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-14 sm:gap-16">
      
      <!-- 3 Core Services with Elevation & Depth -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 text-amber-700 flex items-center justify-center mb-5 border border-amber-300/40 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Smart Push-To-Start Fobs</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              OEM-quality proximity keyless entry remotes programmed on-site via OBD2 diagnostics without dealership delays.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>In Stock for All Models</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 text-amber-700 flex items-center justify-center mb-5 border border-amber-300/40 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Laser Key Blade CNC Cutting</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Computerized high-precision CNC laser cutting for high-security Hyundai sidewinder blades to exact 0.01mm factory tolerances.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>Automated CNC Precision</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:shadow-xl hover:border-amber-400 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-500/5 text-amber-700 flex items-center justify-center mb-5 border border-amber-300/40 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">All Keys Lost Emergency Dispatch</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Lost your only Hyundai key? We decode your door lock cylinder and generate brand new programmed keys on-site. No towing required.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs font-bold text-amber-700">
            <span>Prompt Mobile Dispatch</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>

      </section>

      <!-- Verified Customer Review Spotlight -->
      <section class="bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white rounded-3xl p-8 sm:p-12 shadow-2xl border-t-4 border-amber-500 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="lg:col-span-8 flex flex-col gap-3 relative z-10">
          <div class="flex items-center gap-1 text-amber-400 text-lg">
            ★★★★★
          </div>
          <p class="text-slate-100 text-sm sm:text-base lg:text-lg font-medium leading-relaxed italic">
            "Lost my smart key in Antioch and was stuck in my driveway. Armstrong Locksmith had a technician at my house the same day with a brand new smart fob for my Hyundai Tucson. Tested push-to-start and remote lock perfectly!"
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="font-bold text-amber-300">Megan Sullivan</span>
            <span>&bull;</span>
            <span class="text-slate-300">2021 Hyundai Tucson (Antioch, TN)</span>
            <span>&bull;</span>
            <span class="px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold inline-flex items-center gap-1">
              <svg class="w-3 h-3 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Verified Google Review
            </span>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col gap-3 justify-center items-start lg:items-end relative z-10">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-extrabold text-sm shadow-lg transition active:scale-95 whitespace-nowrap">
            Call (615) 625-8000
          </a>
          <span class="text-xs text-slate-300">Prompt Mobile Dispatch</span>
        </div>
      </section>

      <!-- Supported Models Grid with Badges & Clear Checkmarks -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-md">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-extrabold uppercase tracking-wider px-2.5 py-1 rounded bg-amber-100 text-amber-900 border border-amber-200">Full Model Coverage</span>
        </div>
        
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-3">
          Hyundai Models We Service in Greater Nashville
        </h2>
        <p class="text-slate-600 text-sm sm:text-base max-w-3xl mb-8 leading-relaxed">
          From early mechanical chip keys to modern proximity push-button start smart fobs, our mobile vans stock OEM-quality keys and programming hardware for the following models:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
          {hyundaiModels.map((m) => (
            <div class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50/50 border border-slate-200 hover:border-amber-300 font-bold text-xs text-slate-800 flex items-center gap-3 transition-colors">
              <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-300">
                <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
              </div>
              <div class="flex flex-col truncate">
                <span class="text-slate-900 font-extrabold truncate">{m.name}</span>
                <span class="text-[10px] text-slate-500 font-normal truncate">{m.type} ({m.keys})</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Dealership vs Armstrong Locksmith Comparison -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-md overflow-hidden">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Dealership vs. Armstrong Locksmith
        </h2>

        <div class="overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 bg-slate-100">
                <th class="py-4 px-5 font-bold text-slate-700">Feature</th>
                <th class="py-4 px-5 font-bold text-slate-700">Hyundai Dealership</th>
                <th class="py-4 px-5 font-extrabold text-emerald-950 bg-emerald-100/80">Armstrong Locksmith</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr class="hover:bg-slate-50 transition">
