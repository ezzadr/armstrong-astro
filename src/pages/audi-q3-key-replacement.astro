---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Audi Q3 Key Replacement Nashville TN | Armstrong Locksmith";
const seoDescription = "Specialized Audi Q3 smart key cutting and immobilizer programming in Nashville. Dealership alternative with same-day mobile dispatch. Call (615) 625-8000.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/audi-q3-key-replacement/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">European Automotive Specialist &bull; TN Lic #406</span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        Audi Q3 Key Replacement <br />
        <span class="text-amber-400">in Nashville, TN</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-3 font-normal leading-relaxed">
        OEM-grade Audi Q3 smart key fobs, flip remotes, and MQB immobilizer programming on-site in Nashville, Brentwood, and Franklin.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition active:scale-95">
          <span>Call (615) 625-8000</span>
        </a>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Video Showcase</span>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a]">Dealer-Level Audi Q3 Key Programming in Action</h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            Audi Q3 vehicles feature sophisticated MQB anti-theft security systems. Watch our lead technician Rahim decode, cut, and program an Audi smart key on-site.
          </p>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-lg border border-slate-200 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/i_GF_mS0lBk" 
            title="Audi Q3 Key Replacement Nashville" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>