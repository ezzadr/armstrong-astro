---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Privacy Policy | Armstrong Locksmith Nashville";
const seoDescription = "Privacy Policy for Armstrong Locksmith Inc. Learn how we protect your personal information, quote requests, and contact details.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/privacy-policy/">
  <header class="bg-[#0f274a] bg-navy-grid text-white py-12 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-white mb-2">Privacy Policy</h1>
      <p class="text-slate-300 text-sm">Last updated: January 2026 &bull; Armstrong Locksmith Inc</p>
    </div>
  </header>

  <main class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-3xl mx-auto prose prose-slate text-slate-800 text-sm sm:text-base leading-relaxed flex flex-col gap-6">
      
      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">1. Information We Collect</h2>
        <p>
          When you request a quote, book a service, or contact Armstrong Locksmith Inc through our website (armstronglocksmithinc.com), we collect personal information you provide such as your name, phone number, email address, vehicle details (year, make, model), and service location.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">2. How We Use Your Information</h2>
        <p>
          We use your contact information exclusively to dispatch technicians, provide upfront quotes, send SMS job status updates, and verify vehicle or property ownership prior to performing locksmith services. We do NOT sell, rent, or trade your personal information to third-party advertisers.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">3. SMS Text Messaging Terms</h2>
        <p>
          By submitting your phone number on our quote or contact forms, you consent to receive direct text messages from Armstrong Locksmith regarding your quote or scheduled technician arrival. Standard message and data rates may apply. You may opt out at any time by replying STOP.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0f274a] font-serif mb-2">4. Contact Information</h2>
        <p>
          For any questions regarding this Privacy Policy, please contact our shop at: <br />
          <strong>Armstrong Locksmith Inc</strong> <br />
          208 Thompson Ln, Nashville, TN 37211 <br />
          Phone: <a href="tel:6156258000" class="text-amber-700 font-bold underline">(615) 625-8000</a> <br />
          Email: armstronglocksmithinc@gmail.com
        </p>
      </div>

    </div>
  </main>
</Layout>
