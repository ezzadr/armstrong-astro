---
import Layout from '../layouts/Layout.astro';
const seoTitle = "Automotive Locksmith Nashville TN | Mobile Car Key Specialist";
const seoDescription = "Nashville's #1 automotive locksmith. Car key replacement, laser cutting, transponder & smart key programming for all domestic, Asian, and European makes. (615) 625-8000.";
---
<Layout title={seoTitle} description={seoDescription} canonical="/automotive-locksmith-in-nashville-tn/">
  <header class="bg-[#0f274a] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-300 block mb-2">Auto Key Specialist &bull; TN Lic #406</span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        Nashville Automotive Locksmith <br />
        <span class="text-amber-400">&amp; Car Key Replacement</span>
      </h1>
      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-2xl mt-3 font-normal leading-relaxed">
        Car key replacement, proximity push-to-start programming, emergency lockouts, and ignition repair across Nashville, Franklin, and Brentwood.
      </p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-6">
        <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition active:scale-95">
          <span>Call (615) 625-8000</span>
        </a>
      </div>
    </div>
  </header>
  <section class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm">
        <h2 class="text-lg font-bold text-[#0f274a] font-serif mb-2">European Vehicles</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Specialized key cutting and programming for BMW, Mercedes, Audi, Land Rover & Bentley.</p>
      </div>
      <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm">
        <h2 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Domestic & Asian</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Toyota, Honda, Ford, Chevy, Nissan, Hyundai, Kia, Dodge, and Jeep smart keys.</p>
      </div>
      <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm">
        <h2 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Emergency Lockouts</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">15�25 minute mobile dispatch to unlock any car door non-destructively without damage.</p>
      </div>
    </div>
  </section>
</Layout>