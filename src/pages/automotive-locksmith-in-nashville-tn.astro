---
import Layout from '../layouts/Layout.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "Automotive Locksmith Nashville TN | Armstrong Locksmith";
const seoDescription = "Complete auto locksmith services in Nashville, TN. Car key cutting, transponders, smart fobs & ignition repairs on-site. (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/automotive-locksmith-in-nashville-tn/">
  
  <!-- Hero Section -->
  <header class="relative bg-gradient-to-br from-[#07152b] via-[#0f274a] to-[#16335c] text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto text-left">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-300 uppercase tracking-wider mb-3">
        <span class="px-2.5 py-0.5 rounded bg-amber-400/20 border border-amber-400/30">Auto Key Specialist</span>
        <span>&bull;</span>
        <span>Certified & Insured</span>
        <span>&bull;</span>
        <span>No Call Centers &bull; Real Techs</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-white tracking-tight leading-tight">
        Automotive Locksmith Nashville <br />
        <span class="text-amber-400">Keys Cut, Fobs Programmed, Ignitions Fixed</span>
      </h1>

      <p class="text-slate-200 text-sm sm:text-base lg:text-lg max-w-3xl mt-4 font-normal leading-relaxed">
        We help with most vehicles on the road today, especially when you-re stuck with no start, no remote, or no working key. Stuck at a BNA parking deck, The Gulch, Downtown, or Brentwood? We bring our fully equipped mobile workshop to your vehicle, or visit our physical storefront at 208 Thompson Ln.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-7">
        <a 
          href="tel:6156258000" 
          class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base flex items-center justify-center gap-2.5 shadow-lg transition active:scale-95 whitespace-nowrap"
        >
          <svg class="w-5 h-5 text-white animate-bounce" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
          <span>Call (615) 625-8000</span>
        </a>

        <a 
          href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-7 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg transition active:scale-95 whitespace-nowrap"
        >
          <span>Book Online Appointment</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Quick Key Takeaways Bar -->
  <section class="bg-amber-50 border-b border-amber-200 py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⚡</span>
        <div><strong class="block text-slate-900 font-bold">Same-Day Mobile Dispatch</strong><span class="text-slate-500 text-[11px]">Mobile units across Nashville</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⚡</span>
        <div><strong class="block text-slate-900 font-bold">208 Thompson Ln</strong><span class="text-slate-500 text-[11px]">Physical storefront shop</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">⚡</span>
        <div><strong class="block text-emerald-800 font-bold">Save $200-$600</strong><span class="text-slate-500 text-[11px]">vs Dealership Towing &amp; Wait</span></div>
      </div>
      <div class="flex items-center gap-2.5">
        <span class="text-xl">🛡️</span>
        <div><strong class="block text-slate-900 font-bold">Certified & Insured</strong><span class="text-slate-500 text-[11px]">Verified Master Locksmith</span></div>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <main class="py-16 sm:py-20 bg-slate-50 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      
      <!-- REAL JOB CASE STUDY: 2007 Porsche 911 KESSY Module (With Video) -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 flex flex-col gap-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold w-fit">
            <span>&#10003;</span> Real Job Done In-House
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] leading-tight">
            2007 Porsche 911: All Keys Lost, Made In-House
          </h2>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            A customer in Woodbine had lost all keys to their 2007 Porsche 911. The Porsche dealer quoted around <strong>$1,300</strong> and a 3-week wait just to produce one key from Germany.
          </p>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
            On this generation of 911, there is no shortcut: the <strong>KESSY immobilizer module</strong> must be removed to originate the key data. We handled the entire job in-house at our 208 Thompson Ln shop, KESSY module pulled, key laser-cut, and car running in about <strong>2 hours</strong>.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-bold text-slate-700">
            <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1.5 rounded-lg">&#10003; Saved Customer Over $700</span>
            <span class="bg-slate-100 px-3 py-1.5 rounded-lg">&#10003; 2-Hour Turnaround vs 3 Weeks</span>
          </div>
        </div>
        <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-xl border border-slate-300 aspect-video bg-black">
          <iframe 
            class="w-full h-full" 
            src="https://www.youtube.com/embed/pRr53jg4xw4" 
            title="Porsche 911 All Keys Lost KESSY Module Locksmith Demonstration" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>

      <!-- Interactive Car Key Estimator -->
      <CarKeyEstimator />

      <!-- WHAT WE DO (IN-HOUSE SERVICES) -->
      <section class="flex flex-col gap-6">
        <div class="text-left">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">Our Capabilities</span>
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a]">
            Complete Automotive Security Services (Done In-House)
          </h2>
          <p class="text-slate-600 text-sm sm:text-base max-w-3xl mt-2 leading-relaxed">
            When you call (615) 625-8000, you talk directly to a local licensed locksmith technician, not a third-party lead generation dispatch center.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Car Key Replacement &amp; Duplicates</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              All Keys Lost origination via VIN decoding or mechanical lock reading. Spare keys duplicated and programmed promptly.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Fob Programming &amp; Push-To-Start</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We stock and synchronize Smart Proximity Fobs, Keyless Go remotes, and flip keys for domestic, Asian, and European vehicles.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM14.121 9.879L19 5m-7 7L9.121 9.879a3 3 0 10-4.242 4.242 3 3 0 004.242 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">High-Security Laser Key Cutting</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Precision computerized CNC cutting for internal track sidewinder key blades to prevent premature ignition wafer wear.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div>
            <h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">European &amp; Luxury Specialist</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Owner Rahim specializes in hard jobs: BMW (CAS/FEM/BDC), Audi/VW (MQB/BCM2), Range Rover (KVM), Mercedes, and Porsche.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Ignition Repair &amp; Wafer Rebuild</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              If your Honda, Ford, or Chrysler key won-t turn, we rebuild worn internal wafers and match the cylinder to your key without full column replacement.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-7 border border-slate-200 shadow-sm hover:border-amber-500 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg></div><h3 class="text-lg font-bold text-[#0f274a] font-serif mb-2">Broken Key Extraction &amp; Lockouts</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Key broken inside ignition or door lock? We extract the broken blade non-destructively and cut a fresh replacement on the spot.
            </p>
          </div>
        </div>
      </section>

      <!-- 4-STEP ON-SITE PROCESS -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block mb-2">Clean Process</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          How It Works (Fast + Transparent)
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">1</span>
            <h4 class="font-bold text-[#0f274a] text-base">Call or Text Info</h4>
            <p class="text-xs text-slate-600 leading-relaxed">Provide your Year, Make, Model, and location (e.g., "2018 Ford F-150 at Opry Mills").</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">2</span>
            <h4 class="font-bold text-[#0f274a] text-base">Security Verification</h4>
            <p class="text-xs text-slate-600 leading-relaxed">ID and vehicle registration/title are verified on-site before cutting or programming.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">3</span>
            <h4 class="font-bold text-[#0f274a] text-base">Laser Cut &amp; Sync</h4>
            <p class="text-xs text-slate-600 leading-relaxed">We decode the lock with Lishi tools, CNC laser cut the blade, and sync transponders via OBD2.</p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0f274a] text-white flex items-center justify-center font-bold text-sm">4</span>
            <h4 class="font-bold text-[#0f274a] text-base">Complete Testing</h4>
            <p class="text-xs text-slate-600 leading-relaxed">Door locks, ignition start, and proximity fobs are 100% verified before payment.</p>
          </div>
        </div>
      </section>

      <!-- VEHICLE MAKES WE SERVICE -->
      <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#0f274a] mb-6">
          Vehicle Makes We Cut &amp; Program in Nashville
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-xs font-bold text-slate-800">
          <a href="/toyota-car-key-replacement/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003; Toyota / Lexus</a>
          <a href="/honda-car-keys/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003; Honda / Acura</a>
          <a href="/bmw/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003;? BMW / Mini</a>
          <a href="/audi-car-keys/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003;? Audi / VW</a>
          <a href="/mercedes-benz/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003;? Mercedes-Benz</a>
          <a href="/land-rover-key-replacement-in-nashville-tn-armstrong-locksmith-inc/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003;? Land Rover</a>
          <a href="/hyundai/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003; Hyundai</a>
          <a href="/kia-car-key-replacement/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003; Kia</a>
          <a href="/bentley-key-replacement/" class="p-3.5 rounded-xl bg-slate-50 hover:bg-amber-50 hover:border-amber-400 border border-slate-200 transition flex items-center gap-1.5">&#10003;? Bentley</a>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-1.5">&#10003; Ford / Lincoln</div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-1.5">&#10003; Chevy / GMC</div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-1.5">&#10003; Dodge / Jeep / RAM</div>
        </div>
      </section>

      <!-- Emergency Dispatch CTA Banner -->
      <section class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-[#0f274a] via-[#16335c] to-[#0f274a] text-white shadow-xl border-t-4 border-amber-500 flex flex-col md:flex-row items-center justify-between gap-8 text-left">
        <div class="max-w-2xl">
          <span class="text-xs font-black uppercase tracking-wider text-amber-300 bg-white/10 px-3 py-1 rounded-full">
            🚨 24/7 Mobile Dispatch Across Middle Tennessee
          </span>
          <h3 class="text-2xl sm:text-3xl font-bold font-serif text-white mt-3 mb-2">
            Locked Out or Need a Car Key Programmed Today?
          </h3>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
            Skip the dealership delays and high towing fees. Our mobile locksmith vans carry precision laser cutters and factory key programmers right to your vehicle.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3.5 w-full md:w-auto flex-shrink-0">
          <a href="tel:6156258000" class="px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm text-center shadow-lg transition active:scale-95 flex items-center justify-center gap-2 whitespace-nowrap">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"></path></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="https://online-booking.workiz.com/?ac=ff72b9e4da07483dc3ea20c43712756d0e1998076465f7ea6768e02921635648" target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs text-center shadow transition active:scale-95 flex items-center justify-center whitespace-nowrap">
            <span>Book Online</span>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
