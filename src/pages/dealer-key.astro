---
import Layout from '../layouts/Layout.astro';
import CarKeyEstimator from '../components/CarKeyEstimator.astro';

const seoTitle = "OEM Dealer Key Alternative Nashville | Armstrong Locksmith";
const seoDescription = "Avoid dealership backorders and towing fees. OEM-grade car key cutting and immobilizer programming on-site in Nashville. (615) 625-8000.";
---

<Layout title={seoTitle} description={seoDescription} canonical="/dealer-key/">
  
  <header class="relative bg-showroom text-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-amber-500 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 flex flex-col gap-4 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-amber-300 w-fit">
          <span>OEM Factory Quality &bull; NASTF Credentialed</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-heading font-black uppercase text-white tracking-tight leading-tight">
          OEM Dealer Key Alternative <br />
          <span class="text-amber-400">in Nashville, TN</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          Get genuine OEM factory car keys without dealership prices or multi-week delays. We carry factory blanks and dealer-level programmers for domestic, Asian, and luxury European vehicles.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a href="tel:6156258000" class="px-7 py-3.5 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-white font-extrabold text-base flex items-center justify-center gap-2 shadow-lg transition">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.8-.4 1.2-.2 1 .4 2.1.6 3.2.6.7 0 1.2.5 1.2 1.2V20c0 .7-.5 1.2-1.2 1.2C10.9 21.2 2.8 13.1 2.8 3.2 2.8 2.5 3.3 2 4 2h3.2c.7 0 1.2.5 1.2 1.2 0 1.1.2 2.2.6 3.2.1.4 0 .9-.2 1.2L6.6 10.8Z"/></svg>
            <span>Call (615) 625-8000</span>
          </a>
          <a href="/book-online/" target="_blank" rel="noopener noreferrer" class="px-7 py-3.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-base flex items-center justify-center shadow-md transition">
            <span>Book Online</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-xl border border-slate-200 text-slate-900">
          <h2 class="text-xl font-bold text-[#0f274a] font-heading font-black uppercase pb-3 border-b border-slate-100">
            Trusted by Local Dealerships
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 my-4 leading-relaxed">
            Did you know many car dealerships across Nashville actually outsource their difficult key programming and lock decoding jobs to Armstrong Locksmith?
          </p>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600">
            ⚡ Save 40% to 60% by coming directly to the specialist the dealerships trust.
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Interactive OEM Key Estimator -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <CarKeyEstimator 
      title="OEM Key vs Dealership Estimator" 
      subtitle="Select your vehicle make, year range, and situation to check instant key availability, dealer savings, and programming turnaround times." 
    />
  </section>

  <!-- Complete Original WordPress Long-Form Content -->
  <section class="py-16 sm:py-20 bg-white px-4 sm:px-6 lg:px-8 border-b border-slate-200">
    <div class="max-w-4xl mx-auto flex flex-col gap-10 text-slate-800 leading-relaxed text-sm sm:text-base">
      
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-heading font-black uppercase mb-4">
          Why Dealerships Outsource to Armstrong
        </h2>
        <p class="mb-4">
          Dealerships often face long parts shipping times and complex immobilization locks. Here is why local automotive dealers and individual car owners partner with Armstrong Locksmith:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-2">In-Stock Inventory</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              We stock thousands of remotes, smart keys, and transponder shells locally in Nashville. You don't need to wait 3 to 14 days for a part to arrive from overseas.
            </p>
          </div>

          <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-2">Proprietary Tooling</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              We carry NASTF credentials and proprietary programmers that handle "tricky" vehicles and EEPROM bench calculations where generic OBDII tools fail.
            </p>
          </div>

          <div class="card-clean shadow-sharp hover-lift reveal-up rounded-2xl p-6">
            <h3 class="font-bold text-[#0f274a] text-base mb-2">On-Demand Dispatch</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              We establish a rhythm—whether that's a regular route for dealership sales lots or immediate on-call emergency service for stranded drivers.
            </p>
          </div>
        </div>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f274a] font-heading font-black uppercase mb-3">
          Skip Dealership Towing & Markups
        </h2>
        <p class="mb-3">
          When you lose your car keys, most dealerships insist that you have your vehicle towed to their lot. You pay for the tow truck, wait days for their service queue, and then pay an inflated dealership labor rate.
        </p>
        <p>
          With Armstrong Locksmith, our mobile workshop comes directly to where your car is parked. We laser-cut your emergency key and program the smart proximity remote right on the spot—saving you hundreds of dollars and days of hassle.
        </p>
      </div>

    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[#0f274a] bg-navy-grid text-white py-14 px-4 sm:px-6 text-center">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-4">
      <h2 class="text-2xl sm:text-4xl font-bold font-heading font-black uppercase text-white">Need an OEM Factory Key Replacement?</h2>
      <p class="text-slate-200 text-sm sm:text-base">Call our shop now to check inventory for your vehicle make and year.</p>
      <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
        <a href="tel:6156258000" class="px-8 py-3.5 rounded-xl bg-gold-metallic hover:bg-amber-400 text-slate-950 text-white font-extrabold text-base shadow">
          Call (615) 625-8000
        </a>
        <a href="/book-online/" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-xl bg-gold-metallic shadow-sharp-gold hover-lift-gold text-slate-950 font-extrabold text-base shadow">
          Book Online
        </a>
      </div>
    </div>
  </section>
</Layout>
